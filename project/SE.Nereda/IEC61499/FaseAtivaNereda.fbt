  <BasicFB ID="ed6d0e9e-72ae-b67e-9ec4-bd019fc7bbfe">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="Calcula" />
    <InternalVars>
      <VarDeclaration ID="950BC38432526141" Name="primeira" Type="BOOL" InitialValue="TRUE" Comment="Forca o CNF na 1a execucao" />
      <VarDeclaration ID="F183FD408479AE55" Name="oldFaseAtiva" Type="INT" />
      <VarDeclaration ID="7CBC03B38BCECE73" Name="oldFaseAbortada" Type="INT" />
      <VarDeclaration ID="32B02C9868F58C8F" Name="oldAbortado" Type="BOOL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Estado inicial" x="550" y="430" />
      <ECState Name="CALCULO" Comment="Calcula; CNF so quando muda" x="1170" y="730">
        <ECAction Algorithm="Calcula" />
        <ECAction Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="CALCULO" Condition="REQ" x="895" y="505" />
      <ECTransition Source="CALCULO" Destination="START" Condition="1" x="880" y="665" />
    </ECC>
    <Algorithm Name="Calcula" Comment="Numero da fase ativa e da abortada">
      <ST><![CDATA[
CNF := FALSE;
IF (Run1 OR Partindo1 OR Parando1 OR Abortando1) THEN
    FaseAtiva := 1;
ELSIF (Run2 OR Partindo2 OR Parando2 OR Abortando2) THEN
    FaseAtiva := 2;
ELSIF (Run3 OR Partindo3 OR Parando3 OR Abortando3) THEN
    FaseAtiva := 3;
ELSIF (Run4 OR Partindo4 OR Parando4 OR Abortando4) THEN
    FaseAtiva := 4;
ELSIF (Run5 OR Partindo5 OR Parando5 OR Abortando5) THEN
    FaseAtiva := 5;
ELSIF (Run6 OR Partindo6 OR Parando6 OR Abortando6) THEN
    FaseAtiva := 6;
ELSIF (Run7 OR Partindo7 OR Parando7 OR Abortando7) THEN
    FaseAtiva := 7;
ELSIF (Run8 OR Partindo8 OR Parando8 OR Abortando8) THEN
    FaseAtiva := 8;
ELSIF (Run9 OR Partindo9 OR Parando9 OR Abortando9) THEN
    FaseAtiva := 9;
ELSIF (Run10 OR Partindo10 OR Parando10 OR Abortando10) THEN
    FaseAtiva := 10;
ELSE
    FaseAtiva := 0;
END_IF;
IF Abortada1 THEN
    FaseAbortada := 1;
ELSIF Abortada2 THEN
    FaseAbortada := 2;
ELSIF Abortada3 THEN
    FaseAbortada := 3;
ELSIF Abortada4 THEN
    FaseAbortada := 4;
ELSIF Abortada5 THEN
    FaseAbortada := 5;
ELSIF Abortada6 THEN
    FaseAbortada := 6;
ELSIF Abortada7 THEN
    FaseAbortada := 7;
ELSIF Abortada8 THEN
    FaseAbortada := 8;
ELSIF Abortada9 THEN
    FaseAbortada := 9;
ELSIF Abortada10 THEN
    FaseAbortada := 10;
ELSE
    FaseAbortada := 0;
END_IF;
Abortado := FaseAbortada <> 0;
CNF := primeira OR (FaseAtiva <> oldFaseAtiva) OR (FaseAbortada <> oldFaseAbortada) OR (Abortado <> oldAbortado);
primeira := FALSE;
oldFaseAtiva := FaseAtiva;
oldFaseAbortada := FaseAbortada;
oldAbortado := Abortado;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>