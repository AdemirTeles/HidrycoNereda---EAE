<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="4d202228-76b9-6e4e-5bcf-30e8e0268320" Name="FaseAtivaNereda" Comment="Numero da fase ativa e da fase abortada (pela ordem das entradas) e indicacao de abortado" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.1" Author="Hidryco" Date="05/11/2026" Remarks="1.1: fase ativa = Starting OU Run OU Stopping OU Aborting (entradas PartindoN, ParandoN, AbortandoN). 1.0: FaseAtiva = numero da 1a entrada RunN em TRUE (0 = nenhuma); FaseAbortada = numero da 1a AbortadaN em TRUE (0 = nenhuma); Abortado = alguma AbortadaN. CNF so quando muda (e na 1a execucao). Eventos de saida no ECAction." />
