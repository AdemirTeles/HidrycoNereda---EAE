      <VarDeclaration ID="AF551534ABAEDE3F" Name="Abortando3" Type="BOOL" Comment="Fase 3 em Aborting" />
      <VarDeclaration ID="D2D6B4CA266DBF39" Name="Abortando4" Type="BOOL" Comment="Fase 4 em Aborting" />
      <VarDeclaration ID="C470074BD9FEF42B" Name="Abortando5" Type="BOOL" Comment="Fase 5 em Aborting" />
      <VarDeclaration ID="B46E5CD27C1FCDC2" Name="Abortando6" Type="BOOL" Comment="Fase 6 em Aborting" />
      <VarDeclaration ID="B9B9DAB68E47429C" Name="Abortando7" Type="BOOL" Comment="Fase 7 em Aborting" />
      <VarDeclaration ID="FBF7FC80F3272994" Name="Abortando8" Type="BOOL" Comment="Fase 8 em Aborting" />
      <VarDeclaration ID="CD8CBCB313CC106A" Name="Abortando9" Type="BOOL" Comment="Fase 9 em Aborting" />
      <VarDeclaration ID="A6EE12AB368E4898" Name="Abortando10" Type="BOOL" Comment="Fase 10 em Aborting" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="510DBF64A9858AD2" Name="FaseAtiva" Type="INT" Comment="0 = nenhuma; N = fase da entrada RunN" />
      <VarDeclaration ID="2862F8884DCC93F5" Name="FaseAbortada" Type="INT" Comment="0 = nenhuma; N = fase da entrada AbortadaN" />
      <VarDeclaration ID="4D0A848FDD4477A8" Name="Abortado" Type="BOOL" Comment="TRUE = alguma fase abortada" />
    </OutputVars>
