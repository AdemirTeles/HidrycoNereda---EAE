        <Attribute Name="Configuration.Transaction.BezierPoints" Value="495.5176,466.5339,495.2582,418.6754" />
      </ECTransition>
      <ECTransition Source="R_ABORT" Destination="Reset" Condition="NOT EmergencyON" x="1480.368" y="1866.479">
