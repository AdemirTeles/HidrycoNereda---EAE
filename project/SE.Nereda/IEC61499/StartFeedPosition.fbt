        <Attribute Name="Configuration.Transaction.BezierPoints" Value="1149.581,312.6808,1149.996,402.5615" />
      </ECTransition>
      <ECTransition Source="R_ABORT" Destination="R_ABORT" Condition="REACTOR_N_AV AND EmergencyON" x="2606.695" y="2446.565">
