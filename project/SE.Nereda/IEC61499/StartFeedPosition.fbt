    END_IF;

    IF R3Exist AND R3Available AND (TimeFLastFeedV_R3 >= TimeFLastFeedV_R6) THEN
        StartFeedPositionR6 := StartFeedPositionR6 + 1;
    END_IF;

    IF R4Exist AND R4Available AND (TimeFLastFeedV_R4 >= TimeFLastFeedV_R6) THEN
        StartFeedPositionR6 := StartFeedPositionR6 + 1;
    END_IF;

    IF R5Exist AND R5Available AND (TimeFLastFeedV_R5 >= TimeFLastFeedV_R6) THEN
        StartFeedPositionR6 := StartFeedPositionR6 + 1;
    END_IF;

ELSIF R6Exist AND NOT R6Available THEN

    StartFeedPositionR6 := NbrReactorExisting;

END_IF;]]></ST>
