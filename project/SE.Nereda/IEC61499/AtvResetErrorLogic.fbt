    <Algorithm Name="INIT" Comment="Initialization algorithm">
      <ST><![CDATA[;
ResetError := FALSE;
CmdReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="ATV_RDY">
      <ST><![CDATA[;
ResetError := FALSE;
NeedResetActivated := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="NeedReset">
      <ST><![CDATA[;
NeedResetActivated := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="CmdReset">
      <ST><![CDATA[ResetError := TRUE;
NeedResetActivated := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="SendCmdRdy">
