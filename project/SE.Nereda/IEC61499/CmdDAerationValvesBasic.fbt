    <Algorithm Name="CloseAllValves">
      <ST><![CDATA[;
IF Grafcet = 5 THEN
	Grafcet := 6;
ELSIF Grafcet = 8 THEN
	Grafcet := 9;
ELSIF Grafcet = 11 THEN
	Grafcet := 12;
END_IF;
AerationValve1 := FALSE;
AerationValve2 := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="StartReady">
      <ST><![CDATA[;
Grafcet := 2;
StartReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="OpenValves">
      <ST><![CDATA[;
Grafcet := 1;
StopReady := FALSE;
AbortReady := FALSE;

IF AerationGrid AND NOT InfluentGrid THEN
	AerationValve1 := TRUE;
	AerationValve2 := FALSE;

ELSIF NOT AerationGrid AND InfluentGrid THEN
	AerationValve1 := FALSE;
	AerationValve2 := TRUE;

ELSIF AerationGrid AND InfluentGrid THEN
	AerationValve1 := TRUE;
	AerationValve2 := TRUE;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm Name="UpdateValvesState">
      <ST><![CDATA[;
Grafcet := 4;
IF AerationGrid AND NOT InfluentGrid THEN
	AerationValve1 := TRUE;
	AerationValve2 := FALSE;

ELSIF NOT AerationGrid AND InfluentGrid THEN
	AerationValve1 := FALSE;
	AerationValve2 := TRUE;

ELSIF AerationGrid AND InfluentGrid THEN
	AerationValve1 := TRUE;
	AerationValve2 := TRUE;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm Name="AbortReady">
      <ST><![CDATA[;
Grafcet := 10;
AbortReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="StopReady">
      <ST><![CDATA[;
Grafcet := 7;
StopReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="RunBlowers">
      <ST><![CDATA[;
Grafcet := 3;
CmdBlowers := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="StopBlowers">
      <ST><![CDATA[;
IF Grafcet = 4 THEN
	Grafcet := 5;
ELSE
	Grafcet := 11;
END_IF;
CmdBlowers := FALSE;
StartReady := FALSE;
AbortReady := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="StopBlowers_WhenAborting">
      <ST><![CDATA[;
Grafcet := 8;
CmdBlowers := FALSE;
StartReady := FALSE;
StopReady := FALSE;]]></ST>
    </Algorithm>
    <Algorithm ID="efd24950-557f-47b4-ae2f-0d3a0233caad" Name="Open1stValve">
      <ST><![CDATA[;
IF AerationGrid AND NOT InfluentGrid THEN
	AerationValve1 := TRUE;
	
ELSIF NOT AerationGrid AND InfluentGrid THEN
	AerationValve2 := TRUE;

ELSIF AerationGrid AND InfluentGrid THEN
	AerationValve1 := TRUE;
	AerationValve2 := TRUE;
END_IF;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>