      </ECTransition>
      <ECTransition Source="START_REACTOR" Destination="Change" Condition="FB_NEXT_FEED AND&#xD;&#xA;(NFHDoneR1 OR&#xD;&#xA;NFHDoneR2 OR&#xD;&#xA;NFHDoneR3 OR&#xD;&#xA;NFHDoneR4 OR&#xD;&#xA;NFHDoneR5 OR&#xD;&#xA;NFHDoneR6)" x="2558.05" y="3865.032">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="609.7456,944.3139,600.4261,987.0911" />
