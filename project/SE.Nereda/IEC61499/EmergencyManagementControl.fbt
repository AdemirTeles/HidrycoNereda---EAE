        <ECAction Output="GRAPH" />
      </ECState>
      <ECState Name="Change" x="3128.444" y="4157.403" />
      <ECTransition Source="START" Destination="StopAll" Condition="MODE AND Mode = 3 AND NbrOfReactorsAvailable &gt;= 2 AND&#xD;&#xA;&#xD;&#xA;((NOT FbExistR1) OR Reactor1Available) AND&#xD;&#xA;((NOT FbExistR2) OR Reactor2Available) AND&#xD;&#xA;((NOT FbExistR3) OR Reactor3Available) AND&#xD;&#xA;((NOT FbExistR4) OR Reactor4Available) AND&#xD;&#xA;((NOT FbExistR5) OR Reactor5Available) AND&#xD;&#xA;((NOT FbExistR6) OR Reactor6Available)" x="3121.554" y="659.186">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="780.3288,146.9099,780.3474,181.7631" />
      </ECTransition>
      <ECTransition Source="STARTUP_D" Destination="ASK_FEED_POSITION" Condition="FB_START_UP_DELAY AND StartUpDelay AND&#xD;&#xA;NbrOfReactorsAvailable &gt;= 1" x="3124.487" y="1809.895">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="781.0154,432.8134,780.9992,469.5187" />
      </ECTransition>
      <ECTransition Source="StopAll" Destination="START" Condition="Mode &lt;&gt; 3" x="2655.995" y="670.2914">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="636.577,185.5772,635.0254,150.2176" />
      </ECTransition>
      <ECTransition Source="ASK_FEED_POSITION" Destination="ASK_FOR_INIT" Condition="START_FEED_POS AND&#xD;&#xA;&#xD;&#xA;(StartFeedPositionR1 &lt;&gt; 0 OR&#xD;&#xA;StartFeedPositionR2 &lt;&gt; 0 OR&#xD;&#xA;StartFeedPositionR3 &lt;&gt; 0 OR&#xD;&#xA;StartFeedPositionR4 &lt;&gt; 0 OR&#xD;&#xA;StartFeedPositionR5 &lt;&gt; 0 OR&#xD;&#xA;StartFeedPositionR6 &lt;&gt; 0)" x="3121.557" y="2353.346">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="780.4389,569.9572,780.0573,605.2462" />
      </ECTransition>
      <ECTransition Source="ASK_FOR_INIT" Destination="InitDone" Condition="Valid" x="3125.153" y="2845.996">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="781.3019,695.3469,781.5368,725.4559" />
      </ECTransition>
      <ECTransition Source="StopAll" Destination="STARTUP_D" Condition="Mode = 3 AND NbrOfReactorsAvailable &gt;= 2 AND&#xD;&#xA;&#xD;&#xA;((NOT FbExistR1) OR Reactor1Available) AND&#xD;&#xA;((NOT FbExistR2) OR Reactor2Available) AND&#xD;&#xA;((NOT FbExistR3) OR Reactor3Available) AND&#xD;&#xA;((NOT FbExistR4) OR Reactor4Available) AND&#xD;&#xA;((NOT FbExistR5) OR Reactor5Available) AND&#xD;&#xA;((NOT FbExistR6) OR Reactor6Available)" x="3126.074" y="1238.682">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="781.434,287.8116,781.7858,331.3788" />
      </ECTransition>
