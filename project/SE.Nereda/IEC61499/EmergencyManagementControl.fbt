    </ECC>
    <Algorithm Name="StopAll">
      <ST><![CDATA[;
Grafcet := 10;
InitDone := FALSE;
Initialize := FALSE;
InitRx_ToSD := 0;
InitRx_ToW_S2 := 0;
StartFeed_R1 := FALSE;
StartFeed_R2 := FALSE;
StartFeed_R3 := FALSE;
StartFeed_R4 := FALSE;
StartFeed_R5 := FALSE;
StartFeed_R6 := FALSE;]]></ST>
    </Algorithm>
    <Algorithm ID="4877ac90-febc-4930-bbe8-adb94d3789c8" Name="Initialize">
      <ST><![CDATA[;
Grafcet := 3;
Initialize := TRUE;

//=========================================================
IF FbExistR1 AND StartFeedPositionR1 = 3 THEN
	InitRx_ToSD := 1;
END_IF;

IF FbExistR2 AND StartFeedPositionR2 = 3 THEN
	InitRx_ToSD := 2;
END_IF;

IF FbExistR3 AND StartFeedPositionR3 = 3 THEN
	InitRx_ToSD := 3;
END_IF;

IF FbExistR4 AND StartFeedPositionR4 = 3 THEN
	InitRx_ToSD := 4;
END_IF;

IF FbExistR5 AND StartFeedPositionR5 = 3 THEN
	InitRx_ToSD := 5;
END_IF;

IF FbExistR6 AND StartFeedPositionR6 = 3 THEN
	InitRx_ToSD := 6;
END_IF;

//=========================================================
IF FbExistR1 AND StartFeedPositionR1 = 2 THEN
	InitRx_ToW_S2 := 1;
END_IF;

IF FbExistR2 AND StartFeedPositionR2 = 2 THEN
	InitRx_ToW_S2 := 2;
END_IF;

IF FbExistR3 AND StartFeedPositionR3 = 2 THEN
	InitRx_ToW_S2 := 3;
END_IF;

IF FbExistR4 AND StartFeedPositionR4 = 2 THEN
	InitRx_ToW_S2 := 4;
END_IF;

IF FbExistR5 AND StartFeedPositionR5 = 2 THEN
	InitRx_ToW_S2 := 5;
END_IF;

IF FbExistR6 AND StartFeedPositionR6 = 2 THEN
	InitRx_ToW_S2 := 6;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm ID="46b59b82-eae5-4c38-a90c-e86c990cddcb" Name="StartUpDelay">
      <ST><![CDATA[;
Grafcet := 1;]]></ST>
    </Algorithm>
    <Algorithm ID="071bc27f-30d3-4f8c-9070-50790b325732" Name="AskForPosition">
      <ST><![CDATA[;
Grafcet := 2;

StartFeed_R1 := FALSE;
StartFeed_R2 := FALSE;
StartFeed_R3 := FALSE;
StartFeed_R4 := FALSE;
StartFeed_R5 := FALSE;
StartFeed_R6 := FALSE;]]></ST>
    </Algorithm>
    <Algorithm ID="f342b562-1ea9-4eef-9144-3a6eef94cf50" Name="ResetInit">
      <ST><![CDATA[;
Initialize := FALSE;
InitDone := TRUE;]]></ST>
    </Algorithm>
    <Algorithm ID="415c869a-43d7-4605-b0ea-accdc65675ab" Name="StartReactors">
      <ST><![CDATA[;
Grafcet := 4;
IF FbExistR1 AND StartFeedPositionR1 = 1 THEN
	StartFeed_R1 := TRUE;
	
	StartFeed_R2 := FALSE;
	StartFeed_R3 := FALSE;
	StartFeed_R4 := FALSE;
	StartFeed_R5 := FALSE;
	StartFeed_R6 := FALSE;
END_IF;

IF FbExistR2 AND StartFeedPositionR2 = 1 THEN
	StartFeed_R2 := TRUE;
	
	StartFeed_R1 := FALSE;
	StartFeed_R3 := FALSE;
	StartFeed_R4 := FALSE;
	StartFeed_R5 := FALSE;
	StartFeed_R6 := FALSE;

END_IF;

IF FbExistR3 AND StartFeedPositionR3 = 1 THEN
	StartFeed_R3 := TRUE;
	
	StartFeed_R1 := FALSE;
	StartFeed_R2 := FALSE;
	StartFeed_R4 := FALSE;
	StartFeed_R5 := FALSE;
	StartFeed_R6 := FALSE;
END_IF;

IF FbExistR4 AND StartFeedPositionR4 = 1 THEN
	StartFeed_R4 := TRUE;
	
	StartFeed_R1 := FALSE;
	StartFeed_R2 := FALSE;
	StartFeed_R3 := FALSE;
	StartFeed_R5 := FALSE;
	StartFeed_R6 := FALSE;
END_IF;

IF FbExistR5 AND StartFeedPositionR5 = 1 THEN
	StartFeed_R5 := TRUE;
	
	StartFeed_R1 := FALSE;
	StartFeed_R2 := FALSE;
	StartFeed_R3 := FALSE;
	StartFeed_R4 := FALSE;
	StartFeed_R6 := FALSE;
END_IF;

IF FbExistR6 AND StartFeedPositionR6 = 1 THEN
	StartFeed_R6 := TRUE;

	StartFeed_R1 := FALSE;
	StartFeed_R2 := FALSE;
	StartFeed_R3 := FALSE;
	StartFeed_R4 := FALSE;
	StartFeed_R5 := FALSE;
END_IF;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>