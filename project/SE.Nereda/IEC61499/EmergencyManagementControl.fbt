    <Algorithm Name="StopAll">
      <ST><![CDATA[Grafcet := 10;
Initialize := FALSE;
ShowInitAction := FALSE;
ShowRxToFeed := 0;

StartFeed_R1 := FALSE;
StartFeed_R2 := FALSE;
StartFeed_R3 := FALSE;
StartFeed_R4 := FALSE;
StartFeed_R5 := FALSE;
StartFeed_R6 := FALSE;]]></ST>
    </Algorithm>
    <Algorithm ID="4877ac90-febc-4930-bbe8-adb94d3789c8" Name="Initialize">
      <ST><![CDATA[Grafcet := 3;
Initialize := TRUE;]]></ST>
    </Algorithm>
    <Algorithm ID="46b59b82-eae5-4c38-a90c-e86c990cddcb" Name="StartUpDelay">
      <ST><![CDATA[Grafcet := 2;
ShowInitAction := TRUE;

IF FbExistR1 AND StartFeedPositionR1 = 1 THEN
	ShowRxToFeed := 1;
END_IF;

IF FbExistR2 AND StartFeedPositionR2 = 1 THEN
	ShowRxToFeed := 2;
END_IF;

IF FbExistR3 AND StartFeedPositionR3 = 1 THEN
	ShowRxToFeed := 3;
END_IF;

IF FbExistR4 AND StartFeedPositionR4 = 1 THEN
	ShowRxToFeed := 4;
END_IF;

IF FbExistR5 AND StartFeedPositionR5 = 1 THEN
	ShowRxToFeed := 5;
END_IF;

IF FbExistR6 AND StartFeedPositionR6 = 1 THEN
	ShowRxToFeed := 6;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm ID="071bc27f-30d3-4f8c-9070-50790b325732" Name="AskForPosition">
      <ST><![CDATA[Grafcet := 1;

StartFeed_R1 := FALSE;
StartFeed_R2 := FALSE;
StartFeed_R3 := FALSE;
StartFeed_R4 := FALSE;
StartFeed_R5 := FALSE;
StartFeed_R6 := FALSE;]]></ST>
    </Algorithm>
    <Algorithm ID="f342b562-1ea9-4eef-9144-3a6eef94cf50" Name="ResetInit">
      <ST><![CDATA[Initialize := FALSE;
ShowInitAction := FALSE;
ShowRxToFeed := 0;
CheckSettleID := 0;
ShowSettleTWait := CheckSettleID;]]></ST>
    </Algorithm>
    <Algorithm ID="415c869a-43d7-4605-b0ea-accdc65675ab" Name="StartReactors">
      <ST><![CDATA[Grafcet := 5;

IF FbExistR1 AND StartFeedPositionR1 = 1 THEN
	StartFeed_R1 := TRUE;
	
	StartFeed_R2 := FALSE;
	StartFeed_R3 := FALSE;
	StartFeed_R4 := FALSE;
	StartFeed_R5 := FALSE;
	StartFeed_R6 := FALSE;
END_IF;

IF FbExistR2 AND StartFeedPositionR2 = 1 THEN
	StartFeed_R2 := TRUE;
	
	StartFeed_R1 := FALSE;
	StartFeed_R3 := FALSE;
	StartFeed_R4 := FALSE;
	StartFeed_R5 := FALSE;
	StartFeed_R6 := FALSE;

END_IF;

IF FbExistR3 AND StartFeedPositionR3 = 1 THEN
	StartFeed_R3 := TRUE;
	
	StartFeed_R1 := FALSE;
	StartFeed_R2 := FALSE;
	StartFeed_R4 := FALSE;
	StartFeed_R5 := FALSE;
	StartFeed_R6 := FALSE;
END_IF;

IF FbExistR4 AND StartFeedPositionR4 = 1 THEN
	StartFeed_R4 := TRUE;
	
	StartFeed_R1 := FALSE;
	StartFeed_R2 := FALSE;
	StartFeed_R3 := FALSE;
	StartFeed_R5 := FALSE;
	StartFeed_R6 := FALSE;
END_IF;

IF FbExistR5 AND StartFeedPositionR5 = 1 THEN
	StartFeed_R5 := TRUE;
	
	StartFeed_R1 := FALSE;
	StartFeed_R2 := FALSE;
	StartFeed_R3 := FALSE;
	StartFeed_R4 := FALSE;
	StartFeed_R6 := FALSE;
END_IF;

IF FbExistR6 AND StartFeedPositionR6 = 1 THEN
	StartFeed_R6 := TRUE;

	StartFeed_R1 := FALSE;
	StartFeed_R2 := FALSE;
	StartFeed_R3 := FALSE;
	StartFeed_R4 := FALSE;
	StartFeed_R5 := FALSE;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm ID="f7809c58-f26d-49f3-bb70-1c6875405e0f" Name="ResetEnableStopFeed">
      <ST><![CDATA[;
EnableForceStopFeed := FALSE;]]></ST>
    </Algorithm>
    <Algorithm ID="68b49f2c-012b-439e-b8e9-0253dfce4de3" Name="SetResetEnableStopFeed">
      <ST><![CDATA[;
EnableForceStopFeed := FeedWasRunning;
FeedWasRunInit := FeedWasRunning;]]></ST>
    </Algorithm>
    <Algorithm ID="59c61642-51ee-4b09-8615-0a0fbabf5c85" Name="ResetFeedWasRunInit">
      <ST><![CDATA[;
FeedWasRunInit := FALSE;]]></ST>
    </Algorithm>
    <Algorithm ID="080e4800-36df-47fe-b9e0-fac54fcb2aec" Name="CheckSettleTime">
      <ST><![CDATA[;
Grafcet := 4;

IF FbExistR1 AND StartFeedPositionR1 = 1 THEN
	CheckSettleID := 1;
END_IF;

IF FbExistR2 AND StartFeedPositionR2 = 1 THEN
	CheckSettleID := 2;
END_IF;

IF FbExistR3 AND StartFeedPositionR3 = 1 THEN
	CheckSettleID := 3;
END_IF;

IF FbExistR4 AND StartFeedPositionR4 = 1 THEN
	CheckSettleID := 4;
END_IF;

IF FbExistR5 AND StartFeedPositionR5 = 1 THEN
	CheckSettleID := 5;
END_IF;

IF FbExistR6 AND StartFeedPositionR6 = 1 THEN
	CheckSettleID := 6;
END_IF;

ShowSettleTWait := CheckSettleID;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>