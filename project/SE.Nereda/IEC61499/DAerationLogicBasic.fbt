      </ECTransition>
      <ECTransition Source="Stop_All" Destination="All_Stopped" Condition="Blower1FbStopped AND Blower2FbStopped" x="5080.251" y="3771.344">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="1269.954,921.3594,1270.142,963.794" />
      </ECTransition>
      <ECTransition Source="FromTowToOneBL" Destination="StartOneBlower" Condition="(BL1WasRun AND Blower1FbSpeed &lt;= C3_IN + 1 AND BL2WasRun AND Blower2FbSpeed &lt;= C3_IN + 1)&#xD;&#xA;OR (NOT BL1WasRun AND Blower1FbSpeed &gt;= C3_IN - 1 AND NOT BL2WasRun AND Blower2FbSpeed &gt;= C3_IN - 1)&#xD;&#xA;OR (BL1WasRun AND Blower1FbSpeed &lt;= C3_IN + 1 AND NOT BL2WasRun AND Blower2FbSpeed &gt;= C3_IN - 1)&#xD;&#xA;OR (NOT BL1WasRun AND Blower1FbSpeed &gt;= C3_IN - 1 AND BL1WasRun AND Blower2FbSpeed &lt;= C3_IN + 1)" x="4132.726" y="2121.195">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="1107.847,576.3276,962.2106,489.3301" />
      </ECTransition>
      <ECTransition Source="FromTowToOneBL" Destination="Stop_All" Condition="NOT AerationCmd" x="5082.493" y="3062.23">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="1270.817,736.1198,1270.97,794.3117" />
      </ECTransition>
      <ECTransition Source="Idle_State" Destination="START" Condition="NOT AerationCmd" x="4720.095" y="567.7084">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="1161.249,166.4644,1161.209,115.3069" />
