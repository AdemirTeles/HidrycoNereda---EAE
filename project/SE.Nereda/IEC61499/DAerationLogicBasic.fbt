    </ECC>
    <Algorithm Name="StartOneBlowers">
      <ST><![CDATA[;
Grafcet := 2;
// Default commands
CmdBlower1 := FALSE;
CmdBlower2 := FALSE;

// Start only one blower
IF Blower1FbReady AND NOT Blower2FbReady THEN

    // Only blower 1 is available
    CmdBlower1 := TRUE;
    CmdBlower2 := FALSE;


ELSIF Blower2FbReady AND NOT Blower1FbReady THEN

    // Only blower 2 is available
    CmdBlower1 := FALSE;
    CmdBlower2 := TRUE;


ELSIF Blower1FbReady AND Blower2FbReady THEN

    // Both blowers are available
    // First selection criteria: lowest total running duration
    IF Blower1TotRunDur < Blower2TotRunDur THEN

        CmdBlower1 := TRUE;
        CmdBlower2 := FALSE;

    ELSIF Blower2TotRunDur < Blower1TotRunDur THEN

        CmdBlower1 := FALSE;
        CmdBlower2 := TRUE;

    ELSE

        // If running durations are equal,
        // second selection criteria: lowest operation count
        IF Blower1OpCount <= Blower2OpCount THEN

            CmdBlower1 := TRUE;
            CmdBlower2 := FALSE;

        ELSE

            CmdBlower1 := FALSE;
            CmdBlower2 := TRUE;

        END_IF;

    END_IF;

ELSE

    // No blower available
    CmdBlower1 := FALSE;
    CmdBlower2 := FALSE;

END_IF;

C_OUT := C3_IN;]]></ST>
    </Algorithm>
    <Algorithm Name="StartTowBlowers">
      <ST><![CDATA[;
Grafcet := 4;

CmdBlower1 := TRUE;
CmdBlower2 := TRUE;
C_OUT := C2_IN;]]></ST>
    </Algorithm>
    <Algorithm Name="OneBlowersRunning">
      <ST><![CDATA[;
Grafcet := 3;

// Start only one blower
IF Blower1FbReady AND NOT Blower2FbReady THEN
	
	// Only blower 1 is available
	CmdBlower1 := TRUE;
	CmdBlower2 := FALSE;
	
	
ELSIF Blower2FbReady AND NOT Blower1FbReady THEN
	
	// Only blower 2 is available
	CmdBlower1 := FALSE;
	CmdBlower2 := TRUE;
END_IF;

// Capacity setpoint during starting
C_OUT := AerCapCalc;

BL1WasRun := Blower1FbRunning;
BL2WasRun := Blower2FbRunning;]]></ST>
    </Algorithm>
    <Algorithm Name="TowBlowersRunning">
      <ST><![CDATA[;
Grafcet := 5;

// Start only one blower
IF Blower1FbReady AND NOT Blower2FbReady THEN
	
	// Only blower 1 is available
	CmdBlower1 := TRUE;
	CmdBlower2 := FALSE;
	C_OUT := 100;
	
ELSIF Blower2FbReady AND NOT Blower1FbReady THEN
	
	// Only blower 2 is available
	CmdBlower1 := FALSE;
	CmdBlower2 := TRUE;
	C_OUT := 100;
	
ELSIF Blower2FbReady AND Blower1FbReady THEN
	
	// Tow blowers are available
	CmdBlower1 := TRUE;
	CmdBlower2 := TRUE;
	C_OUT := AerCapCalc;
END_IF;

BL1WasRun := Blower1FbRunning;
BL2WasRun := Blower2FbRunning;]]></ST>
    </Algorithm>
    <Algorithm Name="StopAllBlowers">
      <ST><![CDATA[;
Grafcet := 6;

// Default commands
CmdBlower1 := FALSE;
CmdBlower2 := FALSE;
C_OUT := 0;]]></ST>
    </Algorithm>
    <Algorithm Name="IdleState">
      <ST><![CDATA[;
Grafcet := 1;]]></ST>
    </Algorithm>
    <Algorithm Name="AllStopped">
      <ST><![CDATA[;
Grafcet := 7;

BL1WasRun := Blower1FbRunning;
BL2WasRun := Blower2FbRunning;]]></ST>
    </Algorithm>
    <Algorithm Name="FromTowToOneBL">
      <ST><![CDATA[;
Grafcet := 8;

CmdBlower1 := TRUE;
CmdBlower2 := TRUE;
C_OUT := C3_IN;]]></ST>
    </Algorithm>
  </BasicFB>
