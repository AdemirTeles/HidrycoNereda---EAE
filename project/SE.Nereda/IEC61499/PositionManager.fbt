<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="0b6fd2f9-6896-4aba-a260-e4e918f638a6" Name="PositionManager" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="10/5/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event ID="62F2BAA2CE3D2AE5" Name="POSITION" Comment="Normal Execution Request">
        <With Var="StartFeedPositionR1" />
        <With Var="StartFeedPositionR2" />
        <With Var="StartFeedPositionR3" />
        <With Var="StartFeedPositionR4" />
        <With Var="StartFeedPositionR5" />
        <With Var="StartFeedPositionR6" />
