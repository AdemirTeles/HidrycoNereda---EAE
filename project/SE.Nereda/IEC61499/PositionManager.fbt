        <With Var="R2WasFeeding" />
        <With Var="R3WasFeeding" />
        <With Var="R4WasFeeding" />
        <With Var="R5WasFeeding" />
        <With Var="R6WasFeeding" />
      </Event>
      <Event ID="1D062C508E25C36C" Name="CHECK_FEED_STATE">
        <With Var="R1WasFeeding" />
        <With Var="R2WasFeeding" />
        <With Var="R3WasFeeding" />
        <With Var="R4WasFeeding" />
        <With Var="R5WasFeeding" />
        <With Var="R6WasFeeding" />
      </Event>
      <Event ID="DB4D2147A9FCDB38" Name="FEED_R_INIT">
