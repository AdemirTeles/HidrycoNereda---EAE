      <VarDeclaration ID="A648D6A6110DA594" Name="R5WasFeeding" Type="BOOL" />
      <VarDeclaration ID="E5516A2271061037" Name="R6WasFeeding" Type="BOOL" />
      <VarDeclaration ID="E445F2E583CAC52D" Name="FeedWasRunInit" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="F4E8FEDA0DB2783D" Name="OutPositionR1" Type="INT" />
      <VarDeclaration ID="366B827F69F6F6C7" Name="OutPositionR2" Type="INT" />
      <VarDeclaration ID="7D5DE468AD7F7987" Name="OutPositionR3" Type="INT" />
      <VarDeclaration ID="E411C93DB323E922" Name="OutPositionR4" Type="INT" />
      <VarDeclaration ID="C573A63D6130B1EF" Name="OutPositionR5" Type="INT" />
      <VarDeclaration ID="8B93E90205EBD2CA" Name="OutPositionR6" Type="INT" />
