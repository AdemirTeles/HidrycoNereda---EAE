    </OutputVars>
  </InterfaceList>
  <BasicFB ID="9eac2c0c-9d2f-4627-ae03-07945713248e">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ,ChechFeedState" />
    <InternalVars>
      <VarDeclaration ID="F386947A358B7234" Name="InStartFeedPositionR1" Type="INT" />
      <VarDeclaration ID="69C3DB45A354243C" Name="InStartFeedPositionR2" Type="INT" />
      <VarDeclaration ID="E3C8BA9D88393605" Name="InStartFeedPositionR3" Type="INT" />
      <VarDeclaration ID="120EF2FE600CEBE6" Name="InStartFeedPositionR4" Type="INT" />
      <VarDeclaration ID="BDBB0C8459A397C2" Name="InStartFeedPositionR5" Type="INT" />
      <VarDeclaration ID="19F49A40A17B4A5F" Name="InStartFeedPositionR6" Type="INT" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="1152.941" y="393.4117" />
      <ECState Name="REQ" Comment="Normal execution" x="1801.647" y="896.941">
        <ECAction Algorithm="REQ" Output="CNF" />
      </ECState>
      <ECState Name="CheckFeedState" x="1008" y="1380">
        <ECAction Algorithm="ChechFeedState" Output="F_W_R" />
        <ECAction Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="CheckFeedState" Condition="CHECK_FEED_STATE" x="1158.489" y="897.6072">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="300.2525,188.5509,289.4518,262.0696" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="1" x="1470.278" y="722.2441">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="390.7507,202.926,347.8964,169.6622" />
      </ECTransition>
      <ECTransition Source="CheckFeedState" Destination="START" Condition="1" x="932.0626" y="863.6422">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="217.6865,250.7479,228.4872,177.2293" />
      </ECTransition>
      <ECTransition Source="START" Destination="REQ" Condition="(POSITION OR FEED_R_INIT) AND NOT FeedWasRunInit" x="1535.08" y="585.1364">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="363.2256,124.9134,406.0799,158.1771" />
      </ECTransition>
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;
OutPositionR1 := StartFeedPositionR1;
OutPositionR2 := StartFeedPositionR2;
OutPositionR3 := StartFeedPositionR3;
OutPositionR4 := StartFeedPositionR4;
OutPositionR5 := StartFeedPositionR5;
OutPositionR6 := StartFeedPositionR6;]]></ST>
    </Algorithm>
    <Algorithm ID="42ceb797-d243-4834-96df-8ee4ea517f22" Name="ChechFeedState">
      <ST><![CDATA[;
FeedWasRunning := R1WasFeeding OR R2WasFeeding OR R3WasFeeding OR R4WasFeeding OR R5WasFeeding OR R6WasFeeding;

IF NOT FeedWasRunning THEN
	OutPositionR1 := StartFeedPositionR1;
	OutPositionR2 := StartFeedPositionR2;
	OutPositionR3 := StartFeedPositionR3;
	OutPositionR4 := StartFeedPositionR4;
	OutPositionR5 := StartFeedPositionR5;
	OutPositionR6 := StartFeedPositionR6;
ELSE
	IF R1WasFeeding THEN
		OutPositionR1 := 1;
		OutPositionR2 := 2;
		OutPositionR3 := 0;
		OutPositionR4 := 0;
		OutPositionR5 := 0;
		OutPositionR6 := 0;
	ELSIF R2WasFeeding THEN
		OutPositionR1 := 2;
		OutPositionR2 := 1;
		OutPositionR3 := 0;
		OutPositionR4 := 0;
		OutPositionR5 := 0;
		OutPositionR6 := 0;
	END_IF;
END_IF;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>