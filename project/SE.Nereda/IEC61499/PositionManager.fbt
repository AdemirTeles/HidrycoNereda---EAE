        <With Var="OutPositionR3" />
        <With Var="OutPositionR4" />
        <With Var="OutPositionR5" />
        <With Var="OutPositionR6" />
      </Event>
      <Event ID="F93EFE8555898EF0" Name="F_W_R">
        <With Var="FeedWasRunning" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="B5EC732F306029FB" Name="StartFeedPositionR1" Type="INT" Comment="Input event qualifier" />
