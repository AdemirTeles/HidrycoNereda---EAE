<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="7dd052a1-5f2a-4ed9-b01c-18e8390cd424" Name="OverrideV" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="6/26/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event ID="806431ABD5E78883" Name="REQ" Comment="Normal Execution Request">
        <With Var="Mode" />
        <With Var="AutoIN1" />
        <With Var="AutoIN2" />
        <With Var="ManIN1" />
        <With Var="ManIN2" />
        <With Var="AutoIN3" />
        <With Var="ManIN3" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="B861589364FF8D2A" Name="CNF" Comment="Execution Confirmation">
        <With Var="OUT3" />
        <With Var="OUT1" />
        <With Var="OUT2" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="801967BDFA8F77B6" Name="Mode" Type="BOOL" />
      <VarDeclaration ID="53EE5823BC68BC38" Name="AutoIN1" Type="BOOL" />
      <VarDeclaration ID="531474AB7BB2BE86" Name="AutoIN2" Type="BOOL" />
