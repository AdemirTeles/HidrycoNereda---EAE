      <VarDeclaration ID="C73C44DF80BC8DC6" Name="ManIN2" Type="BOOL" />
      <VarDeclaration ID="A8FE9F00BB619032" Name="ManIN3" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="4B7E902E80034964" Name="OUT1" Type="BOOL" />
      <VarDeclaration ID="FDAA14F9B1820A36" Name="OUT2" Type="BOOL" />
      <VarDeclaration ID="F25E94E81E907B48" Name="OUT3" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="704.9412" y="525.4117" />
      <ECState Name="REQ" Comment="Normal execution" x="1433.647" y="920.9412">
        <ECAction Algorithm="REQ" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="REQ" Condition="REQ" x="1114.997" y="653.8134">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="256.8983,146.6902,301.6008,170.9539" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="1" x="1064.016" y="802.4655">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="289.6747,217.926,244.9723,193.6622" />
      </ECTransition>
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;
IF NOT Mode THEN //Auto
	OUT1 := AutoIN1;
	OUT2 := AutoIN2;
	OUT3 := AutoIN3;
ELSIF Mode THEN //Man
	OUT1 := ManIN1;
	OUT2 := ManIN2;
	OUT3 := ManIN3;
END_IF;]]></ST>
    </Algorithm>
  </BasicFB>
