<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="134ef716-e690-4713-92b8-a025c3fca074" Name="SufficientFeedFlowBasic" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="9/23/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event ID="30C32EB006EA4C34" Name="REQ_PV">
        <With Var="LevelPv" />
      </Event>
      <Event ID="C437AAA8069F1FCB" Name="REQ" Comment="Normal Execution Request">
        <With Var="LevelCheckTimeSp" />
        <With Var="MinLevelRiseSp" />
        <With Var="RunPhase" />
      </Event>
      <Event ID="9849BF7793E3CBCD" Name="END_DELAY" />
      <Event ID="B4D22D015D718341" Name="REQ_RESET">
        <With Var="ResetRecived" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="AB0236918B6AB7A8" Name="CNF">
        <With Var="FeedFlowLevelStart" />
        <With Var="FeedFlowOk" />
        <With Var="FeedFlowInsufficient" />
        <With Var="FeedFlowLevelCheck" />
      </Event>
      <Event ID="CEB292B2283171B2" Name="START_DELAY">
        <With Var="TimeForDelay" />
      </Event>
      <Event ID="613F54422BA47101" Name="STOP_DELAY" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="BCE3C25201AA8B6A" Name="LevelPv" Type="REAL" />
      <VarDeclaration ID="90FA4CE95410AC4D" Name="RunPhase" Type="BOOL" />
      <VarDeclaration ID="52D7FB60C38DD9A8" Name="LevelCheckTimeSp" Type="TIME" />
      <VarDeclaration ID="9A9AE032169D4A25" Name="MinLevelRiseSp" Type="REAL" />
      <VarDeclaration ID="BF5A6785A8565660" Name="ResetRecived" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="17DD066F42AD1878" Name="FeedFlowLevelStart" Type="REAL" />
      <VarDeclaration ID="60ECB844CED0E64F" Name="FeedFlowLevelCheck" Type="REAL" />
      <VarDeclaration ID="81FE2D2793117977" Name="FeedFlowOk" Type="BOOL" />
      <VarDeclaration ID="F365867250E66A90" Name="FeedFlowInsufficient" Type="BOOL" />
      <VarDeclaration ID="BE8006DB0CA17265" Name="TimeForDelay" Type="TIME" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="a471e9e1-f96d-4f2d-92e6-c1853b1a8a21">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="ALG_CaptureStart,ALG_Evaluate,ALG_ClearAll" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="552.9412" y="429.4117" />
      <ECState Name="S_CAPTURE" x="1352" y="660">
        <ECAction Algorithm="ALG_CaptureStart" Output="START_DELAY" />
        <ECAction Output="CNF" />
      </ECState>
      <ECState Name="S_WAIT" x="2056" y="1200" />
      <ECState Name="S_EVAL" x="1108" y="1032">
        <ECAction Algorithm="ALG_Evaluate" Output="CNF" />
      </ECState>
      <ECState Name="S_DONE" x="1020" y="744.0001" />
      <ECState Name="S_ABORT" x="919.9999" y="1632">
        <ECAction Algorithm="ALG_ClearAll" Output="STOP_DELAY" />
      </ECState>
      <ECState Name="S_RESET" x="1716" y="223.9999">
        <ECAction Algorithm="ALG_ClearAll" Output="STOP_DELAY" />
        <ECAction Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="S_RESET" Condition="REQ_RESET" x="1141.455" y="251.8546">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="253.1203,64.68429,321.6042,53.13616" />
      </ECTransition>
      <ECTransition Source="START" Destination="S_CAPTURE" Condition="REQ AND RunPhase" x="976.7195" y="461.8566">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="221.6059,104.5412,266.5259,117.2911" />
      </ECTransition>
      <ECTransition Source="S_CAPTURE" Destination="S_WAIT" Condition="1" x="1672.678" y="836.4441">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="386.3521,183.4347,437.4786,219.1947" />
      </ECTransition>
      <ECTransition Source="S_WAIT" Destination="S_RESET" Condition="REQ_RESET" x="2179.264" y="773.2958">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="479.5319,241.626,651.7828,155.2379" />
      </ECTransition>
      <ECTransition Source="S_WAIT" Destination="S_ABORT" Condition="REQ AND NOT RunPhase" x="1545.002" y="1474.052">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="423.6171,358.437,351.2467,386.3869" />
      </ECTransition>
      <ECTransition Source="S_WAIT" Destination="S_EVAL" Condition="END_DELAY" x="1561.825" y="1205.47">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="419.4063,311.3755,361.2845,300.5084" />
      </ECTransition>
      <ECTransition Source="S_EVAL" Destination="S_DONE" Condition="1" x="982.2465" y="904.2054">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="244.7858,234.9835,240.644,219.8201" />
      </ECTransition>
      <ECTransition Source="S_DONE" Destination="S_RESET" Condition="REQ_RESET" x="1339.413" y="427.7762">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="313.7471,119.4411,357.9782,85.07633" />
      </ECTransition>
      <ECTransition Source="S_ABORT" Destination="START" Condition="1" x="733.5665" y="1122.678">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="197.6325,334.1306,169.5644,242.5371" />
      </ECTransition>
      <ECTransition Source="S_RESET" Destination="START" Condition="1" x="1107.913" y="407.152">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="308.4286,100.5092,242.0974,111.677" />
      </ECTransition>
    </ECC>
    <Algorithm ID="c82a8158-4508-47bb-91ff-351146c076af" Name="ALG_CaptureStart">
      <ST><![CDATA[FeedFlowLevelStart   := LevelPv;
FeedFlowLevelCheck   := 0.0;
FeedFlowOk           := FALSE;
FeedFlowInsufficient := FALSE;
TimeForDelay := LevelCheckTimeSp;
;]]></ST>
    </Algorithm>
    <Algorithm ID="91427886-fcab-4987-8a90-3ddd15327e8e" Name="ALG_Evaluate">
      <ST><![CDATA[FeedFlowLevelCheck := LevelPv;
IF (FeedFlowLevelCheck - FeedFlowLevelStart) < MinLevelRiseSp THEN
    FeedFlowInsufficient := TRUE;
    FeedFlowOk           := FALSE;
ELSE
    FeedFlowOk           := TRUE;
    FeedFlowInsufficient := FALSE;
END_IF;
;]]></ST>
    </Algorithm>
    <Algorithm ID="b1018c32-1b11-4c8d-b1ab-04075bfc4993" Name="ALG_ClearAll">
      <ST><![CDATA[FeedFlowLevelStart   := 0.0;
FeedFlowLevelCheck   := 0.0;
FeedFlowOk           := FALSE;
FeedFlowInsufficient := FALSE;
;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>