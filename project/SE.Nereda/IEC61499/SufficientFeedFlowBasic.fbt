<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="134ef716-e690-4713-92b8-a025c3fca074" Comment="Basic Function Block Type" Name="SufficientFeedFlowBasic" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="9/23/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event ID="30C32EB006EA4C34" Name="REQ_PV">
        <With Var="LevelPv" />
      </Event>
      <Event ID="C437AAA8069F1FCB" Name="REQ" Comment="Normal Execution Request">
        <With Var="LevelCheckTimeSp" />
        <With Var="MinLevelRiseSp" />
        <With Var="RunPhase" />
      </Event>
      <Event ID="9849BF7793E3CBCD" Name="END_DELAY" />
      <Event ID="B4D22D015D718341" Name="REQ_RESET">
        <With Var="ResetRecived" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="AB0236918B6AB7A8" Name="CNF">
        <With Var="FeedFlowLevelStart" />
        <With Var="FeedFlowOk" />
        <With Var="FeedFlowInsufficient" />
        <With Var="FeedFlowLevelCheck" />
      </Event>
      <Event ID="CEB292B2283171B2" Name="START_DELAY">
        <With Var="TimeForDelay" />
      </Event>
      <Event ID="613F54422BA47101" Name="STOP_DELAY" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="BCE3C25201AA8B6A" Name="LevelPv" Type="REAL" />
      <VarDeclaration ID="90FA4CE95410AC4D" Name="RunPhase" Type="BOOL" />
      <VarDeclaration ID="52D7FB60C38DD9A8" Name="LevelCheckTimeSp" Type="TIME" />
      <VarDeclaration ID="9A9AE032169D4A25" Name="MinLevelRiseSp" Type="REAL" />
      <VarDeclaration ID="BF5A6785A8565660" Name="ResetRecived" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="17DD066F42AD1878" Name="FeedFlowLevelStart" Type="REAL" />
      <VarDeclaration ID="60ECB844CED0E64F" Name="FeedFlowLevelCheck" Type="REAL" />
      <VarDeclaration ID="81FE2D2793117977" Name="FeedFlowOk" Type="BOOL" />
      <VarDeclaration ID="F365867250E66A90" Name="FeedFlowInsufficient" Type="BOOL" />
      <VarDeclaration ID="BE8006DB0CA17265" Name="TimeForDelay" Type="TIME" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="a471e9e1-f96d-4f2d-92e6-c1853b1a8a21">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="ALG_CaptureStart,ALG_Evaluate,ALG_ClearAll" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="344.9412" y="169.4117" />
      <ECState Name="S_CAPTURE" x="1724" y="760">
        <ECAction Algorithm="ALG_CaptureStart" Output="START_DELAY" />
        <ECAction Output="CNF" />
      </ECState>
      <ECState Name="S_WAIT" x="3016" y="1508" />
      <ECState Name="S_EVAL" x="1464" y="1296">
        <ECAction Algorithm="ALG_Evaluate" Output="CNF" />
      </ECState>
      <ECState Name="S_DONE" x="1096" y="948.0001" />
      <ECState Name="S_ABORT" x="919.9999" y="1632">
        <ECAction Algorithm="ALG_ClearAll" Output="STOP_DELAY" />
      </ECState>
      <ECState Name="S_RESET" x="1716" y="223.9999">
        <ECAction Algorithm="ALG_ClearAll" Output="STOP_DELAY" />
        <ECAction Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="S_RESET" Condition="REQ_RESET" x="1054.411" y="131.0567">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="224.7377,27.31798,309.291,31.18507" />
      </ECTransition>
      <ECTransition Source="START" Destination="S_CAPTURE" Condition="REQ AND RunPhase" x="1044.627" y="393.1224">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="216.008,74.55692,304.2783,111.722" />
      </ECTransition>
      <ECTransition Source="S_CAPTURE" Destination="S_WAIT" Condition="1" x="2223.292" y="1002.089">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="490.1297,212.3587,592.192,266.7006" />
      </ECTransition>
      <ECTransition Source="S_WAIT" Destination="S_RESET" Condition="REQ_RESET" x="2723.462" y="854.8975">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="665.275,307.6186,747.9131,119.6577" />
      </ECTransition>
      <ECTransition Source="S_WAIT" Destination="S_ABORT" Condition="0" x="1932.141" y="2189.624">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="552.7024,590.5522,407.4472,598.8331" />
      </ECTransition>
      <ECTransition Source="S_WAIT" Destination="S_EVAL" Condition="END_DELAY" x="2249.131" y="1482.646">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="615.3644,382.4464,510.5946,368.1831" />
      </ECTransition>
      <ECTransition Source="S_EVAL" Destination="S_DONE" Condition="1" x="1204.135" y="1158.051">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="308.9421,302.3665,290.2606,282.6674" />
      </ECTransition>
      <ECTransition Source="S_DONE" Destination="S_RESET" Condition="REQ_RESET" x="1392.457" y="521.3527">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="326.7114,150.7356,370.5958,99.1662" />
      </ECTransition>
      <ECTransition Source="S_ABORT" Destination="START" Condition="1" x="646.6061" y="1014.606">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="185.5427,319.781,140.8475,206.5053" />
      </ECTransition>
      <ECTransition Source="S_RESET" Destination="START" Condition="1" x="976.7151" y="266.9988">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="281.1157,72.47552,201.1157,68.66207" />
      </ECTransition>
    </ECC>
    <Algorithm ID="c82a8158-4508-47bb-91ff-351146c076af" Name="ALG_CaptureStart">
      <ST><![CDATA[FeedFlowLevelStart   := LevelPv;
FeedFlowLevelCheck   := 0.0;
FeedFlowOk           := FALSE;
FeedFlowInsufficient := FALSE;
TimeForDelay := LevelCheckTimeSp;
;]]></ST>
    </Algorithm>
    <Algorithm ID="91427886-fcab-4987-8a90-3ddd15327e8e" Name="ALG_Evaluate">
      <ST><![CDATA[FeedFlowLevelCheck := LevelPv;
IF (FeedFlowLevelCheck - FeedFlowLevelStart) < MinLevelRiseSp THEN
    FeedFlowInsufficient := TRUE;
    FeedFlowOk           := FALSE;
ELSE
    FeedFlowOk           := TRUE;
    FeedFlowInsufficient := FALSE;
END_IF;
;]]></ST>
    </Algorithm>
    <Algorithm ID="b1018c32-1b11-4c8d-b1ab-04075bfc4993" Name="ALG_ClearAll">
      <ST><![CDATA[FeedFlowLevelStart   := 0.0;
FeedFlowLevelCheck   := 0.0;
FeedFlowOk           := FALSE;
FeedFlowInsufficient := FALSE;
;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>