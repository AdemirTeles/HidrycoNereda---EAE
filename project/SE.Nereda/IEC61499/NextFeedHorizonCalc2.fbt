<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="dca6fe7e-78bf-4853-b72e-11c7a0d2fa57" Name="NextFeedHorizonCalc2" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="7/15/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event ID="A58B9BBDB9ECFCA5" Name="REQ">
        <With Var="StartFeedInterval" />
        <With Var="PositionR1" />
        <With Var="PositionR2" />
        <With Var="SettleTimeR1" />
        <With Var="SettleTimeR2" />
        <With Var="FallbackElapsedTime" />
        <With Var="R1Used" />
        <With Var="R2Used" />
        <With Var="TimesFed_R1" />
        <With Var="TimesFed_R2" />
        <With Var="NbrReactorsAvailable" />
        <With Var="RecipeElapsedTimeR1" />
        <With Var="RecipeElapsedTimeR2" />
        <With Var="NextFeedHorizonPlant" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="EFD8CD031C6B32D9" Name="NEXT_FEED_H">
        <With Var="NextFeedHorizon_R2" />
        <With Var="NextFeedHorizon_R1" />
        <With Var="CalcDone" />
        <With Var="Valid" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="8D1E3A69349DAF13" Name="NbrReactorsAvailable" Type="INT" />
      <VarDeclaration ID="6181A6BB2EA4EF4B" Name="NextFeedHorizonPlant" Type="REAL" />
      <VarDeclaration ID="BBE64DB6490A1135" Name="TimesFed_R1" Type="INT" Comment="= 0 the First Feed" />
      <VarDeclaration ID="BD15E2C2D98CB8D9" Name="TimesFed_R2" Type="INT" />
      <VarDeclaration ID="C779B02CD721992D" Name="StartFeedInterval" Type="REAL" />
      <VarDeclaration ID="8B12C2002DA4975C" Name="FallbackElapsedTime" Type="REAL" />
      <VarDeclaration ID="CEF2ADFDC80081D5" Name="RecipeElapsedTimeR1" Type="REAL" />
      <VarDeclaration ID="FF7FC8D939B39350" Name="RecipeElapsedTimeR2" Type="REAL" />
      <VarDeclaration ID="7054111BE4D91EB7" Name="PositionR1" Type="INT" />
      <VarDeclaration ID="0B20A0DA317A9F10" Name="PositionR2" Type="INT" />
      <VarDeclaration ID="B37A67F260BCB518" Name="SettleTimeR1" Type="REAL" />
      <VarDeclaration ID="923283901CA0EBA6" Name="SettleTimeR2" Type="REAL" />
      <VarDeclaration ID="0B7947FA35C0E98D" Name="R1Used" Type="BOOL" />
      <VarDeclaration ID="85798B149014E937" Name="R2Used" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="65DD9DFF0E258395" Name="NextFeedHorizon_R1" Type="REAL" />
      <VarDeclaration ID="563DC3E1AC221234" Name="NextFeedHorizon_R2" Type="REAL" />
      <VarDeclaration ID="3174B0E2BA0493C7" Name="CalcDone" Type="BOOL" />
      <VarDeclaration ID="75431D66234D894D" Name="Valid" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="537ce0b7-740f-4afa-93c9-3194bb88e635">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ" />
    <InternalVars>
      <VarDeclaration ID="804C20421CBCF134" Name="InNextFeedHorizon_R1" Type="REAL" />
      <VarDeclaration ID="9EE4391412B69315" Name="InNextFeedHorizon_R2" Type="REAL" />
      <VarDeclaration ID="DC44EEB28290D1AB" Name="InNextFeedHorizon_R3" Type="REAL" />
      <VarDeclaration ID="A38555AC480CDCDB" Name="InNextFeedHorizon_R4" Type="REAL" />
      <VarDeclaration ID="8030E2A631D09D3E" Name="InNextFeedHorizon_R5" Type="REAL" />
      <VarDeclaration ID="FDA1FBF52C1CC9BC" Name="InNextFeedHorizon_R6" Type="REAL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="328.9412" y="517.4117" />
      <ECState Name="REQ" Comment="Normal execution" x="1193.647" y="936.9412">
        <ECAction Algorithm="REQ" Output="NEXT_FEED_H" />
      </ECState>
      <ECTransition Source="START" Destination="REQ" Condition="REQ" x="825.9772" y="649.2119">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="181.3811,144.1705,235.8509,170.1782" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="1" x="759.977" y="807.972">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="218.6847,220.5541,163.9043,193.9763" />
      </ECTransition>
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[
// Validation
Valid := (FallbackElapsedTime > 0) AND (StartFeedInterval > 0);

// Calculate Next Feed Horizon for each Reactor
IF Valid THEN
	IF R1Used THEN
		IF TimesFed_R1 = 0 THEN
			InNextFeedHorizon_R1 := (PositionR1 - 1) * StartFeedInterval - FallbackElapsedTime + SettleTimeR1;
		ELSE
			//InNextFeedHorizon_R1 := (NbrReactorsAvailable * StartFeedInterval) - RecipeElapsedTimeR1;
			InNextFeedHorizon_R1 := NextFeedHorizonPlant + (StartFeedInterval * (PositionR1 - 1));
		END_IF;
	END_IF;
	
	IF R2Used THEN
		IF TimesFed_R2 = 0 THEN
			InNextFeedHorizon_R2 := (PositionR2 - 1) * StartFeedInterval - FallbackElapsedTime + SettleTimeR2;
		ELSE
			//InNextFeedHorizon_R2 := (NbrReactorsAvailable * StartFeedInterval) - RecipeElapsedTimeR2;
			InNextFeedHorizon_R2 := NextFeedHorizonPlant + (StartFeedInterval * (PositionR2 - 1));
		END_IF;
	END_IF;
END_IF;

//Verify Calculation
CalcDone := Valid AND (InNextFeedHorizon_R1 <> 0 OR InNextFeedHorizon_R2 <> 0);

//Results
IF InNextFeedHorizon_R1 > 0 THEN
    NextFeedHorizon_R1 := InNextFeedHorizon_R1;
ELSE
    NextFeedHorizon_R1 := 0;
END_IF;

IF InNextFeedHorizon_R2 > 0 THEN
    NextFeedHorizon_R2 := InNextFeedHorizon_R2;
ELSE
    NextFeedHorizon_R2 := 0;
END_IF;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>