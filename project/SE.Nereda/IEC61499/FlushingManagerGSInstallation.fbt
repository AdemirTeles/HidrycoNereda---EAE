    <Algorithm Name="OpenValve016_002">
      <ST><![CDATA[;
Grafcet := 4;
CmdValve016_002 := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="FlushStarted">
      <ST><![CDATA[;
Grafcet := 7;
FlushStarted := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="CloseValve016_002">
      <ST><![CDATA[;
Grafcet := 10;
CmdValve016_002 := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="FlushOFF">
      <ST><![CDATA[;
Grafcet := 12;
CmdValve016_002 := FALSE;
FlushStarted := FALSE;
oFlushReady := FALSE;
ReqStartGritScreen := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="OpenValve014">
      <ST><![CDATA[;
IF Grafcet = 1 THEN
	Grafcet := 2;
ELSIF Grafcet = 8 THEN
	Grafcet := 9;
END_IF;

CmdOpenValve014 := TRUE;
CmdCloseValve014 := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="CancelReduceSpeed">
      <ST><![CDATA[;
IF Grafcet = 5 THEN
	Grafcet := 6;
ELSIF Grafcet = 10 THEN
	Grafcet := 11;
END_IF;

CmdReduceSpeed := FALSE;]]></ST>
    </Algorithm>
    <Algorithm ID="bf8348c5-fde9-4c58-aefb-5aebc5fa4da0" Name="FlushRdy">
      <ST><![CDATA[;
Grafcet := 1;
IF StartHMI THEN
	oFlushReady := TRUE;
	ReqStartGritScreen := TRUE;
ELSE
	oFlushReady := iFlushReady;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm ID="838488ab-4e40-4399-aaf3-db6ddc7ca2e4" Name="ReduceSpeed">
      <ST><![CDATA[;
IF Grafcet = 2 THEN
	Grafcet := 3;
ELSIF Grafcet = 7 THEN
	Grafcet := 8;
END_IF;

CmdReduceSpeed := TRUE;]]></ST>
    </Algorithm>
    <Algorithm ID="a0f6c123-6768-4747-b259-5da3ad56f519" Name="CloseValve014">
      <ST><![CDATA[;
Grafcet := 5;
CmdOpenValve014 := FALSE;
CmdCloseValve014 := TRUE;]]></ST>
    </Algorithm>
    <Algorithm ID="6a745eb6-ef87-43ee-bc88-64109576a0cf" Name="FlushingOFF">
      <ST><![CDATA[;
oFlushReady := FALSE;]]></ST>
    </Algorithm>
