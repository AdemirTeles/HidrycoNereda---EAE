    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="816.9413" y="489.983" />
      <ECState Name="REQ" Comment="Normal execution" x="2602.219" y="951.7349">
        <ECAction Algorithm="REQ2" Output="START_FEED_POS" />
      </ECState>
      <ECState Name="INIT" x="2600" y="486.2856">
        <ECAction Algorithm="INIT" />
      </ECState>
      <ECState Name="Reset" x="823.5823" y="870.6511">
        <ECAction Algorithm="INIT" Output="START_FEED_POS" />
      </ECState>
      <ECTransition Source="START" Destination="INIT" Condition="ASK_POSITION" x="1679.962" y="484.4326">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="348.8674,121.4176,483.2753,120.3199" />
      </ECTransition>
      <ECTransition Source="INIT" Destination="REQ" Condition="1" x="2599.849" y="715.7519">
