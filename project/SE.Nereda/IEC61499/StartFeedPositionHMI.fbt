        <Attribute Name="Configuration.Transaction.BezierPoints" Value="206.0218,182.8646,205.6232,159.8382" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="Reset" Condition="NOT EmergencyON" x="1670.752" y="1138.146">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="479.6947,302.6764,349.0956,296.7228" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="REQ" Condition="ASK_POSITION AND EmergencyON" x="2606.372" y="1231.979">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="732,330,572,324" />
      </ECTransition>
    </ECC>
    <Algorithm Name="INIT">
      <ST><![CDATA[StartFeedPositionR1 := 0;
StartFeedPositionR2 := 0;
StartFeedPositionR3 := 0;
StartFeedPositionR4 := 0;
StartFeedPositionR5 := 0;
StartFeedPositionR6 := 0;]]></ST>
    </Algorithm>
    <Algorithm ID="bcd0fe9b-2076-47f9-9f5b-06e4ce62b07d" Name="REQ2">
      <ST><![CDATA[// Reset all positions at each execution
StartFeedPositionR1 := 0;
StartFeedPositionR2 := 0;
StartFeedPositionR3 := 0;
StartFeedPositionR4 := 0;
StartFeedPositionR5 := 0;
StartFeedPositionR6 := 0;


// ==================================================
// Reactor 1 position
// ==================================================
IF R1Exist AND R1Available THEN

    StartFeedPositionR1 := 1;

    IF R2Exist AND R2Available AND (TimeFLastFeedV_R2 > TimeFLastFeedV_R1) THEN
        StartFeedPositionR1 := StartFeedPositionR1 + 1;
    END_IF;

    IF R3Exist AND R3Available AND (TimeFLastFeedV_R3 > TimeFLastFeedV_R1) THEN
        StartFeedPositionR1 := StartFeedPositionR1 + 1;
    END_IF;

    IF R4Exist AND R4Available AND (TimeFLastFeedV_R4 > TimeFLastFeedV_R1) THEN
        StartFeedPositionR1 := StartFeedPositionR1 + 1;
    END_IF;

    IF R5Exist AND R5Available AND (TimeFLastFeedV_R5 > TimeFLastFeedV_R1) THEN
        StartFeedPositionR1 := StartFeedPositionR1 + 1;
    END_IF;

    IF R6Exist AND R6Available AND (TimeFLastFeedV_R6 > TimeFLastFeedV_R1) THEN
        StartFeedPositionR1 := StartFeedPositionR1 + 1;
    END_IF;

ELSIF R1Exist AND NOT R1Available THEN

    StartFeedPositionR1 := NbrReactorExisting;

END_IF;


// ==================================================
// Reactor 2 position
// ==================================================
IF R2Exist AND R2Available THEN

    StartFeedPositionR2 := 1;

    IF R1Exist AND R1Available AND (TimeFLastFeedV_R1 >= TimeFLastFeedV_R2) THEN
        StartFeedPositionR2 := StartFeedPositionR2 + 1;
    END_IF;

    IF R3Exist AND R3Available AND (TimeFLastFeedV_R3 > TimeFLastFeedV_R2) THEN
        StartFeedPositionR2 := StartFeedPositionR2 + 1;
    END_IF;

    IF R4Exist AND R4Available AND (TimeFLastFeedV_R4 > TimeFLastFeedV_R2) THEN
        StartFeedPositionR2 := StartFeedPositionR2 + 1;
    END_IF;

    IF R5Exist AND R5Available AND (TimeFLastFeedV_R5 > TimeFLastFeedV_R2) THEN
        StartFeedPositionR2 := StartFeedPositionR2 + 1;
    END_IF;

    IF R6Exist AND R6Available AND (TimeFLastFeedV_R6 > TimeFLastFeedV_R2) THEN
        StartFeedPositionR2 := StartFeedPositionR2 + 1;
    END_IF;

ELSIF R2Exist AND NOT R2Available THEN

    StartFeedPositionR2 := NbrReactorExisting;

END_IF;


// ==================================================
// Reactor 3 position
// ==================================================
IF R3Exist AND R3Available THEN

    StartFeedPositionR3 := 1;

    IF R1Exist AND R1Available AND (TimeFLastFeedV_R1 >= TimeFLastFeedV_R3) THEN
        StartFeedPositionR3 := StartFeedPositionR3 + 1;
    END_IF;

    IF R2Exist AND R2Available AND (TimeFLastFeedV_R2 >= TimeFLastFeedV_R3) THEN
        StartFeedPositionR3 := StartFeedPositionR3 + 1;
    END_IF;

    IF R4Exist AND R4Available AND (TimeFLastFeedV_R4 > TimeFLastFeedV_R3) THEN
        StartFeedPositionR3 := StartFeedPositionR3 + 1;
    END_IF;

    IF R5Exist AND R5Available AND (TimeFLastFeedV_R5 > TimeFLastFeedV_R3) THEN
        StartFeedPositionR3 := StartFeedPositionR3 + 1;
    END_IF;

    IF R6Exist AND R6Available AND (TimeFLastFeedV_R6 > TimeFLastFeedV_R3) THEN
        StartFeedPositionR3 := StartFeedPositionR3 + 1;
    END_IF;

ELSIF R3Exist AND NOT R3Available THEN

    StartFeedPositionR3 := NbrReactorExisting;

END_IF;


// ==================================================
// Reactor 4 position
// ==================================================
IF R4Exist AND R4Available THEN

    StartFeedPositionR4 := 1;

    IF R1Exist AND R1Available AND (TimeFLastFeedV_R1 >= TimeFLastFeedV_R4) THEN
        StartFeedPositionR4 := StartFeedPositionR4 + 1;
    END_IF;

    IF R2Exist AND R2Available AND (TimeFLastFeedV_R2 >= TimeFLastFeedV_R4) THEN
        StartFeedPositionR4 := StartFeedPositionR4 + 1;
    END_IF;

    IF R3Exist AND R3Available AND (TimeFLastFeedV_R3 >= TimeFLastFeedV_R4) THEN
        StartFeedPositionR4 := StartFeedPositionR4 + 1;
    END_IF;

    IF R5Exist AND R5Available AND (TimeFLastFeedV_R5 > TimeFLastFeedV_R4) THEN
        StartFeedPositionR4 := StartFeedPositionR4 + 1;
    END_IF;

    IF R6Exist AND R6Available AND (TimeFLastFeedV_R6 > TimeFLastFeedV_R4) THEN
        StartFeedPositionR4 := StartFeedPositionR4 + 1;
    END_IF;

ELSIF R4Exist AND NOT R4Available THEN

    StartFeedPositionR4 := NbrReactorExisting;

END_IF;


// ==================================================
// Reactor 5 position
// ==================================================
IF R5Exist AND R5Available THEN

    StartFeedPositionR5 := 1;

    IF R1Exist AND R1Available AND (TimeFLastFeedV_R1 >= TimeFLastFeedV_R5) THEN
        StartFeedPositionR5 := StartFeedPositionR5 + 1;
    END_IF;

    IF R2Exist AND R2Available AND (TimeFLastFeedV_R2 >= TimeFLastFeedV_R5) THEN
        StartFeedPositionR5 := StartFeedPositionR5 + 1;
    END_IF;

    IF R3Exist AND R3Available AND (TimeFLastFeedV_R3 >= TimeFLastFeedV_R5) THEN
        StartFeedPositionR5 := StartFeedPositionR5 + 1;
    END_IF;

    IF R4Exist AND R4Available AND (TimeFLastFeedV_R4 >= TimeFLastFeedV_R5) THEN
        StartFeedPositionR5 := StartFeedPositionR5 + 1;
    END_IF;

    IF R6Exist AND R6Available AND (TimeFLastFeedV_R6 > TimeFLastFeedV_R5) THEN
        StartFeedPositionR5 := StartFeedPositionR5 + 1;
    END_IF;

ELSIF R5Exist AND NOT R5Available THEN

    StartFeedPositionR5 := NbrReactorExisting;

END_IF;


// ==================================================
// Reactor 6 position
// ==================================================
IF R6Exist AND R6Available THEN

    StartFeedPositionR6 := 1;

    IF R1Exist AND R1Available AND (TimeFLastFeedV_R1 >= TimeFLastFeedV_R6) THEN
        StartFeedPositionR6 := StartFeedPositionR6 + 1;
    END_IF;

    IF R2Exist AND R2Available AND (TimeFLastFeedV_R2 >= TimeFLastFeedV_R6) THEN
        StartFeedPositionR6 := StartFeedPositionR6 + 1;
    END_IF;

    IF R3Exist AND R3Available AND (TimeFLastFeedV_R3 >= TimeFLastFeedV_R6) THEN
        StartFeedPositionR6 := StartFeedPositionR6 + 1;
    END_IF;

    IF R4Exist AND R4Available AND (TimeFLastFeedV_R4 >= TimeFLastFeedV_R6) THEN
        StartFeedPositionR6 := StartFeedPositionR6 + 1;
    END_IF;

    IF R5Exist AND R5Available AND (TimeFLastFeedV_R5 >= TimeFLastFeedV_R6) THEN
        StartFeedPositionR6 := StartFeedPositionR6 + 1;
    END_IF;

ELSIF R6Exist AND NOT R6Available THEN

    StartFeedPositionR6 := NbrReactorExisting;

END_IF;

ASK_POSITION := FALSE;

ReactorOrder[0] := StartFeedPositionR1;
ReactorOrder[1] := StartFeedPositionR2;
ReactorOrder[2] := StartFeedPositionR3;
ReactorOrder[3] := StartFeedPositionR4;
ReactorOrder[4] := StartFeedPositionR5;
ReactorOrder[5] := StartFeedPositionR6;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>