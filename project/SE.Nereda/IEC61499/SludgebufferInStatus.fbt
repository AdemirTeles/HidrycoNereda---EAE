    <Algorithm Name="Emer" Comment="Normally executed algorithm">
      <ST><![CDATA[;]]></ST>
    </Algorithm>
    <Algorithm ID="5e475c5c-b35b-4426-be01-780718ef8630" Name="Auto">
      <ST><![CDATA[;
OutStatus := InStatus;]]></ST>
    </Algorithm>
    <Algorithm ID="b8cd5159-defd-4d70-b78d-5f9ca7f2c9f4" Name="Off">
      <ST><![CDATA[;
OutStatus := 10;]]></ST>
    </Algorithm>
    <Algorithm ID="5809e836-1339-4e2b-b061-3d202bf02ab8" Name="ManEmer">
      <ST><![CDATA[;
IF NOT ReactorRunning AND NOT ReactorAvailable THEN
	OutStatus := 6;
ELSIF NOT ReactorRunning AND ReactorAvailable THEN
	OutStatus := 0;
ELSIF ReactorRunning AND NOT ReactorAvailable THEN
	OutStatus := 6;
ELSIF ReactorRunning AND ReactorAvailable THEN
	OutStatus := 2;
END_IF;]]></ST>
    </Algorithm>
