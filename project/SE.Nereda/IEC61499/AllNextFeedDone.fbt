        <Attribute Name="Configuration.Transaction.BezierPoints" Value="219.7688,130.3407,263.8991,159.0869" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="CycleFinish" x="918.1262" y="742.6788">
