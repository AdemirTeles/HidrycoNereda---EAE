    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;
IF PositionR1 > 0 THEN
	InDoneR1 := DoneR1;
ELSE
	InDoneR1 := TRUE;
END_IF;

IF PositionR2 > 0 THEN
	InDoneR2 := DoneR2;
ELSE
	InDoneR2 := TRUE;
END_IF;

IF PositionR3 > 0 THEN
	InDoneR3 := DoneR3;
ELSE
	InDoneR3 := TRUE;
END_IF;

IF PositionR4 > 0 THEN
	InDoneR4 := DoneR4;
ELSE
	InDoneR4 := TRUE;
END_IF;

IF PositionR5 > 0 THEN
	InDoneR5 := DoneR5;
ELSE
	InDoneR5 := TRUE;
END_IF;

IF PositionR6 > 0 THEN
	InDoneR6 := DoneR6;
ELSE
	InDoneR6 := TRUE;
END_IF;

CycleFinish := InDoneR1 AND InDoneR2 AND InDoneR3 AND InDoneR4 AND InDoneR5 AND InDoneR6;]]></ST>
    </Algorithm>
