    <Algorithm ID="fead2002-5638-4510-ab2b-dc888efc75cf" Name="Record">
      <ST><![CDATA[;
IF i < 100 THEN
	NextFeedHorizon[i] := iNextFeedHorizon;
	StartFeedInterval[i] := iStartFeedInterval;
	FallbackElapsedTime[i] := iFallbackElapsedTime;
	NbrRAv[i] := iNbrRAv;
	i_R[i] := ii_R;
	SettleTime[i] := iSettleTime;
	TimesFed[i] := iTimesFed;
	RecipeElapsedTime[i] := iRecipeElapsedTime;
	NextFeedHorizonPlant[i] := iNextFeedHorizonPlant;
	
	i := i + 1;
END_IF;

REQ := FALSE;]]></ST>
    </Algorithm>
    <Algorithm ID="c7871b20-fcac-463d-baf7-79585a4a881f" Name="Diag">
      <ST><![CDATA[;
IF Up AND NOT Down THEN
	i := i + 1;
ELSIF NOT Up AND Down THEN
	i := i - 1;
END_IF;

oNextFeedHorizon := NextFeedHorizon[i];
oStartFeedInterval := StartFeedInterval[i];
oFallbackElapsedTime := FallbackElapsedTime[i];
oNbrRAv := NbrRAv[i];
oi_R := i_R[i];
oSettleTime := SettleTime[i];
oTimesFed := TimesFed[i];
oRecipeElapsedTime := RecipeElapsedTime[i];
oNextFeedHorizonPlant := NextFeedHorizonPlant[i];

CTRL := FALSE;]]></ST>
    </Algorithm>
    <Algorithm ID="de873e36-1228-40a1-a228-4f3b7e17eb15" Name="INIT">
      <ST><![CDATA[;
i := 0;]]></ST>
    </Algorithm>
    <Algorithm ID="33192756-5b75-41fb-9846-1ddbd354c07d" Name="Clean">
      <ST><![CDATA[;
FOR i := 0 TO 98 DO
	NextFeedHorizon[i] := 0;
	StartFeedInterval[i] := 0;
	FallbackElapsedTime[i] := 0;
	NbrRAv[i] := 0;
	i_R[i] := 0;
	SettleTime[i] := 0;
	TimesFed[i] := 0;
	RecipeElapsedTime[i] := 0;
	NextFeedHorizonPlant[i] := 0;
END_FOR;]]></ST>
    </Algorithm>
  </BasicFB>
