<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="9b26aa33-958d-4d27-9b58-e1c95a36a0ec" Name="Comp_Send_Receive" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Version="0.0" Author="SESA197029" Date="25/02/2022" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Comment="Normal Execution Request">
        <With Var="Receive" />
        <With Var="Send" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="Send_Cmd" />
        <With Var="TIMER_CMD" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Receive" Type="BOOL" Comment="Input event qualifier" />
      <VarDeclaration Name="Send" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Send_Cmd" Type="BOOL" InitialValue="TRUE" Comment="Output event qualifier" />
      <VarDeclaration Name="TIMER_CMD" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="552.9412" y="429.4117" />
      <ECState Name="REQ" Comment="Normal execution" x="217.647" y="752.9412">
        <ECAction Algorithm="REQ" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="REQ" Condition="REQ" x="447.8488" y="648.3352" />
      <ECTransition Source="REQ" Destination="START" Condition="1" x="372.8767" y="512.7991" />
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[IF Send=Receive AND Send=TRUE THEN
	Send_Cmd:=FALSE;
END_IF;

IF Send=Receive AND Send=FALSE THEN
	Send_Cmd:=TRUE;
END_IF;

IF Send<>Receive THEN
	TIMER_CMD:=TRUE;
ELSE
	TIMER_CMD:=FALSE;
END_IF;
;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>