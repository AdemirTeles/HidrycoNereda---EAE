      <ST><![CDATA[;
CmdBlowers := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="StopBlowers">
      <ST><![CDATA[;
CmdBlowers := FALSE;
StartReady := FALSE;
AbortReady := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="StopBlowers_WhenAborting">
