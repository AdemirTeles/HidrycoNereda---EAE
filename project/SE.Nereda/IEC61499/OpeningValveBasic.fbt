    </ECC>
    <Algorithm Name="INIT" Comment="Initialization algorithm">
      <ST><![CDATA[;]]></ST>
    </Algorithm>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;]]></ST>
    </Algorithm>
    <Algorithm Name="OpenValve">
      <ST><![CDATA[;
CmdValve := TRUE;
Grafcet := 2;]]></ST>
    </Algorithm>
    <Algorithm Name="CloseValve">
      <ST><![CDATA[;
CmdValve := FALSE;
Grafcet := 4;]]></ST>
    </Algorithm>
    <Algorithm Name="ValveOpened">
      <ST><![CDATA[;
Grafcet := 3;]]></ST>
    </Algorithm>
    <Algorithm Name="PumpRunning">
      <ST><![CDATA[;
Grafcet := 1;]]></ST>
    </Algorithm>
    <Algorithm Name="ValveClosed">
      <ST><![CDATA[;
Grafcet := 5;]]></ST>
    </Algorithm>
  </BasicFB>
