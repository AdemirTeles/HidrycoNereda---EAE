<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="155c22ed-40d7-4ea8-ac19-8d40aa4a67b4" Name="NextFeedHorizonPlant" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="10/19/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event ID="128D7001C35ACED9" Name="REQ" Comment="Normal Execution Request">
        <With Var="TimeSinceStartFeedR1" />
        <With Var="TimeSinceStartFeedR2" />
        <With Var="StartFeedInterval" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="4275DD4F4D315D4F" Name="CNF" Comment="Execution Confirmation">
        <With Var="NextFeedHorizonPlant" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="19B2F8536BD9E0B8" Name="TimeSinceStartFeedR1" Type="REAL" />
      <VarDeclaration ID="78BBF66CC9B0C14E" Name="TimeSinceStartFeedR2" Type="REAL" />
      <VarDeclaration ID="D46F78196C2CDE74" Name="StartFeedInterval" Type="REAL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="C1499A736E2E06AC" Name="NextFeedHorizonPlant" Type="REAL" Comment="Output event qualifier" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="f8f56358-80a8-4957-a6c4-496d03649d7b">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ" />
    <InternalVars>
      <VarDeclaration ID="A2C569B10B34D533" Name="LowestTimeSinceStartFeed" Type="REAL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="552.9412" y="429.4117" />
      <ECState Name="REQ" Comment="Normal execution" x="1193.647" y="896.9412">
        <ECAction Algorithm="REQ" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="REQ" Condition="REQ" x="929.097" y="601.1155">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="212.3232,130.4673,253.7968,160.731" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="1" x="866.4881" y="740.8513">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="239.0603,205.926,197.5867,175.6622" />
      </ECTransition>
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;
LowestTimeSinceStartFeed := TimeSinceStartFeedR1;

IF LowestTimeSinceStartFeed > TimeSinceStartFeedR2 THEN
	LowestTimeSinceStartFeed := TimeSinceStartFeedR2;
END_IF;

NextFeedHorizonPlant := StartFeedInterval - LowestTimeSinceStartFeed;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>