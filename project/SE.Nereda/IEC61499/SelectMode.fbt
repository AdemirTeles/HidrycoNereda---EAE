<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="3592a4d0-a065-4ca2-988e-95f664b2574c" Name="SelectMode" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.2" Author="Hidryco" Date="04/11/2026" Remarks="0.2: Nereda: na falha de comunicacao em Automatico, EmergFalhaCom ON vai para Emergencia e OFF para Desligado (botao no faceplate WATCHDOG); volta sozinho para Automatico com a comunicacao boa. EMERGENCY_ON reavalia o modo nas duas bordas, depois do primeiro REQ." />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Comment="Normal Execution Request">
        <With Var="SelectMode" />
      </Event>
      <Event ID="HEART_BEAT" Name="EMERGENCY_ON">
        <With Var="EmergencyON" />
        <With Var="EmergFalhaCom" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="Auto" />
        <With Var="OFF" />
        <With Var="Manu" />
        <With Var="Emergency" />
        <With Var="Light" />
        <With Var="Mode" />
        <With Var="ModeNereda" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="SelectMode" Type="INT" />
      <VarDeclaration ID="HeartBeat" Name="EmergencyON" Type="BOOL" />
      <VarDeclaration ID="4DF8486D4472DDB7" Name="EmergFalhaCom" Type="BOOL" InitialValue="TRUE" Comment="Falha de comunicacao em Automatico: TRUE vai para Emergencia, FALSE para Desligado" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Auto" Type="BOOL" />
      <VarDeclaration Name="OFF" Type="BOOL" />
      <VarDeclaration Name="Manu" Type="BOOL" />
      <VarDeclaration Name="Emergency" Type="BOOL" />
      <VarDeclaration Name="Light" Type="BOOL" />
      <VarDeclaration Name="Mode" Type="INT" />
      <VarDeclaration ID="4C03939BC179E762" Name="ModeNereda" Type="INT" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="9e50351c-72e0-4aa8-8231-fd8c3606535f">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ" />
    <InternalVars>
      <VarDeclaration ID="D5802F5BDBB11254" Name="Inicializado" Type="BOOL" Comment="Ja recebeu o modo selecionado (REQ): antes disso o EMERGENCY_ON so guarda os valores" />
      <VarDeclaration ID="7CB310AA7FD13CCA" Name="ModoEfetivo" Type="INT" Comment="Modo aplicado: o selecionado ou, em Automatico sem comunicacao, Emergencia ou Desligado (EmergFalhaCom)" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="552.9412" y="429.4117" />
      <ECState Name="REQ" Comment="Normal execution" x="1265.647" y="876.9412">
        <ECAction Algorithm="REQ" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="REQ" Condition="REQ OR (EMERGENCY_ON AND Inicializado)" x="959.848" y="587.297">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="217.8472,127.8236,263.389,156.4206" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="1" x="903.3118" y="731.5692">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="250.0945,202.5927,204.5526,173.9956" />
      </ECTransition>
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;
Inicializado := TRUE;
// Modo efetivo: o selecionado pelo operador. Em Automatico com falha de comunicacao (Watchdog), o modo escolhido no
// botao do faceplate WATCHDOG (EmergFalhaCom: ON Emergencia, OFF Desligado). Com a comunicacao boa de novo e o operador
// ainda em Automatico, volta sozinho para Automatico (EMERGENCY_ON chega nas duas bordas).
ModoEfetivo := SelectMode;
IF SelectMode = 0 AND EmergencyON THEN
	IF EmergFalhaCom THEN
		ModoEfetivo := 3;
	ELSE
		ModoEfetivo := 1;
	END_IF;
END_IF;
IF ModoEfetivo = 0 THEN // Automatico
	Auto := TRUE;
	OFF := FALSE;
	Manu := FALSE;
	Emergency := FALSE;
	Light := TRUE;
	Mode := 0;
	ModeNereda := 2;
ELSIF ModoEfetivo = 1 THEN // Desligado
	Auto := FALSE;
	OFF := TRUE;
	Manu := FALSE;
	Emergency := FALSE;
	Light := FALSE;
	Mode := 1;
	ModeNereda := 0;
ELSIF ModoEfetivo = 2 THEN // Manual
	Auto := FALSE;
	OFF := FALSE;
	Manu := TRUE;
	Emergency := FALSE;
	Light := TRUE;
	Mode := 2;
	ModeNereda := 1;
ELSIF ModoEfetivo = 3 THEN // Emergencia
	Auto := FALSE;
	OFF := FALSE;
	Manu := FALSE;
	Emergency := TRUE;
	Light := TRUE;
	Mode := 3;
	ModeNereda := -1;
END_IF;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>