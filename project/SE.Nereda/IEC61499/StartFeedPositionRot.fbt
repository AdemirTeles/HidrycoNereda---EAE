      <VarDeclaration ID="5DD6878914F7DB72" Name="TotNbrReactor" Type="INT" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="01DB13D42D3DBB3B" Name="oStartFeedPositionR1" Type="INT" />
      <VarDeclaration ID="6075D515D2693EEC" Name="oStartFeedPositionR2" Type="INT" />
      <VarDeclaration ID="AE942E19AA2B17CE" Name="oStartFeedPositionR3" Type="INT" />
      <VarDeclaration ID="A0ADA3770331F35E" Name="oStartFeedPositionR4" Type="INT" />
      <VarDeclaration ID="5073F46956E92D6C" Name="oStartFeedPositionR5" Type="INT" />
      <VarDeclaration ID="6BF52B2208BA01D0" Name="oStartFeedPositionR6" Type="INT" />
