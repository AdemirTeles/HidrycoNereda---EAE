  <BasicFB ID="26b50d00-aafe-47d2-b819-8c4907840155">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ,INIT,Update" />
    <InternalVars>
      <VarDeclaration ID="24F985520135B177" Name="PositionTab" Type="INT" ArraySize="6" />
      <VarDeclaration ID="42862556EB82E0BB" Name="i" Type="INT" />
      <VarDeclaration ID="58A3D0ED69D20EAA" Name="FirstIndex" Type="INT" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="312.9413" y="329.4117" />
      <ECState Name="REQ" Comment="Normal execution" x="1227.933" y="1009.513">
        <ECAction Algorithm="REQ" Output="START_FEED_POS" />
      </ECState>
      <ECState Name="INIT" x="1225.714" y="454.2857">
        <ECAction Algorithm="INIT" Output="START_FEED_POS" />
      </ECState>
      <ECState Name="Update" x="1227.5" y="1517.5">
        <ECAction Algorithm="Update" />
      </ECState>
      <ECTransition Source="START" Destination="INIT" Condition="FB_POS_INIT AND EmergencyON AND&#xD;&#xA;(iStartFeedPositionR1 &gt; 0 OR&#xD;&#xA;iStartFeedPositionR2 &gt; 0 OR&#xD;&#xA;iStartFeedPositionR3 &gt; 0 OR&#xD;&#xA;iStartFeedPositionR4 &gt; 0 OR&#xD;&#xA;iStartFeedPositionR5 &gt; 0 OR&#xD;&#xA;iStartFeedPositionR6 &gt; 0)" x="762.5941" y="307.3196">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="158.6656,68.76897,218.4222,75.91722" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="NOT EmergencyON" x="674.8866" y="728.5931">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="195.1434,209.8009,131.8077,163.168" />
      </ECTransition>
      <ECTransition Source="INIT" Destination="REQ" Condition="1" x="1225.718" y="727.8302">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="306.4123,162.8139,306.3192,200.423" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="Update" Condition="ASK_POSITION" x="1384.8" y="1251.067">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="354.8105,294.9126,354.7818,328.5478" />
      </ECTransition>
      <ECTransition Source="Update" Destination="REQ" Condition="1" x="1037.684" y="1256.175">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="248.9822,330.2505,249.0109,296.6153" />
      </ECTransition>
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;
FirstIndex := PositionTab[0];
oStartFeedPositionR1 := PositionTab[0];
oStartFeedPositionR2 := PositionTab[1];
oStartFeedPositionR3 := PositionTab[2];
oStartFeedPositionR4 := PositionTab[3];
oStartFeedPositionR5 := PositionTab[4];
oStartFeedPositionR6 := PositionTab[5];]]></ST>
    </Algorithm>
    <Algorithm Name="INIT">
      <ST><![CDATA[;
PositionTab[0] := iStartFeedPositionR1;
PositionTab[1] := iStartFeedPositionR2;
PositionTab[2] := iStartFeedPositionR3;
PositionTab[3] := iStartFeedPositionR4;
PositionTab[4] := iStartFeedPositionR5;
PositionTab[5] := iStartFeedPositionR6;]]></ST>
    </Algorithm>
    <Algorithm ID="1e89a4d5-5965-4d8e-b19a-3d7c3b99d4bd" Name="Update">
      <ST><![CDATA[;
IF (TotNbrReactor >= 2) AND (TotNbrReactor <= 6) THEN

    FOR i := 0 TO TotNbrReactor - 2 DO
        PositionTab[i] := PositionTab[i + 1];
    END_FOR;

    PositionTab[TotNbrReactor - 1] := FirstIndex;
END_IF;]]></ST>
    </Algorithm>
  </BasicFB>
