    <ECC>
      <ECState Name="START" Comment="Initial State" x="1396.941" y="509.4117" />
      <ECState Name="REQ" Comment="Normal execution" x="1397.647" y="1328.941">
        <ECAction Algorithm="REQ" Output="CNF" />
      </ECState>
      <ECState Name="Start" x="2420" y="1320">
        <ECAction Output="START_OUT" />
      </ECState>
      <ECState Name="Stop" x="2456" y="492">
