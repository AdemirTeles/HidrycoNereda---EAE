    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;
InDelayFeedAfterCycle := (CT_reactor_actual - ElapsedCycleTime);

IF InDelayFeedAfterCycle > 0 THEN
	DelayFeedAfterCycle := InDelayFeedAfterCycle;
ELSE
	DelayFeedAfterCycle := 0;
END_IF;]]></ST>
    </Algorithm>
