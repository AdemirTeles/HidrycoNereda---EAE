      <Event ID="BF02A56838C7F9DA" Name="STOP_OUT">
        <With Var="DelayFeedAfterCycle" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="EFD75DD9E4480893" Name="CT_reactor_actual" Type="REAL" Comment="Input event qualifier" />
      <VarDeclaration ID="FD8FA55805B713A9" Name="ElapsedCycleTime" Type="REAL" />
