      <VarDeclaration ID="E7D15AE9EC482C68" Name="R2Used" Type="BOOL" />
      <VarDeclaration ID="09BD2F883C3677F4" Name="R3Used" Type="BOOL" />
      <VarDeclaration ID="06E0528DEC9D8A60" Name="R4Used" Type="BOOL" />
      <VarDeclaration ID="88F71FD8A45EE4BF" Name="R5Used" Type="BOOL" />
