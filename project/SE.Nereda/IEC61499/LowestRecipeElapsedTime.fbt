  <BasicFB ID="2bff9154-b0fc-4abb-9ce0-1905cd73d74b">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="552.9412" y="429.4117" />
      <ECState Name="REQ" Comment="Normal execution" x="1113.647" y="844.9412">
        <ECAction Algorithm="REQ" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="REQ" Condition="REQ" x="889.9611" y="574.9253">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="205.7137,126.2433,240.7036,152.1737" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="1" x="826.1831" y="715.3846">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="225.8185,197.2593,190.8286,171.3289" />
      </ECTransition>
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;
//R1Used := R1Exist AND R1Available;
//R2Used := R2Exist AND R2Available;
//R3Used := R3Exist AND R3Available;
//R4Used := R4Exist AND R4Available;
//R5Used := R5Exist AND R5Available;
//R6Used := R6Exist AND R6Available;

R1Used := R1Exist;
R2Used := R2Exist;
R3Used := R3Exist;
R4Used := R4Exist;
R5Used := R5Exist;
R6Used := R6Exist;


// Initialize with the first used reactor
IF R1Used THEN
    LowestRecipeElapsedTime := TimeSinceStartFeedR1;

ELSIF R2Used THEN
    LowestRecipeElapsedTime := TimeSinceStartFeedR2;

ELSIF R3Used THEN
    LowestRecipeElapsedTime := TimeSinceStartFeedR3;

ELSIF R4Used THEN
    LowestRecipeElapsedTime := TimeSinceStartFeedR4;

ELSIF R5Used THEN
    LowestRecipeElapsedTime := TimeSinceStartFeedR5;

ELSIF R6Used THEN
    LowestRecipeElapsedTime := TimeSinceStartFeedR6;

END_IF;


// Find the lowest value
IF R1Used AND (TimeSinceStartFeedR1 < LowestRecipeElapsedTime) THEN
    LowestRecipeElapsedTime := TimeSinceStartFeedR1;
END_IF;

IF R2Used AND (TimeSinceStartFeedR2 < LowestRecipeElapsedTime) THEN
    LowestRecipeElapsedTime := TimeSinceStartFeedR2;
END_IF;

IF R3Used AND (TimeSinceStartFeedR3 < LowestRecipeElapsedTime) THEN
    LowestRecipeElapsedTime := TimeSinceStartFeedR3;
END_IF;

IF R4Used AND (TimeSinceStartFeedR4 < LowestRecipeElapsedTime) THEN
    LowestRecipeElapsedTime := TimeSinceStartFeedR4;
END_IF;

IF R5Used AND (TimeSinceStartFeedR5 < LowestRecipeElapsedTime) THEN
    LowestRecipeElapsedTime := TimeSinceStartFeedR5;
END_IF;

IF R6Used AND (TimeSinceStartFeedR6 < LowestRecipeElapsedTime) THEN
    LowestRecipeElapsedTime := TimeSinceStartFeedR6;
END_IF;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>