<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="74251aac-6802-49a2-a82b-69ee4f34bd90" Name="ReactorAbortManager" Comment="Basic Function Block Type" Namespace="SE.Nereda">
