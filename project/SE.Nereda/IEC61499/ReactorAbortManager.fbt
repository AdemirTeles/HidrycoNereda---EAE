        <With Var="AvReactor3" />
        <With Var="AvReactor4" />
        <With Var="AvReactor5" />
        <With Var="AvReactor6" />
        <With Var="EmergencyON" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="191DD4636950BFBF" Name="UPD_POS" Comment="Execution Confirmation" />
      <Event ID="AE1A12FA8CA17FC0" Name="RESET_TIMES_FED">
        <With Var="ResetTimesFedR1" />
        <With Var="ResetTimesFedR2" />
        <With Var="ResetTimesFedR3" />
        <With Var="ResetTimesFedR4" />
        <With Var="ResetTimesFedR5" />
        <With Var="ResetTimesFedR6" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="26CB46CABBD6C832" Name="AvReactor1" Type="BOOL" />
      <VarDeclaration ID="B0F4FEC0CE756C6E" Name="AvReactor2" Type="BOOL" />
      <VarDeclaration ID="1F6339469E597D0A" Name="AvReactor3" Type="BOOL" />
