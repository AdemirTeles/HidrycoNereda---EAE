    <Algorithm Name="CloseAllValves">
      <ST><![CDATA[;

VentValve1 := FALSE;
VentValve2 := FALSE;
VentValve3 := FALSE;

StartReady := FALSE;
AbortReady := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="StartReady">
      <ST><![CDATA[;
Grafcet := 2;
StartReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="OpenValves">
      <ST><![CDATA[;
//VentValve1 : NVPP 001 a—036
//VentValve2 : NVPP 001 a—038
//VentValve3 : NVPP 001 a—067

Grafcet := 2;
StopReady := FALSE;
AbortReady := FALSE;
VentValve2 := TRUE;

IF NOT VentAirGrid AND NOT VentInfluent THEN
	VentValve1 := FALSE;
	VentValve3 := FALSE;
	
ELSIF VentAirGrid AND NOT VentInfluent THEN
	VentValve1 := TRUE;
	VentValve3 := FALSE;

ELSIF NOT VentAirGrid AND VentInfluent THEN
	VentValve1 := FALSE;
	VentValve3 := TRUE;

ELSIF VentAirGrid AND VentInfluent THEN
	VentValve1 := TRUE;
	VentValve3 := TRUE;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm Name="UpdateValvesState">
      <ST><![CDATA[;
//VentValve1 : NVPP 001 a—036
//VentValve2 : NVPP 001 a—038
//VentValve3 : NVPP 001 a—067

Grafcet := 4;
VentValve2 := TRUE;

IF NOT VentAirGrid AND NOT VentInfluent THEN
	VentValve1 := FALSE;
	VentValve3 := FALSE;
	
ELSIF VentAirGrid AND NOT VentInfluent THEN
	VentValve1 := TRUE;
	VentValve3 := FALSE;

ELSIF NOT VentAirGrid AND VentInfluent THEN
	VentValve1 := FALSE;
	VentValve3 := TRUE;

ELSIF VentAirGrid AND VentInfluent THEN
	VentValve1 := TRUE;
	VentValve3 := TRUE;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm Name="AbortReady">
      <ST><![CDATA[;
Grafcet := 10;
AbortReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="StopReady">
      <ST><![CDATA[;
Grafcet := 7;
StopReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="StopBlowers_WhenAborting">
      <ST><![CDATA[;
StartReady := FALSE;
StopReady := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="CloseAllValves_Aborting">
      <ST><![CDATA[;
VentValve1 := FALSE;
VentValve2 := FALSE;
VentValve3 := FALSE;

StartReady := FALSE;
StopReady := FALSE;]]></ST>
    </Algorithm>
