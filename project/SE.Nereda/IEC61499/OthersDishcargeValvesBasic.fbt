<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="1418d6d8-488e-448d-80ee-a120884734c3" Name="OthersDishcargeValvesBasic" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author="SESA371406" Date="11/29/2023" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="TOTAL_REACTOR" Comment="Normal Execution Request">
        <With Var="TotalReactor" />
      </Event>
      <Event ID="REQ_IN" Name="FB_D_V">
        <With Var="FbDrainVCReactor1" />
        <With Var="FbDrainVCReactor2" />
        <With Var="FbDrainVCReactor3" />
        <With Var="FbDrainVCReactor4" />
        <With Var="FbDrainVCReactor5" />
        <With Var="FbDrainVCReactor6" />
