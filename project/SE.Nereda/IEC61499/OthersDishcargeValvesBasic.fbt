  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="OneReactor,TowReactors,ThreeReactors,FourReactors,FiveReactors,SixReactors" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="691.3855" y="1496.745" />
      <ECState Name="OneReactor" x="2182" y="289.3333">
