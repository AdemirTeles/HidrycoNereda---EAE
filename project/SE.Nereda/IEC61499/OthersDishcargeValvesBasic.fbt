    <Algorithm Name="OneReactor">
      <ST><![CDATA[;
DValveCReactor1 := TRUE;
DValveCReactor2 := FALSE;
DValveCReactor3 := FALSE;
DValveCReactor4 := FALSE;
DValveCReactor5 := FALSE;
DValveCReactor6 := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="TowReactors">
      <ST><![CDATA[;
//Operating condition Reacotr1:
IF FbDrainVCReactor1 THEN
	DValveCReactor2 := TRUE;
ELSE
	DValveCReactor2 := FALSE;
END_IF;

//Operating condition Reacotr2:
IF FbDrainVCReactor2 THEN
	DValveCReactor1 := TRUE;
ELSE
	DValveCReactor1 := FALSE;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm Name="ThreeReactors">
      <ST><![CDATA[;
// Operating condition Reactor 1:
IF FbDrainVCReactor2 AND FbDrainVCReactor3 THEN
	DValveCReactor1 := TRUE;
ELSE
	DValveCReactor1 := FALSE;
END_IF;


// Operating condition Reactor 2:
IF FbDrainVCReactor1 AND FbDrainVCReactor3 THEN
	DValveCReactor2 := TRUE;
ELSE
	DValveCReactor2 := FALSE;
END_IF;


// Operating condition Reactor 3:
IF FbDrainVCReactor1 AND FbDrainVCReactor2 THEN
	DValveCReactor3 := TRUE;
ELSE
	DValveCReactor3 := FALSE;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm Name="FourReactors">
      <ST><![CDATA[;
// Operating condition Reactor 1:
IF FbDrainVCReactor2 AND FbDrainVCReactor3 AND FbDrainVCReactor4 THEN
	DValveCReactor1 := TRUE;
ELSE
	DValveCReactor1 := FALSE;
END_IF;


// Operating condition Reactor 2:
IF FbDrainVCReactor1 AND FbDrainVCReactor3 AND FbDrainVCReactor4 THEN
	DValveCReactor2 := TRUE;
ELSE
	DValveCReactor2 := FALSE;
END_IF;


// Operating condition Reactor 3:
IF FbDrainVCReactor1 AND FbDrainVCReactor2 AND FbDrainVCReactor4 THEN
	DValveCReactor3 := TRUE;
ELSE
	DValveCReactor3 := FALSE;
END_IF;


// Operating condition Reactor 4:
IF FbDrainVCReactor1 AND FbDrainVCReactor2 AND FbDrainVCReactor3 THEN
	DValveCReactor4 := TRUE;
ELSE
	DValveCReactor4 := FALSE;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm Name="FiveReactors">
      <ST><![CDATA[;
// Operating condition Reactor 1:
IF FbDrainVCReactor2 AND FbDrainVCReactor3 AND FbDrainVCReactor4 AND FbDrainVCReactor5 THEN
	DValveCReactor1 := TRUE;
ELSE
	DValveCReactor1 := FALSE;
END_IF;


// Operating condition Reactor 2:
IF FbDrainVCReactor1 AND FbDrainVCReactor3 AND FbDrainVCReactor4 AND FbDrainVCReactor5 THEN
	DValveCReactor2 := TRUE;
ELSE
	DValveCReactor2 := FALSE;
END_IF;


// Operating condition Reactor 3:
IF FbDrainVCReactor1 AND FbDrainVCReactor2 AND FbDrainVCReactor4 AND FbDrainVCReactor5 THEN
	DValveCReactor3 := TRUE;
ELSE
	DValveCReactor3 := FALSE;
END_IF;


// Operating condition Reactor 4:
IF FbDrainVCReactor1 AND FbDrainVCReactor2 AND FbDrainVCReactor3 AND FbDrainVCReactor5 THEN
	DValveCReactor4 := TRUE;
ELSE
	DValveCReactor4 := FALSE;
END_IF;


// Operating condition Reactor 5:
IF FbDrainVCReactor1 AND FbDrainVCReactor2 AND FbDrainVCReactor3 AND FbDrainVCReactor4 THEN
	DValveCReactor5 := TRUE;
ELSE
	DValveCReactor5 := FALSE;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm Name="SixReactors">
      <ST><![CDATA[;
// Operating condition Reactor 1:
IF FbDrainVCReactor2 AND FbDrainVCReactor3 AND FbDrainVCReactor4 AND FbDrainVCReactor5 AND FbDrainVCReactor6 THEN
	DValveCReactor1 := TRUE;
ELSE
	DValveCReactor1 := FALSE;
END_IF;


// Operating condition Reactor 2:
IF FbDrainVCReactor1 AND FbDrainVCReactor3 AND FbDrainVCReactor4 AND FbDrainVCReactor5 AND FbDrainVCReactor6 THEN
	DValveCReactor2 := TRUE;
ELSE
	DValveCReactor2 := FALSE;
END_IF;


// Operating condition Reactor 3:
IF FbDrainVCReactor1 AND FbDrainVCReactor2 AND FbDrainVCReactor4 AND FbDrainVCReactor5 AND FbDrainVCReactor6 THEN
	DValveCReactor3 := TRUE;
ELSE
	DValveCReactor3 := FALSE;
END_IF;


// Operating condition Reactor 4:
IF FbDrainVCReactor1 AND FbDrainVCReactor2 AND FbDrainVCReactor3 AND FbDrainVCReactor5 AND FbDrainVCReactor6 THEN
	DValveCReactor4 := TRUE;
ELSE
	DValveCReactor4 := FALSE;
END_IF;


// Operating condition Reactor 5:
IF FbDrainVCReactor1 AND FbDrainVCReactor2 AND FbDrainVCReactor3 AND FbDrainVCReactor4 AND FbDrainVCReactor6 THEN
	DValveCReactor5 := TRUE;
ELSE
	DValveCReactor5 := FALSE;
END_IF;


// Operating condition Reactor 6:
IF FbDrainVCReactor1 AND FbDrainVCReactor2 AND FbDrainVCReactor3 AND FbDrainVCReactor4 AND FbDrainVCReactor5 THEN
	DValveCReactor6 := TRUE;
ELSE
	DValveCReactor6 := FALSE;
END_IF;]]></ST>
    </Algorithm>
