  <BasicFB ID="d36cbe92-32ed-4f82-b74c-f539625029f1">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="OnePump,StartTowPumps_C2,StartTowPumps_Max,StopAll" />
    <InternalVars>
