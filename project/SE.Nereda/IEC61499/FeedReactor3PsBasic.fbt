        <ECAction Output="CNF_CAP_PUMP" />
      </ECState>
      <ECState Name="WaitingTime" x="3547.834" y="692">
        <ECAction Output="WAIT_TIME" />
      </ECState>
      <ECTransition Source="START" Destination="StartOnePump" Condition="NOT ForceStop AND (FbPump01Ready OR FbPump02Ready OR FbPump03Ready) AND&#xD;&#xA;&#xD;&#xA;(FeedReactor1 OR&#xD;&#xA;FeedReactor2 OR&#xD;&#xA;FeedReactor3 OR&#xD;&#xA;FeedReactor4 OR&#xD;&#xA;FeedReactor5 OR&#xD;&#xA;FeedReactor6)" x="1540.824" y="789.431">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="385.1371,175.9922,385.4501,218.0168" />
      </ECTransition>
      <ECTransition Source="StartOnePump" Destination="StartOnePump" Condition="FEED_CAPACITY OR FB_PUMP_RDY OR FEED_REACTOR" x="1044.484" y="1115.393">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="238.5871,338.1547,224.3014,222.4404" />
      </ECTransition>
      <ECTransition Source="StartOnePump" Destination="StartTowPumpsC2" Condition="(Pump01Capacity &gt;= MaxCapacityOnePump AND FbRunningPmp01) OR&#xD;&#xA;(Pump02Capacity &gt;= MaxCapacityOnePump AND FbRunningPmp02) OR&#xD;&#xA;(Pump03Capacity &gt;= MaxCapacityOnePump AND FbRunningPmp03)" x="1545.032" y="1410.421">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="386.1805,334.1556,386.4901,374.2918" />
      </ECTransition>
      <ECTransition Source="StartTowPumpsC2" Destination="StartTowPumpsMax" Condition="(FbRunningPmp01 AND FbRunningPmp02&#xD;&#xA;AND FbCapacityP &gt;= C2Capacity - 2&#xD;&#xA;AND FbCapacityP &lt;= C2Capacity + 2)&#xD;&#xA;&#xD;&#xA;OR&#xD;&#xA;&#xD;&#xA;(FbRunningPmp01 AND FbRunningPmp03&#xD;&#xA;AND FbCapacityP &gt;= C2Capacity - 2&#xD;&#xA;AND FbCapacityP &lt;= C2Capacity + 2)&#xD;&#xA;&#xD;&#xA;OR&#xD;&#xA;&#xD;&#xA;(FbRunningPmp02 AND FbRunningPmp03&#xD;&#xA;AND FbCapacityP &gt;= C2Capacity - 2&#xD;&#xA;AND FbCapacityP &lt;= C2Capacity + 2)" x="1546.593" y="1972.989">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="386.4291,473.0116,386.7015,512.9812" />
      </ECTransition>
      <ECTransition Source="StartTowPumpsMax" Destination="StartTowPumpsMax" Condition="FEED_CAPACITY OR FB_PUMP_RDY" x="990.4648" y="2277">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="211.1304,634.4445,214.4637,505.5556" />
      </ECTransition>
      <ECTransition Source="StartOnePump" Destination="StopAll" Condition="ForceStop OR LoLoLevelPv&#xD;&#xA;OR (NOT FbPump01Ready AND NOT FbPump02Ready AND NOT FbPump03Ready)&#xD;&#xA;&#xD;&#xA;OR (NOT FeedReactor1 AND&#xD;&#xA;	NOT FeedReactor2 AND&#xD;&#xA;	NOT FeedReactor3 AND&#xD;&#xA;	NOT FeedReactor4 AND&#xD;&#xA;	NOT FeedReactor5 AND&#xD;&#xA;	NOT FeedReactor6)&#xD;&#xA;" x="2604.089" y="902.8738">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="582.051,167.4956,724.5873,210.03" />
      </ECTransition>
      <ECTransition Source="StartTowPumpsC2" Destination="StopAll" Condition="ForceStop OR LoLoLevelPv&#xD;&#xA;OR (NOT FbPump01Ready AND NOT FbPump02Ready AND NOT FbPump03Ready)&#xD;&#xA;&#xD;&#xA;OR (NOT FeedReactor1 AND&#xD;&#xA;	NOT FeedReactor2 AND&#xD;&#xA;	NOT FeedReactor3 AND&#xD;&#xA;	NOT FeedReactor4 AND&#xD;&#xA;	NOT FeedReactor5 AND&#xD;&#xA;	NOT FeedReactor6)" x="2600.58" y="1436.978">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="585.9835,341.8522,720.5622,342.9099" />
      </ECTransition>
      <ECTransition Source="StartTowPumpsMax" Destination="StopAll" Condition="ForceStop OR LoLoLevelPv&#xD;&#xA;OR (NOT FbPump01Ready AND NOT FbPump02Ready AND NOT FbPump03Ready)&#xD;&#xA;&#xD;&#xA;OR (NOT FeedReactor1 AND&#xD;&#xA;	NOT FeedReactor2 AND&#xD;&#xA;	NOT FeedReactor3 AND&#xD;&#xA;	NOT FeedReactor4 AND&#xD;&#xA;	NOT FeedReactor5 AND&#xD;&#xA;	NOT FeedReactor6)" x="2627.043" y="1960.005">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="589.9637,508.8472,731.4434,468.7021" />
      </ECTransition>
      <ECTransition Source="StartTowPumpsC2" Destination="StartTowPumpsC2" Condition="PAR" x="987.0803" y="1684.75">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="206.6667,487.5,216.6667,355" />
      </ECTransition>
      <ECTransition Source="StopAll" Destination="START" Condition="LoLoLevelPv&#xD;&#xA;OR (NOT FbPump01Ready AND NOT FbPump02Ready AND NOT FbPump03Ready)&#xD;&#xA;&#xD;&#xA;OR (NOT FeedReactor1 AND&#xD;&#xA;	NOT FeedReactor2 AND&#xD;&#xA;	NOT FeedReactor3 AND&#xD;&#xA;	NOT FeedReactor4 AND&#xD;&#xA;	NOT FeedReactor5 AND&#xD;&#xA;	NOT FeedReactor6)" x="2830.937" y="709.1971">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="803.7007,193.8613,649.9624,101.755" />
      </ECTransition>
      <ECTransition Source="StopAll" Destination="WaitingTime" Condition="NOT ForceStop" x="3546.533" y="1045.029">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="886.6685,286.3275,885.9539,211.1046" />
      </ECTransition>
      <ECTransition Source="WaitingTime" Destination="START" Condition="FB_WAIT_TIME" x="2673.136" y="303.7136">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="747.0748,62.94836,606.0098,48.99782" />
      </ECTransition>
    </ECC>
    <Algorithm ID="b9a0305a-7b60-4353-8ce8-9f1ec530491a" Name="OnePump">
      <ST><![CDATA[;
CapacitySp := 0;

IF FeedReactor_C1 > CapacitySp AND FeedReactor1 THEN
    CapacitySp := FeedReactor_C1;
END_IF;

IF FeedReactor_C2 > CapacitySp AND FeedReactor2 THEN
    CapacitySp := FeedReactor_C2;
END_IF;

IF FeedReactor_C3 > CapacitySp AND FeedReactor3 THEN
    CapacitySp := FeedReactor_C3;
END_IF;

IF FeedReactor_C4 > CapacitySp AND FeedReactor4 THEN
    CapacitySp := FeedReactor_C4;
END_IF;

IF FeedReactor_C5 > CapacitySp AND FeedReactor5 THEN
    CapacitySp := FeedReactor_C5;
END_IF;

IF FeedReactor_C6 > CapacitySp AND FeedReactor6 THEN
    CapacitySp := FeedReactor_C6;
END_IF;


CmdPump01 := FALSE;
CmdPump02 := FALSE;
CmdPump03 := FALSE;

Pump01Capacity := 0.0;
Pump02Capacity := 0.0;
Pump03Capacity := 0.0;


IF FbPump01Ready THEN
    CmdPump01 := TRUE;
    Pump01Capacity := CapacitySp;

ELSIF FbPump02Ready THEN
    CmdPump02 := TRUE;
    Pump02Capacity := CapacitySp;

ELSIF FbPump03Ready THEN
    CmdPump03 := TRUE;
    Pump03Capacity := CapacitySp;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm ID="72237dd9-4c98-48fc-8576-bea150f540a2" Name="StartTowPumps_C2">
      <ST><![CDATA[;
Pump01Capacity := 0.0;
Pump02Capacity := 0.0;
Pump03Capacity := 0.0;


IF FbRunningPmp01 THEN
	Pump01Capacity := C2Capacity;	
	IF FbPump02Ready THEN
		CmdPump02 := TRUE;
		Pump02Capacity := C2Capacity;
		
	ELSIF FbPump03Ready THEN
		CmdPump03 := TRUE;
		Pump03Capacity := C2Capacity;
	END_IF;
ELSIF FbRunningPmp02 THEN
	Pump02Capacity := C2Capacity;	
	IF FbPump01Ready THEN
		CmdPump01 := TRUE;
		Pump01Capacity := C2Capacity;
		
	ELSIF FbPump03Ready THEN
		CmdPump03 := TRUE;
		Pump03Capacity := C2Capacity;
	END_IF;
ELSIF FbRunningPmp03 THEN
	Pump03Capacity := C2Capacity;	
	IF FbPump01Ready THEN
		CmdPump01 := TRUE;
		Pump01Capacity := C2Capacity;
		
	ELSIF FbPump02Ready THEN
		CmdPump02 := TRUE;
		Pump02Capacity := C2Capacity;
	END_IF;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm ID="d6349448-3fb5-47e4-8743-4f5a9ad3bc08" Name="StartTowPumps_Max">
      <ST><![CDATA[;
CapacitySp := 0;

IF FeedReactor_C1 > CapacitySp AND FeedReactor1 THEN
    CapacitySp := FeedReactor_C1;
END_IF;

IF FeedReactor_C2 > CapacitySp AND FeedReactor2 THEN
    CapacitySp := FeedReactor_C2;
END_IF;

IF FeedReactor_C3 > CapacitySp AND FeedReactor3 THEN
    CapacitySp := FeedReactor_C3;
END_IF;

IF FeedReactor_C4 > CapacitySp AND FeedReactor4 THEN
    CapacitySp := FeedReactor_C4;
END_IF;

IF FeedReactor_C5 > CapacitySp AND FeedReactor5 THEN
    CapacitySp := FeedReactor_C5;
END_IF;

IF FeedReactor_C6 > CapacitySp AND FeedReactor6 THEN
    CapacitySp := FeedReactor_C6;
END_IF;

Pump01Capacity := 0.0;
Pump02Capacity := 0.0;
Pump03Capacity := 0.0;

IF CmdPump01 AND NOT FbPump01Ready THEN
	CmdPump01 := FALSE;
    Pump01Capacity := 0.0;
	CmdPump03 := TRUE;
    Pump03Capacity := CapacitySp;
END_IF;

IF CmdPump02 AND NOT FbPump02Ready THEN
	CmdPump02 := FALSE;
    Pump02Capacity := 0.0;
	CmdPump03 := TRUE;
    Pump03Capacity := CapacitySp;
END_IF;

IF FbPump01Ready AND FbPump02Ready THEN
	CmdPump03 := FALSE;
    Pump03Capacity := 0.0;
	CmdPump01 := TRUE;
    Pump01Capacity := CapacitySp;
    CmdPump02 := TRUE;
    Pump02Capacity := CapacitySp;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm ID="35258b4e-d020-4370-929b-15602435f1c6" Name="StopAll">
      <ST><![CDATA[;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>