<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="41986be7-4399-49d9-88d6-ddb28bdc3815" Name="FeedReactor3PsBasic" Comment="Logica das 3 bombas de alimentacao (2 servico + 1 reserva) - mesmo funcionamento da Water Discharge" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="1.1" Author="Claude/Hidryco" Date="10/7/2026" Remarks="Rev2 - Setpoint do PID sempre igual ao setpoint do Nereda (removida a troca pela vazao medida com as bombas em C2) | Rev1 - Reescrito conforme a narrativa (cap. 2) com o mesmo funcionamento da Water Discharge (Rev13): Cmax/C2/C3/Cmin em % de velocidade; entrada da 2a com a bomba no Cmax pela velocidade real (narrativa); descida ate C2 confirmada pela velocidade real antes de partir a nova; T_C2 com as bombas em C2; reserva em falha parte na hora em C2; saida da 2a com protecao anti-ciclo; rodizio por horimetro; paradas por LL do buffer, pH/condutividade (L/H, retomada apos T_Restart) e vazao LL (T_FlowLL, retomada apos T_Restart); falha do medidor pela capacidade teorica; status para IHM" />
  <InterfaceList>
    <EventInputs>
      <Event ID="7E30127865CFE16B" Name="FEED_REACTOR" Comment="Pedido de alimentacao dos reatores (StartFeeding)">
        <With Var="FeedReactor1" />
        <With Var="FeedReactor2" />
        <With Var="FeedReactor3" />
        <With Var="FeedReactor4" />
