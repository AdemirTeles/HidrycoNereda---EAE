    <Algorithm Name="AlgMain" Comment="Logica das bombas de alimentacao">
      <ST><![CDATA[;
(* ============================================================
   FeedReactor3PsBasic Rev2 - bombas de alimentacao P4001/P4002/P4003 (2 servico + 1 reserva)
   Rev2: o setpoint do PID e sempre o setpoint do Nereda (removida a troca pela vazao medida com as bombas em C2).
   Narrativa cap. 2 (Influent feed) com o mesmo funcionamento da Water Discharge do Sludge Buffer.
   - Partida: StartFeeding de algum reator (fase Feed em RUN e AV41101 aberta). SP = maior pedido [m3/h].
   - Demanda = saida do PID [%] (100 % = 2 bombas a 100 %). Cmax / C2 / C3 / Cmin em % de velocidade de UMA bomba.
     1 bomba = 2 x demanda ; 2 bombas = demanda ; nunca abaixo de Cmin.
   - Entrada: velocidade REAL da bomba em operacao no Cmax -> a(s) em operacao descem ate C2 (velocidade REAL),
     a nova parte em C2, T_C2 com as duas com velocidade REAL em C2, depois PID. Sem liberacao por tempo.
   - Saida: velocidade REAL de todas as bombas em operacao abaixo de C3 por T_C3: sai a que partiu primeiro.
   - Falha de bomba com 2 em servico: reserva parte na hora, todas em C2, T_C2, depois PID.
   - Paradas: 1 nivel LL 40LT0001 (retoma ao sair o LL) | 2 pH/condutividade fora da faixa (retoma T_Restart apos voltar)
              3 vazao LL 40FT0003 por T_FlowLL com bomba rodando (retoma apos T_Restart)
   - Falha do 40FT0003: demanda = SP / (2 x capacidade teorica) x 100 ; sem capacidade teorica, SP em % da faixa.
   PumpMode: 0 uma bomba | 1 reduzindo p/ C2 (nova parada) | 2 nova em C2 (T_C2) | 3 duas no PID
   ============================================================ *)

(* ---------- 1. Pedido de alimentacao e setpoint ---------- *)
FeedReq := FeedReactor1 OR FeedReactor2 OR FeedReactor3 OR FeedReactor4 OR FeedReactor5 OR FeedReactor6;
FlowSp := 0.0;
IF FeedReactor1 AND (FeedReactor_C1 > FlowSp) THEN
    FlowSp := FeedReactor_C1;
END_IF;
IF FeedReactor2 AND (FeedReactor_C2 > FlowSp) THEN
    FlowSp := FeedReactor_C2;
END_IF;
IF FeedReactor3 AND (FeedReactor_C3 > FlowSp) THEN
    FlowSp := FeedReactor_C3;
END_IF;
IF FeedReactor4 AND (FeedReactor_C4 > FlowSp) THEN
    FlowSp := FeedReactor_C4;
END_IF;
IF FeedReactor5 AND (FeedReactor_C5 > FlowSp) THEN
    FlowSp := FeedReactor_C5;
END_IF;
IF FeedReactor6 AND (FeedReactor_C6 > FlowSp) THEN
    FlowSp := FeedReactor_C6;
END_IF;
IF FeedReq THEN
    Grafcet := 3;
ELSE
    Grafcet := 0;
END_IF;

(* ---------- 2. Demanda, velocidade minima e parametros ---------- *)
IF FlowFail THEN
    IF CapTheo > 0.0 THEN
        Dem := FlowSp / (2.0 * CapTheo) * 100.0;
    ELSIF FlowPvMax > FlowPvMin THEN
        Dem := (FlowSp - FlowPvMin) / (FlowPvMax - FlowPvMin) * 100.0;
    ELSE
        Dem := 0.0;
    END_IF;
ELSE
    Dem := PIDOut;
END_IF;
IF Dem > 100.0 THEN
    Dem := 100.0;
END_IF;
IF Dem < 0.0 THEN
    Dem := 0.0;
END_IF;
CminEff := Cmin;
IF CminEff > 100.0 THEN
    CminEff := 100.0;
END_IF;
IF CminEff < 0.0 THEN
    CminEff := 0.0;
END_IF;
(* so Cmax e C2 sao indispensaveis; o resto apenas avisa (ParBad) - a protecao anti-ciclo esta embutida na saida *)
ParOk := (MaxCapacityOnePump > 0.0) AND (C2Capacity > 0.0);
ParBad := (MaxCapacityOnePump <= 0.0) OR (C2Capacity <= 0.0) OR (C2Capacity < CminEff) OR (C3Capacity <= CminEff) OR ((2.0 * C3Capacity) >= MaxCapacityOnePump) OR (Cmin < 0.0) OR (Cmin > 100.0);
C2Eff := C2Capacity;
IF C2Eff < CminEff THEN
    C2Eff := CminEff;
END_IF;
ExitCond := FALSE; (* calculado mais abaixo, so pela velocidade real das bombas *)

(* ---------- 3. Paradas da alimentacao (narrativa 2.2) ---------- *)
IF Grafcet = 3 THEN
    IF Paused THEN
        IF (PauseCause = 1) AND (NOT LoLoLevelPv) THEN
            Paused := FALSE;
            PauseCause := 0;
            Tll := T#0s;
        ELSIF (PauseCause >= 2) AND (NOT LoLoLevelPv) AND (NOT ForceStop) AND (Trest >= T_Restart) THEN
            Paused := FALSE;
            PauseCause := 0;
            Tll := T#0s;
        END_IF;
    END_IF;
    IF LoLoLevelPv THEN
        Paused := TRUE;
        PauseCause := 1;
        Trest := T#0s;
        TRests := 0;
    ELSIF ForceStop THEN
        Paused := TRUE;
        PauseCause := 2;
        Trest := T#0s;
        TRests := 0;
    ELSIF (NOT Paused) AND (T_FlowLL > T#0s) AND (Tll >= T_FlowLL) THEN
        Paused := TRUE;
        PauseCause := 3;
        Trest := T#0s;
        TRests := 0;
        Tll := T#0s;
    END_IF;
END_IF;

(* ---------- 4. Bombas ---------- *)
IF (Grafcet = 3) AND Paused THEN
    CmdPump01 := FALSE;
    CmdPump02 := FALSE;
    CmdPump03 := FALSE;
    PumpMode := 0;
    Tacc := T#0s;
    TC2s := 0;
    T3acc := T#0s;
    TC3s := 0;
    NCmd := 0;
    NRun := 0;
    EffFlowSp := FlowSp;
    PumpSpeed := 0.0;
    AtMin := FALSE;
ELSIF Grafcet = 3 THEN
    (* 4.1 bomba sai de servico somente se nao estiver Ready (modo programa) NEM Running *)
    IF CmdPump01 AND NOT FbPump01Ready AND NOT FbRunningPmp01 THEN
        CmdPump01 := FALSE;
    END_IF;
    IF CmdPump02 AND NOT FbPump02Ready AND NOT FbRunningPmp02 THEN
        CmdPump02 := FALSE;
    END_IF;
    IF CmdPump03 AND NOT FbPump03Ready AND NOT FbRunningPmp03 THEN
        CmdPump03 := FALSE;
    END_IF;
    NCmd := 0;
    IF CmdPump01 THEN
        NCmd := NCmd + 1;
    END_IF;
    IF CmdPump02 THEN
        NCmd := NCmd + 1;
    END_IF;
    IF CmdPump03 THEN
        NCmd := NCmd + 1;
    END_IF;
    NRun := 0;
    IF CmdPump01 AND FbRunningPmp01 THEN
        NRun := NRun + 1;
    END_IF;
    IF CmdPump02 AND FbRunningPmp02 THEN
        NRun := NRun + 1;
    END_IF;
    IF CmdPump03 AND FbRunningPmp03 THEN
        NRun := NRun + 1;
    END_IF;
    Spare := (FbPump01Ready AND NOT CmdPump01) OR (FbPump02Ready AND NOT CmdPump02) OR (FbPump03Ready AND NOT CmdPump03);
    (* bombas em operacao ja desceram ate C2 (velocidade real) *)
    SpdAtC2 := TRUE;
    IF CmdPump01 AND FbRunningPmp01 AND (SpeedPvPmp01 > (C2Eff + TolC2)) THEN
        SpdAtC2 := FALSE;
    END_IF;
    IF CmdPump02 AND FbRunningPmp02 AND (SpeedPvPmp02 > (C2Eff + TolC2)) THEN
        SpdAtC2 := FALSE;
    END_IF;
    IF CmdPump03 AND FbRunningPmp03 AND (SpeedPvPmp03 > (C2Eff + TolC2)) THEN
        SpdAtC2 := FALSE;
    END_IF;
    (* bomba em operacao com velocidade real ja no Cmax *)
    SpdAtMax := FALSE;
    IF CmdPump01 AND FbRunningPmp01 AND (SpeedPvPmp01 >= (MaxCapacityOnePump - TolC2)) THEN
        SpdAtMax := TRUE;
    END_IF;
    IF CmdPump02 AND FbRunningPmp02 AND (SpeedPvPmp02 >= (MaxCapacityOnePump - TolC2)) THEN
        SpdAtMax := TRUE;
    END_IF;
    IF CmdPump03 AND FbRunningPmp03 AND (SpeedPvPmp03 >= (MaxCapacityOnePump - TolC2)) THEN
        SpdAtMax := TRUE;
    END_IF;
    (* bombas em operacao com velocidade real ja em C2 (subida da que entrou) *)
    SpdUpC2 := TRUE;
    IF CmdPump01 AND FbRunningPmp01 AND (SpeedPvPmp01 < (C2Eff - TolC2)) THEN
        SpdUpC2 := FALSE;
    END_IF;
    IF CmdPump02 AND FbRunningPmp02 AND (SpeedPvPmp02 < (C2Eff - TolC2)) THEN
        SpdUpC2 := FALSE;
    END_IF;
    IF CmdPump03 AND FbRunningPmp03 AND (SpeedPvPmp03 < (C2Eff - TolC2)) THEN
        SpdUpC2 := FALSE;
    END_IF;
    (* saida de uma bomba: velocidade real de TODAS as bombas em operacao abaixo de C3 (sem usar a saida do PID) *)
    ExitCond := NRun >= 2;
    IF CmdPump01 AND FbRunningPmp01 AND (SpeedPvPmp01 >= C3Capacity) THEN
        ExitCond := FALSE;
    END_IF;
    IF CmdPump02 AND FbRunningPmp02 AND (SpeedPvPmp02 >= C3Capacity) THEN
        ExitCond := FALSE;
    END_IF;
    IF CmdPump03 AND FbRunningPmp03 AND (SpeedPvPmp03 >= C3Capacity) THEN
        ExitCond := FALSE;
    END_IF;
    (* 4.1b com 2 bombas (modo 2/3) uma saiu de servico: a reserva parte NA HORA, todas em C2, T_C2, depois PID *)
    IF ParOk AND (PumpMode >= 2) AND (NCmd < 2) THEN
        IF Spare AND (NCmd >= 1) THEN
            PumpMode := 2;
            Tacc := T#0s;
            TC2s := 0;
            Tup := T#0s;
        ELSE
            PumpMode := 0;
        END_IF;
    END_IF;

    (* 4.2 numero de bombas *)
    IF NOT ParOk THEN
        PumpMode := 0;
    ELSIF PumpMode = 0 THEN
        (* entra a 2a bomba somente quando a velocidade REAL da bomba em operacao chega ao Cmax *)
        IF Spare AND (NRun >= 1) AND SpdAtMax THEN
            PumpMode := 1;
            Tdec := T#0s;
            TDecs := 0;
        END_IF;
    ELSIF PumpMode = 1 THEN
        (* a nova so parte depois que a velocidade REAL da(s) bomba(s) em operacao desceu ate C2 *)
        IF (NOT Spare) OR (NCmd = 0) THEN
            PumpMode := 0;
        ELSIF SpdAtC2 THEN
            PumpMode := 2;
            Tacc := T#0s;
            TC2s := 0;
            Tup := T#0s;
        END_IF;
    ELSIF PumpMode = 2 THEN
        (* T_C2 conta com as duas rodando e com velocidade REAL em C2 *)
        IF (NRun >= 2) AND (Tacc >= T_C2) THEN
            PumpMode := 3;
            T3acc := T#0s;
            TC3s := 0;
        END_IF;
    ELSIF PumpMode = 3 THEN
        (* saida: velocidade REAL das bombas abaixo de C3 por T_C3 *)
        IF ExitCond AND (T3acc >= T_C3) THEN
            PumpMode := 0;
            T3acc := T#0s;
            TC3s := 0;
        END_IF;
    END_IF;
    IF PumpMode >= 2 THEN
        NWant := 2;
    ELSE
        NWant := 1;
    END_IF;

    (* 4.3 entra bomba disponivel de menor horimetro (rodizio) - ate 2 vezes *)
    IF NCmd < NWant THEN
        PumpSel := 0;
        IF FbPump01Ready AND NOT CmdPump01 THEN
            PumpSel := 1;
            MinTot := TotOpePmp01;
        END_IF;
        IF FbPump02Ready AND NOT CmdPump02 THEN
            IF (PumpSel = 0) OR (TotOpePmp02 < MinTot) THEN
                PumpSel := 2;
                MinTot := TotOpePmp02;
            END_IF;
        END_IF;
        IF FbPump03Ready AND NOT CmdPump03 THEN
            IF (PumpSel = 0) OR (TotOpePmp03 < MinTot) THEN
                PumpSel := 3;
                MinTot := TotOpePmp03;
            END_IF;
        END_IF;
        IF PumpSel = 1 THEN
            CmdPump01 := TRUE;
            Seq := Seq + 1;
            Ord1 := Seq;
            NCmd := NCmd + 1;
        ELSIF PumpSel = 2 THEN
            CmdPump02 := TRUE;
            Seq := Seq + 1;
            Ord2 := Seq;
            NCmd := NCmd + 1;
        ELSIF PumpSel = 3 THEN
            CmdPump03 := TRUE;
            Seq := Seq + 1;
            Ord3 := Seq;
            NCmd := NCmd + 1;
        END_IF;
    END_IF;
    IF NCmd < NWant THEN
        PumpSel := 0;
        IF FbPump01Ready AND NOT CmdPump01 THEN
            PumpSel := 1;
            MinTot := TotOpePmp01;
        END_IF;
        IF FbPump02Ready AND NOT CmdPump02 THEN
            IF (PumpSel = 0) OR (TotOpePmp02 < MinTot) THEN
                PumpSel := 2;
                MinTot := TotOpePmp02;
            END_IF;
        END_IF;
        IF FbPump03Ready AND NOT CmdPump03 THEN
            IF (PumpSel = 0) OR (TotOpePmp03 < MinTot) THEN
                PumpSel := 3;
                MinTot := TotOpePmp03;
            END_IF;
        END_IF;
        IF PumpSel = 1 THEN
            CmdPump01 := TRUE;
            Seq := Seq + 1;
            Ord1 := Seq;
            NCmd := NCmd + 1;
        ELSIF PumpSel = 2 THEN
            CmdPump02 := TRUE;
            Seq := Seq + 1;
            Ord2 := Seq;
            NCmd := NCmd + 1;
        ELSIF PumpSel = 3 THEN
            CmdPump03 := TRUE;
            Seq := Seq + 1;
            Ord3 := Seq;
            NCmd := NCmd + 1;
        END_IF;
    END_IF;

    (* 4.4 excedente: sai a bomba em operacao ha mais tempo (menor ordem de partida) *)
    IF NCmd > NWant THEN
        PumpSel := 0;
        IF CmdPump01 THEN
            PumpSel := 1;
            MinOrd := Ord1;
        END_IF;
        IF CmdPump02 THEN
            IF (PumpSel = 0) OR (Ord2 < MinOrd) THEN
                PumpSel := 2;
                MinOrd := Ord2;
            END_IF;
        END_IF;
        IF CmdPump03 THEN
            IF (PumpSel = 0) OR (Ord3 < MinOrd) THEN
                PumpSel := 3;
                MinOrd := Ord3;
            END_IF;
        END_IF;
        IF PumpSel = 1 THEN
            CmdPump01 := FALSE;
        ELSIF PumpSel = 2 THEN
            CmdPump02 := FALSE;
        ELSIF PumpSel = 3 THEN
            CmdPump03 := FALSE;
        END_IF;
        NCmd := NCmd - 1;
    END_IF;

    (* 4.5 sem bomba para a 2a posicao: volta a operar com uma *)
    IF (PumpMode >= 2) AND (NCmd < 2) THEN
        PumpMode := 0;
    END_IF;

    (* 4.6 setpoint do PID e velocidade das bombas *)
    (* setpoint do PID = setpoint do Nereda (maior pedido), sempre - nunca trocado pela vazao medida (Rev2) *)
    EffFlowSp := FlowSp;
    IF (PumpMode = 1) OR (PumpMode = 2) THEN
        SpdRaw := C2Eff;
    ELSIF PumpMode = 3 THEN
        SpdRaw := Dem;
    ELSE
        SpdRaw := 2.0 * Dem;
    END_IF;
    IF SpdRaw > 100.0 THEN
        SpdRaw := 100.0;
    END_IF;
    AtMin := (NCmd >= 1) AND (SpdRaw < CminEff);
    IF SpdRaw < CminEff THEN
        PumpSpeed := CminEff;
    ELSE
        PumpSpeed := SpdRaw;
    END_IF;
ELSE
    (* sem pedido de alimentacao *)
    CmdPump01 := FALSE;
    CmdPump02 := FALSE;
    CmdPump03 := FALSE;
    PumpMode := 0;
    Tacc := T#0s;
    TC2s := 0;
    T3acc := T#0s;
    TC3s := 0;
    NCmd := 0;
    NRun := 0;
    EffFlowSp := FlowSp;
    PumpSpeed := 0.0;
    AtMin := FALSE;
    Paused := FALSE;
    PauseCause := 0;
    Trest := T#0s;
    TRests := 0;
    Tll := T#0s;
END_IF;

(* ---------- 5. Saidas ---------- *)
AnyCmd := CmdPump01 OR CmdPump02 OR CmdPump03;
RunPID := (Grafcet = 3) AND (NOT Paused) AND AnyCmd;
AnyReady := FbPump01Ready OR FbRunningPmp01 OR FbPump02Ready OR FbRunningPmp02 OR FbPump03Ready OR FbRunningPmp03;
AnyRunning := FbRunningPmp01 OR FbRunningPmp02 OR FbRunningPmp03;
AllStopped := NOT AnyRunning;
NPumps := NRun;
SelectedPump := 0;
SecondPump := 0;
MinOrd := 0;
IF CmdPump01 THEN
    SelectedPump := 1;
    MinOrd := Ord1;
END_IF;
IF CmdPump02 THEN
    IF (SelectedPump = 0) OR (Ord2 < MinOrd) THEN
        SecondPump := SelectedPump;
        SelectedPump := 2;
        MinOrd := Ord2;
    ELSE
        SecondPump := 2;
    END_IF;
END_IF;
IF CmdPump03 THEN
    IF (SelectedPump = 0) OR (Ord3 < MinOrd) THEN
        SecondPump := SelectedPump;
        SelectedPump := 3;
        MinOrd := Ord3;
    ELSE
        SecondPump := 3;
    END_IF;
END_IF;

(* ---------- 6. Eventos de saida somente na mudanca ---------- *)
EdgeCmd := (CmdPump01 <> PrevC1) OR (CmdPump02 <> PrevC2) OR (CmdPump03 <> PrevC3);
PrevC1 := CmdPump01;
PrevC2 := CmdPump02;
PrevC3 := CmdPump03;
EdgeOut := (EffFlowSp <> PrevSP) OR (RunPID <> PrevRun) OR (AnyReady <> PrevAR) OR (AnyRunning <> PrevARun);
PrevSP := EffFlowSp;
PrevRun := RunPID;
PrevAR := AnyReady;
PrevARun := AnyRunning;
EdgeSpd := (PumpSpeed <> PrevSpd) OR (AnyCmd <> PrevAC);
PrevSpd := PumpSpeed;
PrevAC := AnyCmd;

(* ---------- 7. Status para a IHM: a cada 1 s (TICK) e quando o estado muda ---------- *)
HmiCmin := CminEff;
HmiC2 := C2Eff;
HmiC3 := C3Capacity;
HmiCmax := MaxCapacityOnePump;
HmiFlowFail := FlowFail;
HmiTC2 := TC2s;
HmiTC3 := TC3s;
HmiTDec := TDecs;
HmiTWait := TRests;
HmiFlowSp := FlowSp;
EdgeSts := FromTick OR (PumpMode <> PrevSPM) OR (NPumps <> PrevSNP) OR (PauseCause <> PrevSPC) OR (Grafcet <> PrevSGR) OR (AtMin <> PrevSAM) OR (ParBad <> PrevSPB);
FromTick := FALSE;
PrevSPM := PumpMode;
PrevSNP := NPumps;
PrevSPC := PauseCause;
PrevSGR := Grafcet;
PrevSAM := AtMin;
PrevSPB := ParBad;
]]></ST>
    </Algorithm>
    <Algorithm Name="AlgTick" Comment="Base de tempo 1 s">
      <ST><![CDATA[;
(* Base de tempo 1 s (E_CYCLE externo) *)
FromTick := TRUE;
IF PumpMode = 2 THEN
    Tup := Tup + T#1s;
ELSE
    Tup := T#0s;
END_IF;
(* T_C2: as duas rodando e com velocidade REAL em C2 *)
IF (PumpMode = 2) AND (NRun >= 2) AND SpdUpC2 THEN
    Tacc := Tacc + T#1s;
    TC2s := TC2s + 1;
END_IF;
(* demanda acima do Cmax com 1 bomba (limite quando a velocidade real nao confirma o Cmax) *)
IF (PumpMode = 0) AND (NRun >= 1) AND ((2.0 * Dem) > MaxCapacityOnePump) THEN
    Tmax := Tmax + T#1s;
ELSE
    Tmax := T#0s;
END_IF;
(* tempo de descida ate C2 antes de partir a nova bomba *)
IF PumpMode = 1 THEN
    Tdec := Tdec + T#1s;
    TDecs := TDecs + 1;
ELSE
    Tdec := T#0s;
    TDecs := 0;
END_IF;
(* duas bombas com a condicao de saida *)
IF (PumpMode = 3) AND (NRun >= 2) AND ExitCond THEN
    T3acc := T3acc + T#1s;
    TC3s := TC3s + 1;
ELSE
    T3acc := T#0s;
    TC3s := 0;
END_IF;
(* espera para retomar: conta so com as causas ja normalizadas *)
IF (Grafcet = 3) AND Paused AND (NOT LoLoLevelPv) AND (NOT ForceStop) THEN
    Trest := Trest + T#1s;
    TRests := TRests + 1;
ELSE
    Trest := T#0s;
    TRests := 0;
END_IF;
(* vazao LL com bomba rodando *)
IF (Grafcet = 3) AND (NOT Paused) AND (NRun >= 1) AND FlowLL AND (NOT FlowFail) THEN
    Tll := Tll + T#1s;
ELSE
    Tll := T#0s;
END_IF;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>