      <VarDeclaration ID="3ED1AC1F50C1DDC5" Name="PositionR4" Type="INT" />
      <VarDeclaration ID="0537CBAEFE3E33F0" Name="PositionR5" Type="INT" />
      <VarDeclaration ID="F44C736C902AD671" Name="PositionR6" Type="INT" />
      <VarDeclaration ID="9A5AAB4E801C2CA4" Name="ExistReactor1" Type="BOOL" />
      <VarDeclaration ID="DE964A829D17457B" Name="ExistReactor2" Type="BOOL" />
      <VarDeclaration ID="68ED98420115DCB8" Name="ExistReactor3" Type="BOOL" />
      <VarDeclaration ID="F91E650BB68991E6" Name="ExistReactor4" Type="BOOL" />
      <VarDeclaration ID="73BF5DEC82E9482C" Name="ExistReactor5" Type="BOOL" />
      <VarDeclaration ID="4B5EC10E0DC11F17" Name="ExistReactor6" Type="BOOL" />
      <VarDeclaration ID="DDB39E45EFCED8D8" Name="AvailableReactor1" Type="BOOL" />
      <VarDeclaration ID="534818A7890109B2" Name="AvailableReactor2" Type="BOOL" />
      <VarDeclaration ID="BEF93F1F81559DBD" Name="AvailableReactor3" Type="BOOL" />
      <VarDeclaration ID="F7E0AE6BB8054480" Name="AvailableReactor4" Type="BOOL" />
      <VarDeclaration ID="EB124F6B538ADD55" Name="AvailableReactor5" Type="BOOL" />
      <VarDeclaration ID="B60357D18066DF0E" Name="AvailableReactor6" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="8A408AC9522596F0" Name="LowestTimeSinceStartFeed" Type="REAL" />
      <VarDeclaration ID="0DCC691260B3560F" Name="NextFeedHorizon" Type="REAL" />
      <VarDeclaration ID="65DD9DFF0E258395" Name="NextFeedHorizon_R1" Type="REAL" />
      <VarDeclaration ID="563DC3E1AC221234" Name="NextFeedHorizon_R2" Type="REAL" />
      <VarDeclaration ID="4C0C80183FC55B5A" Name="NextFeedHorizon_R3" Type="REAL" />
      <VarDeclaration ID="B70593E6D3D95FF1" Name="NextFeedHorizon_R4" Type="REAL" />
      <VarDeclaration ID="65C4708021D9B2CA" Name="NextFeedHorizon_R5" Type="REAL" />
      <VarDeclaration ID="4F3E4C31A73CCE46" Name="NextFeedHorizon_R6" Type="REAL" />
      <VarDeclaration ID="F5613FFDB937CDE2" Name="Valid" Type="BOOL" />
      <VarDeclaration ID="3174B0E2BA0493C7" Name="CalcDone" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="537ce0b7-740f-4afa-93c9-3194bb88e635">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ" />
    <InternalVars>
      <VarDeclaration ID="1AECB90835BA8BE2" Name="TimeSinceStartFeed" Type="REAL" />
      <VarDeclaration ID="B8CB553C61DA205F" Name="FirstValueFound" Type="BOOL" />
      <VarDeclaration ID="0B7947FA35C0E98D" Name="R1Used" Type="BOOL" />
      <VarDeclaration ID="85798B149014E937" Name="R2Used" Type="BOOL" />
      <VarDeclaration ID="8C8FCC94E0BBE93B" Name="R3Used" Type="BOOL" />
      <VarDeclaration ID="29B1BE108E2689DA" Name="R4Used" Type="BOOL" />
      <VarDeclaration ID="15C72696B298D428" Name="R5Used" Type="BOOL" />
      <VarDeclaration ID="DE80D5A5F74D3798" Name="R6Used" Type="BOOL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="328.9412" y="517.4117" />
      <ECState Name="REQ" Comment="Normal execution" x="1193.647" y="936.9412">
        <ECAction Algorithm="REQ" Output="NEXT_FEED_H" />
      </ECState>
      <ECTransition Source="START" Destination="REQ" Condition="REQ" x="857.8212" y="629.4161">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="191.495,137.9533,245.9648,163.961" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="1" x="759.977" y="807.972">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="218.6847,220.5541,163.9043,193.9763" />
      </ECTransition>
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;
R1Used := ExistReactor1 AND AvailableReactor1;
R2Used := ExistReactor2 AND AvailableReactor2;
R3Used := ExistReactor3 AND AvailableReactor3;
R4Used := ExistReactor4 AND AvailableReactor4;
R5Used := ExistReactor5 AND AvailableReactor5;
R6Used := ExistReactor6 AND AvailableReactor6;

Valid := FALSE;
FirstValueFound := FALSE;
LowestTimeSinceStartFeed := 0;
NextFeedHorizon := 0;

NextFeedHorizon_R1 := 0;
NextFeedHorizon_R2 := 0;
NextFeedHorizon_R3 := 0;
NextFeedHorizon_R4 := 0;
NextFeedHorizon_R5 := 0;
NextFeedHorizon_R6 := 0;

IF R1Used THEN
	LowestTimeSinceStartFeed := TimeSinceStartFeedR1;
	FirstValueFound := TRUE;
END_IF;

IF R2Used THEN
	IF NOT FirstValueFound THEN
		LowestTimeSinceStartFeed := TimeSinceStartFeedR2;
		FirstValueFound := TRUE;
	ELSIF TimeSinceStartFeedR2 < LowestTimeSinceStartFeed THEN
		LowestTimeSinceStartFeed := TimeSinceStartFeedR2;
	END_IF;
END_IF;

IF R3Used THEN
	IF NOT FirstValueFound THEN
		LowestTimeSinceStartFeed := TimeSinceStartFeedR3;
		FirstValueFound := TRUE;
	ELSIF TimeSinceStartFeedR3 < LowestTimeSinceStartFeed THEN
		LowestTimeSinceStartFeed := TimeSinceStartFeedR3;
	END_IF;
END_IF;

IF R4Used THEN
	IF NOT FirstValueFound THEN
		LowestTimeSinceStartFeed := TimeSinceStartFeedR4;
		FirstValueFound := TRUE;
	ELSIF TimeSinceStartFeedR4 < LowestTimeSinceStartFeed THEN
		LowestTimeSinceStartFeed := TimeSinceStartFeedR4;
	END_IF;
END_IF;

IF R5Used THEN
	IF NOT FirstValueFound THEN
		LowestTimeSinceStartFeed := TimeSinceStartFeedR5;
		FirstValueFound := TRUE;
	ELSIF TimeSinceStartFeedR5 < LowestTimeSinceStartFeed THEN
		LowestTimeSinceStartFeed := TimeSinceStartFeedR5;
	END_IF;
END_IF;

IF R6Used THEN
	IF NOT FirstValueFound THEN
		LowestTimeSinceStartFeed := TimeSinceStartFeedR6;
		FirstValueFound := TRUE;
	ELSIF TimeSinceStartFeedR6 < LowestTimeSinceStartFeed THEN
		LowestTimeSinceStartFeed := TimeSinceStartFeedR6;
	END_IF;
END_IF;

Valid := FirstValueFound AND (FeedInterval > 0);

IF Valid THEN
	IF LowestTimeSinceStartFeed >= FeedInterval THEN
		NextFeedHorizon := 0;
	ELSE
		NextFeedHorizon := FeedInterval - LowestTimeSinceStartFeed;
	END_IF;
	
	IF R1Used THEN
		NextFeedHorizon_R1 := NextFeedHorizon + (PositionR1 - 1) * FeedInterval;
	END_IF;
	
	IF R2Used THEN
		NextFeedHorizon_R2 := NextFeedHorizon + (PositionR2 - 1) * FeedInterval;
	END_IF;
	
	IF R3Used THEN
		NextFeedHorizon_R3 := NextFeedHorizon + (PositionR3 - 1) * FeedInterval;
	END_IF;
	
	IF R4Used THEN
		NextFeedHorizon_R4 := NextFeedHorizon + (PositionR4 - 1) * FeedInterval;
	END_IF;
	
	IF R5Used THEN
		NextFeedHorizon_R5 := NextFeedHorizon + (PositionR5 - 1) * FeedInterval;
	END_IF;
	
	IF R6Used THEN
		NextFeedHorizon_R6 := NextFeedHorizon + (PositionR6 - 1) * FeedInterval;
	END_IF;
END_IF;

CalcDone := Valid AND  AND
		(AvailableReactor1 AND NextFeedHorizon_R1 <> 0 OR
		AvailableReactor2 AND NextFeedHorizon_R2 <> 0 OR
		AvailableReactor3 AND NextFeedHorizon_R3 <> 0 OR
		AvailableReactor4 AND NextFeedHorizon_R4 <> 0 OR
		AvailableReactor5 AND NextFeedHorizon_R5 <> 0 OR
		AvailableReactor6 AND NextFeedHorizon_R6 <> 0);]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>