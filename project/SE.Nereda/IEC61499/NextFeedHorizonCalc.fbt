      <VarDeclaration ID="923283901CA0EBA6" Name="SettleTimeR2" Type="REAL" />
      <VarDeclaration ID="8F9A0E0EDF207E29" Name="SettleTimeR3" Type="REAL" />
      <VarDeclaration ID="E9EBA76EDAADA7B3" Name="SettleTimeR4" Type="REAL" />
      <VarDeclaration ID="B25F62E947EA6C0E" Name="SettleTimeR5" Type="REAL" />
      <VarDeclaration ID="EF4329CD4AF2CCCC" Name="SettleTimeR6" Type="REAL" />
      <VarDeclaration ID="0B7947FA35C0E98D" Name="R1Used" Type="BOOL" />
      <VarDeclaration ID="85798B149014E937" Name="R2Used" Type="BOOL" />
      <VarDeclaration ID="8C8FCC94E0BBE93B" Name="R3Used" Type="BOOL" />
      <VarDeclaration ID="29B1BE108E2689DA" Name="R4Used" Type="BOOL" />
      <VarDeclaration ID="15C72696B298D428" Name="R5Used" Type="BOOL" />
      <VarDeclaration ID="DE80D5A5F74D3798" Name="R6Used" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="65DD9DFF0E258395" Name="NextFeedHorizon_R1" Type="REAL" />
      <VarDeclaration ID="563DC3E1AC221234" Name="NextFeedHorizon_R2" Type="REAL" />
      <VarDeclaration ID="4C0C80183FC55B5A" Name="NextFeedHorizon_R3" Type="REAL" />
      <VarDeclaration ID="B70593E6D3D95FF1" Name="NextFeedHorizon_R4" Type="REAL" />
      <VarDeclaration ID="65C4708021D9B2CA" Name="NextFeedHorizon_R5" Type="REAL" />
      <VarDeclaration ID="4F3E4C31A73CCE46" Name="NextFeedHorizon_R6" Type="REAL" />
      <VarDeclaration ID="ABE8A54378B7248E" Name="i_R1" Type="INT" />
      <VarDeclaration ID="48667719A40B4531" Name="i_R2" Type="INT" />
      <VarDeclaration ID="CD2B256D43AE121B" Name="i_R3" Type="INT" />
      <VarDeclaration ID="CF28E0450B8B8894" Name="i_R4" Type="INT" />
      <VarDeclaration ID="8E5184FA4107FCA9" Name="i_R5" Type="INT" />
      <VarDeclaration ID="E3B38A29331E2546" Name="i_R6" Type="INT" />
      <VarDeclaration ID="3174B0E2BA0493C7" Name="CalcDone" Type="BOOL" />
      <VarDeclaration ID="75431D66234D894D" Name="Valid" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="537ce0b7-740f-4afa-93c9-3194bb88e635">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ" />
    <InternalVars>
      <VarDeclaration ID="804C20421CBCF134" Name="InNextFeedHorizon_R1" Type="REAL" />
      <VarDeclaration ID="9EE4391412B69315" Name="InNextFeedHorizon_R2" Type="REAL" />
      <VarDeclaration ID="DC44EEB28290D1AB" Name="InNextFeedHorizon_R3" Type="REAL" />
      <VarDeclaration ID="A38555AC480CDCDB" Name="InNextFeedHorizon_R4" Type="REAL" />
      <VarDeclaration ID="8030E2A631D09D3E" Name="InNextFeedHorizon_R5" Type="REAL" />
      <VarDeclaration ID="FDA1FBF52C1CC9BC" Name="InNextFeedHorizon_R6" Type="REAL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="328.9412" y="517.4117" />
      <ECState Name="REQ" Comment="Normal execution" x="1193.647" y="936.9412">
        <ECAction Algorithm="REQ" Output="NEXT_FEED_H" />
      </ECState>
      <ECTransition Source="START" Destination="REQ" Condition="REQ" x="825.9772" y="649.2119">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="181.3811,144.1705,235.8509,170.1782" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="1" x="759.977" y="807.972">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="218.6847,220.5541,163.9043,193.9763" />
      </ECTransition>
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[i_R1 := PositionR1 - 1;
i_R2 := PositionR2 - 1;
i_R3 := PositionR3 - 1;
i_R4 := PositionR4 - 1;
i_R5 := PositionR5 - 1;
i_R6 := PositionR6 - 1;


// Validation
Valid := (FallbackElapsedTime > 0) AND (StartFeedInterval > 0);

// Calculate Next Feed Horizon for each Reactor
IF Valid THEN
	IF R1Used THEN
		InNextFeedHorizon_R1 := StartFeedInterval - FallbackElapsedTime + i_R1 * StartFeedInterval;
	END_IF;
	
	IF R2Used THEN
		InNextFeedHorizon_R2 := StartFeedInterval - FallbackElapsedTime + i_R2 * StartFeedInterval;
	END_IF;
	
	IF R3Used THEN
		InNextFeedHorizon_R3 := StartFeedInterval - FallbackElapsedTime + i_R3 * StartFeedInterval;
	END_IF;
	
	IF R4Used THEN
		InNextFeedHorizon_R4 := StartFeedInterval - FallbackElapsedTime + i_R4 * StartFeedInterval;
	END_IF;
	
	IF R5Used THEN
		InNextFeedHorizon_R5 := StartFeedInterval - FallbackElapsedTime + i_R5 * StartFeedInterval;
	END_IF;
	
	IF R6Used THEN
		InNextFeedHorizon_R6 := StartFeedInterval - FallbackElapsedTime + i_R6 * StartFeedInterval;
	END_IF;
END_IF;

//Verify Calculation
CalcDone := Valid AND (InNextFeedHorizon_R1 <> 0 OR InNextFeedHorizon_R2 <> 0 OR
						InNextFeedHorizon_R3 <> 0 OR InNextFeedHorizon_R4 <> 0 OR
						InNextFeedHorizon_R5 <> 0 OR InNextFeedHorizon_R6 <> 0);

//Results
IF InNextFeedHorizon_R1 > 0 THEN
    NextFeedHorizon_R1 := InNextFeedHorizon_R1;
ELSE
    NextFeedHorizon_R1 := 0;
END_IF;

IF InNextFeedHorizon_R2 > 0 THEN
    NextFeedHorizon_R2 := InNextFeedHorizon_R2;
ELSE
    NextFeedHorizon_R2 := 0;
END_IF;

IF InNextFeedHorizon_R3 > 0 THEN
    NextFeedHorizon_R3 := InNextFeedHorizon_R3;
ELSE
    NextFeedHorizon_R3 := 0;
END_IF;

IF InNextFeedHorizon_R4 > 0 THEN
    NextFeedHorizon_R4 := InNextFeedHorizon_R4;
ELSE
    NextFeedHorizon_R4 := 0;
END_IF;

IF InNextFeedHorizon_R5 > 0 THEN
    NextFeedHorizon_R5 := InNextFeedHorizon_R5;
ELSE
    NextFeedHorizon_R5 := 0;
END_IF;

IF InNextFeedHorizon_R6 > 0 THEN
    NextFeedHorizon_R6 := InNextFeedHorizon_R6;
ELSE
    NextFeedHorizon_R6 := 0;
END_IF;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>