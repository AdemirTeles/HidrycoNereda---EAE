        <With Var="i_R4" />
        <With Var="i_R5" />
        <With Var="i_R6" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="C779B02CD721992D" Name="StartFeedInterval" Type="REAL" />
      <VarDeclaration ID="8B12C2002DA4975C" Name="FallbackElapsedTime" Type="REAL" />
      <VarDeclaration ID="7054111BE4D91EB7" Name="PositionR1" Type="INT" />
      <VarDeclaration ID="0B20A0DA317A9F10" Name="PositionR2" Type="INT" />
      <VarDeclaration ID="FF3C39896E6706FC" Name="PositionR3" Type="INT" />
      <VarDeclaration ID="3ED1AC1F50C1DDC5" Name="PositionR4" Type="INT" />
      <VarDeclaration ID="0537CBAEFE3E33F0" Name="PositionR5" Type="INT" />
