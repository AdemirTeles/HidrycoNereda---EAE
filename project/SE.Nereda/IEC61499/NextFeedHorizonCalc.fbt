        <With Var="PositionR5" />
        <With Var="PositionR6" />
        <With Var="ExistReactor1" />
        <With Var="ExistReactor2" />
        <With Var="ExistReactor3" />
        <With Var="ExistReactor4" />
        <With Var="ExistReactor5" />
        <With Var="ExistReactor6" />
        <With Var="AvailableReactor1" />
        <With Var="AvailableReactor2" />
        <With Var="AvailableReactor3" />
        <With Var="AvailableReactor4" />
        <With Var="AvailableReactor5" />
        <With Var="AvailableReactor6" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="EFD8CD031C6B32D9" Name="NEXT_FEED_H">
        <With Var="NextFeedHorizon" />
        <With Var="Valid" />
        <With Var="NextFeedHorizon_R2" />
        <With Var="NextFeedHorizon_R3" />
        <With Var="NextFeedHorizon_R4" />
        <With Var="NextFeedHorizon_R5" />
        <With Var="NextFeedHorizon_R1" />
        <With Var="LowestTimeSinceStartFeed" />
        <With Var="NextFeedHorizon_R6" />
        <With Var="CalcDone" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="C779B02CD721992D" Name="FeedInterval" Type="REAL" />
      <VarDeclaration ID="02EE639E4A36A4E1" Name="TimeSinceStartFeedR1" Type="REAL" />
      <VarDeclaration ID="F586E04D8C89DEA6" Name="TimeSinceStartFeedR2" Type="REAL" />
      <VarDeclaration ID="AD55B2D2D554E6EC" Name="TimeSinceStartFeedR3" Type="REAL" />
      <VarDeclaration ID="3EBC8C13DE9A2146" Name="TimeSinceStartFeedR4" Type="REAL" />
      <VarDeclaration ID="C0E7B53A76514D03" Name="TimeSinceStartFeedR5" Type="REAL" />
      <VarDeclaration ID="DA82A5DC8F464219" Name="TimeSinceStartFeedR6" Type="REAL" />
