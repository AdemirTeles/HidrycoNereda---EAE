<FBType GUID="236cfdb9-de38-4d5e-b5fd-d76ee5f6bbcf" Comment="CAT Function Block Type" Name="InfluentActuators" Format="2.0" Namespace="SE.Nereda">
  <Attribute Name="HMI.Alias" Value="" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.3" Author=" " Date="30/10/2026" Remarks="0.3: carga no gerador: REQ_GERADOR para Mixer01/02 (R4005A/B). 0.2: chave LL do buffer de entrada (IlckLSLL_*, depois do IlckLL_*) desliga as bombas FeedReactorPump01/02/03; falha do radar (IlckRadar_*) para os misturadores Mixer01/02. 0.1: bombas FeedReactorPump01/02/03 intertravadas pelo alarme LL do buffer de entrada (IlckLL_*)." />
  <InterfaceList>
    <EventInputs>
      <Event ID="CFECDF36D4CD32D8" Name="INIT" />
      <Event ID="5ABFC6918DABFB06" Name="REQ_LEVEL_ALM" Comment="Alarmes de nivel do buffer de entrada (LL)">
        <With Var="LevelLoLo" />
        <With Var="LevelChFail" />
      </Event>
      <Event ID="DB6CF389044532A0" Name="REQ_LSLL" Comment="Chave LL do buffer de entrada">
        <With Var="LevelSwitchLL" />
      </Event>
      <Event ID="CBD8AAE3503334DB" Name="REQ_GERADOR" Comment="Planta nos geradores e liberacao de R4005A/B (Subestacao)">
        <With Var="geradorHabilitaR4005A" />
        <With Var="geradorHabilitaR4005B" />
        <With Var="stsGerador" />
      </Event>
    </EventInputs>
