      <VarDeclaration ID="B04CBEA969302BFE" Name="PlanTgt2" Type="INT" InitialValue="0" Comment="Alvo do B2 no inicio da sequencia" />
      <VarDeclaration ID="7408AB03C953DB2E" Name="PlanTgt3" Type="INT" InitialValue="0" Comment="Alvo do B3 no inicio da sequencia" />
      <VarDeclaration ID="3540B940885E4BD1" Name="Req2H1" Type="BOOL" />
      <VarDeclaration ID="FB12A387B637AC9C" Name="Req2H2" Type="BOOL" />
      <VarDeclaration ID="97A797DBA54E2A6E" Name="Req3H1" Type="BOOL" />
      <VarDeclaration ID="A7119B87EB146842" Name="Req3H2" Type="BOOL" />
      <VarDeclaration ID="05DBE8F5E8B246BA" Name="V1Ok" Type="BOOL" />
      <VarDeclaration ID="5588589114523DAC" Name="V2Ok" Type="BOOL" />
      <VarDeclaration ID="D63F9F07D1BAB2DF" Name="V3Ok" Type="BOOL" />
      <VarDeclaration ID="C6E99534DB0CCB5E" Name="VB2Ok" Type="BOOL" />
      <VarDeclaration ID="CFE96275DC5D5A7C" Name="VB3Ok" Type="BOOL" />
      <VarDeclaration ID="1DDB0C5B25AB547D" Name="RouteOk" Type="BOOL" />
      <VarDeclaration ID="920A5E1191523E3D" Name="NeedV1" Type="BOOL" />
      <VarDeclaration ID="2FE23F60F14FC2C2" Name="NeedV2" Type="BOOL" />
      <VarDeclaration ID="A3AC191935C51F21" Name="NeedV3" Type="BOOL" />
      <VarDeclaration ID="E8BDB9730BC88604" Name="Stuck1" Type="BOOL" Comment="Valvula sem Ready e nao fechada" />
      <VarDeclaration ID="466FD48F76130716" Name="Stuck2" Type="BOOL" />
      <VarDeclaration ID="CE4513143F0141E2" Name="Stuck3" Type="BOOL" />
      <VarDeclaration ID="70632BCD2F53B5C8" Name="B2Done" Type="BOOL" />
      <VarDeclaration ID="0DBC216F608B59A9" Name="B3Done" Type="BOOL" />
