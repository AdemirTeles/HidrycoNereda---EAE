    <Algorithm ID="1f5dcb55-3f2a-41ae-abe4-bf0ee0a75cb9" Name="OpenScndBLVlv_H1">
      <ST><![CDATA[;
CmdValve1 := TRUE;]]></ST>
    </Algorithm>
    <Algorithm ID="23d0d32d-89f5-487e-be14-a11a3c175d96" Name="StartScndBL_H1">
      <ST><![CDATA[;
CmdBlower2 := TRUE;
SpeedSp_BL2 := SpeedSp_H1;]]></ST>
    </Algorithm>
    <Algorithm ID="1c03192b-4bb4-4f07-b28f-793ed4c5317e" Name="OpenScndBLVlv_H2">
      <ST><![CDATA[;
CmdValve3 := TRUE;]]></ST>
    </Algorithm>
    <Algorithm ID="327c4661-6697-40af-bbe1-d2d5a24b9191" Name="StartScndBL_H2">
      <ST><![CDATA[;
CmdBlower3 := TRUE;
SpeedSp_BL3 := SpeedSp_H2;]]></ST>
    </Algorithm>
    <Algorithm ID="3506e506-0a3f-4798-aa75-0e1c442db936" Name="StartStdbyBLVlv_H1">
      <ST><![CDATA[;
CmdValve1 := TRUE;
CmdValve2 := TRUE;]]></ST>
    </Algorithm>
    <Algorithm ID="a88de788-5503-412d-9712-bcb1fe65a88a" Name="StartStdbyBL_H1">
      <ST><![CDATA[;
CmdBlower3 := TRUE;
SpeedSp_BL3 := SpeedSp_H1;]]></ST>
    </Algorithm>
    <Algorithm ID="db01c134-ffdd-406b-91ec-0f2ea26b5364" Name="StartStdbyBLVlv_H2">
      <ST><![CDATA[;
CmdValve3 := TRUE;
CmdValve2 := TRUE;]]></ST>
    </Algorithm>
    <Algorithm ID="e5fc5b03-2e6a-473f-8739-26217298466c" Name="StartStdbyBL_H2">
      <ST><![CDATA[;
CmdBlower2 := TRUE;
SpeedSp_BL2 := SpeedSp_H2;]]></ST>
    </Algorithm>
    <Algorithm ID="6460d2a9-5d74-4c92-8bcb-519c1f56085f" Name="StopBlowers">
      <ST><![CDATA[;
IF NOT Header1 AND NOT Header2 THEN
	CmdBlower2 := FALSE;
	CmdBlower3 := FALSE;
END_IF;

IF Header1 AND NOT StartScndBL_H1 AND NOT StartStdby_H2 THEN
	CmdBlower2 := FALSE;
END_IF;

IF Header2 AND NOT StartScndBL_H2 AND NOT StartStdby_H1 THEN
	CmdBlower3 := FALSE;
END_IF;

IF Header1 AND StartScndBL_H1 AND NOT StartStdby_H1 AND NOT StartStdby_H2 THEN
	CmdBlower3 := FALSE;
END_IF;

IF Header2 AND StartScndBL_H2 AND NOT StartStdby_H1 AND NOT StartStdby_H2 THEN
	CmdBlower2 := FALSE;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm ID="bbfa82a1-445c-473c-a6b4-e6a3b4b46ae9" Name="CloseValves">
      <ST><![CDATA[;
IF NOT Header1 AND NOT Header2 THEN
	CmdValve1 := FALSE;
	CmdValve2 := FALSE;
	CmdValve3 := FALSE;
END_IF;

IF Header1 AND NOT StartScndBL_H1 AND NOT StartStdby_H2 THEN
	CmdValve1 := FALSE;
	CmdValve2 := FALSE;
END_IF;

IF Header2 AND NOT StartScndBL_H2 AND NOT StartStdby_H1 THEN
	CmdValve2 := FALSE;
	CmdValve3 := FALSE;
END_IF;

IF Header1 AND StartScndBL_H1 AND NOT StartStdby_H1 AND NOT StartStdby_H2 THEN
	CmdValve2 := FALSE;
END_IF;

IF Header2 AND StartScndBL_H2 AND NOT StartStdby_H1 AND NOT StartStdby_H2 THEN
	CmdValve2 := FALSE;
END_IF;]]></ST>
    </Algorithm>
