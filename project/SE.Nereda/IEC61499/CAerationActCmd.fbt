      <VarDeclaration ID="9DF319789A1E2E54" Name="SpdChanged" Type="BOOL" InitialValue="FALSE" />
      <VarDeclaration ID="D572692077849F39" Name="Last_CmdBlower2" Type="BOOL" />
      <VarDeclaration ID="C3AC215FFACA9972" Name="Last_CmdBlower3" Type="BOOL" />
      <VarDeclaration ID="5FAEBAB6B9A908D9" Name="Last_CmdValve1" Type="BOOL" />
      <VarDeclaration ID="9D5B91AE7869A334" Name="Last_CmdValve2" Type="BOOL" />
      <VarDeclaration ID="8EBEB982941CA8FD" Name="Last_CmdValve3" Type="BOOL" />
      <VarDeclaration ID="C341D2869513D892" Name="Last_CmdBlowerValve2" Type="BOOL" />
      <VarDeclaration ID="4426FDE4DBD22E7F" Name="Last_CmdBlowerValve3" Type="BOOL" />
      <VarDeclaration ID="EEAA97CF92C8ACF9" Name="Last_SpeedSp_BL2" Type="REAL" />
      <VarDeclaration ID="F66F3BD6390D53B4" Name="Last_SpeedSp_BL3" Type="REAL" />
      <VarDeclaration ID="781EA3B86840E3A9" Name="RunV1" Type="BOOL" Comment="V1 no caminho de soprador rodando" />
      <VarDeclaration ID="CE67248BEE58D1F2" Name="RunV2" Type="BOOL" />
      <VarDeclaration ID="9E525BFACA1247E6" Name="RunV3" Type="BOOL" />
      <VarDeclaration ID="709F3C105AFEDD7D" Name="XferActive" Type="BOOL" InitialValue="FALSE" Comment="Transferencia de soprador rodando em andamento (make-before-break)" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="4676.108" y="2354.555" />
      <ECState Name="SEQ" Comment="Calcula alvo e executa um passo do sequenciador" x="4676.108" y="3606.557">
        <ECAction Algorithm="algSequence" />
      </ECState>
      <ECState Name="SEND_SPD" Comment="Setpoint de velocidade antes do comando" x="2840.873" y="4754.509">
        <ECAction Algorithm="algLatchSpd" Output="CNF_SPEED_SP" />
      </ECState>
      <ECState Name="SEND_CMD" Comment="Comandos de valvulas e sopradores" x="6400" y="4754.509">
        <ECAction Algorithm="algLatchCmd" Output="CNF_BLR_VLV_CMD" />
      </ECState>
      <ECTransition Source="START" Destination="SEQ" Condition="CMD_FB_RDY" x="4676.108" y="2980" />
      <ECTransition Source="SEQ" Destination="SEND_SPD" Condition="SpdChanged" x="3700" y="4180" />
      <ECTransition Source="SEQ" Destination="SEND_CMD" Condition="NOT SpdChanged AND CmdChanged" x="5600" y="4180" />
      <ECTransition Source="SEQ" Destination="START" Condition="NOT SpdChanged AND NOT CmdChanged" x="4400" y="2980" />
      <ECTransition Source="SEND_SPD" Destination="SEND_CMD" Condition="CmdChanged" x="4620" y="4900" />
      <ECTransition Source="SEND_SPD" Destination="START" Condition="NOT CmdChanged" x="3400" y="3300" />
      <ECTransition Source="SEND_CMD" Destination="START" Condition="1" x="6000" y="3300" />
    </ECC>
    <Algorithm ID="1f5dcb55-3f2a-41ae-abe4-bf0ee0a75cb9" Name="algSequence">
      <ST><![CDATA[;
(* ========================================================================== *)
(* CAerationActCmd - Rev2  |  Sequenciador de valvulas e sopradores B2/B3      *)
(*                                                                            *)
(*        H1 (R1)                                  H2 (R2)                    *)
(*          ^                                        ^                        *)
(*         [V1]                                     [V3]                      *)
(*          |                                        |                        *)
(*  B2-[VB2]-> no A -------------[V2]------------- no B <-[VB3]-B3            *)
(*                                                                            *)
(*  B2->H1 (StartScndBL_H1): V1 + VB2        B3->H2 (StartScndBL_H2): V3 + VB3 *)
(*  B3->H1 (StartStdby_H1) : V1 + V2 + VB3   B2->H2 (StartStdby_H2) : V2+V3+VB2*)
(*                                                                            *)
(*  Regras de seguranca (invariantes):                                        *)
(*   I1 V1+V2+V3 abertas juntas (H1 interligado com H2) SO durante a         *)
(*      transferencia de um soprador rodando, entre abrir a rota nova e      *)
(*      fechar a antiga. Fora disso, nunca.                                  *)
(*   I2 Soprador so parte com caminho completo confirmado por feedback       *)
(*   I3 Nenhuma valvula do caminho de um soprador rodando fecha antes de o   *)
(*      novo caminho estar confirmado aberto (nunca dead-head)               *)
(*   I4 Partida: valvulas de rota -> valvula do soprador -> soprador         *)
(*      Parada : soprador -> valvula do soprador -> valvulas de rota         *)
(*   I5 Troca de reator com soprador rodando: ABRE a rota nova, confirma,    *)
(*      depois FECHA a antiga. O soprador nao e desligado.                   *)
(*                                                                            *)
(*  Dest = rota em operacao (0=parado, 1=H1, 2=H2)                            *)
(*  Tgt  = rota desejada pelo CAerationLogicBasic2                            *)
(*  SeqStep: 0 regime | 10 parar | 20 fechar VBx | 30 pre-fechar rota         *)
(*           40 abrir rota nova (make) | 50 fechar rota antiga (break)        *)
(*           60 abrir VBx | 70 partir                                         *)
(* ========================================================================== *)

(* ---------- 0. Primeira execucao: assume o estado real da planta ---------- *)
IF NOT Initialized THEN
    (* Estado herdado com V1+V2+V3 abertas (H1 interligado com H2): fecha V2 *)
    (* ja. Seguro: com V1 e V3 abertas cada no mantem a propria saida.       *)
    InitV2Open := Valve2FbOpened AND NOT (Valve1FbOpened AND Valve3FbOpened);

    Dest2 := 0;
    IF Blower2FbRunning AND ValveBlower2FbOpened THEN
        IF Valve1FbOpened AND NOT (InitV2Open AND Valve3FbOpened) THEN
            Dest2 := 1;
        ELSIF InitV2Open AND Valve3FbOpened AND NOT Valve1FbOpened THEN
            Dest2 := 2;
        END_IF;
    END_IF;

    Dest3 := 0;
    IF Blower3FbRunning AND ValveBlower3FbOpened THEN
        IF Valve3FbOpened AND NOT (InitV2Open AND Valve1FbOpened) THEN
            Dest3 := 2;
        ELSIF InitV2Open AND Valve1FbOpened AND NOT Valve3FbOpened THEN
            Dest3 := 1;
        END_IF;
    END_IF;

    CmdBlower2 := Dest2 <> 0;
    CmdBlower3 := Dest3 <> 0;
    CmdBlowerValve2 := ValveBlower2FbOpened;
    CmdBlowerValve3 := ValveBlower3FbOpened;
    CmdValve1 := Valve1FbOpened;
    CmdValve2 := InitV2Open;
    CmdValve3 := Valve3FbOpened;

    SeqStep := 0;
    Reconcile := TRUE;          (* forca um ciclo completo de alinhamento *)
    Initialized := TRUE;
END_IF;

(* ---------- 1. Rota desejada por soprador ---------- *)
Req2H1 := Header1 AND StartScndBL_H1;
Req2H2 := Header2 AND StartStdby_H2;
Req3H2 := Header2 AND StartScndBL_H2;
Req3H1 := Header1 AND StartStdby_H1;

IF Req2H1 AND Req2H2 THEN
    Tgt2 := Dest2;              (* pedido duplo invalido: mantem o atual *)
ELSIF Req2H1 THEN
    Tgt2 := 1;
ELSIF Req2H2 THEN
    Tgt2 := 2;
ELSE
    Tgt2 := 0;
END_IF;

IF Req3H1 AND Req3H2 THEN
    Tgt3 := Dest3;
ELSIF Req3H2 THEN
    Tgt3 := 2;
ELSIF Req3H1 THEN
    Tgt3 := 1;
ELSE
    Tgt3 := 0;
END_IF;


(* ---------- 2. Viabilidade da rota ---------- *)
(* Valvula utilizavel para abrir: pronta ou ja aberta *)
V1Ok  := Valve1FbReady OR Valve1FbOpened;
V2Ok  := Valve2FbReady OR Valve2FbOpened;
V3Ok  := Valve3FbReady OR Valve3FbOpened;
VB2Ok := ValveBlower2FbReady OR ValveBlower2FbOpened;
VB3Ok := ValveBlower3FbReady OR ValveBlower3FbOpened;

IF (Tgt2 <> 0) AND (Tgt2 <> Dest2) THEN
    (* rota nova: todas as valvulas do caminho precisam poder abrir.      *)
    (* Se nao puder e o soprador ja estiver rodando, fica na rota atual   *)
    (* (nao desliga); a checagem abaixo valida a rota atual.              *)
    IF Tgt2 = 1 THEN
        RouteOk := V1Ok AND VB2Ok;
    ELSE
        RouteOk := V2Ok AND V3Ok AND VB2Ok;
    END_IF;
    IF NOT RouteOk THEN Tgt2 := Dest2; END_IF;
END_IF;
IF (Tgt2 <> 0) AND (Tgt2 = Dest2) THEN
    (* em operacao: se alguma valvula do caminho fechou, para o soprador (I3) *)
    IF Tgt2 = 1 THEN
        RouteOk := NOT Valve1FbClosed AND NOT ValveBlower2FbClosed;
    ELSE
        RouteOk := NOT Valve2FbClosed AND NOT Valve3FbClosed AND NOT ValveBlower2FbClosed;
    END_IF;
    IF NOT RouteOk THEN Tgt2 := 0; END_IF;
END_IF;

IF (Tgt3 <> 0) AND (Tgt3 <> Dest3) THEN
    IF Tgt3 = 2 THEN
        RouteOk := V3Ok AND VB3Ok;
    ELSE
        RouteOk := V1Ok AND V2Ok AND VB3Ok;
    END_IF;
    IF NOT RouteOk THEN Tgt3 := Dest3; END_IF;
END_IF;
IF (Tgt3 <> 0) AND (Tgt3 = Dest3) THEN
    IF Tgt3 = 2 THEN
        RouteOk := NOT Valve3FbClosed AND NOT ValveBlower3FbClosed;
    ELSE
        RouteOk := NOT Valve1FbClosed AND NOT Valve2FbClosed AND NOT ValveBlower3FbClosed;
    END_IF;
    IF NOT RouteOk THEN Tgt3 := 0; END_IF;
END_IF;

(* B2->H2 e B3->H1 juntos cruzam pela V2 e exigiriam V1+V2+V3 abertas  *)
(* permanentemente: proibido. Mantem o que ja estiver rodando na rota.  *)
IF (Tgt2 = 2) AND (Tgt3 = 1) THEN
    IF Dest3 = 1 THEN
        Tgt2 := Dest2;
        IF Tgt2 = 2 THEN Tgt2 := 0; END_IF;
    ELSE
        Tgt3 := Dest3;
        IF Tgt3 = 1 THEN Tgt3 := 0; END_IF;
    END_IF;
END_IF;

(* Valvulas de rota necessarias para a configuracao alvo *)
NeedV1 := (Tgt2 = 1) OR (Tgt3 = 1);
NeedV2 := (Tgt3 = 1) OR (Tgt2 = 2);
NeedV3 := (Tgt3 = 2) OR (Tgt2 = 2);

(* I1 considerando valvula travada aberta (sem Ready e sem Closed) *)
Stuck1 := NOT Valve1FbReady AND NOT Valve1FbClosed;
Stuck2 := NOT Valve2FbReady AND NOT Valve2FbClosed;
Stuck3 := NOT Valve3FbReady AND NOT Valve3FbClosed;

IF (NeedV1 OR Stuck1) AND (NeedV2 OR Stuck2) AND (NeedV3 OR Stuck3) THEN
    IF (Tgt2 <> Dest2) AND (Tgt2 <> 0) THEN Tgt2 := Dest2; END_IF;
    IF (Tgt3 <> Dest3) AND (Tgt3 <> 0) THEN Tgt3 := Dest3; END_IF;
    NeedV1 := (Tgt2 = 1) OR (Tgt3 = 1);
    NeedV2 := (Tgt3 = 1) OR (Tgt2 = 2);
    NeedV3 := (Tgt3 = 2) OR (Tgt2 = 2);
END_IF;

(* ---------- 3. Sequenciador ---------- *)
(* Valvulas de rota usadas pelos sopradores em operacao (Dest) *)
RunV1 := (Dest2 = 1) OR (Dest3 = 1);
RunV2 := (Dest3 = 1) OR (Dest2 = 2);
RunV3 := (Dest3 = 2) OR (Dest2 = 2);

IF SeqStep = 0 THEN
    IF Reconcile OR (Tgt2 <> Dest2) OR (Tgt3 <> Dest3) THEN
        Reconcile := FALSE;
        PlanTgt2 := Tgt2;
        PlanTgt3 := Tgt3;
        SeqStep := 10;
    END_IF;
ELSIF (Tgt2 <> PlanTgt2) OR (Tgt3 <> PlanTgt3) THEN
    (* alvo mudou durante a sequencia: replaneja (seguro em qualquer passo) *)
    PlanTgt2 := Tgt2;
    PlanTgt3 := Tgt3;
    SeqStep := 10;
END_IF;

(* Passo 10 - parar SO os sopradores sem destino. Soprador rodando que   *)
(* muda de reator NAO para: e transferido (passos 40/50).                *)
IF SeqStep = 10 THEN
    IF (Tgt2 = 0) AND (Dest2 <> 0) THEN CmdBlower2 := FALSE; Dest2 := 0; END_IF;
    IF (Tgt3 = 0) AND (Dest3 <> 0) THEN CmdBlower3 := FALSE; Dest3 := 0; END_IF;

    (* Dest <> 0 = rodando (mantido ou em transferencia) *)
    B2Done := (Dest2 <> 0) OR (Blower2FbStopped AND NOT Blower2FbRunning);
    B3Done := (Dest3 <> 0) OR (Blower3FbStopped AND NOT Blower3FbRunning);

    IF B2Done AND B3Done THEN SeqStep := 20; END_IF;
END_IF;

(* Passo 20 - fechar valvula dos sopradores parados *)
IF SeqStep = 20 THEN
    IF Dest2 = 0 THEN CmdBlowerValve2 := FALSE; END_IF;
    IF Dest3 = 0 THEN CmdBlowerValve3 := FALSE; END_IF;

    B2Done := (Dest2 <> 0) OR ValveBlower2FbClosed OR NOT ValveBlower2FbReady;
    B3Done := (Dest3 <> 0) OR ValveBlower3FbClosed OR NOT ValveBlower3FbReady;

    IF B2Done AND B3Done THEN SeqStep := 30; END_IF;
END_IF;

(* Passo 30 - pre-fechamento: fecha valvulas fora do alvo que NAO estao   *)
(* no caminho de nenhum soprador rodando (evita interligar sem motivo)   *)
IF SeqStep = 30 THEN
    IF NOT NeedV1 AND NOT RunV1 THEN CmdValve1 := FALSE; END_IF;
    IF NOT NeedV2 AND NOT RunV2 THEN CmdValve2 := FALSE; END_IF;
    IF NOT NeedV3 AND NOT RunV3 THEN CmdValve3 := FALSE; END_IF;

    IF (NeedV1 OR RunV1 OR Valve1FbClosed OR NOT Valve1FbReady) AND
       (NeedV2 OR RunV2 OR Valve2FbClosed OR NOT Valve2FbReady) AND
       (NeedV3 OR RunV3 OR Valve3FbClosed OR NOT Valve3FbReady) THEN
        SeqStep := 40;
    END_IF;
END_IF;

(* Passo 40 - ABRE a rota alvo (make). Nada fecha aqui. V1+V2+V3 juntas  *)
(* so sao aceitas se houver soprador rodando em transferencia.           *)
IF SeqStep = 40 THEN
    XferActive := ((Dest2 <> 0) AND (Tgt2 <> 0) AND (Tgt2 <> Dest2)) OR
                  ((Dest3 <> 0) AND (Tgt3 <> 0) AND (Tgt3 <> Dest3));

    IF XferActive OR NOT ((NeedV1 OR RunV1) AND (NeedV2 OR RunV2) AND (NeedV3 OR RunV3)) THEN
        IF NeedV1 THEN CmdValve1 := TRUE; END_IF;
        IF NeedV2 THEN CmdValve2 := TRUE; END_IF;
        IF NeedV3 THEN CmdValve3 := TRUE; END_IF;

        IF (NOT NeedV1 OR Valve1FbOpened) AND
           (NOT NeedV2 OR Valve2FbOpened) AND
           (NOT NeedV3 OR Valve3FbOpened) THEN
            (* caminho novo confirmado: soprador em transferencia passa    *)
            (* a pertencer ao novo reator (setpoint de velocidade tambem)  *)
            IF (Dest2 <> 0) AND (Tgt2 <> 0) THEN Dest2 := Tgt2; END_IF;
            IF (Dest3 <> 0) AND (Tgt3 <> 0) THEN Dest3 := Tgt3; END_IF;
            SeqStep := 50;
        END_IF;
    END_IF;
END_IF;

(* Passo 50 - FECHA o que sobrou da rota antiga (break). Todo soprador   *)
(* rodando ja tem o caminho novo confirmado aberto: sem dead-head.       *)
IF SeqStep = 50 THEN
    IF NOT NeedV1 THEN CmdValve1 := FALSE; END_IF;
    IF NOT NeedV2 THEN CmdValve2 := FALSE; END_IF;
    IF NOT NeedV3 THEN CmdValve3 := FALSE; END_IF;

    IF (NeedV1 OR Valve1FbClosed OR NOT Valve1FbReady) AND
       (NeedV2 OR Valve2FbClosed OR NOT Valve2FbReady) AND
       (NeedV3 OR Valve3FbClosed OR NOT Valve3FbReady) THEN
        XferActive := FALSE;
        SeqStep := 60;
    END_IF;
END_IF;

(* Passo 60 - abrir valvula dos sopradores que vao partir *)
IF SeqStep = 60 THEN
    IF Tgt2 <> 0 THEN CmdBlowerValve2 := TRUE; END_IF;
    IF Tgt3 <> 0 THEN CmdBlowerValve3 := TRUE; END_IF;

    IF ((Tgt2 = 0) OR ValveBlower2FbOpened) AND ((Tgt3 = 0) OR ValveBlower3FbOpened) THEN
        SeqStep := 70;
    END_IF;
END_IF;

(* Passo 70 - partir sopradores com caminho completo *)
IF SeqStep = 70 THEN
    IF (Tgt2 <> 0) AND (Dest2 = 0) THEN
        Dest2 := Tgt2;
        CmdBlower2 := TRUE;
    END_IF;
    IF (Tgt3 <> 0) AND (Dest3 = 0) THEN
        Dest3 := Tgt3;
        CmdBlower3 := TRUE;
    END_IF;
    SeqStep := 0;
END_IF;

(* ---------- 4. Setpoint de velocidade (acompanha o header em tempo real) ---------- *)
IF Dest2 = 1 THEN
    SpeedSp_BL2 := SpeedSp_H1;
ELSIF Dest2 = 2 THEN
    SpeedSp_BL2 := SpeedSp_H2;
ELSE
    SpeedSp_BL2 := 0.0;
END_IF;

IF Dest3 = 2 THEN
    SpeedSp_BL3 := SpeedSp_H2;
ELSIF Dest3 = 1 THEN
    SpeedSp_BL3 := SpeedSp_H1;
ELSE
    SpeedSp_BL3 := 0.0;
END_IF;

(* ---------- 5. Deteccao de mudanca para disparo dos eventos ---------- *)
CmdChanged := FirstSend OR
              (Last_CmdBlower2 <> CmdBlower2) OR (Last_CmdBlower3 <> CmdBlower3) OR
              (Last_CmdValve1 <> CmdValve1) OR (Last_CmdValve2 <> CmdValve2) OR
              (Last_CmdValve3 <> CmdValve3) OR
              (Last_CmdBlowerValve2 <> CmdBlowerValve2) OR
              (Last_CmdBlowerValve3 <> CmdBlowerValve3);

SpdChanged := FirstSend OR
              (Last_SpeedSp_BL2 <> SpeedSp_BL2) OR (Last_SpeedSp_BL3 <> SpeedSp_BL3);]]></ST>
    </Algorithm>
    <Algorithm ID="23d0d32d-89f5-487e-be14-a11a3c175d96" Name="algLatchSpd">
      <ST><![CDATA[;
Last_SpeedSp_BL2 := SpeedSp_BL2;
Last_SpeedSp_BL3 := SpeedSp_BL3;]]></ST>
    </Algorithm>
    <Algorithm ID="1c03192b-4bb4-4f07-b28f-793ed4c5317e" Name="algLatchCmd">
      <ST><![CDATA[;
Last_CmdBlower2 := CmdBlower2;
Last_CmdBlower3 := CmdBlower3;
Last_CmdValve1 := CmdValve1;
Last_CmdValve2 := CmdValve2;
Last_CmdValve3 := CmdValve3;
Last_CmdBlowerValve2 := CmdBlowerValve2;
Last_CmdBlowerValve3 := CmdBlowerValve3;
FirstSend := FALSE;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>