<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="489b4789-59a8-533a-bafa-c0589990686e" Name="CargaGerador" Comment="Carga alimentada pelos geradores: raio na IHM e bloqueio" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="04/11/2026" Remarks="1.0: raio do gerador (0 nao conectado, 1 nao liberada, 2 liberada, 3 liberada e funcionando com a planta nos geradores) e bloqueio (conectada, planta nos geradores e nao liberada na Subestacao)." />
  <InterfaceList>
    <EventInputs>
      <Event ID="CBDA4E7ACB706297" Name="REQ" Comment="Atualizacao">
        <With Var="geradorConectado" />
        <With Var="geradorHabilita" />
        <With Var="stsGerador" />
        <With Var="stsLigado" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="CA6A15984D5E93C2" Name="CNF" Comment="Raio e bloqueio">
        <With Var="stsAnimacaoGerador" />
        <With Var="stsBloqueio" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="9088724ABC940154" Name="geradorConectado" Type="BOOL" Comment="TRUE = o gerador pode alimentar esta carga" />
      <VarDeclaration ID="5B562DCC53E7C7E0" Name="geradorHabilita" Type="BOOL" Comment="Carga liberada para operar com a planta nos geradores (Subestacao)" />
      <VarDeclaration ID="71FF6E86C822A1E4" Name="stsGerador" Type="BOOL" Comment="TRUE = planta alimentada pelos geradores" />
      <VarDeclaration ID="629B422BA823BB18" Name="stsLigado" Type="BOOL" Comment="Carga em funcionamento" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="7C61F11FF182428D" Name="stsAnimacaoGerador" Type="INT" Comment="0 nao conectado, 1 nao liberada, 2 liberada, 3 liberada e funcionando nos geradores" />
      <VarDeclaration ID="9767CD73572D0AF4" Name="stsBloqueio" Type="BOOL" Comment="Planta nos geradores e carga conectada nao liberada" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="8b0970ec-17e9-5468-bcb3-37ca8db1aba7">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="Calcula" />
    <ECC>
      <ECState Name="START" Comment="Estado inicial" x="550" y="430" />
      <ECState Name="CALCULO" Comment="Calcula raio e bloqueio" x="1170" y="730">
        <ECAction Algorithm="Calcula" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="CALCULO" Condition="REQ" x="895" y="505" />
      <ECTransition Source="CALCULO" Destination="START" Condition="1" x="880" y="665" />
    </ECC>
    <Algorithm Name="Calcula" Comment="Raio e bloqueio">
      <ST><![CDATA[
IF NOT geradorConectado THEN
    stsAnimacaoGerador := 0;
ELSIF NOT geradorHabilita THEN
    stsAnimacaoGerador := 1;
ELSIF stsGerador AND stsLigado THEN
    stsAnimacaoGerador := 3;
ELSE
    stsAnimacaoGerador := 2;
END_IF;
stsBloqueio := geradorConectado AND stsGerador AND NOT geradorHabilita;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>