    <Algorithm Name="AutoCase">
      <ST><![CDATA[;
ValOut := NeredaValue;
InValue := NeredaValue;
AutoMode := TRUE;
ManMode := FALSE;
EmerMode := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="ManCase">
      <ST><![CDATA[;

ValOut := ManuelValue;
InValue := ManuelValue;
AutoMode := FALSE;
ManMode := TRUE;
EmerMode := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="EmerMode">
      <ST><![CDATA[;
ValOut := EmergencyValue;
InValue := EmergencyValue;
AutoMode := FALSE;
ManMode := FALSE;
EmerMode := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="NoSelection">
      <ST><![CDATA[;
ValOut := 0;
InValue := 0;
AutoMode := FALSE;
ManMode := FALSE;
EmerMode := FALSE;]]></ST>
