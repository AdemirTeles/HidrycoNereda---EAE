    <Algorithm ID="17b142fa-e92b-4204-ae3d-ff3d8273e521" Name="GSiNstallation">
      <ST><![CDATA[;
RequestFlushing := TRUE;
CmdOpenValve014 := CmdOpenValve014GSInst;
CmdCloseValve014 := CmdCloseValve014GSInst;
ReduceSpeed := ReduceSpeedGSInst;
FlushSelected := 1;]]></ST>
    </Algorithm>
    <Algorithm ID="b5c60971-07fb-472c-98fa-3e458e87ab91" Name="GSs">
