<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="0dea89b7-acc2-4962-889a-3baabf65719a" Name="Motor_VS" Format="2.0" Comment="CAT Function Block Type" Namespace="SE.Nereda">
  <Attribute Name="HMI.Alias" Value="" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.6" Author=" " Date="10/11/2026" Remarks="Hidryco 12/11/2026 (2): falha de comunicacao do ATV por Modbus generico como o Motor_Generico - cfgUsaFalhaComunicacao, symlink AtvComInt (connStatusInt), offline 5 s intertrava (ComIlck) e alarma (AlarmeComunicacao); IHM STS_FALHA_COMUNICACAO/STS_ALM_COMUNICACAO_EST no FB_FWD. Hidryco 12/11/2026: cmdFrequency em 0,1 Hz (OutSpeed x 6, 100 % = 60 Hz) para o LFR 8502 do ATV600 generico; cfgEscalaRetorno (FbSpeedAdapter) e cfgProntoForcado (FieldSignals). 0.6 (Hidryco 10/11/2026): cfgResetSoClique padrao TRUE (nenhum motor Nereda com reset automatico; antes so os Sulzer); Reset_Init DI1_1 = FALSE: sem reset automatico da BaseVs na inicializacao (State.INITO) - reset do equipamento so pelo clique de reset na IHM (IThis.RESET): PartidaReset.REQ_RESET/ResetIn agora vem so do IThis (antes vinha do ResetCmd, que inclui Reset_Init na inicializacao e o INereda); cfgResetSoClique vai para PartidaReset.cfgResetClique e LocalPanel.cfgSemResetAuto (sem o reset automatico do AtvResetError). 0.5 (Hidryco 05/11/2026): ResetCmd -> PartidaReset.REQ_RESET: o reset do EAE tambem reseta o Sulzer (cfgResetNaPartida) com o soprador parado. 0.4 (Hidryco 05/11/2026): intertravamento nao deixa pedindo reset - JanelaIlck (intertravamento + 10 s) -> BaseVs.SemResetConf (alarme de realimentacao sem reset) e PowerFailure.Suppress (falta de potencia na janela); falhas do equipamento continuam pedindo reset. 0.3 (Hidryco 05/11/2026): cfgResetNaPartida - PartidaReset (PartidaComReset + DelayPartida) entre BaseVs.OutFwd e cmdFwd: reset 1 s, pausa 1 s e partida; reset pelo LocalPanel.ResetPartida (symlink ResetError_ATV). Hidryco 04/11/2026: BaseVs agora e MotorVsBaseNer (SE.Nereda), copia do MotorVsBase com FbFail = realimentacao OU falha OU intertravamento. 0.2: carga no gerador (Hidryco): REQ_GERADOR (geradorHabilita, stsGerador) e geradorConectado; com a planta nos geradores e a carga nao liberada na Subestacao o intertravamento GeradorBloqueio (ilckCondItem, depois do SafetySwitchOff; calculado no CargaGerador so com a Subestacao) para o motor; raio na IHM (CargaGeradorRaio, tambem com o FbRunning; STS_ANIMACAO_GERADOR no FB_FWD). 0.1: em Local (LocalPanel.oRemoteSelect = FALSE) a base recebe ExternalControlled = TRUE (LocalMode = NOT oRemoteSelect, pelo CNF_STATUS): sem falha de feedback em Local; o extControlled (symlink DIn sem publicador) ficou sem ligacao." />
  <InterfaceList>
    <EventInputs>
      <Event ID="2DBEE771C3E6546D" Name="REQ_SUPPRESS_ALM" Comment="Request to update the alarm suppress status">
        <With Var="SuppressAlarm" />
      </Event>
      <Event ID="0818F4256712489E" Name="REQ_RESET" Comment="Request to reset the device">
        <With Var="Reset" />
      </Event>
      <Event ID="A9A1C3CD924494DF" Name="REQ_ATV_TYPE">
        <With Var="AtvType" />
      </Event>
      <Event Name="REQ_GERADOR" Comment="Planta nos geradores e liberacao da carga (Subestacao)">
        <With Var="geradorHabilita" />
        <With Var="stsGerador" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="E10EF93D9AEB3CF9" Name="CNF_FB" Comment="Execution of confirmed state">
        <With Var="FbStopped" />
        <With Var="FbForward" />
        <With Var="FbReverse" />
      </Event>
      <Event ID="5A9E481FF1AB435E" Name="CNF_SPEED" Comment="Execution of confirmed state">
        <With Var="FbSpeed" />
      </Event>
      <Event ID="B08F9C4F4A29F4CD" Name="CNF_SP" Comment="Execution of confirmation current setpoint">
        <With Var="CurrentSp" />
      </Event>
      <Event ID="70FFD00EBB9F0909" Name="CNF_READY" Comment="Execution of Ready status">
        <With Var="Ready" />
      </Event>
      <Event ID="F0B88CCAAD94C4E0" Name="CNF_FB_ALM" Comment="Execution of confirmation  Fb alarm">
        <With Var="FbAlarm" />
      </Event>
      <Event ID="B8FBA093B968DB4F" Name="CNF_FAIL" Comment="Execution of confirmation  failure">
        <With Var="FbFailure" />
      </Event>
      <Event ID="9780F7C84A330891" Name="CNF_OPD" Comment="Execution confirmation of operation durations">
        <With Var="TotalOperationDuration" />
        <With Var="CurrentOperationDuration" />
        <With Var="OperationCount" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="9D943327E9BA3A69" Name="SuppressAlarm" Type="BOOL" Comment="1 = Suppress alarm in HMI" />
      <VarDeclaration ID="29B38549D8BB58F5" Name="Reset" Type="BOOL" Comment="1 = Reset device failure" />
      <VarDeclaration ID="C15DED4271ABC4C5" Name="AtvType" Type="STRING" />
      <VarDeclaration ID="6BCF92D2F3567973" Name="cfgResetNaPartida" Type="BOOL" InitialValue="FALSE" Comment="TRUE = reset do equipamento antes de cada partida (Sulzer HST: bit 2 Reset da palavra de comando), 1 s de reset e 1 s de pausa" />
      <VarDeclaration ID="B28D95CCDB629245" Name="cfgEscalaRetorno" Type="REAL" InitialValue="100.0" Comment="Retorno de velocidade bruto (fbSpeedINT): % = bruto / cfgEscalaRetorno (Sulzer 100; ATV600 RFR em 0,1 Hz com 100 % = 60 Hz: 6)" />
      <VarDeclaration ID="82A72FB192516113" Name="cfgProntoForcado" Type="BOOL" InitialValue="FALSE" Comment="TRUE = inversor pronto forcado (ATV por Modbus generico, sem HW CAT)" />
      <VarDeclaration ID="6662AF1CEF423C64" Name="cfgUsaFalhaComunicacao" Type="BOOL" InitialValue="FALSE" Comment="TRUE = supervisiona a comunicacao Modbus do inversor (symlink AtvComInt = connStatusInt, 1 online): sem comunicacao por 5 s intertrava o motor (retira o comando, sem memorizar) e gera alarme, como o Motor_Generico" />
      <VarDeclaration ID="EB8B51A6243EA31A" Name="cfgResetSoClique" Type="BOOL" InitialValue="TRUE" Comment="TRUE (padrao) = reset do equipamento (ResetError_ATV) so pelo clique de reset na IHM, um pulso com o motor parado: sem o reset automatico do AtvResetError (ATV e Sulzer)" />
      <VarDeclaration ID="DCB761C03CD4608B" Name="geradorConectado" Type="BOOL" InitialValue="FALSE" Comment="TRUE = carga da lista de cargas no gerador da Subestacao (raio e bloqueio)" />
      <VarDeclaration ID="675F7F871C14320E" Name="geradorHabilita" Type="BOOL" Comment="Carga liberada para operar com a planta nos geradores" />
      <VarDeclaration ID="9446122E66FA8402" Name="stsGerador" Type="BOOL" Comment="TRUE = planta alimentada pelos geradores" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="2E4659C0F7E5B209" Name="FbStopped" Type="BOOL" Comment="1 = Stopped" />
      <VarDeclaration ID="998617E6584B9D98" Name="FbForward" Type="BOOL" Comment="1 = Running" />
      <VarDeclaration ID="B7F345BDC18C6733" Name="FbReverse" Type="BOOL" Comment="1 = Running" />
      <VarDeclaration ID="AAAC0E160F15BA1E" Name="FbSpeed" Type="VTQREAL" Comment="Value from the hardware module" />
      <VarDeclaration ID="3EF369864DB114AA" Name="CurrentSp" Type="INT" Comment="Current output value considering permissive conditions" />
      <VarDeclaration ID="1023720AA2B2B931" Name="Ready" Type="BOOL" Comment="1 = Device is ready to run" />
      <VarDeclaration ID="5F78B2A26C6EAED5" Name="FbAlarm" Type="BOOL" Comment="1 = Feedback failure alarm is active" />
      <VarDeclaration ID="145FB6EE971172E9" Name="FbFailure" Type="BOOL" Comment="1 = Fail active" />
      <VarDeclaration ID="8CA338EBC9995753" Name="TotalOperationDuration" Type="UDINT" Comment="Total operation duration in minutes" />
      <VarDeclaration ID="A1FF7DB001BF016D" Name="CurrentOperationDuration" Type="UDINT" Comment="Current operational duration in minutes" />
      <VarDeclaration ID="A6872E8F86F7E888" Name="OperationCount" Type="UDINT" Comment="Total operations count" />
    </OutputVars>
    <Sockets>
