    <Algorithm Name="OpenValves011_014">
      <ST><![CDATA[;
CmdValve011 := TRUE;
CmdValve014 := TRUE;

Grafcet := 1;]]></ST>
    </Algorithm>
    <Algorithm Name="StartPump">
      <ST><![CDATA[;
CmdPumpctp002 := TRUE;
SelSpeed := 2; //Max Speed
FbSpeedReduced := FALSE;
Grafcet := 2;]]></ST>
    </Algorithm>
    <Algorithm Name="StopPump">
      <ST><![CDATA[;
CmdPumpctp002 := FALSE;
SelSpeed := 0;//Speed zero

Grafcet := 3;]]></ST>
    </Algorithm>
    <Algorithm Name="CloseValves011_014">
      <ST><![CDATA[;
CmdValve011 := FALSE;
CmdValve014 := FALSE;

Grafcet := 4;]]></ST>
    </Algorithm>
    <Algorithm Name="IdleState">
      <ST><![CDATA[;
Grafcet := 14;
oWasLoLevel := WasLoLevel;
oWasHiLevel := WasHiLevel;]]></ST>
    </Algorithm>
    <Algorithm Name="SpeedCmd" />
    <Algorithm Name="ReduceSpeed">
      <ST><![CDATA[;
SelSpeed := 1; //Reduce Speed]]></ST>
    </Algorithm>
    <Algorithm Name="SpeedMax">
      <ST><![CDATA[;
SelSpeed := 2; //Speed Max]]></ST>
    </Algorithm>
    <Algorithm Name="EffluentStarted">
      <ST><![CDATA[;
FbEfluentStarted := TRUE;
FbSpeedReduced := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="EffluentStopped">
      <ST><![CDATA[;
FbEfluentStarted := FALSE;
FbSpeedReduced := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="FbSpeedMax">
      <ST><![CDATA[;
FbSpeedReduced := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="FbSpeedReduced">
      <ST><![CDATA[;
FbSpeedReduced := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="Valve014">
      <ST><![CDATA[;
CmdValve014 := iCmdValve014;]]></ST>
    </Algorithm>
    <Algorithm Name="Flushing">
      <ST><![CDATA[;
Grafcet := 15;]]></ST>
    </Algorithm>
    <Algorithm ID="f6246158-0604-4601-b861-22397153bc5f" Name="LevelLimit">
      <ST><![CDATA[;
IF LoLevel THEN
	WasLoLevel := TRUE;
	WasHiLevel := FALSE;
END_IF;
IF HiLevel THEN
	WasLoLevel := FALSE;
	WasHiLevel := TRUE;
END_IF;

oWasLoLevel := WasLoLevel;
oWasHiLevel := WasHiLevel;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>