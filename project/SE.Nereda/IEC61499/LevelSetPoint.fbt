      </ECTransition>
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;
IF (LevelPv <= LevelSp - Deviation) THEN
	L1 := TRUE; 
ELSE 
	L1 := FALSE; 
END_IF;]]></ST>
    </Algorithm>
