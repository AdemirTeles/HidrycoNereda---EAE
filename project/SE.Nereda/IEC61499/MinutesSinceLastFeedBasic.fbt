        <Attribute Name="Configuration.Transaction.BezierPoints" Value="699.4131,306.2806,706.6288,381.4395" />
      </ECTransition>
      <ECTransition Source="STARTED" Destination="START" Condition="1" x="2566.849" y="1417.22">
