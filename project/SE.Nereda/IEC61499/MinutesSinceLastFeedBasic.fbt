        <Attribute Name="Configuration.Transaction.BezierPoints" Value="806.5018,357.9438,746.7194,317.868" />
      </ECTransition>
      <ECTransition Source="START" Destination="Reset" Condition="REQ AND AllwaysStarted AND Run AND NOT R_Aborted" x="3014.557" y="540.4571">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="716.9032,142.0288,775.4105,112.3767" />
      </ECTransition>
