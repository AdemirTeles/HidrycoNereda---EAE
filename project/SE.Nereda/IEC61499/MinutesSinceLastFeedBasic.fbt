        <ECAction Algorithm="NoReset" Output="RESET_OPD" />
      </ECState>
      <ECState Name="STARTED" x="2768" y="1898.222">
        <ECAction Algorithm="Start" Output="CNF_PV" />
        <ECAction Output="RESET_OPD" />
      </ECState>
      <ECState Name="StopCounter" x="1542.222" y="1906.666">
        <ECAction Algorithm="Stop" Output="CNF_PV" />
        <ECAction Output="RESET_OPD" />
