      <VarDeclaration ID="F7B2FA90A67B4497" Name="Run" Type="BOOL" />
      <VarDeclaration ID="6E036EF412E3C363" Name="Stopping" Type="BOOL" />
      <VarDeclaration ID="2DC2367CDA2D6F18" Name="State" Type="INT" />
      <VarDeclaration ID="34BF8D198081A1C7" Name="R_Aborted" Type="BOOL" />
    </InputVars>
    <OutputVars>
