      </ECTransition>
    </ECC>
    <Algorithm Name="REQ">
      <ST><![CDATA[;
IF (Starting AND State = 1) OR (Run AND State = 2) OR (Stopping AND State = 3) THEN
	Pv := 1;
ELSE
	Pv := 0;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm ID="4a50b3f4-86a7-40b5-ace5-a45743f35f52" Name="Reset">
      <ST><![CDATA[;
Reset := TRUE;]]></ST>
    </Algorithm>
    <Algorithm ID="93ee0507-e733-417c-9434-15f8b2e67c9e" Name="NoReset">
      <ST><![CDATA[;
Reset := FALSE;]]></ST>
    </Algorithm>
    <Algorithm ID="353d48dd-e375-4ddf-8681-0f376cfc6509" Name="Start">
      <ST><![CDATA[;
Pv := 1;
Reset := FALSE;]]></ST>
    </Algorithm>
    <Algorithm ID="09ac1c23-b083-4c96-872d-cc3d59b772ac" Name="Stop">
      <ST><![CDATA[;
Pv := 0;
Reset := TRUE;]]></ST>
    </Algorithm>
