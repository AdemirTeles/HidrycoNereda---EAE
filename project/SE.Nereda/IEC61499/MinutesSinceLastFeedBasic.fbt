      <VarDeclaration ID="6A2647797C19ACFF" Name="Reset" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="8f48ac0b-3924-44f7-b104-5cbd3b63b4e3">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ,Reset,NoReset,Start,Stop" />
    <ECC>
