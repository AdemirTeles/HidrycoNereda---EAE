<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="61d32ee5-3248-41cb-bdc7-a5d80414b18a" Name="NeredaCapacitySpToCBlowersSp" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author="SESA685388" Date="10/7/2023" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event ID="D0388ADF8D5604CA" Name="REQ">
        <With Var="CapSp" />
        <With Var="C2_IN" />
        <With Var="C3_IN" />
        <With Var="UsingPump2" />
        <With Var="MaximumCapacityBlower" />
        <With Var="MaxSp" />
      </Event>
      <Event ID="C290CA59E2E76CE7" Name="END_DELAY_C2" />
      <Event ID="928BD6855BDB8CD4" Name="END_DELAY_C3" />
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="SpeedBlower" />
      </Event>
      <Event ID="C8BBF715CC922495" Name="START_DELAY_C2" />
      <Event ID="C529EC06887E5F22" Name="START_DELAY_C3" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="Setpoint" Name="CapSp" Type="REAL" Comment="Input event qualifier" />
      <VarDeclaration ID="366DF9C08522C788" Name="C2_IN" Type="REAL" />
      <VarDeclaration ID="9458FDB1B841EBF6" Name="C3_IN" Type="REAL" />
      <VarDeclaration ID="0E6B92BFBD466C31" Name="MaximumCapacityBlower" Type="REAL" />
      <VarDeclaration ID="F347E80EA65C1CE5" Name="UsingPump2" Type="BOOL" />
      <VarDeclaration ID="1FE73434323A3C55" Name="MaxSp" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="SpeedBlower" Type="REAL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="71865d44-b989-4ceb-af39-632154f465b8">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ" />
    <InternalVars>
      <VarDeclaration ID="Equal" Name="LastUsingPump2" Type="BOOL" />
      <VarDeclaration ID="5B14F8F64307848B" Name="Starting2Pumps" Type="BOOL" />
      <VarDeclaration ID="84D5E450CED202FB" Name="Stopping1Pump" Type="BOOL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="388.9412" y="341.4117" />
      <ECState Name="STATE2" x="1712" y="632.0001">
        <ECAction Algorithm="REQ" Output="CNF" />
      </ECState>
      <ECState Name="STARTING" x="951.9999" y="1424">
        <ECAction Output="START_DELAY_C2" />
      </ECState>
      <ECState Name="STOPPING" x="2128" y="1408">
        <ECAction Output="START_DELAY_C3" />
      </ECState>
      <ECTransition Source="START" Destination="STATE2" Condition="REQ" x="1071.086" y="396.4731">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="223.3548,83.92085,313.8872,103.7102" />
      </ECTransition>
      <ECTransition Source="STATE2" Destination="STARTING" Condition="Starting2Pumps" x="1366.871" y="1065.047">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="370.5973,240.7941,315.7913,297.9038" />
      </ECTransition>
      <ECTransition Source="STARTING" Destination="STATE2" Condition="END_DELAY_C2" x="1029.852" y="976.2335">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="212.234,267.4897,265.4807,212.3642" />
      </ECTransition>
      <ECTransition Source="STATE2" Destination="STOPPING" Condition="Stopping1Pump" x="2301.333" y="1056.212">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="583.7121,240.3562,615.9935,293.7849" />
      </ECTransition>
      <ECTransition Source="STOPPING" Destination="STATE2" Condition="END_DELAY_C3" x="1909.487" y="1107.039">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="493.6379,312.5134,462.044,255.5125" />
      </ECTransition>
      <ECTransition Source="STATE2" Destination="START" Condition="1" x="1085.542" y="572.6321">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="317.5159,157.2652,232.2139,139.1306" />
      </ECTransition>
    </ECC>
    <Algorithm Name="REQ" Comment="Initialization algorithm">
      <ST><![CDATA[;
IF (UsingPump2 AND NOT(LastUsingPump2)) THEN
	Starting2Pumps:=TRUE;
ELSE
	Starting2Pumps:=FALSE;
END_IF;

IF (NOT UsingPump2 AND LastUsingPump2) THEN
	Stopping1Pump := TRUE;
ELSE
	Stopping1Pump := FALSE;
END_IF;


IF (NOT UsingPump2 )THEN
    // Zone 1 : 0 ... C2_IN  =>  0 ... 100 %
    IF Stopping1Pump THEN
	    SpeedBlower := C3_IN;
    ELSE
    	SpeedBlower := MIN((CapSp / MaximumCapacityBlower) * 100.0, 100);
    END_IF;
END_IF; 	

IF (UsingPump2 )THEN
    // Zone 1 : 0 ... C2_IN  =>  0 ... 100 %
    IF Starting2Pumps THEN
	    SpeedBlower := C2_IN;
    ELSE
    	SpeedBlower := (CapSp / (2*MaximumCapacityBlower)) * 100.0;
    END_IF;
END_IF; 

IF MaxSp AND NOT Stopping1Pump THEN
	SpeedBlower := 100.0;
END_IF;

LastUsingPump2:=UsingPump2;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>