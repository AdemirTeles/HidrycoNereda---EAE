        <ECAction Algorithm="EmerOFF" Output="CNF_SD_DONE" />
      </ECState>
      <ECState Name="WAIT" x="1928" y="1160">
        <ECAction Output="START_DELAY" />
      </ECState>
      <ECTransition Source="START" Destination="WAIT" Condition="FB_R_STATE AND &#xD;&#xA;((InitRx_ToSD = 1 AND CurrState_R1 &gt;= 4) OR&#xD;&#xA;(InitRx_ToSD = 2 AND CurrState_R2 &gt;= 4) OR&#xD;&#xA;(InitRx_ToSD = 3 AND CurrState_R3 &gt;= 4) OR&#xD;&#xA;(InitRx_ToSD = 4 AND CurrState_R4 &gt;= 4) OR&#xD;&#xA;(InitRx_ToSD = 5 AND CurrState_R5 &gt;= 4) OR&#xD;&#xA;(InitRx_ToSD = 6 AND CurrState_R6 &gt;= 4))" x="1931.897" y="876.4532">
