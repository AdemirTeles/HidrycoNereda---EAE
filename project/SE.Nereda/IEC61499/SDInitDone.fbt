    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;
IF InitRx_ToW_S2 = 1 THEN
	InitGoToSD_ToR1 := TRUE;
	
ELSIF InitRx_ToW_S2 = 2 THEN
	InitGoToSD_ToR2 := TRUE;
	
ELSIF InitRx_ToW_S2 = 3 THEN
	InitGoToSD_ToR3 := TRUE;
	
ELSIF InitRx_ToW_S2 = 4 THEN
	InitGoToSD_ToR4 := TRUE;
	
ELSIF InitRx_ToW_S2 = 5 THEN
	InitGoToSD_ToR5 := TRUE;
	
ELSIF InitRx_ToW_S2 = 6 THEN
	InitGoToSD_ToR6 := TRUE;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm ID="bd8335c6-2c17-4f3c-a0d8-ad72fb384f4b" Name="EmerOFF">
      <ST><![CDATA[;
InitGoToSD_ToR1 := FALSE;
InitGoToSD_ToR2 := FALSE;
InitGoToSD_ToR3 := FALSE;
InitGoToSD_ToR4 := FALSE;
InitGoToSD_ToR5 := FALSE;
InitGoToSD_ToR6 := FALSE;]]></ST>
    </Algorithm>
  </BasicFB>
