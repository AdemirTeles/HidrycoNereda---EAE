      <VarDeclaration Name="Speed_Value" Type="WORD" />
      <VarDeclaration Name="RUN" Type="WORD" />
      <VarDeclaration Name="STOP" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="CMD" Type="WORD" Comment="Output event qualifier" />
