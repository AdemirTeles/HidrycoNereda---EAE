        <ECAction Algorithm="INIT" Output="INITO" />
      </ECState>
      <ECState Name="REQ_ETA_Error" Comment="Normal execution" x="2677.647" y="1588.941">
        <ECAction Algorithm="REQ_ETA_Error" Output="CNF_CMD" />
      </ECState>
      <ECState Name="REQ_ETA" x="267.9999" y="1136">
        <ECAction Algorithm="REQ_ETA" Output="CNF_CMD" />
      </ECState>
      <ECState Name="NST" x="1352" y="680" />
