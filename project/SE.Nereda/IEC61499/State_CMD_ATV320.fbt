    </ECC>
    <Algorithm Name="INIT" Comment="Initialization algorithm">
      <ST><![CDATA[;

	CMD := 16#80;

	
]]></ST>
    </Algorithm>
    <Algorithm Name="REQ_ETA_Error" Comment="Normally executed algorithm">
      <ST><![CDATA[;

(*IF Reset_ATV320 =TRUE THEN
	CMD := 16#80;
END_IF;*)

IF ETA_Code8 = 16#8 AND Reset_ATV320 =TRUE THEN
	CMD := 16#80;
	Reset_ATV320 := FALSE;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="REQ_ETA">
      <ST><![CDATA[;

IF ETA = 16#50  THEN
	CMD := 16#6;
END_IF;

IF ETA = 16#31  THEN
	CMD := 16#7;
END_IF;



]]></ST>
    </Algorithm>
    <Algorithm Name="REQ_Speed_Value">
      <ST><![CDATA[;

LFRD:=Speed_Value; ]]></ST>
    </Algorithm>
    <Algorithm Name="REQ_RUN">
      <ST><![CDATA[;

IF RUN = 16#F AND ETA = 16#33 AND STOP = FALSE THEN
	CMD:= 16#F;
END_IF;

IF RUN = 16#7 AND ETA = 16#37 THEN
	CMD:= 16#7;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="REQ_STOP">
      <ST><![CDATA[;

IF STOP = TRUE AND (CMD = 16#F OR CMD =16#7) THEN
	CMD:= 16#2;
END_IF;

IF STOP = FALSE AND ETA = 16#17 THEN
	CMD:= 16#0;
END_IF;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>