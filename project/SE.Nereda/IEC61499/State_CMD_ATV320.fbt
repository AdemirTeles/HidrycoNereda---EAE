      </Event>
      <Event Name="CNF_CMD">
        <With Var="CMD" />
        <With Var="LFRD" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="ETA_Code8" Type="WORD" Comment="Input event qualifier" />
