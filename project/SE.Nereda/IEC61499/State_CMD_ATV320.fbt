        <With Var="ETA_Code8" />
      </Event>
      <Event Name="REQ_ETA_Error" Comment="Normal Execution Request">
        <With Var="Reset_ATV320" />
        <With Var="ETA_Code8" />
      </Event>
      <Event Name="REQ_ETA">
