<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="8643cb45-906b-4560-a768-60db56284447" Name="State_CMD_ATV320" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author="SESA371406" Date="05/08/2021" Remarks="Template" />
  <InterfaceList>
