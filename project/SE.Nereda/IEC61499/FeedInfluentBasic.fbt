    <Algorithm Name="StartPump">
      <ST><![CDATA[;
CmdPump := TRUE;

IF Grafcet = 1 THEN
	Grafcet := 2;
ELSIF Grafcet = 10 THEN
	Grafcet := 11;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm Name="StopPump">
      <ST><![CDATA[;
CmdPump := FALSE;

IF Grafcet = 3 THEN
	Grafcet := 4;
ELSIF Grafcet = 12 THEN
	Grafcet := 13;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm Name="NormalOper">
      <ST><![CDATA[;
Grafcet := 1;
FreezeMode := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="FreezOper">
      <ST><![CDATA[;
Grafcet := 10;]]></ST>
    </Algorithm>
    <Algorithm Name="PumpRun">
      <ST><![CDATA[;
IF Grafcet = 2 THEN
	Grafcet := 3;
ELSIF Grafcet = 11 THEN
	Grafcet := 12;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm Name="PumpStopped">
      <ST><![CDATA[;
CmdPump := FALSE;
Grafcet := 9;]]></ST>
    </Algorithm>
    <Algorithm Name="UpdateFreeze">
      <ST><![CDATA[;
FreezeMode := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="Reset">
      <ST><![CDATA[;
CmdPump := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="ReTrigger">
      <ST><![CDATA[;
CmdPump := FALSE;]]></ST>
    </Algorithm>
