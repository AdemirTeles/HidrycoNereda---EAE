    <Algorithm ID="42cf27f2-e44a-45a4-bc96-9aae58cc0c1e" Name="REQ">
      <ST><![CDATA[;
(* ======================================================================== *)
(* CAerationLogicBasic2 - Rev6                                              *)
(* Alocacao de sopradores por header                                        *)
(*   H1 (Reator 1): B1 fixo -> B2 (StartScndBL_H1) -> B3 (StartStdby_H1)     *)
(*   H2 (Reator 2): B4 fixo -> B3 (StartScndBL_H2) -> B2 (StartStdby_H2)     *)
(* Prioridades:                                                             *)
(*   1) Aeracao minima: 1 soprador em cada reator comandado                 *)
(*   2) Capacidade: 2o soprador quando AerCapRx > MaximumCapacity           *)
(*   3) Em disputa pelo mesmo soprador compartilhado, o header "dono" vence *)
(*      (B2 -> H1, B3 -> H2). Aeracao minima SEMPRE vence capacidade extra. *)
(*   4) MaxSp_Hx: demanda acima de MaximumCapacity e no maximo 1 soprador  *)
(*      soprando DE FATO no reator (feedback real, nao o plano)            *)
(*   5) Maximo MaxBlowers (3) sopradores ligados no total; o extra vai para *)
(*      o reator com maior demanda acima do SP (com histerese de troca)     *)
(*   6) Continuidade: prefere transferir soprador rodando a parar/partir    *)
(*   7) So aloca por rota passavel (todas as valvulas Ready ou abertas).   *)
(*      Se a prioridade nao consegue receber, o extra vai para o outro.    *)
(*   8) B1/B4 sempre prioridade no proprio reator: ao voltar ocupam a vaga; *)
(*      o compartilhado segura o ar (ponte) ate B1/B4 confirmar Running.   *)
(*   9) B1/B4 com a valvula de cima fechada em manual/falha = indisponivel *)
(* B1/B4 sao partidos fora deste FB (AerationRxCmd). Um soprador nunca e    *)
(* alocado aos dois headers ao mesmo tempo.                                 *)
(* ======================================================================== *)

(* ---------- 1. Disponibilidade ---------- *)
(* B1/B4 so contam se a valvula acima deles for passavel (Ready ou aberta). *)
(* Valvula fechada em manual/falha = B1/B4 indisponivel: o compartilhado    *)
(* assume o reator.                                                         *)
Avail1 := (Blower1FbReady OR Blower1FbRunning) AND (ValveBlower1FbReady OR ValveBlower1FbOpened);
Avail2 := Blower2FbReady OR Blower2FbRunning;
Avail3 := Blower3FbReady OR Blower3FbRunning;
Avail4 := (Blower4FbReady OR Blower4FbRunning) AND (ValveBlower4FbReady OR ValveBlower4FbOpened);

(* ---------- 2. Demanda por header (com histerese) ---------- *)
HystAbs := MaximumCapacity * HystPct / 100.0;

IF NOT AerationR1Cmd THEN
    Need2_H1 := FALSE;
ELSIF AerCapR1 > MaximumCapacity THEN
    Need2_H1 := TRUE;
ELSIF AerCapR1 <= (MaximumCapacity - HystAbs) THEN
    Need2_H1 := FALSE;
END_IF;

IF NOT AerationR2Cmd THEN
    Need2_H2 := FALSE;
ELSIF AerCapR2 > MaximumCapacity THEN
    Need2_H2 := TRUE;
ELSIF AerCapR2 <= (MaximumCapacity - HystAbs) THEN
    Need2_H2 := FALSE;
END_IF;

NeedH1 := 0;
IF AerationR1Cmd THEN
    IF Need2_H1 THEN NeedH1 := 2; ELSE NeedH1 := 1; END_IF;
END_IF;

NeedH2 := 0;
IF AerationR2Cmd THEN
    IF Need2_H2 THEN NeedH2 := 2; ELSE NeedH2 := 1; END_IF;
END_IF;

(* ---------- 2b. Rotas passaveis (ar consegue chegar ao reator) ---------- *)
(* Valvula passavel: Ready (pode abrir) ou ja aberta (ar ja passa).        *)
(* Rota com qualquer valvula sem Ready e nao aberta e descartada: o        *)
(* soprador vai para quem consegue recebe-lo.                              *)
PassV1  := Valve1FbReady OR Valve1FbOpened;
PassV2  := Valve2FbReady OR Valve2FbOpened;
PassV3  := Valve3FbReady OR Valve3FbOpened;
PassVB2 := ValveBlower2FbReady OR ValveBlower2FbOpened;
PassVB3 := ValveBlower3FbReady OR ValveBlower3FbOpened;

Route2H1 := PassVB2 AND PassV1;             (* B2 -> R1: VB2 + V1      *)
Route2H2 := PassVB2 AND PassV2 AND PassV3;  (* B2 -> R2: VB2 + V2 + V3 *)
Route3H2 := PassVB3 AND PassV3;             (* B3 -> R2: VB3 + V3      *)
Route3H1 := PassVB3 AND PassV2 AND PassV1;  (* B3 -> R1: VB3 + V2 + V1 *)

(* ---------- 3. Inicializa alocacao ---------- *)
H1_B2 := FALSE;
H1_B3 := FALSE;
H2_B3 := FALSE;
H2_B2 := FALSE;
Free2 := Avail2;
Free3 := Avail3;

CntH1 := 0;
IF AerationR1Cmd AND Avail1 THEN CntH1 := 1; END_IF;
CntH2 := 0;
IF AerationR2Cmd AND Avail4 THEN CntH2 := 1; END_IF;

(* ---------- 4. Etapa 1 - garantir aeracao minima ---------- *)
(* 4a. soprador compartilhado "dono" *)
IF (NeedH1 >= 1) AND (CntH1 = 0) AND Free2 AND Route2H1 THEN
    H1_B2 := TRUE; Free2 := FALSE; CntH1 := CntH1 + 1;
END_IF;
IF (NeedH2 >= 1) AND (CntH2 = 0) AND Free3 AND Route3H2 THEN
    H2_B3 := TRUE; Free3 := FALSE; CntH2 := CntH2 + 1;
END_IF;
(* 4b. soprador compartilhado cruzado (standby) *)
IF (NeedH1 >= 1) AND (CntH1 = 0) AND Free3 AND Route3H1 THEN
    H1_B3 := TRUE; Free3 := FALSE; CntH1 := CntH1 + 1;
END_IF;
IF (NeedH2 >= 1) AND (CntH2 = 0) AND Free2 AND Route2H2 THEN
    H2_B2 := TRUE; Free2 := FALSE; CntH2 := CntH2 + 1;
END_IF;

(* ---------- 4c. Ponte: B1/B4 voltando tem prioridade, sem deixar o reator sem ar ---------- *)
(* B1/B4 ocupa a vaga assim que fica disponivel (etapa 1). Enquanto ele ainda   *)
(* nao estiver rodando, o compartilhado que ja alimentava o reator continua     *)
(* ligado (se couber no limite de sopradores). Quando B1/B4 confirma Running,   *)
(* a ponte cai e o compartilhado e liberado. Vem antes da capacidade extra:    *)
(* manter ar no reator e mais importante que o 2o soprador do outro.          *)
IF AerationR1Cmd AND Avail1 AND NOT (Blower1FbRunning AND ValveBlower1FbOpened) AND (CntH1 < 2) AND ((CntH1 + CntH2) < MaxBlowers) THEN
    IF Free2 AND Route2H1 AND Last_StartScndBL_H1 AND Blower2FbRunning THEN
        H1_B2 := TRUE; Free2 := FALSE; CntH1 := CntH1 + 1;
    ELSIF Free3 AND Route3H1 AND Last_StartStdby_H1 AND Blower3FbRunning THEN
        H1_B3 := TRUE; Free3 := FALSE; CntH1 := CntH1 + 1;
    END_IF;
END_IF;
IF AerationR2Cmd AND Avail4 AND NOT (Blower4FbRunning AND ValveBlower4FbOpened) AND (CntH2 < 2) AND ((CntH1 + CntH2) < MaxBlowers) THEN
    IF Free3 AND Route3H2 AND Last_StartScndBL_H2 AND Blower3FbRunning THEN
        H2_B3 := TRUE; Free3 := FALSE; CntH2 := CntH2 + 1;
    ELSIF Free2 AND Route2H2 AND Last_StartStdby_H2 AND Blower2FbRunning THEN
        H2_B2 := TRUE; Free2 := FALSE; CntH2 := CntH2 + 1;
    END_IF;
END_IF;

(* ---------- 5. Etapa 2 - capacidade acima do setpoint ---------- *)
(* Limite: no maximo MaxBlowers sopradores ligados no total (B1..B4).  *)
(* Quando os dois reatores pedem 2 e so cabe 1 extra, leva quem tiver  *)
(* maior excesso sobre MaximumCapacity. A prioridade so troca se o     *)
(* outro superar o atual em SwapHystPct % (evita ficar trocando B2/B3). *)
Exc1 := AerCapR1 - MaximumCapacity;
Exc2 := AerCapR2 - MaximumCapacity;
SwapHystAbs := MaximumCapacity * SwapHystPct / 100.0;

IF (NeedH1 = 2) AND (NeedH2 = 2) THEN
    IF ExtraPrio = 1 THEN
        IF Exc2 > (Exc1 + SwapHystAbs) THEN ExtraPrio := 2; END_IF;
    ELSIF ExtraPrio = 2 THEN
        IF Exc1 > (Exc2 + SwapHystAbs) THEN ExtraPrio := 1; END_IF;
    ELSIF Exc2 > Exc1 THEN
        ExtraPrio := 2;
    ELSE
        ExtraPrio := 1;
    END_IF;
ELSIF NeedH1 = 2 THEN
    ExtraPrio := 1;
ELSIF NeedH2 = 2 THEN
    ExtraPrio := 2;
ELSE
    ExtraPrio := 0;
END_IF;

IF ExtraPrio = 2 THEN
    (* H2 tem prioridade no soprador extra *)
    IF (CntH2 < NeedH2) AND ((CntH1 + CntH2) < MaxBlowers) AND Free3 AND Route3H2 THEN
        H2_B3 := TRUE; Free3 := FALSE; CntH2 := CntH2 + 1;
    END_IF;
    IF (CntH2 < NeedH2) AND ((CntH1 + CntH2) < MaxBlowers) AND Free2 AND Route2H2 THEN
        H2_B2 := TRUE; Free2 := FALSE; CntH2 := CntH2 + 1;
    END_IF;
    IF (CntH1 < NeedH1) AND ((CntH1 + CntH2) < MaxBlowers) AND Free2 AND Route2H1 THEN
        H1_B2 := TRUE; Free2 := FALSE; CntH1 := CntH1 + 1;
    END_IF;
    IF (CntH1 < NeedH1) AND ((CntH1 + CntH2) < MaxBlowers) AND Free3 AND Route3H1 THEN
        H1_B3 := TRUE; Free3 := FALSE; CntH1 := CntH1 + 1;
    END_IF;
ELSE
    (* H1 tem prioridade no soprador extra *)
    IF (CntH1 < NeedH1) AND ((CntH1 + CntH2) < MaxBlowers) AND Free2 AND Route2H1 THEN
        H1_B2 := TRUE; Free2 := FALSE; CntH1 := CntH1 + 1;
    END_IF;
    IF (CntH1 < NeedH1) AND ((CntH1 + CntH2) < MaxBlowers) AND Free3 AND Route3H1 THEN
        H1_B3 := TRUE; Free3 := FALSE; CntH1 := CntH1 + 1;
    END_IF;
    IF (CntH2 < NeedH2) AND ((CntH1 + CntH2) < MaxBlowers) AND Free3 AND Route3H2 THEN
        H2_B3 := TRUE; Free3 := FALSE; CntH2 := CntH2 + 1;
    END_IF;
    IF (CntH2 < NeedH2) AND ((CntH1 + CntH2) < MaxBlowers) AND Free2 AND Route2H2 THEN
        H2_B2 := TRUE; Free2 := FALSE; CntH2 := CntH2 + 1;
    END_IF;
END_IF;

(* ---------- 5c. Continuidade: transferir em vez de parar/partir ---------- *)
(* Se o resultado for "para um soprador que esta rodando e parte o outro",   *)
(* o que ja esta rodando assume a rota do outro (transferencia sem desligar). *)
(* Mesmos sopradores por reator: capacidade, limite e prioridade iguais.     *)
PrevB2 := 0;
IF Last_StartScndBL_H1 THEN PrevB2 := 1; ELSIF Last_StartStdby_H2 THEN PrevB2 := 2; END_IF;
PrevB3 := 0;
IF Last_StartScndBL_H2 THEN PrevB3 := 2; ELSIF Last_StartStdby_H1 THEN PrevB3 := 1; END_IF;

NewB2 := 0;
IF H1_B2 THEN NewB2 := 1; ELSIF H2_B2 THEN NewB2 := 2; END_IF;
NewB3 := 0;
IF H2_B3 THEN NewB3 := 2; ELSIF H1_B3 THEN NewB3 := 1; END_IF;

(* Rota que o soprador em operacao teria no reator que o outro ia assumir *)
IF NewB3 = 1 THEN SwapRouteOk := Route2H1; ELSE SwapRouteOk := Route2H2; END_IF;
IF (PrevB2 <> 0) AND (NewB2 = 0) AND Blower2FbRunning AND (PrevB3 = 0) AND (NewB3 <> 0) AND SwapRouteOk THEN
    NewB2 := NewB3;
    NewB3 := 0;
ELSE
    IF NewB2 = 1 THEN SwapRouteOk := Route3H1; ELSE SwapRouteOk := Route3H2; END_IF;
    IF (PrevB3 <> 0) AND (NewB3 = 0) AND Blower3FbRunning AND (PrevB2 = 0) AND (NewB2 <> 0) AND SwapRouteOk THEN
        NewB3 := NewB2;
        NewB2 := 0;
    END_IF;
END_IF;

H1_B2 := NewB2 = 1;
H2_B2 := NewB2 = 2;
H2_B3 := NewB3 = 2;
H1_B3 := NewB3 = 1;

(* ---------- 6. Saidas ---------- *)
StartScndBL_H1 := H1_B2;   (* Blower 2 -> Header 1 *)
StartStdby_H1  := H1_B3;   (* Blower 3 -> Header 1 *)
StartScndBL_H2 := H2_B3;   (* Blower 3 -> Header 2 *)
StartStdby_H2  := H2_B2;   (* Blower 2 -> Header 2 *)

(* Sopradores REALMENTE soprando em cada reator (nao o planejado):          *)
(* fixo em Running + compartilhado alocado, em Running e com o caminho       *)
(* completo confirmado aberto. Cobre partida em andamento, manobra travada,  *)
(* valvula que fechou e troca de reator.                                     *)
ActH1 := 0;
IF Blower1FbRunning AND ValveBlower1FbOpened THEN ActH1 := ActH1 + 1; END_IF;
IF H1_B2 AND Blower2FbRunning AND ValveBlower2FbOpened AND Valve1FbOpened THEN
    ActH1 := ActH1 + 1;
END_IF;
IF H1_B3 AND Blower3FbRunning AND ValveBlower3FbOpened AND Valve2FbOpened AND Valve1FbOpened THEN
    ActH1 := ActH1 + 1;
END_IF;

ActH2 := 0;
IF Blower4FbRunning AND ValveBlower4FbOpened THEN ActH2 := ActH2 + 1; END_IF;
IF H2_B3 AND Blower3FbRunning AND ValveBlower3FbOpened AND Valve3FbOpened THEN
    ActH2 := ActH2 + 1;
END_IF;
IF H2_B2 AND Blower2FbRunning AND ValveBlower2FbOpened AND Valve2FbOpened AND Valve3FbOpened THEN
    ActH2 := ActH2 + 1;
END_IF;

Using2Pumps_H1 := ActH1 >= 2;
Using2Pumps_H2 := ActH2 >= 2;

(* Capacidade pedida acima de MaximumCapacity e no maximo 1 soprador        *)
(* soprando de fato no reator: o que estiver soprando vai ao maximo.         *)
MaxSp_H1 := AerationR1Cmd AND Need2_H1 AND (ActH1 <= 1);
MaxSp_H2 := AerationR2Cmd AND Need2_H2 AND (ActH2 <= 1);

(* ---------- 7. Deteccao de mudanca (dispara CNF_CMD) ---------- *)
OutChanged := (NOT Initialized) OR
              (Last_StartScndBL_H1 <> StartScndBL_H1) OR
              (Last_StartStdby_H1 <> StartStdby_H1) OR
              (Last_StartScndBL_H2 <> StartScndBL_H2) OR
              (Last_StartStdby_H2 <> StartStdby_H2) OR
              (Last_MaxSp_H1 <> MaxSp_H1) OR
              (Last_MaxSp_H2 <> MaxSp_H2) OR
              (Last_Using2Pumps_H1 <> Using2Pumps_H1) OR
              (Last_Using2Pumps_H2 <> Using2Pumps_H2);]]></ST>
    </Algorithm>
    <Algorithm ID="6955cf78-208c-4e67-a99e-0bf01b559f9c" Name="algLastValue">
      <ST><![CDATA[;
Last_StartScndBL_H1 := StartScndBL_H1;
Last_StartStdby_H1 := StartStdby_H1;
Last_StartScndBL_H2 := StartScndBL_H2;
Last_StartStdby_H2 := StartStdby_H2;
Last_MaxSp_H1 := MaxSp_H1;
Last_MaxSp_H2 := MaxSp_H2;
Last_Using2Pumps_H1 := Using2Pumps_H1;
Last_Using2Pumps_H2 := Using2Pumps_H2;
Initialized := TRUE;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>