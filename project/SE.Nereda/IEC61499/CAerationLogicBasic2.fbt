    </ECC>
    <Algorithm ID="42cf27f2-e44a-45a4-bc96-9aae58cc0c1e" Name="REQ">
      <ST><![CDATA[;
(* Standby status *)

(* Default outputs *)
StartScndBL_H1 := FALSE;
StartStdby_H1 := FALSE;

StartScndBL_H2 := FALSE;
StartStdby_H2 := FALSE;

MaxSp_H1 := FALSE;
MaxSp_H2 := FALSE;
(* ========================================================= *)
(* HEADER 1 - REACTOR 1                                      *)
(* Priority: Blower1 -> Blower2 -> Standby                    *)
(* ========================================================= *)

IF AerationR1Cmd THEN

    (* 1 blower required *)
    IF AerCapR1 <= MaximumCapacity THEN
        IF Blower1FbReady THEN
            StartScndBL_H1 := FALSE;
            StartStdby_H1 := FALSE;
        ELSIF Owner = 0 OR Owner = 1 THEN
            StartScndBL_H1 := FALSE;
            StartStdby_H1 := TRUE;
            Owner := 1;
        END_IF;


    (* 2 blowers required *)
    ELSIF AerCapR1 > MaximumCapacity THEN
        IF Blower1FbReady AND Blower2FbReady AND (Owner = 0 OR Owner = 1) THEN
            StartScndBL_H1 := TRUE;
            StartStdby_H1 := FALSE;
            Owner := 1;
        ELSIF (Owner = 0 OR Owner = 1) THEN

            StartScndBL_H1 := Blower2FbReady;
            StartStdby_H1 := TRUE;
            Owner := 1;
            MaxSp_H1 := ((Blower1FbReady +  Blower2FbReady +  Blower3FbReady) = 1);
    	ELSIF Blower1FbReady THEN
    		MaxSp_H1 := TRUE;
    		
        END_IF;
    END_IF;
END_IF;


(* ========================================================= *)
(* HEADER 2 - REACTOR 2                                      *)
(* Priority: Blower4 -> Blower3 -> Standby                    *)
(* ========================================================= *)

IF AerationR2Cmd THEN
	
    (* 1 blower required *)
    IF AerCapR2 <= MaximumCapacity THEN
        IF Blower4FbReady THEN
            StartScndBL_H2 := FALSE;
            StartStdby_H2 := FALSE;
        ELSIF Owner = 0 OR Owner = 2 THEN
            StartScndBL_H2 := FALSE;
            StartStdby_H2 := TRUE;
            Owner := 2;
        END_IF;


    (* 2 blowers required *)
    ELSIF AerCapR2 > MaximumCapacity THEN
        IF Blower4FbReady AND Blower3FbReady AND (Owner = 0 OR Owner = 2) THEN
            StartScndBL_H2 := TRUE;
            StartStdby_H2 := FALSE;
            Owner := 2;
        ELSIF (Owner = 0 OR Owner = 2) THEN
            StartScndBL_H2 := Blower3FbReady;
            StartStdby_H2 := TRUE;
            Owner := 2;
            MaxSp_H2 := ((Blower2FbReady +  Blower3FbReady +  Blower4FbReady) = 1);
         ELSIF Blower4FbReady THEN
    		MaxSp_H2 := TRUE;
        END_IF;
    END_IF;
END_IF;

IF NOT (StartScndBL_H2 OR StartStdby_H2 OR StartScndBL_H1 OR StartStdby_H1) THEN
	Owner := 0;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm ID="6955cf78-208c-4e67-a99e-0bf01b559f9c" Name="algLastValue">
      <ST><![CDATA[;

Last_MaxSp_H1 := MaxSp_H1;
Last_MaxSp_H2 := MaxSp_H2;
Last_StartScndBL_H1 := StartScndBL_H1;
Last_StartScndBL_H2 := StartScndBL_H2;
Last_StartStdby_H1 := StartStdby_H1;
Last_StartStdby_H2 := StartStdby_H2;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>