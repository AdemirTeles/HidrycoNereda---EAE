      </ECTransition>
      <ECTransition Source="REQ" Destination="REQ" Condition="Owner = 0" x="4012.396" y="2303.689" />
      <ECTransition Source="REQ" Destination="STATE1" Condition="Last_MaxSp_H1 &lt;&gt; MaxSp_H1 OR&#xD;&#xA;Last_MaxSp_H2 &lt;&gt; MaxSp_H2 OR&#xD;&#xA;Last_StartScndBL_H1 &lt;&gt; StartScndBL_H1 OR&#xD;&#xA;Last_StartScndBL_H2 &lt;&gt; StartScndBL_H2 OR&#xD;&#xA;Last_StartStdby_H1 &lt;&gt; StartStdby_H1 OR&#xD;&#xA;Last_StartStdby_H2 &lt;&gt; StartStdby_H2" x="4233.947" y="1829.53">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="1048.917,463.5291,1076.615,437.9943" />
      </ECTransition>
