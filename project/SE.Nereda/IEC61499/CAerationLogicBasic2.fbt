      <VarDeclaration ID="B6D3DE1C81A97984" Name="ActH1" Type="INT" Comment="Sopradores soprando de fato no R1" />
      <VarDeclaration ID="F9B92E548C9D8291" Name="ActH2" Type="INT" Comment="Sopradores soprando de fato no R2" />
    </InternalVars>
