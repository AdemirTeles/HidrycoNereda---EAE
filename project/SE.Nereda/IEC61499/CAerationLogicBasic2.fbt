        <Attribute Name="Configuration.Transaction.BezierPoints" Value="937.6135,390.2598,797.8777,342.9702" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="NOT OutChanged" x="3318.219" y="1693.031">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="889.9545,470.8896,780.2292,392.7963" />
