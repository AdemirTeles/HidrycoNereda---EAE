<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="8533c08f-8e08-49dd-bef7-cc215b00f8db" Name="FlushSludgeBufferCond" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author="SESA713705" Date="5/26/2024" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="CHECK_CONDITION">
        <With Var="EffluentLevelIsOK" />
        <With Var="FbFlowLLAlarm" />
        <With Var="ValveAvailable" />
        <With Var="ConfigurationIsDone" />
        <With Var="FlushPumpNotReady" />
        <With Var="HighLevelSB" />
        <With Var="OtherFlushRunning" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF_ENABLE">
        <With Var="SendEnableOperation" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="EffluentLevelIsOK" Type="BOOL" />
      <VarDeclaration Name="ValveAvailable" Type="BOOL" />
      <VarDeclaration Name="HighLevelSB" Type="BOOL" />
      <VarDeclaration Name="FbFlowLLAlarm" Type="BOOL" />
      <VarDeclaration Name="FlushPumpNotReady" Type="BOOL" />
      <VarDeclaration Name="ConfigurationIsDone" Type="BOOL" />
      <VarDeclaration Name="OtherFlushRunning" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="SendEnableOperation" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="CheckCondition" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="632.9412" y="569.4117" />
      <ECState Name="STATE1" x="1956" y="564">
        <ECAction Algorithm="CheckCondition" Output="CNF_ENABLE" />
      </ECState>
      <ECTransition Source="START" Destination="STATE1" Condition="CHECK_CONDITION" x="1287.791" y="484.7417">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="278.161,116.8624,365.7345,116.5042" />
      </ECTransition>
      <ECTransition Source="STATE1" Destination="START" Condition="1" x="1288.098" y="648.7299">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="365.8367,166.5057,278.2632,166.8639" />
      </ECTransition>
    </ECC>
    <Algorithm Name="CheckCondition">
      <ST><![CDATA[;
IF 	EffluentLevelIsOK AND
	NOT FbFlowLLAlarm AND
	ValveAvailable AND
	NOT HighLevelSB AND
	NOT FlushPumpNotReady AND
	NOT OtherFlushRunning AND
	ConfigurationIsDone	THEN
	
	SendEnableOperation := TRUE;
ELSE
	SendEnableOperation := FALSE;
END_IF;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>