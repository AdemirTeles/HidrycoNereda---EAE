      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="RawPvIn" Type="VTQREAL" Comment="Unscaled analog signal" />
      <VarDeclaration Name="SuppressAlarm" Type="BOOL" Comment="1 = Suppress channel failure in HMI" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Pv" Type="VTQREAL" Comment="Scaled process signal" />
      <VarDeclaration Name="PvMin" Type="REAL" Comment="Minimum pv measurement range (in engineering units)" />
      <VarDeclaration Name="PvMax" Type="REAL" Comment="Maximun pv measurement range (in engineering units)" />
      <VarDeclaration Name="ChFailAlarm" Type="BOOL" Comment="1 = Alarm condition is true with considering the suppress status" />
      <VarDeclaration ID="BCEE37427EBF3A7A" Name="OverrideStatus" Type="BOOL" Comment="1 = Signal is forced from HwCat based on quality code" />
    </OutputVars>
  </InterfaceList>
