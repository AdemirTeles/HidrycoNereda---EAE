  <InterfaceList>
    <EventInputs>
      <Event Name="REQ_PV" Comment="Request input value">
        <With Var="RawPvIn" />
        <With Var="SuppressAlarm" />
      </Event>
      <Event Name="REQ_SUPPRESS" Comment="Request to suppress the channel failure alarm">
        <With Var="SuppressAlarm" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF_PV" Comment="Execution confirmation of Pv">
