<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="d3c45343-9af8-4d5b-ad66-1019697d0449" Name="FeedReactor1PBasic" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="6/15/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event ID="7E30127865CFE16B" Name="FEED_REACTOR">
