      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="3100FF95313D2E79" Name="Suppress" Type="BOOL" Comment="1 = Condition suppressed" />
      <VarDeclaration ID="B24A2EB6CD7D5206" Name="CurrentOwner" Type="WORD" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="74F62D32B8AB17CB" Name="State" Type="BOOL" Comment="1 = interlock active" />
      <VarDeclaration ID="5B70B8A759686CBA" Name="CondPos" Type="InterlockState" Namespace="SE.App2CommonProcess" Comment="Passive = Passive condition; Active 1 = Active condition 1; Active 2 = Active condition 2" />
      <VarDeclaration ID="5CCAAE9E9D3EC477" Name="CondType" Type="CondType" Namespace="SE.App2CommonProcess" Comment="Type of condition interlock, (0 = Normal, 1 = Sequential, 2 = Process, 3 = Protection)" />
      <VarDeclaration ID="7BFBF177262F6463" Name="IlckSpeed" Type="VTQREAL" Comment="Vtq value" />
    </OutputVars>
    <Sockets>
      <AdapterDeclaration ID="67B6C8BC3D21E047" Name="IIlckSum" Type="IIlckCondSum" Namespace="SE.App2CommonProcess" Comment="Interlock condition summary chain input from ilckcondsum block" x="2020" y="620">
        <Parameter Name="$DeviceType" Value="BiDirectional" />
        <Parameter Name="$ServiceState" Value="TRUE" />
      </AdapterDeclaration>
      <AdapterDeclaration ID="8B394DC08166B07A" Name="IIlckSpeed" Type="IAnalog" Namespace="SE.App2Base" Comment="Speed setpoint to be considered if interlock condition is active" x="2220" y="1500" />
    </Sockets>
  </InterfaceList>
