<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="ad7b4647-52d1-4347-a6ba-f67acd0bf20a" Name="IlckMotVs" Format="2.0" Comment="CAT Function Block Type" Namespace="SE.Nereda">
  <Attribute Name="HMI.Alias" Value="" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="6/3/2026" Remarks="template" />
  <InterfaceList>
    <EventInputs>
      <Event ID="BB07CE5CA3A90E8C" Name="REQ" Comment="Request from Socket">
        <With Var="Suppress" />
      </Event>
      <Event ID="47593EB5799F5830" Name="REQ_OWNER">
        <With Var="CurrentOwner" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="1ACB26BE744F37A1" Name="COND_IND" Comment="Confirmation from Plug">
        <With Var="State" />
        <With Var="CondPos" />
