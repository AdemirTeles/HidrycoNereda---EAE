<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="f383185c-8ae4-4843-a0d4-0bca9e64d498" Name="CmdSludgeDischargeSLB_HMI" Comment="Service Interface Function Block Type" Namespace="SE.Nereda">
