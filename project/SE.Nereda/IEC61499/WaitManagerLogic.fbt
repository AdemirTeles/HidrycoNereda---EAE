<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="34c011f9-ad03-4951-bdcc-c00661098e12" Name="WaitManagerLogic" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.1" Author="SESA713705" Date="10/8/2026" Remarks="Hidryco 10/2026: volta ao START quando a fase sai de Starting/Run/Stopping sem passar por Stopping (abort, interlock, reset). Antes ficava presa e a fase nao saia mais do Starting" />
  <InterfaceList>
    <EventInputs>
      <Event ID="READY_STATE" Name="STATE">
        <With Var="ReadyState" />
        <With Var="StartingState" />
        <With Var="RunningState" />
        <With Var="StoppingState" />
      </Event>
      <Event Name="REQ_DELAY" />
    </EventInputs>
    <EventOutputs>
      <Event Name="START_RDY">
        <With Var="StartReday" />
      </Event>
      <Event Name="STOP_RDY">
        <With Var="StopReady" />
      </Event>
      <Event Name="CNF_DELAY" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="ReadyState" Type="BOOL" />
      <VarDeclaration Name="StartingState" Type="BOOL" />
      <VarDeclaration Name="RunningState" Type="BOOL" />
      <VarDeclaration Name="StoppingState" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="StartReday" Type="BOOL" />
      <VarDeclaration Name="StopReady" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="b843d194-a20b-48fc-9487-d90a7b0514e3">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="Ready,StartReady,RunningState,StopReady" />
