<FBType GUID="9279c13a-a747-4ed8-90c7-27d7cb328c75" Name="FeedReactorLogic" Format="2.0" Comment="CAT Function Block Type" Namespace="SE.Nereda">
  <Attribute Name="HMI.Alias" Value="" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="1.0" Author="Claude/Hidryco" Date="10/1/2026" Remarks="Rev1 - Caminho de 3 bombas reescrito (FeedReactor3PsBasic Rev1): mesmo funcionamento da Water Discharge; PID unico (PIDISc.RunPID1/Setpoint1); velocidade unica via SpeedGate (reenvio 1 s); rodizio por horimetro (FB_OPD); velocidade real (FB_SPEED); pH/condutividade pelos alarmes L/H (narrativa); reatores recebem disponibilidade/rodando de qualquer bomba; removidos SpeedSp1-3, InfluentCofiguration, INT2BOOL e WaitingTime (caminho de 1 bomba nao usado)" />
