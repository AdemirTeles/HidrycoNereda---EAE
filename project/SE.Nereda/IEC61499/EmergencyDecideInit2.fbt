<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="d0cbeb9d-55ff-4ec7-9692-4ee0b985a259" Name="EmergencyDecideInit2" Comment="Basic Function Block Type" Namespace="SE.Nereda">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="7/15/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event ID="CB5BC2F1A1AE16A3" Name="INIT_CMD">
        <With Var="EmergencyON" />
        <With Var="EnoughTime" />
        <With Var="Initialize" />
        <With Var="InitRx_To_Step10" />
      </Event>
      <Event ID="0587A7D0236844E8" Name="SHOW_INIT_ACT">
        <With Var="ShwoInitAction" />
        <With Var="EnoughTime" />
        <With Var="EmergencyON" />
        <With Var="ShowRxToFeed" />
        <With Var="ShowSettleTWait" />
      </Event>
      <Event ID="A265894F67E5210F" Name="REQ" Comment="Normal Execution Request">
        <With Var="EnoughTime" />
        <With Var="EmergencyON" />
      </Event>
      <Event ID="EBD053A98A1A70A5" Name="EMER">
        <With Var="EmergencyON" />
      </Event>
      <Event ID="2E85D83F8E687538" Name="CURR_S">
        <With Var="CurrStep" />
      </Event>
      <Event ID="4094C1FC48DD1583" Name="ID">
        <With Var="ReactorID" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="BCEA9B57A1625B8E" Name="GO_TO_S" Comment="Execution Confirmation">
        <With Var="GoToStep2" />
        <With Var="GoToStep10" />
        <With Var="oInitDone" />
      </Event>
      <Event ID="EEE84093672F5149" Name="SHOW_INIT_HMI">
        <With Var="InitStatus" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="465E8A05EBC8F670" Name="Initialize" Type="BOOL" />
      <VarDeclaration ID="E7F735E9E7BC78CA" Name="InitRx_To_Step10" Type="BOOL" />
      <VarDeclaration ID="4AB9C956B8026F99" Name="ShwoInitAction" Type="BOOL" />
      <VarDeclaration ID="79E8F3204D78737F" Name="ShowRxToFeed" Type="INT" />
      <VarDeclaration ID="552F5A48A687EBC7" Name="ShowSettleTWait" Type="INT" />
      <VarDeclaration ID="02AAB2707FF1365A" Name="EnoughTime" Type="BOOL" Comment="Input event qualifier" />
      <VarDeclaration ID="B4FF674B444ECDD1" Name="EmergencyON" Type="BOOL" />
      <VarDeclaration ID="5250E59468B0D4FE" Name="CurrStep" Type="INT" />
      <VarDeclaration ID="BD4E0FF48B3C0B85" Name="ReactorID" Type="INT" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="507EF3B39A4900A8" Name="GoToStep2" Type="BOOL" Comment="Output event qualifier" />
      <VarDeclaration ID="D53B1E868844A93D" Name="GoToStep10" Type="BOOL" />
      <VarDeclaration ID="405DFF3C3F93E112" Name="oInitDone" Type="BOOL" />
      <VarDeclaration ID="6D4DE5A32FF8B310" Name="InitStatus" Type="INT" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="2e07b71e-2657-40df-8010-94f8e7c8b919">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ,InitDone,EmerOFF,InitToStep10" />
    <InternalVars>
      <VarDeclaration ID="BC13DBE2E4CDCF6B" Name="TargetStep" Type="INT" InitialValue="255" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="1880.941" y="889.4116" />
      <ECState Name="REQ" x="2316" y="1608">
        <ECAction Algorithm="REQ" Output="GO_TO_S" />
      </ECState>
      <ECState Name="Done" x="1876" y="248">
        <ECAction Algorithm="InitDone" Output="GO_TO_S" />
        <ECAction Output="SHOW_INIT_HMI" />
      </ECState>
      <ECState Name="HMI" x="2908" y="675.9998">
        <ECAction Algorithm="REQ" Output="SHOW_INIT_HMI" />
      </ECState>
      <ECState Name="EmerOFF" x="911.9998" y="1616">
        <ECAction Algorithm="EmerOFF" Output="SHOW_INIT_HMI" />
        <ECAction Output="GO_TO_S" />
      </ECState>
      <ECState Name="STATE1" x="372" y="704">
        <ECAction Algorithm="InitToStep10" Output="GO_TO_S" />
        <ECAction Output="SHOW_INIT_HMI" />
      </ECState>
      <ECTransition Source="START" Destination="REQ" Condition="INIT_CMD AND Initialize" x="2149.33" y="1198.337">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="523.9047,270.1615,555.6049,320.6119" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="1" x="1888.267" y="1311.148">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="473.1138,355.6612,445.5325,309.6107" />
      </ECTransition>
      <ECTransition Source="START" Destination="Done" Condition="CURR_S AND CurrStep = TargetStep" x="1702.085" y="576.3027">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="413.7128,164.0906,415.804,125.3269" />
      </ECTransition>
      <ECTransition Source="Done" Destination="START" Condition="1" x="1997.812" y="580.3196">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="506.6993,124.9149,506.6235,167.1805" />
      </ECTransition>
      <ECTransition Source="START" Destination="HMI" Condition="SHOW_INIT_ACT AND ShwoInitAction" x="2369.985" y="663.8036">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="556.5978,166.056,625.2161,151.667" />
      </ECTransition>
      <ECTransition Source="HMI" Destination="START" Condition="1" x="2424.666" y="858.0651">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="640.7581,211.8518,573.3965,225.6345" />
      </ECTransition>
      <ECTransition Source="START" Destination="EmerOFF" Condition="EMER AND NOT EmergencyON " x="1434.475" y="1317.551">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="394.1248,308.789,323.649,360.7943" />
      </ECTransition>
      <ECTransition Source="EmerOFF" Destination="START" Condition="1" x="1326.787" y="1125.725">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="296.4411,297.0064,363.3411,246.5955" />
      </ECTransition>
      <ECTransition Source="START" Destination="STATE1" Condition="INIT_CMD AND InitRx_To_Step10" x="734.3013" y="991.941">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="207.0678,267.3726,104.8525,254.9438" />
      </ECTransition>
      <ECTransition Source="STATE1" Destination="START" Condition="1" x="1062.48" y="552.9208">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="208.2682,115.9313,311.3319,128.5953" />
      </ECTransition>
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[oInitDone := FALSE;
IF EnoughTime THEN
	IF ShowRxToFeed = ReactorID THEN
		IF ShowSettleTWait = ReactorID THEN
			GoToStep2 := FALSE;
			GoToStep10 := FALSE;
			TargetStep := 1;
			InitStatus := 200;
		ELSE
			GoToStep2 := FALSE;
			GoToStep10 := FALSE;
			TargetStep := 1;
			InitStatus := 1;
		END_IF;
	ELSE
		GoToStep2 := TRUE;
		GoToStep10 := FALSE;
		TargetStep := 2;
		InitStatus := 2;
	END_IF;
ELSE
	IF ShowRxToFeed = ReactorID THEN
		IF ShowSettleTWait = ReactorID THEN
			GoToStep2 := FALSE;
			GoToStep10 := FALSE;
			TargetStep := 1;
			InitStatus := 200;
		ELSE
			GoToStep2 := FALSE;
			GoToStep10 := FALSE;
			TargetStep := 1;
			InitStatus := 1;
		END_IF;
	ELSE
		GoToStep2 := FALSE;
		GoToStep10 := TRUE;
		TargetStep := 10;
		InitStatus := 10;
	END_IF;
END_IF;]]></ST>
    </Algorithm>
    <Algorithm ID="9402421c-dd72-41bd-9995-96dddc1e4d56" Name="InitDone">
      <ST><![CDATA[GoToStep2 := FALSE;
GoToStep10 := FALSE;
oInitDone := TRUE;
TargetStep := 255;
InitStatus := 255;]]></ST>
    </Algorithm>
    <Algorithm ID="2b9c9706-a852-4559-9ef7-cd51e364bd56" Name="EmerOFF">
      <ST><![CDATA[;
GoToStep2 := FALSE;
GoToStep10 := FALSE;
oInitDone := FALSE;
TargetStep := 255;
InitStatus := 0;]]></ST>
    </Algorithm>
    <Algorithm ID="a48fcde0-b0b9-4c38-9286-ce3af1c5cc83" Name="InitToStep10">
      <ST><![CDATA[;
GoToStep2 := FALSE;
GoToStep10 := TRUE;
TargetStep := 10;
InitStatus := 10;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>