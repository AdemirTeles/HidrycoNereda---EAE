      <Parameter Name="Font" Value="Microsoft Sans Serif, 10pt" />
      <Parameter Name="TextAlignment" Value="TopCenter" />
      <Parameter Name="MoveStyle" Value="None" />
      <Parameter Name="Text" Value="Operating conditions :&#xD;&#xA;1. Discharge valve AV41103 is available and valves for other reactors of the same line (AV4x103) is&#xD;&#xA;closed&#xD;&#xA;2. Lower level valve AV41102 is closed.&#xD;&#xA;3. Reserved, do not use&#xD;&#xA;4. Phase ‘feed’ sludge buffer (1 for line A, 2 for line B) NOT aborted and NOT interlocked (1 for line A, 2&#xD;&#xA;for line B)&#xD;&#xA;5. Air fill valve sludge discharge AV41171 is closed&#xD;&#xA;6.	No High level in the sludge holding tank 49LT3001 (In case of sludge holding tank)&#xA;7.	No HH-level in the sludge holding tank LS??? (In case of sludge holding tank)&#xA;8.	Level measurement in sludge holding tank is available (In case of sludge holding tank)" />
      <Parameter Name="NxtLayerIdentifier" Value="" />
