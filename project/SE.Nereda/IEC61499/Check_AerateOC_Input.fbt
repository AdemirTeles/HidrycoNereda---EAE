    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;

IF NOT (Cdt AND NOT(AerateStarting OR AerateRunning OR AerateStopping)) THEN
	Input := TRUE;
ELSE 
	Input := FALSE;
END_IF;]]></ST>
