    <Algorithm Name="FEED">
      <ST><![CDATA[;
CmdFeed := TRUE;
CmdWait := FALSE;
CmdSludgeDischarge := FALSE;
CmdSupernatantDischarge := FALSE;

Grafcet := 1;]]></ST>
    </Algorithm>
    <Algorithm Name="StopAll">
      <ST><![CDATA[;
