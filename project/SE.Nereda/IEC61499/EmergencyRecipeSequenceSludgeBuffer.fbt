    <Algorithm Name="FEED">
      <ST><![CDATA[;
CmdFeed := TRUE;
CmdWait := FALSE;
CmdSludgeDischarge := FALSE;
CmdSupernatantDischarge := FALSE;

Grafcet := 1;]]></ST>
    </Algorithm>
    <Algorithm Name="StopAll">
      <ST><![CDATA[;
CmdFeed := FALSE;
CmdWait := FALSE;
CmdSludgeDischarge := FALSE;
CmdSupernatantDischarge := FALSE;

Grafcet := 5;]]></ST>
    </Algorithm>
    <Algorithm ID="dce46f28-c176-451f-a36e-2de28e923e10" Name="WAIT_S2">
      <ST><![CDATA[;
CmdFeed := FALSE;
CmdWait := TRUE;
CmdSludgeDischarge := FALSE;
CmdSupernatantDischarge := FALSE;

Grafcet := 2;]]></ST>
    </Algorithm>
    <Algorithm ID="dfb46956-7eaa-4da9-908a-dcdeaf99b614" Name="SLUDGE_DISCHARGE_S3">
      <ST><![CDATA[;
CmdFeed := FALSE;
CmdWait := FALSE;
CmdSludgeDischarge := TRUE;
CmdSupernatantDischarge := FALSE;

Grafcet := 3;]]></ST>
    </Algorithm>
    <Algorithm ID="b32f283d-63f7-4a7f-9954-140f5e4fa847" Name="SludgeSupernanatDischargeS4">
      <ST><![CDATA[;
CmdFeed := FALSE;
CmdWait := FALSE;
CmdSludgeDischarge := FALSE;
CmdSupernatantDischarge := TRUE;

Grafcet := 4;]]></ST>
    </Algorithm>
    <Algorithm ID="103d97d9-ba6d-471f-b548-186878711f1b" Name="IDLE_S0">
      <ST><![CDATA[;
Grafcet :=0;

CmdFeed := FALSE;
CmdWait := FALSE;
CmdSludgeDischarge := FALSE;
CmdSupernatantDischarge := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="StepEnd" Comment="Fim do passo: zera os comandos e espera a fase parar (Grafcet nao muda)">
      <ST><![CDATA[CmdFeed := FALSE;
CmdWait := FALSE;
CmdSludgeDischarge := FALSE;
CmdSupernatantDischarge := FALSE;]]></ST>
    </Algorithm>
