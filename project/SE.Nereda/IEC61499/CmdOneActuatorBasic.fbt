Grafcet := 2;
StartReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="CloseStopAct">
      <ST><![CDATA[;
Grafcet := 3;
CmdActuator := FALSE;
StartReady := FALSE;
AbortReady  := FALSE;]]></ST>
    </Algorithm>
