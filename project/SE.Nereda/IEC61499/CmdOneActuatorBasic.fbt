    <Algorithm Name="OpenRunAct" Comment="Normally executed algorithm">
      <ST><![CDATA[;
Grafcet := 1;
CmdActuator := TRUE;
StopReady := FALSE;
AbortReady := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="StartReady">
