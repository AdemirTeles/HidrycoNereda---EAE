      <ECTransition Source="START" Destination="R_NO_AV" Condition="REQ AND (&#xD;&#xA;NOT R1Available OR&#xD;&#xA;NOT R2Available OR&#xD;&#xA;NOT R3Available OR&#xD;&#xA;NOT R4Available OR&#xD;&#xA;NOT R5Available OR&#xD;&#xA;NOT R6Available) AND&#xD;&#xA;EmergencyON" x="1291.621" y="883.9783">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="322.2072,200.2244,323.4628,242.0324" />
      </ECTransition>
      <ECTransition Source="R_NO_AV" Destination="BACK_AV" Condition="R1Available AND&#xD;&#xA;R2Available AND&#xD;&#xA;R3Available AND&#xD;&#xA;R4Available AND&#xD;&#xA;R5Available AND&#xD;&#xA;R6Available" x="1296.1" y="1446.551">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="323.831,341.7802,324.1469,379.5315" />
