      <VarDeclaration ID="9A72FCE4A16B3A07" Name="MemoR6Available" Type="BOOL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="1292.275" y="578.0784" />
      <ECState Name="R_NO_AV" x="1293.333" y="1186.667">
        <ECAction Algorithm="REQ" Output="CNF" />
      </ECState>
      <ECState Name="BACK_AV" x="1300" y="1730">
