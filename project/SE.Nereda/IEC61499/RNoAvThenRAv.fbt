    <Algorithm ID="b9783581-e0a0-49d2-b290-6c1947911d92" Name="REQ">
      <ST><![CDATA[;
MemoR1Available := R1Available;
MemoR2Available := R2Available;
MemoR3Available := R3Available;
MemoR4Available := R4Available;
MemoR5Available := R5Available;
MemoR6Available := R6Available;

R1GoToS8W := FALSE;
R2GoToS8W := FALSE;
R3GoToS8W := FALSE;
R4GoToS8W := FALSE;
R5GoToS8W := FALSE;
R6GoToS8W := FALSE;]]></ST>
    </Algorithm>
    <Algorithm ID="3d490dbe-5d3b-4410-b7f9-f618d1dafc1e" Name="BACK_AV">
      <ST><![CDATA[;
R1GoToS8W := FALSE;
R2GoToS8W := FALSE;
R3GoToS8W := FALSE;
R4GoToS8W := FALSE;
R5GoToS8W := FALSE;
R6GoToS8W := FALSE;

IF NOT MemoR1Available THEN
    R1GoToS8W := TRUE;
END_IF;

IF NOT MemoR2Available THEN
    R2GoToS8W := TRUE;
END_IF;

IF NOT MemoR3Available THEN
    R3GoToS8W := TRUE;
END_IF;

IF NOT MemoR4Available THEN
    R4GoToS8W := TRUE;
END_IF;

IF NOT MemoR5Available THEN
    R5GoToS8W := TRUE;
END_IF;

IF NOT MemoR6Available THEN
    R6GoToS8W := TRUE;
END_IF;]]></ST>
    </Algorithm>
