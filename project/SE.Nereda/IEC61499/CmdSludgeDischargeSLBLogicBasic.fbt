  <BasicFB ID="b09b6cfe-84e6-466d-9649-93dbbf4f5b70">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="AlgMain,AlgTick" />
    <InternalVars>
      <VarDeclaration Name="UseSup" Type="BOOL" />
      <VarDeclaration Name="AllPumpsStopped" Type="BOOL" />
      <VarDeclaration Name="AnyPumpRunning" Type="BOOL" />
      <VarDeclaration Name="ValvesOpenOk" Type="BOOL" />
      <VarDeclaration Name="ValvesClosedOk" Type="BOOL" />
      <VarDeclaration Name="Spare" Type="BOOL" />
      <VarDeclaration Name="ParOk" Type="BOOL" />
      <VarDeclaration Name="NCmd" Type="INT" />
      <VarDeclaration Name="NRun" Type="INT" />
      <VarDeclaration Name="NWant" Type="INT" />
      <VarDeclaration Name="PumpSel" Type="INT" />
      <VarDeclaration Name="NCmdPrev" Type="INT" />
      <VarDeclaration Name="MinTot" Type="UDINT" />
      <VarDeclaration Name="MinOrd" Type="UDINT" />
      <VarDeclaration Name="Seq" Type="UDINT" />
      <VarDeclaration Name="Ord1" Type="UDINT" />
      <VarDeclaration Name="Ord2" Type="UDINT" />
      <VarDeclaration Name="Ord3" Type="UDINT" />
      <VarDeclaration Name="Tacc" Type="TIME" />
      <VarDeclaration Name="T3acc" Type="TIME" />
      <VarDeclaration Name="Trest" Type="TIME" />
      <VarDeclaration Name="Tll" Type="TIME" />
      <VarDeclaration Name="PrevPC" Type="INT" />
      <VarDeclaration Name="EdgeOut" Type="BOOL" />
      <VarDeclaration Name="EdgeSpd" Type="BOOL" />
      <VarDeclaration Name="PrevSpd" Type="REAL" />
      <VarDeclaration Name="PrevSR" Type="BOOL" />
      <VarDeclaration Name="PrevST" Type="BOOL" />
      <VarDeclaration Name="PrevAB" Type="BOOL" />
      <VarDeclaration Name="PrevSP" Type="REAL" />
      <VarDeclaration Name="PrevGR" Type="INT" />
      <VarDeclaration Name="PrevSel" Type="INT" />
      <VarDeclaration Name="PrevSec" Type="INT" />
      <VarDeclaration Name="PrevPM" Type="INT" />
    </InternalVars>
    <ECC>
      <ECState Name="START" x="2600" y="300" />
      <ECState Name="TIMEBASE" x="1200" y="1100">
        <ECAction Algorithm="AlgTick" />
      </ECState>
      <ECState Name="EVAL" x="2600" y="1100">
        <ECAction Algorithm="AlgMain" Output="VALVE_CNF" />
        <ECAction Output="PUMP_CNF" />
      </ECState>
      <ECState Name="SEND_OUT" x="2600" y="1900">
        <ECAction Output="SP_CNF" />
        <ECAction Output="START_READY" />
        <ECAction Output="STOP_READY" />
        <ECAction Output="ABORTED_READY" />
        <ECAction Output="GRAPH" />
      </ECState>
      <ECState Name="SEND_SPD" x="4000" y="1900">
        <ECAction Output="SPEED_CNF" />
      </ECState>
      <ECTransition Source="START" Destination="TIMEBASE" Condition="TICK" x="1700" y="700" />
      <ECTransition Source="START" Destination="EVAL" Condition="READY OR STARTING OR RUN OR STOPPING OR ABORTING OR VALVE_FB OR PUMP_FB OR VALVE_READY OR PUMP_READY OR PUMP_TOT OR SP OR LEVEL OR FLOW OR PID_UPD" x="2700" y="700" />
      <ECTransition Source="TIMEBASE" Destination="EVAL" Condition="1" x="1900" y="1150" />
      <ECTransition Source="EVAL" Destination="SEND_OUT" Condition="EdgeOut" x="2700" y="1500" />
      <ECTransition Source="EVAL" Destination="SEND_SPD" Condition="EdgeSpd" x="3400" y="1500" />
      <ECTransition Source="EVAL" Destination="START" Condition="1" x="3300" y="700" />
      <ECTransition Source="SEND_OUT" Destination="SEND_SPD" Condition="EdgeSpd" x="3300" y="2000" />
      <ECTransition Source="SEND_OUT" Destination="START" Condition="1" x="3700" y="1100" />
      <ECTransition Source="SEND_SPD" Destination="START" Condition="1" x="4200" y="1000" />
    </ECC>
    <Algorithm Name="AlgMain" Comment="Logica de valvulas/bombas da descarga">
      <ST><![CDATA[;
(* ============================================================
   CmdSludgeDischargeSLBLogicBasic Rev2 - logica de descarga do Sludge Buffer
   SupernatantMode = FALSE : descarga de lodo  (1 servico + 2 reserva,
                              AV49004 E/OU AV49005, tolera falha de uma delas)
   SupernatantMode = TRUE  : descarga de sobrenadante (2 servico + 1 reserva,
                              AV49002 + AV49003 + AV40001, Cmax/C2/C3 em m3/h)
   Grafcet: 0 repouso | 1 abrindo valvulas | 2 StartReady | 3 Run
            4 parando bombas | 5 fechando valvulas | 6 StopReady
            7 abortando bombas | 8 abortando valvulas | 9 AbortedReady
   PumpMode (sobrenadante): 0 uma bomba | 1 segunda bomba entrando, ambas em C2
            2 ambas rodando em C2 (T_C2) | 3 duas bombas moduladas pelo PID
   Capacidade = saida do PID (0-100 % da capacidade total). Cmax [%] = parcela de uma bomba.
   Velocidade: 1 bomba = PID/Cmax*100 ; 2 bombas = PID/(2*Cmax)*100 ; entrada = C2
   PauseCause: 0 sem pausa | 1 nivel L 49LT0001 | 2 vazao LL 49FT0004
   ============================================================ *)

(* ---------- 1. Estado da fase -> Grafcet ---------- *)
IF Aborting THEN
    IF Grafcet < 7 THEN
        Grafcet := 7;
    END_IF;
ELSIF Stopping THEN
    IF (Grafcet < 4) OR (Grafcet > 6) THEN
        Grafcet := 4;
    END_IF;
ELSIF Starting THEN
    IF (Grafcet <> 1) AND (Grafcet <> 2) THEN
        Grafcet := 1;
    END_IF;
ELSIF Run THEN
    Grafcet := 3;
ELSE
    Grafcet := 0;
END_IF;

(* ---------- 2. Condicoes auxiliares ---------- *)
UseSup := SupernatantMode;
(* bomba conta como parada se parada, ou se fora de programa (sem Ready) E sem Running.
   Bomba em modo operador ainda rodando segura o fechamento das valvulas *)
AllPumpsStopped := (PumpFbStopped_1 OR (NOT PumpReady_1 AND NOT PumpFbRunning_1)) AND (PumpFbStopped_2 OR (NOT PumpReady_2 AND NOT PumpFbRunning_2)) AND (PumpFbStopped_3 OR (NOT PumpReady_3 AND NOT PumpFbRunning_3));
AnyPumpRunning := PumpFbRunning_1 OR PumpFbRunning_2 OR PumpFbRunning_3;
IF SupernatantMode THEN
    ValvesOpenOk := ValveFbOpen_1 AND ValveFbOpen_2 AND ValveFbOpen_Supernant;
ELSE
    ValvesOpenOk := (ValveFbOpen_1 OR NOT ValveReady_1) AND (ValveFbOpen_2 OR NOT ValveReady_2) AND (ValveFbOpen_1 OR ValveFbOpen_2);
END_IF;
ValvesClosedOk := (ValveFbClose_1 OR NOT ValveReady_1) AND (ValveFbClose_2 OR NOT ValveReady_2) AND ((NOT UseSup) OR ValveFbClose_Supernant OR NOT ValveReady_Supernant);

(* ---------- 3. Transicoes ---------- *)
IF (Grafcet = 1) AND ValvesOpenOk THEN
    Grafcet := 2;
END_IF;
IF (Grafcet = 4) AND AllPumpsStopped THEN
    Grafcet := 5;
END_IF;
IF (Grafcet = 5) AND ValvesClosedOk THEN
    Grafcet := 6;
END_IF;
IF (Grafcet = 7) AND AllPumpsStopped THEN
    Grafcet := 8;
END_IF;
IF (Grafcet = 8) AND ValvesClosedOk THEN
    Grafcet := 9;
END_IF;

(* ---------- 4. Valvulas (fecham so depois das bombas pararem) ---------- *)
IF (Grafcet >= 1) AND (Grafcet <= 4) THEN
    Valve_Tank1 := TRUE;
    Valve_Tank2 := TRUE;
    Valve_TankSupernant := UseSup;
ELSIF (Grafcet = 5) OR (Grafcet = 6) OR (Grafcet >= 8) OR ((Grafcet = 0) AND NOT AnyPumpRunning) THEN
    Valve_Tank1 := FALSE;
    Valve_Tank2 := FALSE;
    Valve_TankSupernant := FALSE;
END_IF;

(* ---------- 5. Bombas ---------- *)
IF Grafcet = 3 THEN
    (* 5.0 pausa no RUN (5.2 / 5.3.6 da narrativa): nivel L do 49LT0001 ou vazao LL do 49FT0004.
       Bombas param, valvulas permanecem abertas; retoma T_Restart apos a causa sair, sem reset *)
    IF Paused AND (NOT LowLevel) AND (Trest >= T_Restart) THEN
        Paused := FALSE;
        PauseCause := 0;
        Tll := T#0s;
    END_IF;
    IF LowLevel THEN
        Paused := TRUE;
        PauseCause := 1;
        Trest := T#0s;
    END_IF;
    IF (NOT Paused) AND (T_FlowLL > T#0s) AND (Tll >= T_FlowLL) THEN
        Paused := TRUE;
        PauseCause := 2;
        Trest := T#0s;
        Tll := T#0s;
    END_IF;
END_IF;
IF (Grafcet = 3) AND Paused THEN
    Pump_1 := FALSE;
    Pump_2 := FALSE;
    Pump_3 := FALSE;
    PumpMode := 0;
    Tacc := T#0s;
    T3acc := T#0s;
    NCmd := 0;
    NRun := 0;
    EffFlowSp := FlowSp;
    PumpSpeed := PIDOut;
ELSIF Grafcet = 3 THEN
    (* 5.1 bomba sai de servico somente se nao estiver Ready (modo programa) NEM Running.
       Bomba passada para modo operador e ainda rodando continua contando: nao parte reserva *)
    IF Pump_1 AND NOT PumpReady_1 AND NOT PumpFbRunning_1 THEN
        Pump_1 := FALSE;
    END_IF;
    IF Pump_2 AND NOT PumpReady_2 AND NOT PumpFbRunning_2 THEN
        Pump_2 := FALSE;
    END_IF;
    IF Pump_3 AND NOT PumpReady_3 AND NOT PumpFbRunning_3 THEN
        Pump_3 := FALSE;
    END_IF;
    NCmd := 0;
    IF Pump_1 THEN
        NCmd := NCmd + 1;
    END_IF;
    IF Pump_2 THEN
        NCmd := NCmd + 1;
    END_IF;
    IF Pump_3 THEN
        NCmd := NCmd + 1;
    END_IF;
    NRun := 0;
    IF Pump_1 AND PumpFbRunning_1 THEN
        NRun := NRun + 1;
    END_IF;
    IF Pump_2 AND PumpFbRunning_2 THEN
        NRun := NRun + 1;
    END_IF;
    IF Pump_3 AND PumpFbRunning_3 THEN
        NRun := NRun + 1;
    END_IF;
    Spare := (PumpReady_1 AND NOT Pump_1) OR (PumpReady_2 AND NOT Pump_2) OR (PumpReady_3 AND NOT Pump_3);
    ParOk := SupernatantMode AND (Cmax > 0.0) AND (C2 > 0.0);

    (* 5.2 numero de bombas (so sobrenadante). Capacidade = saida do PID (0-100 % da capacidade total);
           Cmax = parcela que uma bomba cobre sozinha [%], C2 / C3 = velocidade de cada bomba [%]
           0: 1 bomba | 1: 2a bomba entrando, ambas em C2 | 2: ambas rodando em C2 (T_C2) | 3: duas no PID *)
    IF NOT ParOk THEN
        PumpMode := 0;
    ELSIF PumpMode = 0 THEN
        IF (PIDOut > Cmax) AND Spare AND (NRun >= 1) THEN
            PumpMode := 1;
            Tacc := T#0s;
        END_IF;
    ELSIF PumpMode = 1 THEN
        IF NRun >= 2 THEN
            PumpMode := 2;
            Tacc := T#0s;
        END_IF;
    ELSIF PumpMode = 2 THEN
        IF Tacc >= T_C2 THEN
            PumpMode := 3;
            T3acc := T#0s;
        END_IF;
    ELSIF PumpMode = 3 THEN
        (* saida exige a condicao fisica (velocidade abaixo de C3) alem do tempo: com T_C3 = 0 nao pode sair acima de C3 *)
        IF (PumpSpeed < C3) AND (T3acc >= T_C3) THEN
            PumpMode := 0;
            T3acc := T#0s;
        END_IF;
    END_IF;
    IF PumpMode >= 1 THEN
        NWant := 2;
    ELSE
        NWant := 1;
    END_IF;

    (* 5.3 entra bomba disponivel de menor horimetro (rodizio) - ate 2 vezes *)
    NCmdPrev := NCmd;
    IF NCmd < NWant THEN
        PumpSel := 0;
        IF PumpReady_1 AND NOT Pump_1 THEN
            PumpSel := 1;
            MinTot := PumpTotOpe_1;
        END_IF;
        IF PumpReady_2 AND NOT Pump_2 THEN
            IF (PumpSel = 0) OR (PumpTotOpe_2 < MinTot) THEN
                PumpSel := 2;
                MinTot := PumpTotOpe_2;
            END_IF;
        END_IF;
        IF PumpReady_3 AND NOT Pump_3 THEN
            IF (PumpSel = 0) OR (PumpTotOpe_3 < MinTot) THEN
                PumpSel := 3;
                MinTot := PumpTotOpe_3;
            END_IF;
        END_IF;
        IF PumpSel = 1 THEN
            Pump_1 := TRUE;
            Seq := Seq + 1;
            Ord1 := Seq;
            NCmd := NCmd + 1;
        ELSIF PumpSel = 2 THEN
            Pump_2 := TRUE;
            Seq := Seq + 1;
            Ord2 := Seq;
            NCmd := NCmd + 1;
        ELSIF PumpSel = 3 THEN
            Pump_3 := TRUE;
            Seq := Seq + 1;
            Ord3 := Seq;
            NCmd := NCmd + 1;
        END_IF;
    END_IF;
    IF NCmd < NWant THEN
        PumpSel := 0;
        IF PumpReady_1 AND NOT Pump_1 THEN
            PumpSel := 1;
            MinTot := PumpTotOpe_1;
        END_IF;
        IF PumpReady_2 AND NOT Pump_2 THEN
            IF (PumpSel = 0) OR (PumpTotOpe_2 < MinTot) THEN
                PumpSel := 2;
                MinTot := PumpTotOpe_2;
            END_IF;
        END_IF;
        IF PumpReady_3 AND NOT Pump_3 THEN
            IF (PumpSel = 0) OR (PumpTotOpe_3 < MinTot) THEN
                PumpSel := 3;
                MinTot := PumpTotOpe_3;
            END_IF;
        END_IF;
        IF PumpSel = 1 THEN
            Pump_1 := TRUE;
            Seq := Seq + 1;
            Ord1 := Seq;
            NCmd := NCmd + 1;
        ELSIF PumpSel = 2 THEN
            Pump_2 := TRUE;
            Seq := Seq + 1;
            Ord2 := Seq;
            NCmd := NCmd + 1;
        ELSIF PumpSel = 3 THEN
            Pump_3 := TRUE;
            Seq := Seq + 1;
            Ord3 := Seq;
            NCmd := NCmd + 1;
        END_IF;
    END_IF;

    (* 5.3b bomba entrando para compor 2 bombas (reserva substituindo bomba intertravada/em falha):
            mesma sequencia da entrada - todas em C2, as duas rodando por T_C2, depois PID *)
    IF (PumpMode >= 2) AND (NCmd > NCmdPrev) THEN
        PumpMode := 1;
        Tacc := T#0s;
    END_IF;

    (* 5.4 excedente: sai a bomba em operacao ha mais tempo (menor ordem de partida) *)
    IF NCmd > NWant THEN
        PumpSel := 0;
        IF Pump_1 THEN
            PumpSel := 1;
            MinOrd := Ord1;
        END_IF;
        IF Pump_2 THEN
            IF (PumpSel = 0) OR (Ord2 < MinOrd) THEN
                PumpSel := 2;
                MinOrd := Ord2;
            END_IF;
        END_IF;
        IF Pump_3 THEN
            IF (PumpSel = 0) OR (Ord3 < MinOrd) THEN
                PumpSel := 3;
                MinOrd := Ord3;
            END_IF;
        END_IF;
        IF PumpSel = 1 THEN
            Pump_1 := FALSE;
        ELSIF PumpSel = 2 THEN
            Pump_2 := FALSE;
        ELSIF PumpSel = 3 THEN
            Pump_3 := FALSE;
        END_IF;
        NCmd := NCmd - 1;
    END_IF;

    (* 5.5 sem bomba para a 2a posicao: volta a operar com uma *)
    IF (PumpMode >= 1) AND (NCmd < 2) THEN
        PumpMode := 0;
    END_IF;

    (* 5.6 PI sempre no setpoint de vazao; velocidade das bombas conforme o modo *)
    EffFlowSp := FlowSp;
    IF NOT ParOk THEN
        PumpSpeed := PIDOut;
    ELSIF (PumpMode = 1) OR (PumpMode = 2) THEN
        PumpSpeed := C2;
    ELSIF PumpMode = 3 THEN
        PumpSpeed := PIDOut / (2.0 * Cmax) * 100.0;
    ELSE
        PumpSpeed := PIDOut / Cmax * 100.0;
    END_IF;
    IF PumpSpeed > 100.0 THEN
        PumpSpeed := 100.0;
    END_IF;
    IF PumpSpeed < 0.0 THEN
        PumpSpeed := 0.0;
    END_IF;
ELSE
    Pump_1 := FALSE;
    Pump_2 := FALSE;
    Pump_3 := FALSE;
    PumpMode := 0;
    Tacc := T#0s;
    T3acc := T#0s;
    NCmd := 0;
    NRun := 0;
    EffFlowSp := FlowSp;
    PumpSpeed := PIDOut;
    Paused := FALSE;
    PauseCause := 0;
    Trest := T#0s;
    Tll := T#0s;
END_IF;

(* ---------- 6. Saidas para a fase e IHM ---------- *)
StartReady := (Grafcet = 2) OR (Grafcet = 3);
StopReady := (Grafcet = 6);
AbortedReady := (Grafcet = 9);
SelectedPump := 0;
SecondPump := 0;
MinOrd := 0;
IF Pump_1 THEN
    SelectedPump := 1;
    MinOrd := Ord1;
END_IF;
IF Pump_2 THEN
    IF (SelectedPump = 0) OR (Ord2 < MinOrd) THEN
        SecondPump := SelectedPump;
        SelectedPump := 2;
        MinOrd := Ord2;
    ELSE
        SecondPump := 2;
    END_IF;
END_IF;
IF Pump_3 THEN
    IF (SelectedPump = 0) OR (Ord3 < MinOrd) THEN
        SecondPump := SelectedPump;
        SelectedPump := 3;
        MinOrd := Ord3;
    ELSE
        SecondPump := 3;
    END_IF;
END_IF;

(* ---------- 7. Eventos de saida somente quando algum valor muda ---------- *)
EdgeOut := (StartReady <> PrevSR) OR (StopReady <> PrevST) OR (AbortedReady <> PrevAB) OR (EffFlowSp <> PrevSP) OR (Grafcet <> PrevGR) OR (SelectedPump <> PrevSel) OR (SecondPump <> PrevSec) OR (PumpMode <> PrevPM) OR (PauseCause <> PrevPC);
PrevSR := StartReady;
PrevST := StopReady;
PrevAB := AbortedReady;
PrevSP := EffFlowSp;
PrevGR := Grafcet;
PrevSel := SelectedPump;
PrevSec := SecondPump;
PrevPM := PumpMode;
PrevPC := PauseCause;
EdgeSpd := PumpSpeed <> PrevSpd;
PrevSpd := PumpSpeed;
]]></ST>
    </Algorithm>
    <Algorithm Name="AlgTick" Comment="Base de tempo 1 s">
      <ST><![CDATA[;
(* Base de tempo 1 s (E_CYCLE externo): tempos em C2 e abaixo de C3 *)
IF (PumpMode = 2) AND (NRun >= 2) THEN
    Tacc := Tacc + T#1s;
END_IF;
(* duas bombas operando com velocidade abaixo de C3 *)
IF (PumpMode = 3) AND (NRun >= 2) AND (PumpSpeed < C3) THEN
    T3acc := T3acc + T#1s;
ELSE
    T3acc := T#0s;
END_IF;
IF (Grafcet = 3) AND Paused AND (NOT LowLevel) THEN
    Trest := Trest + T#1s;
ELSE
    Trest := T#0s;
END_IF;
IF (Grafcet = 3) AND (NOT Paused) AND (NRun >= 1) AND FlowLL AND (NOT FlowFail) THEN
    Tll := Tll + T#1s;
ELSE
    Tll := T#0s;
END_IF;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>