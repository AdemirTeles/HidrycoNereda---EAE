      <VarDeclaration ID="2E15F5890513A407" Name="PauseCause" Type="INT" Comment="0=sem pausa 1=nivel L 49LT0001 2=vazao LL 49FT0004" />
      <VarDeclaration ID="1E314D8B4487BA0C" Name="PumpSpeed" Type="REAL" Comment="Velocidade enviada as bombas [%]" />
    </OutputVars>
