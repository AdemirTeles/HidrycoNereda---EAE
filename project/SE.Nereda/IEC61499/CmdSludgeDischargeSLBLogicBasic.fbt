    </ECC>
    <Algorithm Name="AlgMain" Comment="Logica de valvulas/bombas da descarga">
      <ST><![CDATA[;
(* ============================================================
   CmdSludgeDischargeSLBLogicBasic Rev2 - logica de descarga do Sludge Buffer
   SupernatantMode = FALSE : descarga de lodo  (1 servico + 2 reserva,
                              AV49004 E/OU AV49005, tolera falha de uma delas)
   SupernatantMode = TRUE  : descarga de sobrenadante (2 servico + 1 reserva,
                              AV49002 + AV49003 + AV40001, Cmax/C2/C3 em m3/h)
   Grafcet: 0 repouso | 1 abrindo valvulas | 2 StartReady | 3 Run
            4 parando bombas | 5 fechando valvulas | 6 StopReady
            7 abortando bombas | 8 abortando valvulas | 9 AbortedReady
   PumpMode (sobrenadante): 0 uma bomba | 1 reduzindo a(s) bomba(s) em operacao p/ C2, a nova ainda parada
            2 nova bomba partindo, todas em C2 (T_C2 com as duas rodando) | 3 duas bombas moduladas pelo PID
   Rev12: sempre que parte uma bomba nova (entrada da 2a ou reserva no lugar de uma que saiu),
   a que esta rodando desce primeiro ate C2; a nova so parte com FbSpeedPv <= C2 + TolC2 ou apos T_DecMax.
   Rev13: T_C2 so conta com as duas com velocidade real em C2; reserva em falha parte na hora (modo 2);
   saida da 2a: Dem < C3 E 2 x Dem < Cmax - HystExit (parametros incoerentes nao travam: ParBad so avisa).
   Rev11: demanda = saida do PID [%] (sobrenadante: 100 % = 2 bombas a 100 %; lodo: 100 % = 1 bomba).
   Em falha do 49FT0004 a demanda = SP em % da faixa do medidor.
   Cmax / C2 / C3 / Cmin em % de velocidade de UMA bomba (o que o inversor mostra).
   Velocidade (sobrenadante): 1 bomba = 2 x demanda ; 2 bombas = demanda ; entrada = C2.
   Lodo: velocidade = demanda. Toda bomba em servico nunca abaixo de Cmin.
   PauseCause: 0 sem pausa | 1 nivel L 49LT0001 | 2 vazao LL 49FT0004
   ============================================================ *)

(* ---------- 1. Estado da fase -> Grafcet ---------- *)
IF Aborting THEN
    IF Grafcet < 7 THEN
        Grafcet := 7;
    END_IF;
ELSIF Stopping THEN
    IF (Grafcet < 4) OR (Grafcet > 6) THEN
        Grafcet := 4;
    END_IF;
ELSIF Starting THEN
    IF (Grafcet <> 1) AND (Grafcet <> 2) THEN
        Grafcet := 1;
    END_IF;
ELSIF Run THEN
    Grafcet := 3;
ELSE
    Grafcet := 0;
END_IF;

(* ---------- 2. Condicoes auxiliares ---------- *)
UseSup := SupernatantMode;
(* bomba conta como parada se parada, ou se fora de programa (sem Ready) E sem Running.
   Bomba em modo operador ainda rodando segura o fechamento das valvulas *)
AllPumpsStopped := (PumpFbStopped_1 OR (NOT PumpReady_1 AND NOT PumpFbRunning_1)) AND (PumpFbStopped_2 OR (NOT PumpReady_2 AND NOT PumpFbRunning_2)) AND (PumpFbStopped_3 OR (NOT PumpReady_3 AND NOT PumpFbRunning_3));
AnyPumpRunning := PumpFbRunning_1 OR PumpFbRunning_2 OR PumpFbRunning_3;
IF SupernatantMode THEN
    ValvesOpenOk := ValveFbOpen_1 AND ValveFbOpen_2 AND ValveFbOpen_Supernant;
ELSE
    ValvesOpenOk := (ValveFbOpen_1 OR NOT ValveReady_1) AND (ValveFbOpen_2 OR NOT ValveReady_2) AND (ValveFbOpen_1 OR ValveFbOpen_2);
END_IF;
ValvesClosedOk := (ValveFbClose_1 OR NOT ValveReady_1) AND (ValveFbClose_2 OR NOT ValveReady_2) AND ((NOT UseSup) OR ValveFbClose_Supernant OR NOT ValveReady_Supernant);

(* 2b. demanda, velocidade minima e coerencia dos parametros *)
IF FlowFail THEN
    IF FlowPvMax > FlowPvMin THEN
        Dem := (FlowSp - FlowPvMin) / (FlowPvMax - FlowPvMin) * 100.0;
    ELSE
        Dem := 0.0;
    END_IF;
ELSE
    Dem := PIDOut;
END_IF;
IF Dem > 100.0 THEN
    Dem := 100.0;
END_IF;
IF Dem < 0.0 THEN
    Dem := 0.0;
END_IF;
CminEff := Cmin;
IF CminEff > 100.0 THEN
    CminEff := 100.0;
END_IF;
IF CminEff < 0.0 THEN
    CminEff := 0.0;
END_IF;
(* C3 acima de Cmin (senao a 2a bomba nunca sai); 2 x C3 abaixo de Cmax (senao entra e sai em ciclo) *)
(* Rev13: so Cmax e C2 sao indispensaveis; o resto apenas avisa (ParBad) - a protecao anti-ciclo esta embutida na saida *)
ParOk := SupernatantMode AND (Cmax > 0.0) AND (C2 > 0.0);
ParBad := (SupernatantMode AND ((Cmax <= 0.0) OR (C2 <= 0.0) OR (C2 < CminEff) OR (C3 <= CminEff) OR ((2.0 * C3) >= Cmax))) OR (Cmin < 0.0) OR (Cmin > 100.0);
(* C2 efetivo nunca abaixo da velocidade minima *)
C2Eff := C2;
IF C2Eff < CminEff THEN
    C2Eff := CminEff;
END_IF;
(* saida da 2a bomba: velocidade pedida abaixo de C3 E a bomba que fica assume sem passar de Cmax - HystExit *)
ExitCond := (Dem < C3) AND ((2.0 * Dem) < (Cmax - HystExit));

(* ---------- 3. Transicoes ---------- *)
IF (Grafcet = 1) AND ValvesOpenOk THEN
    Grafcet := 2;
END_IF;
IF (Grafcet = 4) AND AllPumpsStopped THEN
    Grafcet := 5;
END_IF;
IF (Grafcet = 5) AND ValvesClosedOk THEN
    Grafcet := 6;
END_IF;
IF (Grafcet = 7) AND AllPumpsStopped THEN
    Grafcet := 8;
END_IF;
IF (Grafcet = 8) AND ValvesClosedOk THEN
    Grafcet := 9;
END_IF;

(* ---------- 4. Valvulas (fecham so depois das bombas pararem) ---------- *)
IF (Grafcet >= 1) AND (Grafcet <= 4) THEN
    Valve_Tank1 := TRUE;
    Valve_Tank2 := TRUE;
    Valve_TankSupernant := UseSup;
ELSIF (Grafcet = 5) OR (Grafcet = 6) OR (Grafcet >= 8) OR ((Grafcet = 0) AND NOT AnyPumpRunning) THEN
    Valve_Tank1 := FALSE;
    Valve_Tank2 := FALSE;
    Valve_TankSupernant := FALSE;
END_IF;

(* ---------- 5. Bombas ---------- *)
IF Grafcet = 3 THEN
    (* 5.0 pausa no RUN (5.2 / 5.3.6 da narrativa): nivel L do 49LT0001 ou vazao LL do 49FT0004.
       Bombas param, valvulas permanecem abertas; retoma T_Restart apos a causa sair, sem reset *)
    IF Paused AND (NOT LowLevel) AND (Trest >= T_Restart) THEN
        Paused := FALSE;
        PauseCause := 0;
        Tll := T#0s;
    END_IF;
    IF LowLevel THEN
        Paused := TRUE;
        PauseCause := 1;
        Trest := T#0s;
    END_IF;
    IF (NOT Paused) AND (T_FlowLL > T#0s) AND (Tll >= T_FlowLL) THEN
        Paused := TRUE;
        PauseCause := 2;
        Trest := T#0s;
        Tll := T#0s;
    END_IF;
END_IF;
IF (Grafcet = 3) AND Paused THEN
    Pump_1 := FALSE;
    Pump_2 := FALSE;
    Pump_3 := FALSE;
    PumpMode := 0;
    Tacc := T#0s;
    TC2s := 0;
    T3acc := T#0s;
    TC3s := 0;
    NCmd := 0;
    NRun := 0;
    EffFlowSp := FlowSp;
    PumpSpeed := PIDOut;
    AtMin := FALSE;
ELSIF Grafcet = 3 THEN
    (* 5.1 bomba sai de servico somente se nao estiver Ready (modo programa) NEM Running.
       Bomba passada para modo operador e ainda rodando continua contando: nao parte reserva *)
    IF Pump_1 AND NOT PumpReady_1 AND NOT PumpFbRunning_1 THEN
        Pump_1 := FALSE;
    END_IF;
    IF Pump_2 AND NOT PumpReady_2 AND NOT PumpFbRunning_2 THEN
        Pump_2 := FALSE;
    END_IF;
    IF Pump_3 AND NOT PumpReady_3 AND NOT PumpFbRunning_3 THEN
        Pump_3 := FALSE;
    END_IF;
    NCmd := 0;
    IF Pump_1 THEN
        NCmd := NCmd + 1;
    END_IF;
    IF Pump_2 THEN
        NCmd := NCmd + 1;
    END_IF;
    IF Pump_3 THEN
        NCmd := NCmd + 1;
    END_IF;
    NRun := 0;
    IF Pump_1 AND PumpFbRunning_1 THEN
        NRun := NRun + 1;
    END_IF;
    IF Pump_2 AND PumpFbRunning_2 THEN
        NRun := NRun + 1;
    END_IF;
    IF Pump_3 AND PumpFbRunning_3 THEN
        NRun := NRun + 1;
    END_IF;
    Spare := (PumpReady_1 AND NOT Pump_1) OR (PumpReady_2 AND NOT Pump_2) OR (PumpReady_3 AND NOT Pump_3);
    (* bombas em operacao ja desceram ate C2 (velocidade real) *)
    SpdAtC2 := TRUE;
    IF Pump_1 AND PumpFbRunning_1 AND (PumpSpeedPv_1 > (C2Eff + TolC2)) THEN
        SpdAtC2 := FALSE;
    END_IF;
    IF Pump_2 AND PumpFbRunning_2 AND (PumpSpeedPv_2 > (C2Eff + TolC2)) THEN
        SpdAtC2 := FALSE;
    END_IF;
    IF Pump_3 AND PumpFbRunning_3 AND (PumpSpeedPv_3 > (C2Eff + TolC2)) THEN
        SpdAtC2 := FALSE;
    END_IF;
    (* bombas em operacao com velocidade real ja em C2 (subida da que entrou) *)
    SpdUpC2 := TRUE;
    IF Pump_1 AND PumpFbRunning_1 AND (PumpSpeedPv_1 < (C2Eff - TolC2)) THEN
        SpdUpC2 := FALSE;
    END_IF;
    IF Pump_2 AND PumpFbRunning_2 AND (PumpSpeedPv_2 < (C2Eff - TolC2)) THEN
        SpdUpC2 := FALSE;
    END_IF;
    IF Pump_3 AND PumpFbRunning_3 AND (PumpSpeedPv_3 < (C2Eff - TolC2)) THEN
        SpdUpC2 := FALSE;
    END_IF;
    (* 5.1b com 2 bombas (modo 2/3) uma saiu de servico (falha/indisponivel): a reserva parte NA HORA,
            todas em C2, T_C2 com as duas em C2, depois PID (a vazao ja caiu: nao espera descida) *)
    IF ParOk AND (PumpMode >= 2) AND (NCmd < 2) THEN
        IF Spare AND (NCmd >= 1) THEN
            PumpMode := 2;
            Tacc := T#0s;
            TC2s := 0;
            Tup := T#0s;
        ELSE
            PumpMode := 0;
        END_IF;
    END_IF;

    (* 5.2 numero de bombas (so sobrenadante). Demanda 0-100 % = 0 a 2 bombas a 100 %;
           Cmax / C2 / C3 = velocidade de cada bomba [%]; entra a 2a quando 1 bomba precisaria passar de Cmax
           0: 1 bomba | 1: reduzindo p/ C2 (nova parada) | 2: nova partindo em C2 (T_C2) | 3: duas no PID *)
    IF NOT ParOk THEN
        PumpMode := 0;
    ELSIF PumpMode = 0 THEN
        IF ((2.0 * Dem) > Cmax) AND Spare AND (NRun >= 1) THEN
            PumpMode := 1;
            Tdec := T#0s;
            TDecs := 0;
        END_IF;
    ELSIF PumpMode = 1 THEN
        (* a nova so parte depois que a(s) bomba(s) em operacao desceram ate C2 (ou apos T_DecMax) *)
        IF (NOT Spare) OR (NCmd = 0) THEN
            PumpMode := 0;
        ELSIF SpdAtC2 OR (Tdec >= T_DecMax) THEN
            PumpMode := 2;
            Tacc := T#0s;
            TC2s := 0;
            Tup := T#0s;
        END_IF;
    ELSIF PumpMode = 2 THEN
        (* T_C2 conta com as duas rodando e com velocidade real em C2 (ou apos T_DecMax); condicao fisica junto com o tempo *)
        IF (NRun >= 2) AND (Tacc >= T_C2) THEN
            PumpMode := 3;
            T3acc := T#0s;
            TC3s := 0;
        END_IF;
    ELSIF PumpMode = 3 THEN
        (* saida exige a condicao fisica (ExitCond) alem do tempo: com T_C3 = 0 nao sai sem a condicao *)
        IF ExitCond AND (T3acc >= T_C3) THEN
            PumpMode := 0;
            T3acc := T#0s;
            TC3s := 0;
        END_IF;
    END_IF;
    IF PumpMode >= 2 THEN
        NWant := 2;
    ELSE
        NWant := 1;
    END_IF;

    (* 5.3 entra bomba disponivel de menor horimetro (rodizio) - ate 2 vezes *)
    NCmdPrev := NCmd;
    IF NCmd < NWant THEN
        PumpSel := 0;
        IF PumpReady_1 AND NOT Pump_1 THEN
            PumpSel := 1;
            MinTot := PumpTotOpe_1;
        END_IF;
        IF PumpReady_2 AND NOT Pump_2 THEN
            IF (PumpSel = 0) OR (PumpTotOpe_2 < MinTot) THEN
                PumpSel := 2;
                MinTot := PumpTotOpe_2;
            END_IF;
        END_IF;
        IF PumpReady_3 AND NOT Pump_3 THEN
            IF (PumpSel = 0) OR (PumpTotOpe_3 < MinTot) THEN
                PumpSel := 3;
                MinTot := PumpTotOpe_3;
            END_IF;
        END_IF;
        IF PumpSel = 1 THEN
            Pump_1 := TRUE;
            Seq := Seq + 1;
            Ord1 := Seq;
            NCmd := NCmd + 1;
        ELSIF PumpSel = 2 THEN
            Pump_2 := TRUE;
            Seq := Seq + 1;
            Ord2 := Seq;
            NCmd := NCmd + 1;
        ELSIF PumpSel = 3 THEN
            Pump_3 := TRUE;
            Seq := Seq + 1;
            Ord3 := Seq;
            NCmd := NCmd + 1;
        END_IF;
    END_IF;
    IF NCmd < NWant THEN
        PumpSel := 0;
        IF PumpReady_1 AND NOT Pump_1 THEN
            PumpSel := 1;
            MinTot := PumpTotOpe_1;
        END_IF;
        IF PumpReady_2 AND NOT Pump_2 THEN
            IF (PumpSel = 0) OR (PumpTotOpe_2 < MinTot) THEN
                PumpSel := 2;
                MinTot := PumpTotOpe_2;
            END_IF;
        END_IF;
        IF PumpReady_3 AND NOT Pump_3 THEN
            IF (PumpSel = 0) OR (PumpTotOpe_3 < MinTot) THEN
                PumpSel := 3;
                MinTot := PumpTotOpe_3;
            END_IF;
        END_IF;
        IF PumpSel = 1 THEN
            Pump_1 := TRUE;
            Seq := Seq + 1;
            Ord1 := Seq;
            NCmd := NCmd + 1;
        ELSIF PumpSel = 2 THEN
            Pump_2 := TRUE;
            Seq := Seq + 1;
            Ord2 := Seq;
            NCmd := NCmd + 1;
        ELSIF PumpSel = 3 THEN
            Pump_3 := TRUE;
            Seq := Seq + 1;
            Ord3 := Seq;
            NCmd := NCmd + 1;
        END_IF;
    END_IF;

    (* 5.4 excedente: sai a bomba em operacao ha mais tempo (menor ordem de partida) *)
    IF NCmd > NWant THEN
        PumpSel := 0;
        IF Pump_1 THEN
            PumpSel := 1;
            MinOrd := Ord1;
        END_IF;
        IF Pump_2 THEN
            IF (PumpSel = 0) OR (Ord2 < MinOrd) THEN
                PumpSel := 2;
                MinOrd := Ord2;
            END_IF;
        END_IF;
        IF Pump_3 THEN
            IF (PumpSel = 0) OR (Ord3 < MinOrd) THEN
                PumpSel := 3;
                MinOrd := Ord3;
            END_IF;
        END_IF;
        IF PumpSel = 1 THEN
            Pump_1 := FALSE;
        ELSIF PumpSel = 2 THEN
            Pump_2 := FALSE;
        ELSIF PumpSel = 3 THEN
            Pump_3 := FALSE;
        END_IF;
        NCmd := NCmd - 1;
    END_IF;

    (* 5.5 sem bomba para a 2a posicao: volta a operar com uma *)
    IF (PumpMode >= 2) AND (NCmd < 2) THEN
        PumpMode := 0;
    END_IF;

    (* 5.6 PI sempre no setpoint de vazao; velocidade das bombas conforme o modo *)
    (* bombas fixas em C2 (entrada da 2a): setpoint do PID acompanha a vazao medida, o PID nao integra
       e ao fim de T_C2 a velocidade parte de onde estava (sem salto para 100 %) *)
    IF ParOk AND ((PumpMode = 1) OR (PumpMode = 2)) AND NOT FlowFail THEN
        EffFlowSp := FlowPv;
    ELSE
        EffFlowSp := FlowSp;
    END_IF;
    IF NOT SupernatantMode THEN
        SpdRaw := Dem;
    ELSIF (PumpMode = 1) OR (PumpMode = 2) THEN
        SpdRaw := C2Eff;
    ELSIF PumpMode = 3 THEN
        SpdRaw := Dem;
    ELSE
        SpdRaw := 2.0 * Dem;
    END_IF;
    IF SpdRaw > 100.0 THEN
        SpdRaw := 100.0;
    END_IF;
    (* velocidade minima de cada bomba em servico *)
    AtMin := (NCmd >= 1) AND (SpdRaw < CminEff);
    IF SpdRaw < CminEff THEN
        PumpSpeed := CminEff;
    ELSE
        PumpSpeed := SpdRaw;
    END_IF;
ELSE
    Pump_1 := FALSE;
    Pump_2 := FALSE;
    Pump_3 := FALSE;
    PumpMode := 0;
    Tacc := T#0s;
    TC2s := 0;
    T3acc := T#0s;
    TC3s := 0;
    NCmd := 0;
    NRun := 0;
    EffFlowSp := FlowSp;
    PumpSpeed := PIDOut;
    AtMin := FALSE;
    Paused := FALSE;
    PauseCause := 0;
    Trest := T#0s;
    Tll := T#0s;
END_IF;

(* ---------- 6. Saidas para a fase e IHM ---------- *)
StartReady := (Grafcet = 2) OR (Grafcet = 3);
StopReady := (Grafcet = 6);
AbortedReady := (Grafcet = 9);
NPumps := NRun;
SelectedPump := 0;
SecondPump := 0;
MinOrd := 0;
IF Pump_1 THEN
    SelectedPump := 1;
    MinOrd := Ord1;
END_IF;
IF Pump_2 THEN
    IF (SelectedPump = 0) OR (Ord2 < MinOrd) THEN
        SecondPump := SelectedPump;
        SelectedPump := 2;
        MinOrd := Ord2;
    ELSE
        SecondPump := 2;
    END_IF;
END_IF;
IF Pump_3 THEN
    IF (SelectedPump = 0) OR (Ord3 < MinOrd) THEN
        SecondPump := SelectedPump;
        SelectedPump := 3;
        MinOrd := Ord3;
    ELSE
        SecondPump := 3;
    END_IF;
END_IF;

(* ---------- 7. Eventos de saida somente quando algum valor muda ---------- *)
EdgeOut := (StartReady <> PrevSR) OR (StopReady <> PrevST) OR (AbortedReady <> PrevAB) OR (EffFlowSp <> PrevSP) OR (Grafcet <> PrevGR) OR (SelectedPump <> PrevSel) OR (SecondPump <> PrevSec) OR (PumpMode <> PrevPM) OR (PauseCause <> PrevPC) OR (AtMin <> PrevAM) OR (ParBad <> PrevPB) OR (NPumps <> PrevNP);
PrevAM := AtMin;
PrevPB := ParBad;
PrevNP := NPumps;
PrevSR := StartReady;
PrevST := StopReady;
PrevAB := AbortedReady;
PrevSP := EffFlowSp;
PrevGR := Grafcet;
PrevSel := SelectedPump;
PrevSec := SecondPump;
PrevPM := PumpMode;
PrevPC := PauseCause;
EdgeSpd := PumpSpeed <> PrevSpd;
PrevSpd := PumpSpeed;

(* ---------- 8. Status para a IHM: a cada 1 s (TICK) e quando o estado muda ---------- *)
HmiCmin := CminEff;
HmiC2 := C2Eff;
HmiC3 := C3;
HmiCmax := Cmax;
HmiSup := SupernatantMode;
HmiFlowFail := FlowFail;
HmiTC2 := TC2s;
HmiTC3 := TC3s;
HmiTDec := TDecs;
EdgeSts := FromTick OR (PumpMode <> PrevSPM) OR (NPumps <> PrevSNP) OR (PauseCause <> PrevSPC) OR (Grafcet <> PrevSGR) OR (AtMin <> PrevSAM) OR (ParBad <> PrevSPB);
FromTick := FALSE;
PrevSPM := PumpMode;
PrevSNP := NPumps;
PrevSPC := PauseCause;
PrevSGR := Grafcet;
PrevSAM := AtMin;
PrevSPB := ParBad;
]]></ST>
    </Algorithm>
    <Algorithm Name="AlgTick" Comment="Base de tempo 1 s">
      <ST><![CDATA[;
(* Base de tempo 1 s (E_CYCLE externo): tempos em C2 e abaixo de C3 *)
FromTick := TRUE;
(* tempo de espera da subida da nova bomba ate C2 (limite T_DecMax) *)
IF PumpMode = 2 THEN
    Tup := Tup + T#1s;
ELSE
    Tup := T#0s;
END_IF;
(* T_C2: as duas rodando e com velocidade real em C2 (ou apos T_DecMax sem confirmacao) *)
IF (PumpMode = 2) AND (NRun >= 2) AND (SpdUpC2 OR (Tup >= T_DecMax)) THEN
    Tacc := Tacc + T#1s;
    TC2s := TC2s + 1;
END_IF;
(* tempo de descida ate C2 antes de partir a nova bomba *)
IF PumpMode = 1 THEN
    Tdec := Tdec + T#1s;
    TDecs := TDecs + 1;
ELSE
    Tdec := T#0s;
    TDecs := 0;
END_IF;
(* duas bombas operando com velocidade abaixo de C3 *)
IF (PumpMode = 3) AND (NRun >= 2) AND ExitCond THEN
    T3acc := T3acc + T#1s;
    TC3s := TC3s + 1;
ELSE
    T3acc := T#0s;
    TC3s := 0;
END_IF;
IF (Grafcet = 3) AND Paused AND (NOT LowLevel) THEN
    Trest := Trest + T#1s;
ELSE
    Trest := T#0s;
END_IF;
IF (Grafcet = 3) AND (NOT Paused) AND (NRun >= 1) AND FlowLL AND (NOT FlowFail) THEN
    Tll := Tll + T#1s;
ELSE
    Tll := T#0s;
END_IF;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>