      <VarDeclaration ID="C4E5F519898D3848" Name="PumpFbRunning_3" Type="BOOL" />
      <VarDeclaration ID="956E0A0A54836360" Name="PumpFbStopped_3" Type="BOOL" />
      <VarDeclaration ID="0EC6936CA60DF719" Name="PumpReady_3" Type="BOOL" />
