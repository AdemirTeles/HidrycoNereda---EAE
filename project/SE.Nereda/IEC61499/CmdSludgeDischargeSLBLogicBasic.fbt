    <Algorithm Name="OpenValve" Comment="Normally executed algorithm">
      <ST><![CDATA[;
Grafcet := 1;
Valve_Tank1 := TRUE;
Valve_Tank2 := TRUE;
StopReady := FALSE;
AbortedReady := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="StartReady">
      <ST><![CDATA[;
Grafcet := 2;
StartReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="CloseValve">
      <ST><![CDATA[;
IF Grafcet = 4 THEN
	Grafcet := 5;
ELSIF Grafcet = 7 THEN
	Grafcet := 8;
END_IF;
Valve_Tank1 := FALSE;
Valve_Tank2 := FALSE;
]]></ST>
    </Algorithm>
    <Algorithm Name="StopReady">
      <ST><![CDATA[;
Grafcet := 6;
StopReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="AbortedReady">
      <ST><![CDATA[;
Grafcet := 9;
AbortedReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="RunPump">
      <VarDeclaration Name="MinTOT" Type="UDINT" InitialValue="16#FFFFFFFF" />
      <ST><![CDATA[;
Grafcet := 3;

(* Inicialização *)
SelectedPump := 0;
MinTOT := 16#FFFFFFFF; (* Maior valor possível para UDINT *)

(* Seleciona a bomba Ready com menor ToT *)

IF PumpReady_1 AND NOT PumpFbRunning_1 THEN
    MinTOT := PumpTotOpe_1;
    SelectedPump := 1;
END_IF;

IF PumpReady_2 AND NOT PumpFbRunning_2 THEN
    IF (SelectedPump = 0) OR (PumpTotOpe_2 < MinTOT) THEN
        MinTOT := PumpTotOpe_2;
        SelectedPump := 2;
    END_IF;
END_IF;

IF PumpReady_3 AND NOT PumpFbRunning_3 THEN
    IF (SelectedPump = 0) OR (PumpTotOpe_3 < MinTOT) THEN
        MinTOT := PumpTotOpe_3;
        SelectedPump := 3;
    END_IF;
END_IF;

(* Limpa todos os comandos *)
Pump_1 := FALSE;
Pump_2 := FALSE;
Pump_3 := FALSE;

(* Apenas a bomba selecionada recebe o comando *)
CASE SelectedPump OF
    1: Pump_1 := TRUE;
    2: Pump_2 := TRUE;
    3: Pump_3 := TRUE;
END_CASE;
]]></ST>
    </Algorithm>
    <Algorithm Name="StopPump">
      <ST><![CDATA[;
Grafcet := 4;
CASE SelectedPump OF
	1: Pump_1 := FALSE;
	2: Pump_2 := FALSE;
	3: Pump_3 := FALSE;
END_CASE;

StartReady := FALSE;
AbortedReady  := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="StopPump_WhenAborting">
      <ST><![CDATA[;
Grafcet := 7;
Pump_1 := FALSE;
Pump_2 := FALSE;
Pump_3 := FALSE;
StartReady := FALSE;
StopReady := FALSE;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>