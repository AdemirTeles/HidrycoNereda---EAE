    <Algorithm Name="OpenValve" Comment="Normally executed algorithm">
      <ST><![CDATA[;
Grafcet := 1;
Valve := TRUE;
StopReady := FALSE;
AbortedReady := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="StartReady">
      <ST><![CDATA[;
Grafcet := 2;
StartReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="CloseValve">
      <ST><![CDATA[;
IF Grafcet = 4 THEN
	Grafcet := 5;
ELSIF Grafcet = 7 THEN
	Grafcet := 8;
END_IF;
Valve := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="StopReady">
      <ST><![CDATA[;
Grafcet := 6;
StopReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="AbortedReady">
      <ST><![CDATA[;
Grafcet := 9;
AbortedReady := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="RunPump">
      <ST><![CDATA[;
Grafcet := 3;
Pump := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="StopPump">
      <ST><![CDATA[;
Grafcet := 4;
Pump := FALSE;
StartReady := FALSE;
AbortedReady  := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="StopPump_WhenAborting">
      <ST><![CDATA[;
Grafcet := 7;
Pump := FALSE;
StartReady := FALSE;
StopReady := FALSE;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>