  <BasicFB ID="2b3f6219-0e76-42cf-9ba7-2b7afdc7016b">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="INIT,REQ" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="1120.941" y="545.4117" />
      <ECState Name="REQ" x="1728" y="1092">
        <ECAction Algorithm="REQ" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="REQ" Condition="REQ" x="1485.995" y="762.9695">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="352.3812,167.6717,393.3102,204.5237" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="1" x="1305.365" y="902.6711">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="340.4904,249.9633,299.5614,213.1113" />
      </ECTransition>
    </ECC>
    <Algorithm Name="INIT" Comment="Initialization algorithm">
      <ST><![CDATA[;]]></ST>
    </Algorithm>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;
IF NOT RunR1 AND NOT RunR2 AND NOT RunR3 AND NOT RunR4 AND NOT RunR5 AND NOT RunR6 THEN
	FbRunningR1 := FbRunning;
	FbStoppedR1 := FbStopped;
	
	FbRunningR2 := FbRunning;
	FbStoppedR2 := FbStopped;
	
	FbRunningR3 := FbRunning;
	FbStoppedR3 := FbStopped;
	
	FbRunningR4 := FbRunning;
	FbStoppedR4 := FbStopped;
	
	FbRunningR5 := FbRunning;
	FbStoppedR5 := FbStopped;
	
	FbRunningR6 := FbRunning;
	FbStoppedR6 := FbStopped;
ELSE
	IF StoppingR1 THEN
		FbRunningR1 := FALSE;
		FbStoppedR1 := TRUE;
	END_IF;
		
	IF StoppingR2 THEN
		FbRunningR2 := FALSE;
		FbStoppedR2 := TRUE;
	END_IF;
		
	IF StoppingR3 THEN
		FbRunningR3 := FALSE;
		FbStoppedR3 := TRUE;
	END_IF;
		
	IF StoppingR4 THEN
		FbRunningR4 := FALSE;
		FbStoppedR4 := TRUE;
	END_IF;
		
	IF StoppingR5 THEN
		FbRunningR5 := FALSE;
		FbStoppedR5 := TRUE;
	END_IF;
		
	IF StoppingR6 THEN
		FbRunningR6 := FALSE;
		FbStoppedR6 := TRUE;
	END_IF;
END_IF;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>