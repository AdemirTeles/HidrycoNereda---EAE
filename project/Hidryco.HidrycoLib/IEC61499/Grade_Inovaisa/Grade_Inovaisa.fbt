<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="c0c6a6cf-01db-8a49-24fa-41423473cdb4" Name="Grade_Inovaisa" Comment="Grade mecanizada do painel Vibropac com os niveis montante, jusante e diferencial - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.1" Author="Hidryco" Date="11/11/2026" Remarks="1.1: sensores com cfgSkid = TRUE (niveis ja escalados no painel; sem ajuste de escala na IHM). 1.0: uma grade do gradeamento (padrao Grade_Equipamentos do legado): SensorMontante, SensorJusante, SensorDiferencial (Sensor_Generico por comunicacao, %) e Grade_Mecanizada_Inovaisa1 (Motor_Inovaisa com reverso e sobretorque). Os niveis chegam do processo e vao aos sensores por symlink ${PATH}SensorX.stsEntrada / stsFalhaComunicacao." />
  <InterfaceList>
    <EventInputs>
      <Event ID="ABEE1148E34D9BFE" Name="REQ" Comment="Leitura do painel (pelo processo)">
        <With Var="nivMontante" />
        <With Var="nivJusante" />
        <With Var="nivDiferencial" />
        <With Var="falhaCom" />
        <With Var="fldStatus" />
        <With Var="fldSobretorque" />
      </Event>
      <Event ID="546B340D62024106" Name="E_RESET_FALHAS" Comment="Reset dos sensores e reconhecimento dos alarmes (com cmdResetFalhas = TRUE)">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="E31D8EEC4AA83653" Name="CNF" Comment="Status da grade (na mudanca)">
        <With Var="stsLigado" />
        <With Var="stsFalha" />
        <With Var="stsAlarme" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="5629422A3B5B838A" Name="nivMontante" Type="REAL" Comment="Nivel montante (%)" />
      <VarDeclaration ID="0A48A90C6A0D0550" Name="nivJusante" Type="REAL" Comment="Nivel jusante (%)" />
      <VarDeclaration ID="5F90538AE86731E7" Name="nivDiferencial" Type="REAL" Comment="Nivel diferencial (%)" />
      <VarDeclaration ID="DFE6CA66F4E123D9" Name="falhaCom" Type="BOOL" Comment="Sem comunicacao com o painel" />
      <VarDeclaration ID="DFA27FFCDD03BE32" Name="fldStatus" Type="INT" Comment="Registro de status da grade (4007/4008)" />
      <VarDeclaration ID="550C3011667C2FB9" Name="fldSobretorque" Type="INT" Comment="Registro do sobretorque (4010/4011)" />
      <VarDeclaration ID="605D63048CED98E9" Name="cmdResetFalhas" Type="BOOL" Comment="TRUE = reset (com o evento E_RESET_FALHAS)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="E2890AE591C3E435" Name="stsLigado" Type="BOOL" Comment="Grade funcionando" />
      <VarDeclaration ID="8D853BC897AD2F8F" Name="stsFalha" Type="BOOL" Comment="Grade em falha" />
      <VarDeclaration ID="7912CE47E4646D27" Name="stsAlarme" Type="BOOL" Comment="Falha ou sobretorque" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
