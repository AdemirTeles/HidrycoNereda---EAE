<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="a7e8d041-32cd-6e13-d7ae-ba7948768507" Name="Grade_Inovaisa_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
