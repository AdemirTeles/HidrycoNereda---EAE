<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="35704e0b-2ab3-464d-a9fe-a89344f74869" Comment="Motor generico (partida direta ou inversor) - HidrycoLib" Name="Motor_Generico" Format="2.0" Namespace="Hidryco.HidrycoLib">
  <Attribute Name="HMI.Alias" Value="" />
  <Attribute Name="Configuration.FB.IDCounter" Value="4" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.6" Author="Hidryco" Date="16/10/2026" Remarks="1.6: simbolos sBomba/sMotor/sSoprador - icones de termica e de falha de comunicacao piscam enquanto o alarme nao foi reconhecido. 1.5: symlink stsFalhaComunicacao recebe o ComStatus do ATV (TRUE = comunicacao OK), invertido por NOT para a logica; saida stsComunicacaoOK no CNF. 1.1: padrao SE.App2CommonProcess (supervisao por E_DELAY, horimetro/partidas pelo devMntCalc, escala com limites). 1.3: faceplates ISA-101. 1.4: horimetro com resolucao de 1 s (E_CYCLE + PERSISTENCE), falhas na lista de alarmes do EAE (ALARM_BIT, comunicacao = Warning), reset reconhece os alarmes, termica NF e velocidade manual 50 % por padrao. Campo por symlink ${PATH}: stsFalhaComunicacao, stsRemoto, stsLocal, stsLigado, stsProtecaoTermica, stsSemFalha (NF); saidas cmdAcionamento, stpVelocidade, cmdReset; inversor (cfgInversor=TRUE): stsVelocidade, stsCorrente, stsTensao, stsPotencia, stsFrequencia, stsTorque, stsCodigoFalha, stsRpm" />
  <InterfaceList>
    <EventInputs>
      <Event ID="21070E4B73BFECDC" Name="REQ" Comment="Atualizacao do processo">
        <With Var="cmdLigarAutomatico" />
        <With Var="stpVelocidadeAutomatico" />
        <With Var="ilkGeral" />
        <With Var="ilkAutomatico" />
        <With Var="ilkManual" />
        <With Var="stsEmergencia" />
        <With Var="geradorConectado" />
        <With Var="geradorHabilita" />
        <With Var="stsGerador" />
      </Event>
      <Event ID="BA30A65ADDA4ECC3" Name="E_RESET_FALHAS" Comment="Reset de falhas pelo processo (com cmdResetFalhas = TRUE)">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="9D4F26EE27EDF5B9" Name="CNF" Comment="Status (so na mudanca)">
        <With Var="stsDisponivelAutomatico" />
        <With Var="stsLigado" />
        <With Var="stsFalha" />
        <With Var="stsAnimacao" />
        <With Var="stsVelocidade" />
        <With Var="stsRemoto" />
        <With Var="stsAutomatico" />
        <With Var="stsComunicacaoOK" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="87DAE15414E7C412" Name="cmdLigarAutomatico" Type="BOOL" Comment="Comando ligar do processo (modo automatico)" />
      <VarDeclaration ID="F94ABA993E8E9FF4" Name="stpVelocidadeAutomatico" Type="REAL" Comment="Referencia de velocidade do processo (%)" />
      <VarDeclaration ID="8E1E39034B916602" Name="ilkGeral" Type="BOOL" Comment="Intertravamento geral (automatico e manual)" />
      <VarDeclaration ID="B35265D6C3CF40DC" Name="ilkAutomatico" Type="BOOL" Comment="Intertravamento so do automatico" />
      <VarDeclaration ID="868EE32E6507B748" Name="ilkManual" Type="BOOL" Comment="Intertravamento so do manual" />
      <VarDeclaration ID="85953C7B9294A9BF" Name="stsEmergencia" Type="BOOL" Comment="Emergencia (TRUE = acionada): retira o comando e exige reset" />
      <VarDeclaration ID="8914049066EE23D9" Name="geradorConectado" Type="BOOL" Comment="TRUE = o gerador pode alimentar este equipamento" />
      <VarDeclaration ID="5C3D51A654AD25BA" Name="geradorHabilita" Type="BOOL" Comment="Selecao do operador no CAT Gerador (HAB_GERADOR_EQUIP_n)" />
      <VarDeclaration ID="A33BC24B3E7310B0" Name="stsGerador" Type="BOOL" Comment="TRUE = planta alimentada pelo gerador" />
      <VarDeclaration ID="C2F1E9C0FB076F17" Name="cmdResetFalhas" Type="BOOL" Comment="Processo: reset de falhas (vale com TRUE)" />
      <VarDeclaration ID="63EFEFB7C85EC93E" Name="cfgInversor" Type="BOOL" InitialValue="FALSE" Comment="TRUE = motor com inversor (referencia de velocidade e medicoes)" />
      <VarDeclaration ID="1ECF468387CA7EB2" Name="cfgVelocidadeMin" Type="REAL" InitialValue="0.0" Comment="Limite minimo da referencia de velocidade (%)" />
      <VarDeclaration ID="540BE0E4E6611ACA" Name="cfgVelocidadeMax" Type="REAL" InitialValue="100.0" Comment="Limite maximo da referencia de velocidade (%)" />
      <VarDeclaration ID="E24313AE3BEE4D49" Name="cfgSaidaMin" Type="REAL" InitialValue="0.0" Comment="Valor de campo equivalente a 0 % (referencia e realimentacao)" />
      <VarDeclaration ID="39489193B7758574" Name="cfgSaidaMax" Type="REAL" InitialValue="100.0" Comment="Valor de campo equivalente a 100 % (ex.: 100 = %, 60 = Hz, 10000 = Sulzer 0,01 %)" />
      <VarDeclaration ID="D34C88BE7FFF3208" Name="cfgUsaTermica" Type="BOOL" InitialValue="TRUE" Comment="TRUE = supervisiona a protecao termica" />
      <VarDeclaration ID="66763E13F70A4420" Name="cfgTermicaNF" Type="BOOL" InitialValue="TRUE" Comment="TRUE = termica NF (FALSE no campo = atuada). Padrao NF (definido pelo usuario)" />
      <VarDeclaration ID="3AD811F03C7B9855" Name="cfgUsaFalhaComunicacao" Type="BOOL" InitialValue="TRUE" Comment="TRUE = considera o bit de falha de comunicacao da remota" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="EBDC9E59C4286586" Name="stsDisponivelAutomatico" Type="BOOL" Comment="Pode ser comandado pelo automatico agora" />
      <VarDeclaration ID="40A5976BFB296133" Name="stsLigado" Type="BOOL" Comment="Motor ligado (confirmacao de campo)" />
      <VarDeclaration ID="C5DF7BA69D90B1CF" Name="stsFalha" Type="BOOL" Comment="Alguma falha memorizada (exige reset)" />
      <VarDeclaration ID="66DCA44233B31656" Name="stsAnimacao" Type="INT" Comment="0 desligado, 1 ligado, 2 falha, 3 manutencao" />
      <VarDeclaration ID="8D68BF83D50068CD" Name="stsVelocidade" Type="REAL" Comment="Velocidade real (%); partida direta: 0 ou 100" />
      <VarDeclaration ID="A08B1C50DE38CD1F" Name="stsRemoto" Type="BOOL" Comment="Chave em remoto" />
      <VarDeclaration ID="368C3F9EC04E0359" Name="stsAutomatico" Type="BOOL" Comment="Modo automatico" />
      <VarDeclaration ID="0F3C10FA447A4A49" Name="stsComunicacaoOK" Type="BOOL" />
    </OutputVars>
    <Plugs>
      <AdapterDeclaration ID="03227ACC7BC898FF" Name="IStatus" Type="IActStatus" Namespace="Hidryco.HidrycoLib" x="6980" y="2140" />
    </Plugs>
  </InterfaceList>
