      <VarDeclaration ID="EC0AD5583DFA829A" Name="STS_ALM_PARADA_EST" Type="USINT" Comment="Estado do ALARM_BIT (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
