<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="56e0acbe-e63f-15f1-769c-ea342bffd0a6" Name="basicStatusRemota" Comment="Estado da comunicacao de uma remota Modbus TCP" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.1" Author="Hidryco" Date="06/11/2026" Remarks="1.1: aceita 'Online' (valor real do runtime; antes so 'online' e toda remota comunicando aparecia SEM COMUNICACAO); INIT tambem le o conn (antes o valor inicial era ignorado e a remota ficava AGUARDANDO); CNF_HMI a cada leitura com stsVivo (sinal de vida para a IHM). 1.0: connStatus (online/offline) do escravo MODBUSGENTCPS" />
  <InterfaceList>
    <EventInputs>
      <Event ID="D8FB89F910445551" Name="INIT" Comment="Inicializacao (com o valor atual do connStatus)">
        <With Var="conn" />
      </Event>
      <Event ID="5CBFC3A39A689AE7" Name="REQ" Comment="Status da conexao recebido do hardware">
        <With Var="conn" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="53F8DD0FF6D3BB94" Name="INITO" Comment="Inicializacao concluida" />
      <Event ID="E1D8AB57600D137E" Name="CNF_HMI" Comment="Status para a IHM (a cada leitura)">
        <With Var="stsEstado" />
        <With Var="stsComunicando" />
        <With Var="stsVivo" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="5F664A6BAFC27D5F" Name="conn" Type="STRING" Comment="connStatus do escravo Modbus TCP: online / offline" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="64E083C639D0A0DD" Name="stsEstado" Type="INT" Comment="0 aguardando, 1 comunicando, 2 sem comunicacao" />
      <VarDeclaration ID="ED85EB0A8AE1B373" Name="stsComunicando" Type="BOOL" Comment="Remota comunicando" />
      <VarDeclaration ID="7F803DDDF0928C0A" Name="stsVivo" Type="INT" Comment="Sinal de vida: contador 0..9999 a cada leitura" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="23dd0d3e-3594-8719-50f2-36ff9131c954">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="algStatus" />
    <InternalVars>
      <VarDeclaration ID="C64D19512E9618FF" Name="initDone" Type="BOOL" />
      <VarDeclaration ID="16B690E22C572B8D" Name="primeiro" Type="BOOL" InitialValue="TRUE" />
      <VarDeclaration ID="5D82212D6E038DF6" Name="est" Type="INT" />
      <VarDeclaration ID="6B7716E9E72B5CB2" Name="oldEst" Type="INT" InitialValue="-1" />
      <VarDeclaration ID="BCBBC9D5B4587C9A" Name="vivo" Type="INT" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Estado inicial" x="1500" y="640" />
      <ECState Name="EXEC" Comment="Executa a logica; o algoritmo decide quais eventos saem" x="1500" y="1100">
        <ECAction Algorithm="algStatus" Output="INITO" />
        <ECAction Output="CNF_HMI" />
      </ECState>
      <ECTransition Source="START" Destination="EXEC" Condition="INIT OR REQ" x="1580" y="860" />
      <ECTransition Source="EXEC" Destination="START" Condition="1" x="1420" y="860" />
    </ECC>
    <Algorithm Name="algStatus" Comment="Logica completa">
      <ST><![CDATA[(* =====================================================================
   basicStatusRemota v1.1 - estado da comunicacao de uma remota
   connStatus do MODBUSGENTCPS: o runtime manda 'Online' / 'Offline' (conferido online no EAE 06/11/2026;
   a documentacao diz 'online'): aceita as tres grafias.
   INIT tambem le o conn (valor atual entregue no INITO do symlink).
   Cada INIT/REQ emite CNF_HMI com stsVivo (contador) para a IHM detectar CLP sem dados.
   ===================================================================== *)
INITO   := FALSE;
CNF_HMI := FALSE;
IF INIT THEN
    initDone := TRUE;
    INITO := TRUE;
END_IF;
IF NOT initDone THEN
    RETURN;
END_IF;
IF (conn = 'Online') OR (conn = 'online') OR (conn = 'ONLINE') THEN
    est := 1;
ELSIF conn = '' THEN
    est := 0;
ELSE
    est := 2;
END_IF;
stsEstado := est;
stsComunicando := est = 1;
vivo := vivo + 1;
IF vivo > 9999 THEN
    vivo := 0;
END_IF;
stsVivo := vivo;
CNF_HMI := TRUE;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
