<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="f892b526-d2b0-48a7-9453-fa7f21ec533a" Name="basicFalhaFeedbackOnOff" Comment="Basic Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="1/26/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Comment="Initialization Request">
        <With Var="stpTempoFalhaAbertura" />
        <With Var="stpTempoFalhaFechamento" />
      </Event>
      <Event Name="REQ" Comment="Normal Execution Request">
        <With Var="stsRemoto" />
        <With Var="stpTempoFalhaAbertura" />
        <With Var="stpTempoFalhaFechamento" />
        <With Var="stsOn" />
        <With Var="stsOff" />
        <With Var="cmdOn" />
        <With Var="cmdOff" />
      </Event>
      <Event Name="END_DELAY_ABERTURA">
        <With Var="stsOn" />
        <With Var="cmdOn" />
      </Event>
      <Event Name="END_DELAY_FECHAMENTO">
        <With Var="stsOff" />
        <With Var="cmdOff" />
      </Event>
      <Event Name="E_RESET_FALHA" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Comment="Initialization Confirm" />
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="stsFalhaFeedback" />
        <With Var="stsFalhaAbertura" />
        <With Var="stsFalhaFechamento" />
      </Event>
      <Event Name="START_DELAY_ABERTURA">
        <With Var="delayTimeAbertura" />
      </Event>
      <Event Name="START_DELAY_FECHAMENTO">
        <With Var="delayTimeFechamento" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="stsRemoto" Type="BOOL" />
      <VarDeclaration Name="stsOn" Type="BOOL" />
      <VarDeclaration Name="stsOff" Type="BOOL" />
      <VarDeclaration Name="cmdOn" Type="BOOL" />
      <VarDeclaration Name="cmdOff" Type="BOOL" />
      <VarDeclaration Name="stpTempoFalhaAbertura" Type="UINT" />
      <VarDeclaration Name="stpTempoFalhaFechamento" Type="UINT" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="stsFalhaFeedback" Type="BOOL" />
      <VarDeclaration Name="stsFalhaAbertura" Type="BOOL" />
      <VarDeclaration Name="stsFalhaFechamento" Type="BOOL" />
      <VarDeclaration Name="delayTimeAbertura" Type="TIME" />
      <VarDeclaration Name="delayTimeFechamento" Type="TIME" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="INIT,REQ,DelayAbertura,DelayFechamento,AcionaFalhaAbertura,AcionaFalhaFechamento,ResetFalhas" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="2668.941" y="649.4117" />
      <ECState Name="Remoto" x="2160" y="1352" />
      <ECState Name="STATE1" x="3252" y="1296">
        <ECAction Algorithm="DelayAbertura" Output="START_DELAY_ABERTURA" />
      </ECState>
      <ECState Name="STATE2" x="3008" y="1972">
        <ECAction Algorithm="AcionaFalhaAbertura" Output="CNF" />
      </ECState>
      <ECState Name="STATE3" x="1244" y="1952">
        <ECAction Algorithm="DelayFechamento" Output="START_DELAY_FECHAMENTO" />
      </ECState>
      <ECState Name="STATE4" x="771.9999" y="1388">
        <ECAction Algorithm="AcionaFalhaFechamento" Output="CNF" />
      </ECState>
      <ECState Name="STATE5" x="1720" y="635.9999">
        <ECAction Algorithm="ResetFalhas" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="Remoto" Condition="1" x="2490.937" y="1035.928">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="644.4284,237.0027,609.2295,286.8318" />
      </ECTransition>
      <ECTransition Source="Remoto" Destination="STATE1" Condition="cmdOn AND NOT(stsOn) AND NOT END_DELAY_ABERTURA" x="2703.879" y="1235.112">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="642.1921,306.2551,710.0106,302.4767" />
      </ECTransition>
      <ECTransition Source="STATE1" Destination="Remoto" Condition="1" x="2707.304" y="1401.806">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="711.157,352.3833,643.3284,356.1864" />
      </ECTransition>
      <ECTransition Source="Remoto" Destination="STATE2" Condition="cmdOn AND NOT(stsOn) AND END_DELAY_ABERTURA" x="2634.751" y="1600.42">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="629.6954,373.4728,688.7377,416.4739" />
      </ECTransition>
      <ECTransition Source="STATE2" Destination="Remoto" Condition="1" x="2596.25" y="1744.158">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="682.8066,464.3862,623.5201,421.3855" />
      </ECTransition>
      <ECTransition Source="Remoto" Destination="STATE3" Condition="cmdOff AND NOT(stsOff) AND NOT END_DELAY_FECHAMENTO" x="1755.583" y="1714.72">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="470.9467,413.0834,407.8775,454.4959" />
      </ECTransition>
      <ECTransition Source="STATE3" Destination="Remoto" Condition="1" x="1714.855" y="1571.181">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="401.4486,406.8525,464.5556,365.5039" />
      </ECTransition>
      <ECTransition Source="Remoto" Destination="STATE4" Condition="cmdOff AND NOT(stsOff) AND END_DELAY_FECHAMENTO" x="1472.194" y="1442.395">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="414.5,363.4357,322.013,365.8067" />
      </ECTransition>
      <ECTransition Source="STATE4" Destination="Remoto" Condition="1" x="1470.746" y="1295.858">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="321.5287,321.0558,414.0192,318.6504" />
      </ECTransition>
      <ECTransition Source="Remoto" Destination="STATE5" Condition="E_RESET_FALHA" x="1805.549" y="1065.858">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="460.2243,297.9194,428.8536,246.9859" />
      </ECTransition>
