        <Attribute Name="Configuration.Transaction.BezierPoints" Value="492.8997,210.411,523.4164,261.355" />
      </ECTransition>
      <ECTransition Source="Remoto" Destination="START" Condition="1" x="2314.317" y="880.0043">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="550.4282,241.7101,600.351,179.723" />
      </ECTransition>
    </ECC>
    <Algorithm Name="INIT" Comment="Initialization algorithm">
      <ST><![CDATA[;]]></ST>
    </Algorithm>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;]]></ST>
    </Algorithm>
    <Algorithm Name="DelayAbertura">
      <ST><![CDATA[delayTimeAbertura := DINT_TO_TIME(UINT_TO_DINT(stpTempoFalhaAbertura) * 1000);
;]]></ST>
    </Algorithm>
    <Algorithm Name="DelayFechamento">
      <ST><![CDATA[delayTimeFechamento := DINT_TO_TIME(UINT_TO_DINT(stpTempoFalhaFechamento) * 1000);
;]]></ST>
    </Algorithm>
    <Algorithm Name="AcionaFalhaAbertura">
      <ST><![CDATA[IF (cmdOn AND NOT(stsOn)) THEN
	stsFalhaAbertura := TRUE;
	stsFalhaFeedback := TRUE;
END_IF
;]]></ST>
    </Algorithm>
    <Algorithm Name="AcionaFalhaFechamento">
      <ST><![CDATA[IF (cmdOff AND NOT(stsOff)) THEN
	stsFalhaFechamento := TRUE;
	stsFalhaFeedback := TRUE;
END_IF
;]]></ST>
    </Algorithm>
    <Algorithm Name="ResetFalhas">
      <ST><![CDATA[stsFalhaAbertura := FALSE;
stsFalhaFechamento := FALSE;
stsFalhaFeedback := FALSE;
;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>