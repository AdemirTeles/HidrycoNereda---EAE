<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="01e7f10b-090c-4491-9fd1-89af1ddb71c5" Name="pidCtl" Format="2.0" Comment="Composite Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Attribute Name="Configuration.FB.IDCounter" Value="30" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="1.0.1" Author="ApplicationLibDevTeam" Date="11/15/2023" Remarks="First Version" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Comment="Request to execute PID in auto or manual mode">
        <With Var="Pv" />
        <With Var="Gain" />
        <With Var="DerivativeTime" />
        <With Var="IntegralTime" />
        <With Var="Direction" />
        <With Var="Deadband" />
        <With Var="DWorkOnError" />
        <With Var="Mode" />
        <With Var="PresetValue" />
        <With Var="CycleTime" />
        <With Var="EnFeedFwd" />
        <With Var="FeedFwdGain" />
        <With Var="FeedFwd" />
        <With Var="LagTime" />
        <With Var="OutMin" />
        <With Var="OutMax" />
        <With Var="ProhibitOutInc" />
        <With Var="ProhibitOutDec" />
        <With Var="Bump" />
      </Event>
      <Event Name="REQ_SP" Comment="Request for setpoint execution">
        <With Var="Sp" />
      </Event>
      <Event Name="REQ_ILCK" Comment="Request to update interlock">
        <With Var="IlckCond" />
        <With Var="IlckType" />
      </Event>
      <Event Name="REQ_TRACK" Comment="Request for track setpoint">
        <With Var="TrackSp" />
      </Event>
      <Event Name="REQ_PARA" Comment="Request for parameter updates">
        <With Var="Gain" />
        <With Var="DerivativeTime" />
        <With Var="IntegralTime" />
        <With Var="Direction" />
        <With Var="Deadband" />
        <With Var="DWorkOnError" />
        <With Var="CycleTime" />
        <With Var="EnFeedFwd" />
        <With Var="LagTime" />
        <With Var="OutMin" />
        <With Var="OutMax" />
        <With Var="ProhibitOutInc" />
        <With Var="ProhibitOutDec" />
      </Event>
      <Event Name="REQ_FEEDFWD" Comment="Request for executing feedforward gain">
        <With Var="FeedFwd" />
        <With Var="EnFeedFwd" />
        <With Var="FeedFwdGain" />
      </Event>
      <Event Name="REQ_OUTBIAS" Comment="Request to update outbias offset value">
        <With Var="OutbiasOffset" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Comment="Execution confirmation">
        <With Var="Out" />
        <With Var="OutMinActive" />
        <With Var="OutMaxActive" />
        <With Var="CalcP" />
        <With Var="CalcI" />
        <With Var="CalcD" />
        <With Var="CalcDeadband" />
        <With Var="CalcFf" />
        <With Var="IsAuto" />
        <With Var="IsMan" />
        <With Var="DeadbandActive" />
        <With Var="OutChangeProhibited" />
        <With Var="Outbias" />
      </Event>
      <Event Name="C_CNF" Comment="Cyclic execution confirmation">
        <With Var="Out" />
        <With Var="OutMinActive" />
        <With Var="OutMaxActive" />
        <With Var="OutInc" />
        <With Var="OutDec" />
        <With Var="CalcP" />
        <With Var="CalcI" />
        <With Var="CalcD" />
        <With Var="CalcDeadband" />
        <With Var="CalcFf" />
        <With Var="IsAuto" />
        <With Var="IsMan" />
        <With Var="DeadbandActive" />
        <With Var="OutChangeProhibited" />
        <With Var="Outbias" />
      </Event>
      <Event Name="CNF_READY" Comment="Execution confirmation of control module ready">
        <With Var="Ready" />
      </Event>
      <Event Name="IND_LIMIT" Comment="Indication for output low/high limit activated">
        <With Var="OutMinActive" />
        <With Var="OutMaxActive" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Pv" Type="VTQREAL" Comment="Process value" />
      <VarDeclaration Name="Sp" Type="VTQREAL" Comment="Setpoint" />
      <VarDeclaration Name="Mode" Type="BOOL" Comment="1 = Auto, 0 = Manual mode" />
      <VarDeclaration Name="Gain" Type="REAL" Comment="Gain parameter for PID calculation" />
      <VarDeclaration Name="IntegralTime" Type="REAL" Comment="Integral parameter for I calculation" />
      <VarDeclaration Name="DerivativeTime" Type="REAL" Comment="Derivative parameter for D calculation" />
      <VarDeclaration Name="Direction" Type="BOOL" InitialValue="FALSE" Comment="Direction for error calculation (0 = PV-SP; 1 = SP-PV)" />
      <VarDeclaration Name="Deadband" Type="REAL" Comment="Deadband for I and D calculation" />
      <VarDeclaration Name="DWorkOnError" Type="BOOL" Comment="1 = Derivative applied to error; 0 = Derivative applied to Pv" />
      <VarDeclaration Name="LagTime" Type="REAL" Comment="Lag time parameter for D calculation" />
      <VarDeclaration Name="OutMin" Type="REAL" Comment="Minimal output value" />
      <VarDeclaration Name="OutMax" Type="REAL" Comment="Maximal output value" />
      <VarDeclaration Name="PresetValue" Type="VTQREAL" Comment="Preset value for Out" />
      <VarDeclaration Name="CycleTime" Type="DINT" Comment="Timebase for PID calculation (ms)" />
      <VarDeclaration Name="EnFeedFwd" Type="BOOL" Comment="1 = Feed forward usage active" />
      <VarDeclaration Name="FeedFwdGain" Type="REAL" Comment="Feed forward Gain parameter" />
      <VarDeclaration Name="FeedFwd" Type="REAL" Comment="Feedforward" />
      <VarDeclaration Name="ProhibitOutInc" Type="BOOL" Comment="1 = Output increment prohibited" />
      <VarDeclaration Name="ProhibitOutDec" Type="BOOL" Comment="1 = Output decrement prohibited" />
      <VarDeclaration Name="Bump" Type="BOOL" Comment="1 =Transition to automatic mode with bump ,0= Bumpless transition to automatic mode " />
      <VarDeclaration Name="IlckCond" Type="BOOL" Comment="1 = Interlock condition active" />
      <VarDeclaration Name="IlckType" Type="CondType" Namespace="SE.App2CommonProcess" Comment="Type of condition interlock, (0 = Normal, 1 = Process interlock/Sequence interlock)" />
      <VarDeclaration Name="TrackSp" Type="BOOL" Comment="1 = Track setpoint" />
      <VarDeclaration Name="OutbiasOffset" Type="REAL" Comment="Output offset (bias), calculated based on integral component " />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Out" Type="VTQREAL" Comment="Calculated Output value" />
      <VarDeclaration Name="OutMinActive" Type="BOOL" Comment="1 = Out has reached OutMinLimit" />
      <VarDeclaration Name="OutMaxActive" Type="BOOL" Comment="1 = Out has reached OutMaxLimit" />
      <VarDeclaration Name="OutInc" Type="BOOL" Comment="1 = Output is increasing" />
      <VarDeclaration Name="OutDec" Type="BOOL" Comment="1 = Output is decreasing" />
      <VarDeclaration Name="Ready" Type="BOOL" Comment="1 = Control module ready for operation" />
      <VarDeclaration Name="CalcP" Type="REAL" Comment="Calculated proportional part" />
      <VarDeclaration Name="CalcI" Type="REAL" Comment="Calculated intergral part" />
      <VarDeclaration Name="CalcD" Type="REAL" Comment="Calculated derivative part" />
      <VarDeclaration Name="CalcDeadband" Type="REAL" Comment="Calculated Deadband " />
      <VarDeclaration Name="CalcFf" Type="REAL" Comment="Calculated Feed forward value" />
      <VarDeclaration Name="IsAuto" Type="BOOL" Comment="1 = Automatic mode detected" />
      <VarDeclaration Name="IsMan" Type="BOOL" Comment="1 = Manual mode detected" />
      <VarDeclaration Name="DeadbandActive" Type="BOOL" Comment="1 = Deadband mode is active" />
      <VarDeclaration Name="OutChangeProhibited" Type="BOOL" Comment="1 = Output changed prohibited" />
      <VarDeclaration Name="Outbias" Type="REAL" Comment="Output offset (bias) value in Auto Mode and Integration time is zero" />
    </OutputVars>
  </InterfaceList>
