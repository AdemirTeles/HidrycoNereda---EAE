<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="8455b537-2fed-54b3-a3ad-b382a3a32209" Name="Valvula_Solenoide" Comment="Valvula solenoide on/off (saida digital) com fim de curso opcional - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="04/11/2026" Remarks="1.0: SV-900 da agua de servico do lodo. O comando continua na logica do pai (cmdAbrir com REQ). Fins de curso por symlink ${PATH}stsAberto e ${PATH}stsFechado, usados so com cfgUsaFimCurso = TRUE; sem eles aberta/fechada saem do comando. Alarme = discrepancia por cfgTempoFalha (s). Modo sempre manual (fbkStsAutomatico = FALSE)." />
  <InterfaceList>
    <EventInputs>
      <Event ID="86EA94777281EF59" Name="REQ" Comment="Novo comando da logica">
        <With Var="cmdAbrir" />
      </Event>
    </EventInputs>
    <InputVars>
      <VarDeclaration ID="D0E4493379BA5C47" Name="cmdAbrir" Type="BOOL" Comment="Comando abrir (mesmo valor enviado a saida digital)" />
      <VarDeclaration ID="F8C5AB276CEAC3A9" Name="cfgUsaFimCurso" Type="BOOL" InitialValue="FALSE" Comment="TRUE = usa os fins de curso (symlinks stsAberto/stsFechado) e alarme de discrepancia" />
      <VarDeclaration ID="ABEA54D0FF478A94" Name="cfgTempoFalha" Type="UINT" InitialValue="10" Comment="Tempo de discrepancia para o alarme (s)" />
    </InputVars>
  </InterfaceList>
  <FBNetwork>
    <FB ID="5A857A695D3F0271" Name="IThis" Type="Valvula_Solenoide_HMI" x="3000" y="1400" Namespace="Hidryco.HidrycoLib">
      <Parameter Name="$6842FA5378295046" Value="TRUE" />
    </FB>
    <FB ID="992D691402098C31" Name="plcStart1" Type="plcStart" x="400" y="200" Namespace="SE.App2Base">
      <Parameter Name="$Prio" Value="10" />
    </FB>
    <FB ID="B62ADBB86DF80539" Name="Tick" Type="E_CYCLE" x="400" y="1000" Namespace="IEC61499.Standard">
      <Parameter Name="$DT" Value="T#1s" />
    </FB>
    <FB ID="23FBFE23F967B2D8" Name="Logica" Type="basicValvulaSolenoide" x="1700" y="200" Namespace="Hidryco.HidrycoLib" />
    <FB ID="CD1EA4D22BA39826" Name="FimAberto" Type="SYMLINKMULTIVARDST_1559B0FF8170C9BA0" x="400" y="1600" Namespace="Hidryco.HidrycoLib">
      <Attribute Name="Configuration.GenericFBType.InterfaceParams" Value="Runtime.System#I:=1;VALUE${I}:BOOL" />
      <Parameter Name="$NAME1" Value="'$${PATH}stsAberto'" />
      <Parameter Name="$QI" Value="TRUE" />
    </FB>
    <FB ID="191756F647887BAB" Name="FimFechado" Type="SYMLINKMULTIVARDST_1559B0FF8170C9BA0" x="400" y="2200" Namespace="Hidryco.HidrycoLib">
      <Attribute Name="Configuration.GenericFBType.InterfaceParams" Value="Runtime.System#I:=1;VALUE${I}:BOOL" />
      <Parameter Name="$NAME1" Value="'$${PATH}stsFechado'" />
      <Parameter Name="$QI" Value="TRUE" />
    </FB>
