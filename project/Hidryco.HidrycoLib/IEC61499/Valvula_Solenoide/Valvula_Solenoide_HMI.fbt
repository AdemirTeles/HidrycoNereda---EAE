<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="ba299bce-3f63-54d2-a103-1af3cd30ec30" Name="Valvula_Solenoide_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="04/11/2026" Remarks="IHM da Valvula_Solenoide (tags da IO List da Nereda)" />
  <InterfaceList>
    <EventInputs>
      <Event ID="83089A3FA0CD105D" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="6F6FC729C43E4672" Name="REQ" Comment="Atualizacao de status">
        <With Var="STS_ABERTO" />
        <With Var="STS_FECHADO" />
        <With Var="STS_ALARME" />
        <With Var="fbkStsAutomatico" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="9A210691C7CE4150" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="6842FA5378295046" Name="QI" Type="BOOL" />
      <VarDeclaration ID="40389A597DFA46C2" Name="STS_ABERTO" Type="BOOL" Comment="Valvula aberta" />
      <VarDeclaration ID="D4D007E20DF75F61" Name="STS_FECHADO" Type="BOOL" Comment="Valvula fechada" />
      <VarDeclaration ID="CD6047F1FD3E57C1" Name="STS_ALARME" Type="BOOL" Comment="Discrepancia entre comando e fim de curso" />
      <VarDeclaration ID="3A86C4D695C209FE" Name="fbkStsAutomatico" Type="BOOL" Comment="Modo automatico (sempre FALSE: SV so manual)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="17881AD1911EAEFA" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="091BB45B04CBB672" Name="STATUS" Type="STRING" Comment="Service Status" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>