<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="6552d68c-cb12-2dab-7bf9-1277e8332bff" Name="Motor_Inovaisa_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="22/10/2026" Remarks="IHM do Motor_Inovaisa" />
  <InterfaceList>
    <EventInputs>
      <Event ID="ADDA54BBAB97D79C" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="2D292CEE0EECA179" Name="LOAD_PERS_DATA" Comment="Reenvia os parametros persistentes" />
      <Event ID="894CF465CBE5DE99" Name="E_ATUALIZA" Comment="Atualizacao de status">
        <With Var="STS_FUNCIONAMENTO" />
        <With Var="STS_SENSOR_SOBRETORQUE" />
        <With Var="STS_LIGADO" />
        <With Var="STS_ALARME" />
        <With Var="STS_REVERSO" />
        <With Var="STS_FALHA" />
        <With Var="STS_SOBRETORQUE" />
        <With Var="STS_COMUNICACAO_OK" />
        <With Var="STS_TEM_REVERSO" />
        <With Var="STS_TEM_SOBRETORQUE" />
        <With Var="STS_ALM_FALHA_EST" />
        <With Var="STS_ALM_SOBRETORQUE_EST" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="168B52168BE98B03" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="2CDECF5265485734" Name="E_RESET">
        <With Var="CMD_RESET" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="F43CD31FC7FA8AC3" Name="QI" Type="BOOL" />
      <VarDeclaration ID="F30BD638AF8C13FF" Name="STS_FUNCIONAMENTO" Type="INT" Comment="Codigo de funcionamento do painel: grade 0 parado, 1 avante, 2 reverso, 3 falha; rosca 0 parado, 1 funcionando, 2 falha" />
      <VarDeclaration ID="132A020204BDDA20" Name="STS_SENSOR_SOBRETORQUE" Type="INT" Comment="Sensor de sobretorque: 0 normal, 1 sobretorque (so grade)" />
      <VarDeclaration ID="B5F58A52FFB0C024" Name="STS_LIGADO" Type="BOOL" Comment="Motor funcionando (avante ou reverso)" />
      <VarDeclaration ID="448B011AAE0077EF" Name="STS_ALARME" Type="BOOL" Comment="Falha do motor ou sobretorque" />
      <VarDeclaration ID="F15F28A051648FE4" Name="STS_REVERSO" Type="BOOL" Comment="Grade funcionando em reverso" />
      <VarDeclaration ID="357502AC3EA2474E" Name="STS_FALHA" Type="BOOL" Comment="Motor em falha (informado pelo painel)" />
      <VarDeclaration ID="84B01C540721AF7B" Name="STS_SOBRETORQUE" Type="BOOL" Comment="Sobretorque atuado" />
      <VarDeclaration ID="B43C4E444017CBEB" Name="STS_COMUNICACAO_OK" Type="BOOL" Comment="Comunicacao com o painel do gradeamento OK" />
      <VarDeclaration ID="4360993572C5722B" Name="STS_TEM_REVERSO" Type="BOOL" Comment="Configuracao: motor com reverso (grade)" />
      <VarDeclaration ID="0C124BF0C30CD2E9" Name="STS_TEM_SOBRETORQUE" Type="BOOL" Comment="Configuracao: motor com sensor de sobretorque (grade)" />
      <VarDeclaration ID="ED55F77B30DFA30E" Name="STS_ALM_FALHA_EST" Type="USINT" Comment="Estado do ALARM_BIT (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="FF1BB0A2DD9AE219" Name="STS_ALM_SOBRETORQUE_EST" Type="USINT" Comment="Estado do ALARM_BIT (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="F3EBAF2BE282680B" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="B7227105DD71A685" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="E70B674576CB02E5" Name="CMD_RESET" Type="BOOL" Comment="Reconhece os alarmes do motor" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>
