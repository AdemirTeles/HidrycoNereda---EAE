<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="cda2ade2-2cd4-8a34-0b4f-528818671d7b" Name="Motor_Inovaisa" Comment="Motor do painel do gradeamento Vibropac (grade ou rosca) - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Attribute Name="HMI.Alias" Value="" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="22/10/2026" Remarks="1.0: status de um motor do painel do gradeamento (tabela Modbus Inovaisa PV-35524). IThis com as tags do legado (Grade_Mecanizada_Inovaisa / Motor_Status): STS_FUNCIONAMENTO, STS_SENSOR_SOBRETORQUE, STS_LIGADO, STS_ALARME no evento E_ATUALIZA. Dados pelo processo (sem symlink)." />
  <InterfaceList>
    <EventInputs>
      <Event ID="94DE44B005A7078D" Name="REQ" Comment="Leitura do painel (pelo processo)">
        <With Var="fldStatus" />
        <With Var="fldSobretorque" />
        <With Var="falhaCom" />
      </Event>
      <Event ID="86B7A273610FFA5D" Name="E_RESET_FALHAS" Comment="Reconhecimento dos alarmes pelo processo (com cmdResetFalhas = TRUE)">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="B512B9549703084F" Name="CNF" Comment="Status (na mudanca)">
        <With Var="stsLigado" />
        <With Var="stsFalha" />
        <With Var="stsAlarme" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="7B969788E59D2A58" Name="fldStatus" Type="INT" Comment="Registro de status do motor (4007/4008/4009)" />
      <VarDeclaration ID="32F60EC0B2C7F401" Name="fldSobretorque" Type="INT" Comment="Registro do sobretorque (4010/4011)" />
      <VarDeclaration ID="BC209493FBB47803" Name="falhaCom" Type="BOOL" Comment="Sem comunicacao com o painel" />
      <VarDeclaration ID="08D30EE79B49C6AD" Name="cmdResetFalhas" Type="BOOL" Comment="TRUE = reconhece (com o evento E_RESET_FALHAS)" />
      <VarDeclaration ID="0E1A34A88A70736E" Name="cfgReverso" Type="BOOL" InitialValue="FALSE" Comment="TRUE = grade (avante/reverso); FALSE = rosca" />
      <VarDeclaration ID="61D2C77E6EFE9878" Name="cfgSobretorque" Type="BOOL" InitialValue="FALSE" Comment="TRUE = tem sensor de sobretorque (grade)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="9F7A867A79CFF3D0" Name="stsLigado" Type="BOOL" Comment="Motor funcionando" />
      <VarDeclaration ID="0E2B8B9306A90020" Name="stsFalha" Type="BOOL" Comment="Motor em falha" />
      <VarDeclaration ID="3E3B51589C07F168" Name="stsAlarme" Type="BOOL" Comment="Falha ou sobretorque" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
