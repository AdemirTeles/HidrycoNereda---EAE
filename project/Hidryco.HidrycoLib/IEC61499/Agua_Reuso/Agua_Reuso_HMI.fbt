<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="61beeb13-0040-47b1-a6a0-6c4a9d8e4860" Name="Agua_Reuso_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.2" Author="Hidryco" Date="15/10/2026" Remarks="IHM da Agua_Reuso" />
  <InterfaceList>
    <EventInputs>
      <Event ID="5B291D4D67D48173" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="BA9200524709281B" Name="LOAD_PERS_DATA" Comment="Reenvia os parametros persistentes" />
      <Event ID="0FFD476B12261BFC" Name="REQ" Comment="Atualizacao de status">
        <With Var="STS_NIVEL_01" />
        <With Var="STS_PORCENTAGEM_01" />
        <With Var="STS_COND_01" />
        <With Var="STS_NIVEL_02" />
        <With Var="STS_PORCENTAGEM_02" />
        <With Var="STS_COND_02" />
        <With Var="STS_BOIA_NORMAL" />
        <With Var="STS_NIVEL_BAIXO" />
        <With Var="STS_FALHA_REMOTA1" />
        <With Var="STS_FALHA_REMOTA2" />
        <With Var="STS_ALARME" />
        <With Var="STS_ALM_NIVEL_BAIXO_EST" />
        <With Var="STS_ALM_REMOTA1_EST" />
        <With Var="STS_ALM_REMOTA2_EST" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="D656758D65B70390" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="05D27B56DB642E3B" Name="E_RESET">
        <With Var="CMD_RESET" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="93F1B98356204249" Name="QI" Type="BOOL" />
      <VarDeclaration ID="502DB12634FA3EAE" Name="STS_NIVEL_01" Type="REAL" Comment="Nivel 1000-PIT-01" />
      <VarDeclaration ID="81C0628EFE8726A6" Name="STS_PORCENTAGEM_01" Type="REAL" Comment="Nivel 1000-PIT-01 (%)" />
      <VarDeclaration ID="35A08BB1DE44C71A" Name="STS_COND_01" Type="INT" Comment="PIT-01: 0 normal, 1 HH, 2 H, 3 L, 4 LL, 5 sinal invalido, 6 falha memorizada, 7 desabilitado" />
      <VarDeclaration ID="A8D89D8718373A64" Name="STS_NIVEL_02" Type="REAL" Comment="Nivel 1000-PIT-02" />
      <VarDeclaration ID="2529D64949E9AEE6" Name="STS_PORCENTAGEM_02" Type="REAL" Comment="Nivel 1000-PIT-02 (%)" />
      <VarDeclaration ID="E2AEEC2ED3B0FA82" Name="STS_COND_02" Type="INT" Comment="PIT-02: mesmos codigos do STS_COND_01" />
      <VarDeclaration ID="C99A868607210194" Name="STS_BOIA_NORMAL" Type="BOOL" Comment="Boia 1000-LSL-01 levantada" />
      <VarDeclaration ID="F60000E1A4383811" Name="STS_NIVEL_BAIXO" Type="BOOL" Comment="Nivel baixo pela boia 1000-LSL-01" />
      <VarDeclaration ID="BF5934575D19358B" Name="STS_FALHA_REMOTA1" Type="BOOL" Comment="Falha de comunicacao com a remota 1 da Subestacao" />
      <VarDeclaration ID="87D3EF366AF9B5C3" Name="STS_FALHA_REMOTA2" Type="BOOL" Comment="Falha de comunicacao com a remota 2 da Subestacao" />
      <VarDeclaration ID="759FEBA1D038B19B" Name="STS_ALARME" Type="BOOL" Comment="Algum alarme da agua de reuso" />
      <VarDeclaration ID="1946141CF0DDF720" Name="STS_ALM_NIVEL_BAIXO_EST" Type="USINT" Comment="Estado do ALARM_BIT nivel baixo (boia) (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="B090B8451459FC56" Name="STS_ALM_REMOTA1_EST" Type="USINT" Comment="Estado do ALARM_BIT remota 1 (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="FB7C34D2BA98C96C" Name="STS_ALM_REMOTA2_EST" Type="USINT" Comment="Estado do ALARM_BIT remota 2 (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="E27C03BE208FCFAC" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="E5896C6EFE4F7B7C" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="8080CCD0B707ACBC" Name="CMD_RESET" Type="BOOL" Comment="Reconhece os alarmes da agua de reuso e faz o reset dos sensores" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>