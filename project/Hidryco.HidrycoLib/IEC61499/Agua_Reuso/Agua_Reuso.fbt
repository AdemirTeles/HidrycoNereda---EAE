      <VarDeclaration ID="4D64B1C32FD5045A" Name="stsNivelBaixoBoia" Type="BOOL" Comment="Nivel baixo pela boia 1000-LSL-01 (confirmado por cfgTempoBoia)" />
      <VarDeclaration ID="53C62893BF7940F6" Name="stsFalhaComRemota1" Type="BOOL" Comment="Falha de comunicacao com a remota 1 da Subestacao (boia)" />
      <VarDeclaration ID="16EC2BD564811BCA" Name="stsFalhaComRemota2" Type="BOOL" Comment="Falha de comunicacao com a remota 2 da Subestacao (PIT-01/02)" />
      <VarDeclaration ID="DA940A0650B4B7CD" Name="stsAlarme" Type="BOOL" Comment="Algum alarme da agua de reuso (sensores, boia, comunicacao)" />
    </OutputVars>
