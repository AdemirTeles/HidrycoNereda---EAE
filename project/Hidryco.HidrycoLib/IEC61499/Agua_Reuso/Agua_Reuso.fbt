        <With Var="stsAlarmeLLPIT02" />
        <With Var="stsNivelBaixoBoia" />
        <With Var="stsFalhaComRemota1" />
        <With Var="stsFalhaComRemota2" />
        <With Var="stsAlarme" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="B45CEE46167C7385" Name="cmdResetFalhas" Type="BOOL" Comment="TRUE = reset (com o evento E_RESET_FALHAS)" />
      <VarDeclaration ID="045DD74B18E53815" Name="cfgTempoBoia" Type="UINT" InitialValue="10" Comment="Tempo (s) da boia 1000-LSL-01 abaixada para confirmar o nivel baixo" />
      <VarDeclaration ID="C5556562F5059798" Name="cfgBoiaInvertida" Type="BOOL" InitialValue="FALSE" Comment="FALSE: entrada da boia TRUE = nivel normal (boia levantada). TRUE: entrada TRUE = nivel baixo" />
      <VarDeclaration ID="10FA9914C914869F" Name="cfgTempoCom" Type="UINT" InitialValue="5" Comment="Tempo (s) sem comunicacao para confirmar a falha das remotas" />
    </InputVars>
