      <VarDeclaration ID="220EC8A10C0E8ACA" Name="stsFalhaPIT01" Type="BOOL" Comment="Falha do sensor PIT_1000_01 (memorizada ate o reset)" />
      <VarDeclaration ID="379C0FD82106139D" Name="stsAlarmeHHPIT01" Type="BOOL" Comment="Alarme HH do PIT_1000_01" />
      <VarDeclaration ID="B10978005BF527AC" Name="stsAlarmeHPIT01" Type="BOOL" Comment="Alarme H do PIT_1000_01" />
      <VarDeclaration ID="36B22FC5F4ED4A74" Name="stsAlarmeLPIT01" Type="BOOL" Comment="Alarme L do PIT_1000_01" />
