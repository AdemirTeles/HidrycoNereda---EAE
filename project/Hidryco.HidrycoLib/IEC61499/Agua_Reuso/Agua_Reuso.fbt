      <VarDeclaration ID="CC0837897A1B06B0" Name="stsNivelPIT02" Type="REAL" Comment="Nivel PIT_1000_02 (unidade de engenharia do sensor; 0 com o sinal em falha)" />
      <VarDeclaration ID="7BB11CFAE6D67FB1" Name="stsPorcentagemPIT02" Type="REAL" Comment="Nivel PIT_1000_02 em % da altura maxima" />
      <VarDeclaration ID="A6F1FE7BB2DFF6F0" Name="stsFalhaPIT02" Type="BOOL" Comment="Falha do sensor PIT_1000_02 (memorizada ate o reset)" />
      <VarDeclaration ID="5D6FBA2FD51AB66B" Name="stsAlarmeHHPIT02" Type="BOOL" Comment="Alarme HH do PIT_1000_02" />
      <VarDeclaration ID="56ECAEEED33A904C" Name="stsAlarmeHPIT02" Type="BOOL" Comment="Alarme H do PIT_1000_02" />
