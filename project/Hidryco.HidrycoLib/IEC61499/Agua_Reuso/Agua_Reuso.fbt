<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="4101c694-13cc-42d8-afa5-94201cf8e6f0" Name="Agua_Reuso" Format="2.0" Comment="Agua de reuso (serie 1000) - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Attribute Name="HMI.Alias" Value="" />
  <Attribute Name="Configuration.FB.IDCounter" Value="4" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.2" Author="Hidryco" Date="15/10/2026" Remarks="1.2: o MGE do PCM Agua Reuso (MGE_1000) sai do CAT: passa a ser a instancia MGE_AGUA_REUSO do frame de MGEs do ETE_TJ; saem as saidas e tags do MGE. 1.1: MGE_1000 passa a ser o MGE_Generico (PM5300 pelo HW CAT PM53xxMbtcp, falta de fase e H/L de tensao e corrente); saidas stsFaltaFaseMGE, stsAlarmeMGE e stsPotenciaAtivaMGE; sai o cfgMonitoraMGE e o symlink stsConexaoMGE. 1.0: agua de reuso (serie 1000), so monitoracao. 1000-PIT-01/02 (Sensor_Generico, 4-20 mA, nivel) pelos symlinks ${PATH}PIT_1000_0x.stsSensorBruto; boia 1000-LSL-01 por ${PATH}stsBoiaLSL; comunicacao por ${PATH}stsFalhaRemota1 (BOOL, cartao), ${PATH}stsConexaoRemota2 e ${PATH}stsConexaoMGE (INT, connStatusInt); MGE do PCM Agua Reuso no MGE_1000. Valores e alarmes nas saidas do CAT." />
  <InterfaceList>
    <EventInputs>
      <Event ID="38FF8AD75B0EE11B" Name="E_RESET_FALHAS" Comment="Reset pelo processo (sensores) com cmdResetFalhas = TRUE">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="A7B6C348F1CFC261" Name="CNF" Comment="Valores e alarmes (so na mudanca)">
