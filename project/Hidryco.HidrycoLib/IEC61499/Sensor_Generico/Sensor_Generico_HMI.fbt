<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="50e735ae-4a34-4649-af13-db99d323a359" Name="Sensor_Generico_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.5" Author="Hidryco" Date="04/11/2026" Remarks="1.5: CommonError, Reliability e DaysToMaintenance para a IO List da Nereda. 1.4: STS_LIMITE_HH..LL (limites dos alarmes em unidade de engenharia) para o grafico. IHM do Sensor_Generico" />
  <InterfaceList>
    <EventInputs>
      <Event ID="B11E9EDFB330BB0A" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="F46E32F8CF51BE9D" Name="LOAD_PERS_DATA" Comment="Reenvia os parametros persistentes" />
      <Event ID="0DB49FB1D65E52DB" Name="REQ" Comment="Atualizacao de status">
        <With Var="STS_SENSOR" />
        <With Var="STS_PORCENTAGEM" />
        <With Var="STS_ESTADO" />
        <With Var="STS_FALHA_SENSOR" />
        <With Var="STS_FALHA_ATIVA" />
        <With Var="STS_HABILITADO" />
        <With Var="STS_ALARME_HH" />
        <With Var="STS_ALARME_H" />
        <With Var="STS_ALARME_L" />
        <With Var="STS_ALARME_LL" />
        <With Var="STS_ALARME" />
        <With Var="STS_BRUTO" />
        <With Var="CFG_COMUNICACAO" />
        <With Var="CFG_NIVEL" />
        <With Var="CFG_UNIDADE" />
        <With Var="CFG_CASAS_DECIMAIS" />
        <With Var="STS_ALM_HH_EST" />
        <With Var="STS_ALM_H_EST" />
        <With Var="STS_ALM_L_EST" />
        <With Var="STS_ALM_LL_EST" />
        <With Var="STS_ALM_FALHA_EST" />
        <With Var="STS_FALHA_COMUNICACAO" />
        <With Var="STS_LIMITE_HH" />
        <With Var="STS_LIMITE_H" />
        <With Var="STS_LIMITE_L" />
        <With Var="STS_LIMITE_LL" />
        <With Var="CommonError" />
        <With Var="Reliability" />
        <With Var="DaysToMaintenance" />
        <With Var="CFG_SKID" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="8DA9E22D0BD63DE1" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="BC1F18854FDB14ED" Name="E_PARAMETROS">
        <With Var="CMD_HABILITA_SENSOR" />
        <With Var="STP_RANGE_MINIMO" />
        <With Var="STP_RANGE_MAXIMO" />
        <With Var="STP_ALTURA_MAXIMA" />
        <With Var="CMD_HABILITA_ALARME_HH" />
        <With Var="CMD_HABILITA_ALARME_H" />
        <With Var="CMD_HABILITA_ALARME_L" />
        <With Var="CMD_HABILITA_ALARME_LL" />
        <With Var="STP_ALARME_HH" />
        <With Var="STP_ALARME_H" />
        <With Var="STP_ALARME_L" />
        <With Var="STP_ALARME_LL" />
        <With Var="STP_TEMPO_ALARME_HH" />
        <With Var="STP_TEMPO_ALARME_H" />
        <With Var="STP_TEMPO_ALARME_L" />
        <With Var="STP_TEMPO_ALARME_LL" />
      </Event>
      <Event ID="4275246E291683C0" Name="E_RESET">
        <With Var="CMD_RESET" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="1C38ED12C8BD1D24" Name="QI" Type="BOOL" />
      <VarDeclaration ID="8897CDA500AC3B43" Name="STS_SENSOR" Type="REAL" Comment="Valor em unidade de engenharia" />
      <VarDeclaration ID="03F005FFEA8B1EB7" Name="STS_PORCENTAGEM" Type="REAL" Comment="Nivel em % (so sensor de nivel)" />
      <VarDeclaration ID="8C3B32492EDE30F6" Name="STS_ESTADO" Type="INT" Comment="0 normal, 1 alerta, 2 alarme, 3 falha, 4 desabilitado" />
      <VarDeclaration ID="F96D4140FF4E3BE0" Name="STS_FALHA_SENSOR" Type="BOOL" Comment="Falha do sensor (4-20 mA fora da faixa ou falha do instrumento), sem a falha de comunicacao" />
      <VarDeclaration ID="50692E037DBEB5AF" Name="STS_FALHA_ATIVA" Type="BOOL" Comment="Qualquer falha ativa (sensor ou comunicacao)" />
      <VarDeclaration ID="8CC7DAAF94A2F272" Name="STS_HABILITADO" Type="BOOL" Comment="Sensor habilitado" />
      <VarDeclaration ID="F359F702D2084BBB" Name="STS_ALARME_HH" Type="BOOL" Comment="Alarme HH" />
      <VarDeclaration ID="A44C5B0C739C913A" Name="STS_ALARME_H" Type="BOOL" Comment="Alarme H" />
      <VarDeclaration ID="02D192408DD0BAD7" Name="STS_ALARME_L" Type="BOOL" Comment="Alarme L" />
      <VarDeclaration ID="383A34199F936BCE" Name="STS_ALARME_LL" Type="BOOL" Comment="Alarme LL" />
      <VarDeclaration ID="D2378FEEF5A3D1D1" Name="STS_ALARME" Type="BOOL" Comment="Algum alarme" />
      <VarDeclaration ID="D7B779974D991A8E" Name="STS_BRUTO" Type="REAL" Comment="Valor bruto lido (diagnostico)" />
      <VarDeclaration ID="CBCE958A8B6D12A1" Name="CFG_COMUNICACAO" Type="BOOL" Comment="Configuracao: valor por comunicacao" />
      <VarDeclaration ID="8BC973C9232A9202" Name="CFG_NIVEL" Type="BOOL" Comment="Configuracao: sensor de nivel (mostra %)" />
      <VarDeclaration ID="1A77C34E03AFA0CE" Name="CFG_UNIDADE" Type="STRING" Comment="Configuracao: unidade de engenharia" />
      <VarDeclaration ID="4834B2F21AEC2CC6" Name="CFG_CASAS_DECIMAIS" Type="UINT" Comment="Configuracao: casas decimais" />
      <VarDeclaration ID="A91C3C65B4F67DE5" Name="STS_ALM_HH_EST" Type="USINT" Comment="Estado do ALARM_BIT HH (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="B10CA9D36B32EBC9" Name="STS_ALM_H_EST" Type="USINT" Comment="Estado do ALARM_BIT H (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="02DAB08BEDD4D70F" Name="STS_ALM_L_EST" Type="USINT" Comment="Estado do ALARM_BIT L (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="C4A67D01408D3D56" Name="STS_ALM_LL_EST" Type="USINT" Comment="Estado do ALARM_BIT LL (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="D31A79F7D2BBEF19" Name="STS_ALM_FALHA_EST" Type="USINT" Comment="Estado do ALARM_BIT FALHA (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="3066A0DA727B2781" Name="STS_FALHA_COMUNICACAO" Type="BOOL" Comment="Falha de comunicacao do sensor" />
      <VarDeclaration ID="4D0002C974B24A69" Name="STS_LIMITE_HH" Type="REAL" Comment="Limite do alarme HH em unidade de engenharia" />
      <VarDeclaration ID="2007E90E21C8B4CF" Name="STS_LIMITE_H" Type="REAL" Comment="Limite do alarme H em unidade de engenharia" />
      <VarDeclaration ID="7B165BE1315191C3" Name="STS_LIMITE_L" Type="REAL" Comment="Limite do alarme L em unidade de engenharia" />
      <VarDeclaration ID="FFEA0503A1019B14" Name="STS_LIMITE_LL" Type="REAL" Comment="Limite do alarme LL em unidade de engenharia" />
      <VarDeclaration ID="339076CC42EE7FBD" Name="CommonError" Type="BOOL" Comment="Nereda: erro do sensor (= STS_FALHA_SENSOR)" />
      <VarDeclaration ID="3B6F1F6BAD6853A9" Name="Reliability" Type="INT" Comment="Nereda: confiabilidade do sensor (%), fixo em 80" />
      <VarDeclaration ID="9CD8D28946EE45E2" Name="DaysToMaintenance" Type="INT" Comment="Nereda: dias para a manutencao (sem fonte: 0)" />
      <VarDeclaration ID="BB5D27FFFC44E39C" Name="CFG_SKID" Type="BOOL" Comment="Configuracao: valor ja escalado no skid (sem ajuste de escala na IHM)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="05157ADCFA2355D6" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="78ED2C760F77BA43" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="74F7308C27744D49" Name="CMD_HABILITA_SENSOR" Type="BOOL" Comment="Sensor habilitado" />
      <VarDeclaration ID="0BD1CDAA1517CE9D" Name="STP_RANGE_MINIMO" Type="REAL" Comment="Valor de engenharia em 4 mA" />
      <VarDeclaration ID="80A8E9E8A637C9EC" Name="STP_RANGE_MAXIMO" Type="REAL" Comment="Valor de engenharia em 20 mA" />
      <VarDeclaration ID="9F16D125566454DD" Name="STP_ALTURA_MAXIMA" Type="REAL" Comment="Altura maxima do tanque (nivel)" />
      <VarDeclaration ID="93AF73B64660FBA6" Name="CMD_HABILITA_ALARME_HH" Type="BOOL" Comment="Alarme HH habilitado" />
      <VarDeclaration ID="A8AE53BDCD5D904B" Name="CMD_HABILITA_ALARME_H" Type="BOOL" Comment="Alarme H habilitado" />
      <VarDeclaration ID="D202A579D84D6111" Name="CMD_HABILITA_ALARME_L" Type="BOOL" Comment="Alarme L habilitado" />
      <VarDeclaration ID="D0AF2971D81905DB" Name="CMD_HABILITA_ALARME_LL" Type="BOOL" Comment="Alarme LL habilitado" />
      <VarDeclaration ID="7654A9844654582E" Name="STP_ALARME_HH" Type="REAL" Comment="Setpoint do alarme HH" />
      <VarDeclaration ID="9F33F2002C72AA38" Name="STP_ALARME_H" Type="REAL" Comment="Setpoint do alarme H" />
      <VarDeclaration ID="20FFBF6BD7638BE5" Name="STP_ALARME_L" Type="REAL" Comment="Setpoint do alarme L" />
      <VarDeclaration ID="27BF8C3F14711ABA" Name="STP_ALARME_LL" Type="REAL" Comment="Setpoint do alarme LL" />
      <VarDeclaration ID="81B00D22F26005A0" Name="STP_TEMPO_ALARME_HH" Type="UINT" Comment="Tempo do alarme HH (s); padrao 5 s (retardo contra alarme falso, ISA-18.2)" />
      <VarDeclaration ID="CA2F98887484603A" Name="STP_TEMPO_ALARME_H" Type="UINT" Comment="Tempo do alarme H (s); padrao 5 s (retardo contra alarme falso, ISA-18.2)" />
      <VarDeclaration ID="CC9F410D4B3B3695" Name="STP_TEMPO_ALARME_L" Type="UINT" Comment="Tempo do alarme L (s); padrao 5 s (retardo contra alarme falso, ISA-18.2)" />
      <VarDeclaration ID="5C9A19D23397D700" Name="STP_TEMPO_ALARME_LL" Type="UINT" Comment="Tempo do alarme LL (s); padrao 5 s (retardo contra alarme falso, ISA-18.2)" />
      <VarDeclaration ID="23C877B7D5B67937" Name="CMD_RESET" Type="BOOL" Comment="Reset de falha e alarmes" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>