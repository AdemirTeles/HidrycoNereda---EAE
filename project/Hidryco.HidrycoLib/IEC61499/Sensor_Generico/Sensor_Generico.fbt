<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="cd6bd9db-8c60-4c56-aa13-316dc546ecde" Name="Sensor_Generico" Format="2.0" Comment="Sensor analogico generico (4-20 mA ou comunicacao) - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Attribute Name="HMI.Alias" Value="" />
  <Attribute Name="Configuration.FB.IDCounter" Value="2" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.4" Author="Hidryco" Date="16/10/2026" Remarks="1.4: sinal em falha tambem pelo status da conexao Modbus (symlink stsConexao INT, 1 = online) com cfgUsaConexao, no 4-20 mA lido por remota e na comunicacao. 1.3: entrada inibeAlarmesBaixos (E_INIBE) e saidas stsCondicaoHH/H/L/LL (limite ultrapassado agora). 1.2: alarmes na lista do EAE com reconhecimento pelo reset e pisca na IHM (ISA-101), tempo padrao de alarme 5 s. 1.0: sensor generico (substitui Sensor_4a20, Sensor_Nivel_4a20 e Sensor_Comunicacao). Campo por symlink ${PATH}: 4-20 mA = stsSensorBruto (INT); comunicacao = stsFalhaSensor, stsEntrada (REAL), stsFalhaComunicacao. Alarmes HH/H/L/LL e falha no sistema de alarmes do EAE (ALARM_BIT)." />
  <InterfaceList>
    <EventInputs>
      <Event ID="D21DAA5004F58516" Name="E_RESET_FALHAS" Comment="Reset da falha e dos alarmes pelo processo (com cmdResetFalhas = TRUE)">
        <With Var="cmdResetFalhas" />
      </Event>
      <Event ID="33AD1B5E06E89E39" Name="E_INIBE" Comment="Inibicao dos alarmes L e LL pelo processo">
        <With Var="inibeAlarmesBaixos" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="28A380156DB271B8" Name="CNF" Comment="Status (so na mudanca)">
        <With Var="stsValor" />
        <With Var="stsPorcentagem" />
        <With Var="stsFalhaSensor" />
        <With Var="stsFalhaAtiva" />
        <With Var="stsHabilitado" />
        <With Var="stsAlarmeHH" />
        <With Var="stsAlarmeH" />
        <With Var="stsAlarmeL" />
        <With Var="stsAlarmeLL" />
        <With Var="stsAlarme" />
        <With Var="stsCondicaoHH" />
        <With Var="stsCondicaoH" />
        <With Var="stsCondicaoL" />
        <With Var="stsCondicaoLL" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="1908F43CB878F5E7" Name="cmdResetFalhas" Type="BOOL" Comment="TRUE = reset (com o evento E_RESET_FALHAS)" />
      <VarDeclaration ID="D46B37D45FD5AF5D" Name="cfgComunicacao" Type="BOOL" InitialValue="FALSE" Comment="FALSE = entrada 4-20 mA (stsSensorBruto), TRUE = valor por comunicacao (stsEntrada, ja em unidade de engenharia)" />
      <VarDeclaration ID="FC98F78ABCBC0A7E" Name="cfgNivel" Type="BOOL" InitialValue="FALSE" Comment="TRUE = sensor de nivel: calcula % sobre a altura maxima" />
      <VarDeclaration ID="31E57DCE3AF9C996" Name="cfgBrutoMin" Type="REAL" InitialValue="4000.0" Comment="Valor bruto em 4 mA (TM3: 4000)" />
      <VarDeclaration ID="BFED79817B71957D" Name="cfgBrutoMax" Type="REAL" InitialValue="20000.0" Comment="Valor bruto em 20 mA (TM3: 20000)" />
      <VarDeclaration ID="CA39953142B1EBBD" Name="cfgFalhaMin" Type="REAL" InitialValue="3600.0" Comment="Abaixo deste bruto = falha (NAMUR NE43: 3,6 mA)" />
      <VarDeclaration ID="519A2B73CC673344" Name="cfgFalhaMax" Type="REAL" InitialValue="21000.0" Comment="Acima deste bruto = falha (NAMUR NE43: 21,0 mA)" />
      <VarDeclaration ID="F21E4E6BC95CB4D0" Name="cfgTempoFalha" Type="UINT" InitialValue="5" Comment="Tempo para confirmar a falha do sinal (s)" />
      <VarDeclaration ID="0ECE7B3867B02E0B" Name="cfgUsaConexao" Type="BOOL" InitialValue="FALSE" Comment="TRUE = sinal em falha tambem quando o status da conexao Modbus (symlink stsConexao, INT: 1 = online) for diferente de 1 (4-20 mA lido por remota ou comunicacao)" />
      <VarDeclaration ID="CC8EEC06FF0C4430" Name="cfgUnidade" Type="STRING" InitialValue="''" Comment="Unidade de engenharia mostrada na IHM (ex.: m, bar, m3/h, mg/L)" />
      <VarDeclaration ID="6D3A2524C5D0F0D1" Name="cfgCasasDecimais" Type="UINT" InitialValue="2" Comment="Casas decimais do valor na IHM" />
      <VarDeclaration ID="A5CADABB487002E6" Name="inibeAlarmesBaixos" Type="BOOL" InitialValue="FALSE" Comment="TRUE = alarmes L e LL inibidos (com o evento E_INIBE). Ex.: pressao de recalque com as bombas paradas" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="D7422D307E6AF52D" Name="stsValor" Type="REAL" Comment="Valor em unidade de engenharia (0 em falha ou desabilitado)" />
      <VarDeclaration ID="E6F78A591442B69F" Name="stsPorcentagem" Type="REAL" Comment="Nivel em % da altura maxima (so cfgNivel)" />
      <VarDeclaration ID="6108F9B5CA5170A6" Name="stsFalhaSensor" Type="BOOL" Comment="Falha do sensor memorizada (ate o reset)" />
      <VarDeclaration ID="726640D1704B3F86" Name="stsFalhaAtiva" Type="BOOL" Comment="Sinal em falha agora (valor invalido)" />
      <VarDeclaration ID="07C3588C57A022B8" Name="stsHabilitado" Type="BOOL" Comment="Sensor habilitado" />
      <VarDeclaration ID="9578190A49DBC450" Name="stsAlarmeHH" Type="BOOL" Comment="Alarme HH (memorizado ate o reset; suprimido com o sinal em falha)" />
      <VarDeclaration ID="0D14BA934DBED883" Name="stsAlarmeH" Type="BOOL" Comment="Alarme H (memorizado ate o reset; suprimido com o sinal em falha)" />
      <VarDeclaration ID="ADAD629D7A214F32" Name="stsAlarmeL" Type="BOOL" Comment="Alarme L (memorizado ate o reset; suprimido com o sinal em falha)" />
      <VarDeclaration ID="53279A5859ECAB18" Name="stsAlarmeLL" Type="BOOL" Comment="Alarme LL (memorizado ate o reset; suprimido com o sinal em falha)" />
      <VarDeclaration ID="72E7C8EC75361066" Name="stsAlarme" Type="BOOL" Comment="Algum alarme ativo" />
      <VarDeclaration ID="5493E1BF18D97620" Name="stsCondicaoHH" Type="BOOL" Comment="Valor alem do setpoint HH agora (sem tempo e sem memoria; so com o alarme habilitado e o sinal bom)" />
      <VarDeclaration ID="613F6EF6FA647237" Name="stsCondicaoH" Type="BOOL" Comment="Valor alem do setpoint H agora (sem tempo e sem memoria; so com o alarme habilitado e o sinal bom)" />
      <VarDeclaration ID="324136474F57E8DB" Name="stsCondicaoL" Type="BOOL" Comment="Valor alem do setpoint L agora (sem tempo e sem memoria; so com o alarme habilitado e o sinal bom)" />
      <VarDeclaration ID="4D71F9AF04DA2016" Name="stsCondicaoLL" Type="BOOL" Comment="Valor alem do setpoint LL agora (sem tempo e sem memoria; so com o alarme habilitado e o sinal bom)" />
    </OutputVars>
    <Plugs>
      <AdapterDeclaration ID="6CDDEE4759B81B9D" Name="IStatus" Type="ISensorStatus" Namespace="Hidryco.HidrycoLib" x="6100" y="3460" />
    </Plugs>
  </InterfaceList>
