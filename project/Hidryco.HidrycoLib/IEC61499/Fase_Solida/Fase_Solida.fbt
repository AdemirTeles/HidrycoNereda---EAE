<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="f6730ecd-c0ba-0a4d-194d-fe2c1e2d5246" Name="Fase_Solida" Comment="Fase solida (900): estocagem, alimentacao das prensas C-Press, polimero - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.4" Author="Hidryco" Date="21/10/2026" Remarks="1.4: velocidade de partida e PIDs das prensas em Hz (conversao no CLP). 1.3: pidCtl Pid1/2/3 com CycleTime 1000 ms (sem ele o calculo ciclico do pidSC ficava sem periodo). 1.2: sub-CATs Revezamento (horas por soprador, padrao do legado com o nome da elevatoria) e PID (ganho, integral, velocidade minima/maxima das 3 prensas). 1.0: fase solida (900, PCE LODO). Sub-CATs: LIT_900_01/02 (nivel dos tanques, 4-20 mA), FT_900_01/02/03/07 (vazao, comunicacao), SO_900_01/02, BO_900_01..03, BR_900_01/02 (Motor_Generico com ATV), VA_900_01/02, VB_900_03/04, VA_900_06..13 (Valvula_Coester on/off; VA_900_12 futura), AD_900_01..03 (Prensa_Vibropac; AD_900_03 futura), PP_900_01 (Preparador_Vibropac). Campo por symlink ${PATH}: djXXX (disjuntores do PCM LODO, XXX = equipamento), stsEmergenciaPainel (NF), stsMonitTrafo, stsMonitFonte, stsRemota1ComOk, stsRemota2Conexao (INT, connStatusInt); escrita cmdSV01/02/03/04/06/08 (solenoides, manual)." />
  <InterfaceList>
    <EventInputs>
      <Event ID="DAB96FE935A92679" Name="E_RESET_FALHAS" Comment="Reset pelo processo (fase solida e equipamentos) com cmdResetFalhas = TRUE">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="D64A39BCF02DDEB2" Name="CNF" Comment="Status">
        <With Var="stsEmergencia" />
        <With Var="stsAlarme" />
        <With Var="stsNivelBaixoTQ" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="24CD1B2317618B18" Name="cmdResetFalhas" Type="BOOL" Comment="TRUE = reset (com o evento E_RESET_FALHAS)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="317BB96205F3F911" Name="stsEmergencia" Type="BOOL" Comment="Emergencia do PCM LODO" />
      <VarDeclaration ID="2462DCD097711319" Name="stsAlarme" Type="BOOL" Comment="Algum alarme da alimentacao/painel" />
      <VarDeclaration ID="5405EB7088EC4BDE" Name="stsNivelBaixoTQ" Type="BOOL" Comment="Tanques de estocagem em nivel baixo" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
