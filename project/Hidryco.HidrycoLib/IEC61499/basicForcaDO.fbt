  <BasicFB ID="eb16d974-54f9-8bad-caca-2296819fae94">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="Main" />
    <InternalVars>
      <VarDeclaration ID="7D43B0D4790AA1A8" Name="wL0" Type="WORD" />
      <VarDeclaration ID="6AD572C1D6BAC8CE" Name="wL1" Type="WORD" />
      <VarDeclaration ID="FC70B9FE643824FD" Name="wD0" Type="WORD" />
      <VarDeclaration ID="74EF2795737654A6" Name="wD1" Type="WORD" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="550" y="425" />
      <ECState Name="EXEC" x="550" y="1100">
        <ECAction Algorithm="Main" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="EXEC" Condition="REQ_B0 OR REQ_B1 OR REQ_FORCA" x="760" y="760" />
      <ECTransition Source="EXEC" Destination="START" Condition="1" x="340" y="760" />
    </ECC>
    <Algorithm Name="Main" Comment="Aplica o forcamento">
      <ST><![CDATA[(* Saida efetiva = comando da logica, a nao ser que o bit esteja forcado pela IHM.
   LIGAx: bit em 1 = saida forcada LIGADA; DESLx: bit em 1 = saida forcada DESLIGADA (DESL prevalece).
   Mascaras nao sao persistentes: depois de reiniciar o CLP nenhuma saida fica forcada. *)
wL0 := UINT_TO_WORD(LIGA0); wL1 := UINT_TO_WORD(LIGA1);
wD0 := UINT_TO_WORD(DESL0); wD1 := UINT_TO_WORD(DESL1);
OUT0 := (IN0 OR ((wL0 AND 16#0001) <> 0)) AND ((wD0 AND 16#0001) = 0);
OUT1 := (IN1 OR ((wL0 AND 16#0002) <> 0)) AND ((wD0 AND 16#0002) = 0);
OUT2 := (IN2 OR ((wL0 AND 16#0004) <> 0)) AND ((wD0 AND 16#0004) = 0);
OUT3 := (IN3 OR ((wL0 AND 16#0008) <> 0)) AND ((wD0 AND 16#0008) = 0);
OUT4 := (IN4 OR ((wL0 AND 16#0010) <> 0)) AND ((wD0 AND 16#0010) = 0);
OUT5 := (IN5 OR ((wL0 AND 16#0020) <> 0)) AND ((wD0 AND 16#0020) = 0);
OUT6 := (IN6 OR ((wL0 AND 16#0040) <> 0)) AND ((wD0 AND 16#0040) = 0);
OUT7 := (IN7 OR ((wL0 AND 16#0080) <> 0)) AND ((wD0 AND 16#0080) = 0);
OUT8 := (IN8 OR ((wL0 AND 16#0100) <> 0)) AND ((wD0 AND 16#0100) = 0);
OUT9 := (IN9 OR ((wL0 AND 16#0200) <> 0)) AND ((wD0 AND 16#0200) = 0);
OUT10 := (IN10 OR ((wL0 AND 16#0400) <> 0)) AND ((wD0 AND 16#0400) = 0);
OUT11 := (IN11 OR ((wL0 AND 16#0800) <> 0)) AND ((wD0 AND 16#0800) = 0);
OUT12 := (IN12 OR ((wL0 AND 16#1000) <> 0)) AND ((wD0 AND 16#1000) = 0);
OUT13 := (IN13 OR ((wL0 AND 16#2000) <> 0)) AND ((wD0 AND 16#2000) = 0);
OUT14 := (IN14 OR ((wL0 AND 16#4000) <> 0)) AND ((wD0 AND 16#4000) = 0);
OUT15 := (IN15 OR ((wL0 AND 16#8000) <> 0)) AND ((wD0 AND 16#8000) = 0);
OUT16 := (IN16 OR ((wL1 AND 16#0001) <> 0)) AND ((wD1 AND 16#0001) = 0);
OUT17 := (IN17 OR ((wL1 AND 16#0002) <> 0)) AND ((wD1 AND 16#0002) = 0);
OUT18 := (IN18 OR ((wL1 AND 16#0004) <> 0)) AND ((wD1 AND 16#0004) = 0);
OUT19 := (IN19 OR ((wL1 AND 16#0008) <> 0)) AND ((wD1 AND 16#0008) = 0);
OUT20 := (IN20 OR ((wL1 AND 16#0010) <> 0)) AND ((wD1 AND 16#0010) = 0);
OUT21 := (IN21 OR ((wL1 AND 16#0020) <> 0)) AND ((wD1 AND 16#0020) = 0);
OUT22 := (IN22 OR ((wL1 AND 16#0040) <> 0)) AND ((wD1 AND 16#0040) = 0);
OUT23 := (IN23 OR ((wL1 AND 16#0080) <> 0)) AND ((wD1 AND 16#0080) = 0);
OUT24 := (IN24 OR ((wL1 AND 16#0100) <> 0)) AND ((wD1 AND 16#0100) = 0);
OUT25 := (IN25 OR ((wL1 AND 16#0200) <> 0)) AND ((wD1 AND 16#0200) = 0);
OUT26 := (IN26 OR ((wL1 AND 16#0400) <> 0)) AND ((wD1 AND 16#0400) = 0);
OUT27 := (IN27 OR ((wL1 AND 16#0800) <> 0)) AND ((wD1 AND 16#0800) = 0);
OUT28 := (IN28 OR ((wL1 AND 16#1000) <> 0)) AND ((wD1 AND 16#1000) = 0);
OUT29 := (IN29 OR ((wL1 AND 16#2000) <> 0)) AND ((wD1 AND 16#2000) = 0);
OUT30 := (IN30 OR ((wL1 AND 16#4000) <> 0)) AND ((wD1 AND 16#4000) = 0);
OUT31 := (IN31 OR ((wL1 AND 16#8000) <> 0)) AND ((wD1 AND 16#8000) = 0);
FORCADO := (LIGA0 <> 0) OR (LIGA1 <> 0) OR (DESL0 <> 0) OR (DESL1 <> 0);
Q_LIGA0 := LIGA0; Q_LIGA1 := LIGA1; Q_DESL0 := DESL0; Q_DESL1 := DESL1;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>