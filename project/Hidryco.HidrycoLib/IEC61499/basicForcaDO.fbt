      <VarDeclaration ID="AC1807EA57815369" Name="Q_LIGA1" Type="UINT" Comment="Mascara LIGA1 em uso (para a IHM)" />
      <VarDeclaration ID="A2504AAC08EA0F22" Name="Q_DESL0" Type="UINT" Comment="Mascara DESL0 em uso (para a IHM)" />
