<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="36fc40b4-459f-f0bf-1eee-6a31fe765c45" Name="Controle_PID_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="21/10/2026" Remarks="IHM do Controle_PID" />
  <InterfaceList>
    <EventInputs>
      <Event ID="BDED583D3630F715" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="121991B86286E4C6" Name="LOAD_PERS_DATA" Comment="Reenvia os parametros persistentes" />
      <Event ID="95D672F30A7887FA" Name="E_ATUALIZA_SAIDA_PID" Comment="Status do processo">
        <With Var="stsSaidaPID" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="F005F4976A3519E1" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="C6353F61556B21DC" Name="E_ATUALIZA_SETPOINT" Comment="Ajustes (IHM/OPC UA e LOAD_PERS_DATA)">
        <With Var="CMD_HABILITA" />
        <With Var="STP_DESEJADO" />
        <With Var="STP_PARAMETRO_KP" />
        <With Var="STP_PARAMETRO_KI" />
        <With Var="STP_PARAMETRO_KD" />
        <With Var="STP_MAXIMO" />
        <With Var="STP_MINIMO" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="6ED3F930158E7480" Name="QI" Type="BOOL" />
      <VarDeclaration ID="32C267059FF1D22A" Name="stsSaidaPID" Type="REAL" Comment="Saida do PID (%)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="67415A82183FC541" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="AB3B961A386F0A2B" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="4DE0DC8F22900EEB" Name="CMD_HABILITA" Type="BOOL" Comment="PID habilitado" />
      <VarDeclaration ID="E4E0530DF8DB6A71" Name="STP_DESEJADO" Type="REAL" Comment="Valor desejado" />
      <VarDeclaration ID="BB03E6E90B8CA1CC" Name="STP_PARAMETRO_KP" Type="REAL" Comment="Ganho (Kp)" />
      <VarDeclaration ID="A07F53E869BCC90D" Name="STP_PARAMETRO_KI" Type="REAL" Comment="Tempo integral (s)" />
      <VarDeclaration ID="D0C5A2C5728349F9" Name="STP_PARAMETRO_KD" Type="REAL" Comment="Tempo derivativo (s)" />
      <VarDeclaration ID="C4DEF97517D810A8" Name="STP_MINIMO" Type="REAL" Comment="Saída mínima" />
      <VarDeclaration ID="8888910686BE1994" Name="STP_MAXIMO" Type="REAL" Comment="Saída máxima" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>
