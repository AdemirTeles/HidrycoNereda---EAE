<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="5a9768cf-14c9-5326-adec-e41aabfb72dd" Name="Dosagem_Alcalinizante" Comment="Dosagem de alcalinizante (800): casca sem logica e sem campo - BO-02, DO-04/05 e LIT-03 so com as tags para o OPC UA - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.3" Author="Hidryco" Date="12/11/2026" Remarks="1.3: campo na Remota 1 da Subestacao (A6 %I0.96-104 pelo M262_Substacao): BO/DO com cfgFalhaNA (FALHA = TRUE em falha); LIT_800_03 em 4-20 mA (A12 canal 0); LIGA 800-BO-02 em %Q0.15 (M262_Substacao); LIGA 800-DO-04/05 sai em CNF_DOSADORAS (cmdDO04/05, na mudanca e a cada 5 s) para o Utilities do M262_Nereda, que escreve a word 1 do A8. 1.2: LIT_800_03 como sensor de nivel (cfgNivel, m) para a tela DOSAGEM_ALCALINIZANTE. 1.1: carga no gerador: REQ_GERADOR com geradorHabilitaDO04/DO05 e stsGerador (Subestacao HAB_DO_800_04/05 e stsPlantaNoGerador) para DO_800_04/05 (bloqueio e raio do Motor_Generico). 1.0: casca para a IO List da Nereda (caminhos DosagemAlcalinizante.BO_800_02/DO_800_04/DO_800_05/LIT_800_03). Sem logica e sem campo: motores com cfgUsaTermica = FALSE e sensor com cfgComunicacao = TRUE para nao gerar alarme. Ao ligar o campo, rever esses parametros." />
  <InterfaceList>
    <EventInputs>
      <Event ID="3550FA6DB34A3727" Name="REQ_GERADOR" Comment="Planta no gerador e liberacao das dosadoras (Subestacao)">
        <With Var="geradorHabilitaDO04" />
        <With Var="geradorHabilitaDO05" />
        <With Var="stsGerador" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="2549BCE0C5B3D328" Name="CNF_DOSADORAS" Comment="Comando das dosadoras para o M262_Nereda (Utilities.REQ_DOSADORAS, A8 %Q0.16/17): na mudanca e a cada 5 s">
        <With Var="cmdDO04" />
        <With Var="cmdDO05" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="A0398C4E77A10EEE" Name="geradorHabilitaDO04" Type="BOOL" Comment="800-DO-04 liberada para operar com a planta nos geradores" />
      <VarDeclaration ID="7CA01E1D24150792" Name="geradorHabilitaDO05" Type="BOOL" Comment="800-DO-05 liberada para operar com a planta nos geradores" />
      <VarDeclaration ID="7838A99D6B60D295" Name="stsGerador" Type="BOOL" Comment="TRUE = planta alimentada pelos geradores" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="102C84667EC49B91" Name="cmdDO04" Type="BOOL" Comment="LIGA 800-DO-04 (cmdAcionamento do DO_800_04)" />
      <VarDeclaration ID="32CD2F3F12A90B15" Name="cmdDO05" Type="BOOL" Comment="LIGA 800-DO-05 (cmdAcionamento do DO_800_05)" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <FB ID="E6C432D7E999D40E" Name="IThis" Type="Dosagem_Alcalinizante_HMI" x="1400" y="1400" Namespace="Hidryco.HidrycoLib">
      <Parameter Name="$BE248E190DAC90D3" Value="TRUE" />
    </FB>
    <FB ID="681A2F5C25FCE167" Name="plcStart1" Type="plcStart" x="1400" y="200" Namespace="SE.App2Base">
      <Parameter Name="$Prio" Value="10" />
    </FB>
    <FB ID="E2E7206CEC4380D4" Name="BO_800_02" Type="Motor_Generico" x="4000" y="200" Namespace="Hidryco.HidrycoLib">
      <Parameter Name="$7E2990CF98A28E53" Value="TRUE" />
      <Parameter Name="$D34C88BE7FFF3208" Value="FALSE" />
    </FB>
