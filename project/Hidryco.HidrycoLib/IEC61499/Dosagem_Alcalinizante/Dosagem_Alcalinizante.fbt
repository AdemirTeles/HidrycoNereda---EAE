      <Parameter Name="$8914049066EE23D9" Value="TRUE" />
      <Parameter Name="$D34C88BE7FFF3208" Value="FALSE" />
    </FB>
    <FB ID="3C590043671364CC" Name="LIT_800_03" Type="Sensor_Generico" x="7000" y="200" Namespace="Hidryco.HidrycoLib">
      <Parameter Name="$FC98F78ABCBC0A7E" Value="TRUE" />
      <Parameter Name="$CC8EEC06FF0C4430" Value="'m'" />
