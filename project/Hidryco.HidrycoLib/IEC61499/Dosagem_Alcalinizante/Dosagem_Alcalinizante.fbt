    <FB ID="487574562ABB646D" Name="CmdDosadoras" Type="SYMLINKMULTIVARDST_277E97BEC1451D2C" x="7000" y="1100" Namespace="Hidryco.HidrycoLib">
      <Attribute Name="Configuration.GenericFBType.InterfaceParams" Value="Runtime.System#I:=2;VALUE${I}:BOOL,BOOL" />
      <Parameter Name="$QI" Value="TRUE" />
