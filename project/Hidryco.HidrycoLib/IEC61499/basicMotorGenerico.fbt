      </Event>
      <Event ID="5F826E4CBCD659F3" Name="REQ_ILCK" Comment="Intertravamentos, emergencia e gerador">
        <With Var="ilkGeral" />
        <With Var="ilkAutomatico" />
        <With Var="ilkManual" />
        <With Var="inEmergencia" />
        <With Var="geradorConectado" />
