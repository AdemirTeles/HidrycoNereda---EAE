        <With Var="hmiAutomatico" />
      </Event>
      <Event ID="515471E320ACA903" Name="REQ_MANUAL" Comment="Liga/desliga manual (IHM)">
        <With Var="hmiCmdManual" />
      </Event>
      <Event ID="0C2D266AF6549AC9" Name="REQ_RESET" Comment="Reset de falhas (IHM)">
        <With Var="hmiResetFalha" />
      </Event>
      <Event ID="0D409FE636F62649" Name="REQ_RESET_PROC" Comment="Reset de falhas (processo)">
        <With Var="cmdResetFalhas" />
      </Event>
      <Event ID="1767A5462AC4396E" Name="REQ_MNT" Comment="Numero de partidas do devMntCalc">
        <With Var="mntPartidas" />
      </Event>
