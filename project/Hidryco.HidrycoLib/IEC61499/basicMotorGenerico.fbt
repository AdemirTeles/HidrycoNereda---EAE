        <With Var="TimeOut" />
      </Event>
      <Event ID="EEEBF5CC51C91C4E" Name="RST_T" Comment="Inicia o pulso de reset (E_DELAY.START)" />
      <Event ID="53ECCF865FC89D5D" Name="OP_STOP" Comment="Para o E_CYCLE do horimetro - sai antes do OP_START" />
      <Event ID="51A40868F4B890EF" Name="OP_START" Comment="Inicia o E_CYCLE de 1 s do horimetro" />
      <Event ID="B3EC08981095182D" Name="CNF_PERS" Comment="Grava o horimetro no PERSISTENCE (a cada minuto, na parada e no reset)">
        <With Var="stsHorimetroSegundo" />
        <With Var="stsHorimetroMinuto" />
        <With Var="stsHorimetroHora" />
      </Event>
    </EventOutputs>
