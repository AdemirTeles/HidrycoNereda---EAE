        <With Var="hmiResetHorimetro" />
      </Event>
      <Event ID="F9A311D126CA484B" Name="MON_MAX" Comment="Tempo de supervisao de partida/parada esgotado (E_DELAY)" />
      <Event ID="068D65FB1CCC02E9" Name="RST_END" Comment="Fim do pulso de reset (E_DELAY)" />
    </EventInputs>
