<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="05042151-8115-451f-8d99-594dad2c1076" Name="basicMotorGenerico" Comment="Logica unica do motor generico (partida direta ou inversor)" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.4" Author="Hidryco" Date="13/10/2026" Remarks="1.1: refeito no padrao SE.App2CommonProcess - eventos por grupo de dados, saidas so na mudanca, supervisao por E_DELAY (MON_T/MON_RESET/MON_MAX), horimetro e partidas pelo devMntCalc, escala linear com limites. 1.4: horimetro proprio com resolucao de 1 s (E_CYCLE + PERSISTENCE), termica NF por padrao" />
  <InterfaceList>
    <EventInputs>
      <Event ID="683CE05B486FAC1D" Name="INIT" Comment="Inicializacao (configuracao da instancia)">
        <With Var="cfgInversor" />
        <With Var="cfgVelocidadeMin" />
        <With Var="cfgVelocidadeMax" />
        <With Var="cfgSaidaMin" />
        <With Var="cfgSaidaMax" />
        <With Var="cfgUsaTermica" />
        <With Var="cfgTermicaNF" />
        <With Var="cfgUsaFalhaComunicacao" />
