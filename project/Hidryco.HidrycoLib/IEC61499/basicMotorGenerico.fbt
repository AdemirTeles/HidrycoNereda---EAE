        <With Var="stpTempoFalhaDesligamento" />
        <With Var="stpVelocidadeManual" />
      </Event>
      <Event ID="7C3B0EC5F898F810" Name="REQ_PARA" Comment="Atualizacao de parametros (IHM)">
        <With Var="cfgInversor" />
        <With Var="cfgVelocidadeMin" />
        <With Var="cfgVelocidadeMax" />
        <With Var="cfgSaidaMin" />
        <With Var="cfgSaidaMax" />
