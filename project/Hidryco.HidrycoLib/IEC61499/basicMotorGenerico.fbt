      <VarDeclaration ID="A063BE2E18C7FEF0" Name="bTick" Type="BOOL" Comment="E_CYCLE do horimetro deve rodar" />
      <VarDeclaration ID="5C1054651E3B97A6" Name="oldTick" Type="BOOL" />
      <VarDeclaration ID="A2248760A5C0102C" Name="uMinTotal" Type="UDINT" Comment="Horimetro em minutos (deteccao de mudanca)" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Estado inicial" x="1500" y="640" />
      <ECState Name="EXEC" Comment="Executa a logica; o algoritmo decide quais eventos saem" x="1500" y="1100">
        <ECAction Algorithm="algMotor" Output="INITO" />
        <ECAction Output="CNF_OUT" />
        <ECAction Output="CNF_SPEED_OUT" />
        <ECAction Output="CNF" />
        <ECAction Output="CNF_SPEED" />
        <ECAction Output="CNF_HMI" />
        <ECAction Output="CNF_PV" />
        <ECAction Output="CNF_HORIMETRO" />
        <ECAction Output="MON_RESET" />
        <ECAction Output="MON_T" />
        <ECAction Output="RST_T" />
        <ECAction Output="OP_STOP" />
        <ECAction Output="OP_START" />
        <ECAction Output="CNF_PERS" />
      </ECState>
      <ECTransition Source="START" Destination="EXEC" Condition="INIT OR REQ_PARA OR REQ_CMD OR REQ_ILCK OR REQ_FB OR REQ_SPEED_FB OR REQ_MODE OR REQ_MANUAL OR REQ_RESET OR REQ_RESET_PROC OR REQ_MNT OR REQ_PERS OR TICK OR REQ_RESET_HOR OR MON_MAX OR RST_END" x="1580" y="860" />
      <ECTransition Source="EXEC" Destination="START" Condition="1" x="1420" y="860" />
    </ECC>
    <Algorithm Name="algMotor" Comment="Logica completa do motor (um unico algoritmo)">
      <ST><![CDATA[(* =====================================================================
   basicMotorGenerico v1.1 - logica do CAT Motor_Generico (HidrycoLib)
   Padrao das bibliotecas Schneider (SE.App2CommonProcess):
   - eventos de saida desligados no inicio e ligados so na mudanca (variaveis oldX);
   - supervisao de partida/parada por E_DELAY externo (MON_T/MON_RESET/MON_MAX);
   - horimetro e partidas calculados e persistidos pelo devMntCalc.
   Regras de operacao (definidas pelo usuario):
   - emergencia, termica, falha do acionamento (NF), falha de partida e de
     parada ficam memorizadas ate o reset (IHM ou processo);
   - emergencia so retira o comando;
   - automatico -> manual mantem o motor como estava;
   - em manual o motor so liga com comando do operador: qualquer perda de
     permissivo cancela o comando manual (nao religa sozinho);
   - falha de comunicacao retira o comando, sem memorizar;
   - chave nem em local nem em remoto = manutencao.
   ===================================================================== *)

(* ---- 0. Eventos de saida: so sai o que for ligado abaixo ---- *)
INITO         := FALSE;
CNF_OUT       := FALSE;
CNF_SPEED_OUT := FALSE;
CNF           := FALSE;
CNF_SPEED     := FALSE;
CNF_HMI       := FALSE;
CNF_PV        := FALSE;
CNF_HORIMETRO := FALSE;
MON_RESET     := FALSE;
MON_T         := FALSE;
RST_T         := FALSE;
OP_STOP       := FALSE;
OP_START      := FALSE;
CNF_PERS      := FALSE;
bReset        := FALSE;

IF REQ_FB THEN
    fbRecebido := TRUE;                    (* campo valido a partir da 1a leitura *)
END_IF;

(* ---- 1. Inicializacao: nada e calculado antes do INIT ---- *)
IF INIT THEN
    initDone := TRUE;
    initPass := TRUE;
    INITO    := TRUE;
END_IF;
IF NOT initDone THEN
    RETURN;                                (* os dados recebidos ficam guardados *)
END_IF;

(* ---- 2. Sinais de campo (so atualizados com comunicacao OK) ---- *)
bComOk := fbRecebido AND NOT (cfgUsaFalhaComunicacao AND fldFalhaComunicacao);
IF bComOk THEN
    bRemoto := fldRemoto;
    bLocal  := fldLocal;
    bLigado := fldLigado;
    bTermicaAtiva  := cfgUsaTermica AND (fldProtecaoTermica XOR cfgTermicaNF);
    bFalhaInvAtiva := NOT fldSemFalha;     (* falha NF: FALSE no campo = falha *)
ELSE
    bRemoto := FALSE;                      (* sem comunicacao: sai de remoto *)
    bLocal  := FALSE;
    bLigado := FALSE;                      (* e considera parado; memorias mantidas *)
END_IF;
bManutencao := bComOk AND NOT fldLocal AND NOT fldRemoto;

(* ---- 3. Falhas memorizadas ---- *)
IF inEmergencia THEN
    bEmergencia := TRUE;
END_IF;
IF bComOk AND bTermicaAtiva THEN
    bTermica := TRUE;
END_IF;
IF bComOk AND bFalhaInvAtiva THEN
    bFalhaInversor := TRUE;
END_IF;
(* tempo de supervisao esgotado: vale o tipo de espera que iniciou o E_DELAY *)
IF MON_MAX THEN
    IF oldMon = 1 THEN
        bFalhaPartida := TRUE;
    ELSIF oldMon = 2 THEN
        bFalhaParada := TRUE;
    END_IF;
END_IF;

(* ---- 4. Reset: libera so o que ja normalizou e pulsa o reset no campo ---- *)
bReset := (REQ_RESET AND hmiResetFalha) OR (REQ_RESET_PROC AND cmdResetFalhas);
IF bReset THEN
    IF NOT inEmergencia THEN
        bEmergencia := FALSE;
    END_IF;
    IF NOT bTermicaAtiva THEN
        bTermica := FALSE;
    END_IF;
    IF NOT bFalhaInvAtiva THEN
        bFalhaInversor := FALSE;
    END_IF;
    bFalhaPartida  := FALSE;
    bFalhaParada   := FALSE;
    bResetPendente := TRUE;
    RST_T          := TRUE;                (* pulso de reset para o campo *)
END_IF;
(* falha do acionamento que some durante o pulso de reset tambem e liberada *)
IF bResetPendente AND bComOk AND NOT bFalhaInvAtiva THEN
    bFalhaInversor := FALSE;
END_IF;
IF RST_END THEN
    bResetPendente := FALSE;
END_IF;
acmReset := bResetPendente;

(* ---- 5. Modo e comando manual (IHM) ---- *)
IF REQ_MODE THEN
    IF bAutomatico AND NOT hmiAutomatico THEN
        bCmdManual := acmLigar;            (* automatico -> manual: mantem como estava *)
    END_IF;
    bAutomatico := hmiAutomatico;
END_IF;
IF REQ_MANUAL THEN
    bCmdManual := hmiCmdManual;
END_IF;

(* ---- 6. Permissivos ---- *)
bFalha := bEmergencia OR bTermica OR bFalhaInversor OR bFalhaPartida OR bFalhaParada;
(* gerador: com a planta no gerador so opera o que esta conectado E selecionado *)
bBloqueioGerador := inGerador AND (NOT geradorConectado OR NOT geradorHabilita);
bPermissivo := bRemoto AND bComOk AND NOT bFalha AND NOT inEmergencia
               AND NOT bBloqueioGerador AND NOT ilkGeral;
IF NOT bPermissivo OR ilkManual THEN
    bCmdManual := FALSE;                   (* manual nunca religa sozinho *)
END_IF;

(* ---- 7. Comando ---- *)
acmLigar := bPermissivo AND
            ((bAutomatico AND cmdLigarAutomatico AND NOT ilkAutomatico) OR
             (NOT bAutomatico AND bCmdManual AND NOT ilkManual));

(* ---- 8. Supervisao de partida e parada (E_DELAY externo) ---- *)
IF bRemoto AND bComOk AND acmLigar AND NOT bLigado THEN
    iMon := 1;                             (* esperando confirmar ligado *)
ELSIF bRemoto AND bComOk AND NOT acmLigar AND bLigado THEN
    iMon := 2;                             (* esperando confirmar parado *)
ELSE
    iMon := 0;
END_IF;
IF iMon <> oldMon THEN
    MON_RESET := oldMon <> 0;              (* cancela a espera anterior *)
    IF iMon = 1 AND stpTempoFalhaLigamento > 0 THEN
        TimeOut := TO_TIME(UINT_TO_DINT(stpTempoFalhaLigamento) * 1000);
        MON_T := TRUE;
    ELSIF iMon = 2 AND stpTempoFalhaDesligamento > 0 THEN
        TimeOut := TO_TIME(UINT_TO_DINT(stpTempoFalhaDesligamento) * 1000);
        MON_T := TRUE;
    END_IF;
    oldMon := iMon;
END_IF;

(* ---- 9. Velocidade: limite em % e escala linear para o campo (como analogOutBasic) ---- *)
IF bAutomatico THEN
    rRef := stpVelocidadeAutomatico;
ELSE
    rRef := stpVelocidadeManual;
END_IF;
IF cfgVelocidadeMax > cfgVelocidadeMin THEN
    rRef := LIMIT(cfgVelocidadeMin, rRef, cfgVelocidadeMax);
ELSE
    rRef := LIMIT(0.0, rRef, 100.0);
END_IF;
IF NOT cfgInversor THEN
    rRef := 0.0;                           (* partida direta: sem referencia *)
END_IF;
rFaixa := cfgSaidaMax - cfgSaidaMin;
IF rFaixa = 0.0 THEN
    rFaixa := 100.0;                       (* escala invalida: trata como % *)
END_IF;
stpVelocidadeCampo := cfgSaidaMin + rRef * rFaixa / 100.0;
IF cfgInversor THEN
    stsVelocidade := (fldVelocidade - cfgSaidaMin) * 100.0 / rFaixa;
ELSIF bLigado THEN
    stsVelocidade := 100.0;
ELSE
    stsVelocidade := 0.0;
END_IF;

(* ---- 10. Horimetro (resolucao de 1 s, persistido) e partidas (devMntCalc) ---- *)
(* sem comunicacao o estado fica congelado: evita contar partida falsa na volta *)
IF bComOk THEN
    IF bLigado THEN
        stsPv := 1;
    ELSE
        stsPv := 0;
    END_IF;
END_IF;
IF REQ_PERS THEN
    stsHorimetroSegundo := perSegundo;     (* restaura o valor gravado *)
    stsHorimetroMinuto  := perMinuto;
    stsHorimetroHora    := perHora;
    bPersLido := TRUE;
END_IF;
IF REQ_RESET_HOR AND hmiResetHorimetro THEN
    stsHorimetroSegundo := 0;
    stsHorimetroMinuto  := 0;
    stsHorimetroHora    := 0;
    CNF_PERS := TRUE;
END_IF;
IF TICK AND bTick THEN
    stsHorimetroSegundo := stsHorimetroSegundo + 1;
    IF stsHorimetroSegundo >= 60 THEN
        stsHorimetroSegundo := 0;
        stsHorimetroMinuto  := stsHorimetroMinuto + 1;
        CNF_PERS := TRUE;                  (* grava a cada minuto *)
        IF stsHorimetroMinuto >= 60 THEN
            stsHorimetroMinuto := 0;
            stsHorimetroHora   := stsHorimetroHora + 1;
        END_IF;
    END_IF;
END_IF;
(* E_CYCLE de 1 s so com o motor ligado; na parada grava os segundos acumulados *)
bTick := bPersLido AND (stsPv = 1);
IF bTick <> oldTick THEN
    IF bTick THEN
        OP_START := TRUE;
    ELSE
        OP_STOP  := TRUE;
        CNF_PERS := bPersLido;
    END_IF;
    oldTick := bTick;
END_IF;
uMinTotal := stsHorimetroHora * 60 + UINT_TO_UDINT(stsHorimetroMinuto);
stsNumeroPartidas := mntPartidas;
stsHorimetro := TO_TIME(UDINT_TO_LINT(stsHorimetroHora) * 3600000 + UINT_TO_LINT(stsHorimetroMinuto) * 60000 + UINT_TO_LINT(stsHorimetroSegundo) * 1000);

(* ---- 11. Status ---- *)
stsRemoto := bRemoto;
stsLocal := bLocal;
stsManutencao := bManutencao;
stsLigado := bLigado;
stsParado := NOT bLigado;
stsAutomatico := bAutomatico;
stsCmdManual := bCmdManual;
stsFalhaComunicacao := NOT bComOk;
stsProtecaoTermica := bTermica;
stsFalhaInversor := bFalhaInversor;
stsFalhaPartida := bFalhaPartida;
stsFalhaParada := bFalhaParada;
stsEmergencia := bEmergencia;
stsFalha := bFalha;
stsAlarme := bFalha OR NOT bComOk;
stsBloqueioGerador := bBloqueioGerador;
stsBloqueado := ilkGeral OR (bAutomatico AND ilkAutomatico) OR (NOT bAutomatico AND ilkManual);
stsDisponivelAutomatico := bAutomatico AND bPermissivo AND NOT ilkAutomatico;
stsVelocidadeReferencia := rRef;
(* configuracao para a IHM: os faceplates escondem o que nao se aplica ao tipo de motor *)
stsInversor := cfgInversor;
stsUsaTermica := cfgUsaTermica;
stsUsaFalhaComunicacao := cfgUsaFalhaComunicacao;

IF bManutencao THEN
    stsAnimacao := 3;
ELSIF bFalha THEN
    stsAnimacao := 2;
ELSIF bLigado THEN
    stsAnimacao := 1;
ELSE
    stsAnimacao := 0;
END_IF;

IF NOT geradorConectado THEN
    stsAnimacaoGerador := 0;
ELSIF NOT geradorHabilita THEN
    stsAnimacaoGerador := 1;
ELSIF NOT inGerador THEN
    stsAnimacaoGerador := 2;
ELSE
    stsAnimacaoGerador := 3;
END_IF;

(* ---- 12. Emissao so na mudanca ---- *)
CNF_OUT := initPass OR (acmLigar <> oldAcm) OR (acmReset <> oldReset);
oldAcm := acmLigar;
oldReset := acmReset;

CNF_SPEED_OUT := initPass OR (stpVelocidadeCampo <> oldStp);
oldStp := stpVelocidadeCampo;

wStsProc := 16#0;
IF stsDisponivelAutomatico THEN wStsProc := wStsProc OR 16#0001; END_IF;
IF stsLigado THEN wStsProc := wStsProc OR 16#0002; END_IF;
IF stsFalha THEN wStsProc := wStsProc OR 16#0004; END_IF;
IF stsRemoto THEN wStsProc := wStsProc OR 16#0008; END_IF;
IF stsAutomatico THEN wStsProc := wStsProc OR 16#0010; END_IF;
CNF := initPass OR (wStsProc <> oldStsProc) OR (stsAnimacao <> oldAnim);
oldStsProc := wStsProc;

CNF_SPEED := initPass OR CNF OR (ABS(stsVelocidade - oldVel) >= 0.1);
IF CNF_SPEED THEN
    oldVel := stsVelocidade;
END_IF;

wSts := 16#0;
IF stsRemoto THEN wSts := wSts OR 16#0001; END_IF;
IF stsLocal THEN wSts := wSts OR 16#0002; END_IF;
IF stsManutencao THEN wSts := wSts OR 16#0004; END_IF;
IF stsLigado THEN wSts := wSts OR 16#0008; END_IF;
IF stsAutomatico THEN wSts := wSts OR 16#0010; END_IF;
IF stsCmdManual THEN wSts := wSts OR 16#0020; END_IF;
IF stsAlarme THEN wSts := wSts OR 16#0040; END_IF;
IF stsFalhaComunicacao THEN wSts := wSts OR 16#0080; END_IF;
IF stsProtecaoTermica THEN wSts := wSts OR 16#0100; END_IF;
IF stsFalhaInversor THEN wSts := wSts OR 16#0200; END_IF;
IF stsFalhaPartida THEN wSts := wSts OR 16#0400; END_IF;
IF stsFalhaParada THEN wSts := wSts OR 16#0800; END_IF;
IF stsEmergencia THEN wSts := wSts OR 16#1000; END_IF;
IF stsBloqueado THEN wSts := wSts OR 16#2000; END_IF;
IF stsBloqueioGerador THEN wSts := wSts OR 16#4000; END_IF;
IF stsDisponivelAutomatico THEN wSts := wSts OR 16#8000; END_IF;
CNF_HMI := initPass OR (wSts <> oldSts) OR (stsAnimacao <> oldAnim) OR (stsAnimacaoGerador <> oldAnimGer)
           OR CNF_SPEED OR (rRef <> oldRef) OR (uMinTotal <> oldMnt) OR (mntPartidas <> oldPartidas);
oldSts := wSts;
oldAnim := stsAnimacao;
oldAnimGer := stsAnimacaoGerador;
oldRef := rRef;

CNF_PV := fbRecebido AND (stsPv <> oldPv);  (* so depois da 1a leitura do campo *)
oldPv := stsPv;

CNF_HORIMETRO := initPass OR (uMinTotal <> oldMnt);
oldMnt := uMinTotal;
oldPartidas := mntPartidas;

initPass := FALSE;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>