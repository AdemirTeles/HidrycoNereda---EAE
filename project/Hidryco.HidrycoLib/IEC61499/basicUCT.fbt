        <ECAction Output="CNF_V116" />
        <ECAction Output="CNF_V121" />
        <ECAction Output="CNF_V136" />
        <ECAction Output="CNF_V141" />
        <ECAction Output="CNF_V151" />
        <ECAction Output="CNF_V161" />
      </ECState>
      <ECTransition Source="START" Destination="EXEC" Condition="INIT OR REQ_L1 OR REQ_L2 OR REQ_L3 OR REQ_L4 OR REQ_L5 OR REQ_COM OR REQ_PEN_LIGA OR REQ_PEN_INT OR REQ_PEN_VEL OR REQ_B1_LIGA OR REQ_B1_VEL OR REQ_B2_LIGA OR REQ_B2_VEL OR REQ_V1_LIGA OR REQ_V2_LIGA OR REQ_CMP_LIGA OR REQ_CMP_VEL OR REQ_RSP_LIGA OR REQ_RSP_INT OR REQ_RSP_REV OR REQ_RSP_VEL OR REQ_R1_LIGA OR REQ_R1_INT OR REQ_R1_REV OR REQ_R1_VEL OR REQ_R2_LIGA OR REQ_R2_INT OR REQ_R2_REV OR REQ_R2_VEL OR REQ_LIGA_PEN OR REQ_SEL_PEN OR REQ_LIGA_ROS OR REQ_SEL_ROS OR REQ_LIGA_RC OR REQ_SEL_RC OR REQ_SEL_BOMBA OR REQ_RESET OR REQ_RESET_PROC OR REQ_VALVULA OR REQ_PARA OR REQ_DISP OR REQ_PROC OR REQ_BOMBA OR TICK" x="1580" y="860" />
      <ECTransition Source="EXEC" Destination="START" Condition="1" x="1420" y="860" />
    </ECC>
    <Algorithm Name="algUCT" Comment="Logica completa da UCT (um unico algoritmo)">
      <ST><![CDATA[(* =====================================================================
   basicUCT v1.0 - UCT Fast (tratamento preliminar) por Modbus TCP
   Padrao das bibliotecas Schneider: eventos de saida desligados no inicio e
   ligados so na mudanca; tempos pelo TICK de 1 s (E_CYCLE do CAT).
   - leitura: palavras de comando 40005..40017 (imagem), falhas 40081,
     niveis 40082, status/velocidade dos equipamentos 401xx, nivel da
     peneira 40230 (0-16000 = 0-100 %), horimetros 40500..40517 (DINT,
     palavra baixa no endereco menor);
   - escrita so quando o operador comanda (um evento por comando): o bit
     comandado e trocado na imagem lida e a palavra inteira e escrita
     (os outros bits ficam como a UCT informou); velocidade 0-100 % ->
     0-16000; reset = pulso de cfgTempoReset s em 40005.3;
   - disponibilidade: as condicoes vao para o bloco AND do CAT (editavel)
     e o resultado volta em "disponivel"; cadeia das UCTs: bloqueio da EEE
     Bruto so com UCT habilitada e nenhuma disponivel;
   - bomba de gordura (automatico): nivel alto do tanque de gordura ->
     abre a valvula de lavagem, espera stpTempoPreLavagem e liga a bomba;
     a valvula fecha stpTempoValvula s depois da partida; com o nivel
     normal conta stpTempoDesliga e desliga; fora do automatico a
     valvula segue o botao da IHM.
   ===================================================================== *)

(* ---- 0. Eventos de saida: so sai o que for ligado abaixo ---- *)
INITO := FALSE;
CNF := FALSE;
CNF_HMI := FALSE;
CNF_EQ := FALSE;
CNF_DISP := FALSE;
CNF_ALM := FALSE;
CNF_BOMBA := FALSE;
CNF_VALVULA := FALSE;
CNF_RESET := FALSE;
CNF_W005 := FALSE;
CNF_W006 := FALSE;
CNF_W007 := FALSE;
CNF_W008 := FALSE;
CNF_W009 := FALSE;
CNF_W010 := FALSE;
CNF_W011 := FALSE;
CNF_W012 := FALSE;
CNF_W013 := FALSE;
CNF_W014 := FALSE;
CNF_W015 := FALSE;
CNF_W016 := FALSE;
CNF_W017 := FALSE;
CNF_V101 := FALSE;
CNF_V116 := FALSE;
CNF_V121 := FALSE;
CNF_V136 := FALSE;
CNF_V141 := FALSE;
CNF_V151 := FALSE;
CNF_V161 := FALSE;

IF REQ_COM THEN
    bComRecebida := TRUE;
END_IF;
IF REQ_L1 THEN
    bLeitura := TRUE;
    img005 := INT_TO_WORD(w005);
    img006 := INT_TO_WORD(w006);
    img007 := INT_TO_WORD(w007);
    img008 := INT_TO_WORD(w008);
    img009 := INT_TO_WORD(w009);
    img010 := INT_TO_WORD(w010);
    img011 := INT_TO_WORD(w011);
    img012 := INT_TO_WORD(w012);
    img013 := INT_TO_WORD(w013);
    img014 := INT_TO_WORD(w014);
    img015 := INT_TO_WORD(w015);
    img016 := INT_TO_WORD(w016);
    img017 := INT_TO_WORD(w017);
END_IF;

(* ---- 1. Inicializacao ---- *)
IF INIT THEN
    initDone := TRUE;
    initPass := TRUE;
    INITO    := TRUE;
END_IF;
IF NOT initDone THEN
    RETURN;
END_IF;

(* ---- 2. Comunicacao (falha confirmada depois de cfgTempoCom s) ---- *)
bComOK := cfgInstalada AND bComRecebida AND comInt = 1;
IF cfgInstalada AND NOT bComOK THEN
    IF TICK AND uSegCom < UINT_TO_UDINT(cfgTempoCom) THEN
        uSegCom := uSegCom + 1;
    END_IF;
ELSE
    uSegCom := 0;
END_IF;
stsFalhaComunicacao := cfgInstalada AND NOT bComOK AND uSegCom >= UINT_TO_UDINT(cfgTempoCom);

(* ---- 3. Estado lido (com a comunicacao em falha os valores ficam congelados) ---- *)
w81 := INT_TO_WORD(w081);
w82 := INT_TO_WORD(w082);
stsEmergenciaUCT := bComOK AND ((w81 AND 16#0001) <> 16#0000);
stsNivelBaixoPeneira := bComOK AND ((w82 AND 16#0001) <> 16#0000);
stsNivelAltoPeneira := bComOK AND ((w82 AND 16#0002) <> 16#0000);
stsNivelBaixoAgua := bComOK AND ((w82 AND 16#0004) <> 16#0000);
stsNivelAltoGordura := bComOK AND ((w82 AND 16#0008) <> 16#0000);
stsNivelPeneira := INT_TO_REAL(w230) * 100.0 / 16000.0;
stsAutoPeneira := (img015 AND 16#0004) <> 16#0000;
stsLigaAutoPeneira := (img015 AND 16#0001) <> 16#0000;
stsAutoRoscas := (img016 AND 16#0004) <> 16#0000;
stsLigaAutoRoscas := (img016 AND 16#0001) <> 16#0000;
stsAutoRaspComp := (img017 AND 16#0004) <> 16#0000;
stsLigaAutoRaspComp := (img017 AND 16#0001) <> 16#0000;
stsSelecaoBomba := (img007 AND 16#0008) <> 16#0000;
(* Peneira rotativa *)
IF bComOK THEN
    penAnim := s106;
ELSE
    penAnim := 4;
END_IF;
penDef := bComOK AND ((w81 AND 16#0010) <> 16#0000);
penHor := DWORD_TO_DINT(SHL(WORD_TO_DWORD(INT_TO_WORD(h501)), 16) OR WORD_TO_DWORD(INT_TO_WORD(h500)));
penAuto := stsAutoPeneira;
penVelSts := INT_TO_REAL(s101) * 100.0 / 16000.0;
penFbLiga := (img006 AND 16#0001) <> 16#0000;
penFbInt := (img006 AND 16#0020) <> 16#0000;
penFbRev := FALSE;
(* Bomba 1 de higienização da peneira *)
IF bComOK THEN
    b1Anim := s117;
ELSE
    b1Anim := 4;
END_IF;
b1Def := bComOK AND ((w81 AND 16#0004) <> 16#0000);
b1Hor := DWORD_TO_DINT(SHL(WORD_TO_DWORD(INT_TO_WORD(h503)), 16) OR WORD_TO_DWORD(INT_TO_WORD(h502)));
b1Auto := stsAutoPeneira;
b1VelSts := INT_TO_REAL(s116) * 100.0 / 16000.0;
b1FbLiga := (img007 AND 16#0001) <> 16#0000;
b1FbInt := FALSE;
b1FbRev := FALSE;
(* Bomba 2 de higienização da peneira *)
IF bComOK THEN
    b2Anim := s122;
ELSE
    b2Anim := 4;
END_IF;
b2Def := bComOK AND ((w81 AND 16#0008) <> 16#0000);
b2Hor := DWORD_TO_DINT(SHL(WORD_TO_DWORD(INT_TO_WORD(h505)), 16) OR WORD_TO_DWORD(INT_TO_WORD(h504)));
b2Auto := stsAutoPeneira;
b2VelSts := INT_TO_REAL(s121) * 100.0 / 16000.0;
b2FbLiga := (img008 AND 16#0001) <> 16#0000;
b2FbInt := FALSE;
b2FbRev := FALSE;
(* Válvula 1 - higienização do cesto da peneira *)
IF bComOK THEN
    v1Anim := s127;
ELSE
    v1Anim := 4;
END_IF;
v1Def := bComOK AND (s127 = 2);
v1Hor := DWORD_TO_DINT(SHL(WORD_TO_DWORD(INT_TO_WORD(h507)), 16) OR WORD_TO_DWORD(INT_TO_WORD(h506)));
v1Auto := stsAutoPeneira;
v1VelSts := 0.0;
v1FbLiga := (img009 AND 16#0001) <> 16#0000;
v1FbInt := FALSE;
v1FbRev := FALSE;
(* Válvula 2 - higienização da rosca da peneira *)
IF bComOK THEN
    v2Anim := s132;
ELSE
    v2Anim := 4;
END_IF;
v2Def := bComOK AND (s132 = 2);
v2Hor := DWORD_TO_DINT(SHL(WORD_TO_DWORD(INT_TO_WORD(h509)), 16) OR WORD_TO_DWORD(INT_TO_WORD(h508)));
v2Auto := stsAutoPeneira;
v2VelSts := 0.0;
v2FbLiga := (img010 AND 16#0001) <> 16#0000;
v2FbInt := FALSE;
v2FbRev := FALSE;
(* Compressor de ar *)
IF bComOK THEN
    cmpAnim := s137;
ELSE
    cmpAnim := 4;
END_IF;
cmpDef := bComOK AND ((w81 AND 16#0100) <> 16#0000);
cmpHor := DWORD_TO_DINT(SHL(WORD_TO_DWORD(INT_TO_WORD(h511)), 16) OR WORD_TO_DWORD(INT_TO_WORD(h510)));
cmpAuto := stsAutoRaspComp;
cmpVelSts := INT_TO_REAL(s136) * 100.0 / 16000.0;
cmpFbLiga := (img011 AND 16#0001) <> 16#0000;
cmpFbInt := FALSE;
cmpFbRev := FALSE;
(* Raspador de gordura *)
IF bComOK THEN
    rspAnim := s142;
ELSE
    rspAnim := 4;
END_IF;
rspDef := bComOK AND ((w81 AND 16#0080) <> 16#0000);
rspHor := DWORD_TO_DINT(SHL(WORD_TO_DWORD(INT_TO_WORD(h513)), 16) OR WORD_TO_DWORD(INT_TO_WORD(h512)));
rspAuto := stsAutoRaspComp;
rspVelSts := INT_TO_REAL(s141) * 100.0 / 16000.0;
rspFbLiga := (img012 AND 16#0001) <> 16#0000;
rspFbInt := (img012 AND 16#0020) <> 16#0000;
rspFbRev := (img012 AND 16#0008) <> 16#0000;
(* Rosca 1 - horizontal *)
IF bComOK THEN
    r1Anim := s152;
ELSE
    r1Anim := 4;
END_IF;
r1Def := bComOK AND ((w81 AND 16#0020) <> 16#0000);
r1Hor := DWORD_TO_DINT(SHL(WORD_TO_DWORD(INT_TO_WORD(h515)), 16) OR WORD_TO_DWORD(INT_TO_WORD(h514)));
r1Auto := stsAutoRoscas;
r1VelSts := INT_TO_REAL(s151) * 100.0 / 16000.0;
r1FbLiga := (img013 AND 16#0001) <> 16#0000;
r1FbInt := (img013 AND 16#0020) <> 16#0000;
r1FbRev := (img013 AND 16#0008) <> 16#0000;
(* Rosca 2 - inclinada *)
IF bComOK THEN
    r2Anim := s162;
ELSE
    r2Anim := 4;
END_IF;
r2Def := bComOK AND ((w81 AND 16#0040) <> 16#0000);
r2Hor := DWORD_TO_DINT(SHL(WORD_TO_DWORD(INT_TO_WORD(h517)), 16) OR WORD_TO_DWORD(INT_TO_WORD(h516)));
r2Auto := stsAutoRoscas;
r2VelSts := INT_TO_REAL(s161) * 100.0 / 16000.0;
r2FbLiga := (img014 AND 16#0001) <> 16#0000;
r2FbInt := (img014 AND 16#0020) <> 16#0000;
r2FbRev := (img014 AND 16#0008) <> 16#0000;

(* ---- 4. Comandos da IHM: troca so o bit comandado na imagem e escreve a palavra ---- *)
IF REQ_PEN_LIGA THEN
    IF penLiga THEN
        img006 := img006 OR 16#0001;
    ELSE
        img006 := img006 AND 16#FFFE;
    END_IF;
    ww006 := WORD_TO_INT(img006);
    CNF_W006 := TRUE;
END_IF;
IF REQ_PEN_INT THEN
    IF penInt THEN
        img006 := img006 OR 16#0020;
    ELSE
        img006 := img006 AND 16#FFDF;
    END_IF;
    ww006 := WORD_TO_INT(img006);
    CNF_W006 := TRUE;
END_IF;
IF REQ_PEN_VEL THEN
    ww101 := REAL_TO_INT(LIMIT(0.0, penVel, 100.0) * 160.0);
    CNF_V101 := TRUE;
END_IF;
IF REQ_B1_LIGA THEN
    IF b1Liga THEN
        img007 := img007 OR 16#0001;
    ELSE
        img007 := img007 AND 16#FFFE;
    END_IF;
    ww007 := WORD_TO_INT(img007);
    CNF_W007 := TRUE;
END_IF;
IF REQ_B1_VEL THEN
    ww116 := REAL_TO_INT(LIMIT(0.0, b1Vel, 100.0) * 160.0);
    CNF_V116 := TRUE;
END_IF;
IF REQ_B2_LIGA THEN
    IF b2Liga THEN
        img008 := img008 OR 16#0001;
    ELSE
        img008 := img008 AND 16#FFFE;
    END_IF;
    ww008 := WORD_TO_INT(img008);
    CNF_W008 := TRUE;
END_IF;
IF REQ_B2_VEL THEN
    ww121 := REAL_TO_INT(LIMIT(0.0, b2Vel, 100.0) * 160.0);
    CNF_V121 := TRUE;
END_IF;
IF REQ_V1_LIGA THEN
    IF v1Liga THEN
        img009 := img009 OR 16#0001;
    ELSE
        img009 := img009 AND 16#FFFE;
    END_IF;
    ww009 := WORD_TO_INT(img009);
    CNF_W009 := TRUE;
END_IF;
IF REQ_V2_LIGA THEN
    IF v2Liga THEN
        img010 := img010 OR 16#0001;
    ELSE
        img010 := img010 AND 16#FFFE;
    END_IF;
    ww010 := WORD_TO_INT(img010);
    CNF_W010 := TRUE;
END_IF;
IF REQ_CMP_LIGA THEN
    IF cmpLiga THEN
        img011 := img011 OR 16#0001;
    ELSE
        img011 := img011 AND 16#FFFE;
    END_IF;
    ww011 := WORD_TO_INT(img011);
    CNF_W011 := TRUE;
END_IF;
IF REQ_CMP_VEL THEN
    ww136 := REAL_TO_INT(LIMIT(0.0, cmpVel, 100.0) * 160.0);
    CNF_V136 := TRUE;
END_IF;
IF REQ_RSP_LIGA THEN
    IF rspLiga THEN
        img012 := img012 OR 16#0001;
    ELSE
        img012 := img012 AND 16#FFFE;
    END_IF;
    ww012 := WORD_TO_INT(img012);
    CNF_W012 := TRUE;
END_IF;
IF REQ_RSP_INT THEN
    IF rspInt THEN
        img012 := img012 OR 16#0020;
    ELSE
        img012 := img012 AND 16#FFDF;
    END_IF;
    ww012 := WORD_TO_INT(img012);
    CNF_W012 := TRUE;
END_IF;
IF REQ_RSP_REV THEN
    IF rspRev THEN
        img012 := img012 OR 16#0008;
    ELSE
        img012 := img012 AND 16#FFF7;
    END_IF;
    ww012 := WORD_TO_INT(img012);
    CNF_W012 := TRUE;
END_IF;
IF REQ_RSP_VEL THEN
    ww141 := REAL_TO_INT(LIMIT(0.0, rspVel, 100.0) * 160.0);
    CNF_V141 := TRUE;
END_IF;
IF REQ_R1_LIGA THEN
    IF r1Liga THEN
        img013 := img013 OR 16#0001;
    ELSE
        img013 := img013 AND 16#FFFE;
    END_IF;
    ww013 := WORD_TO_INT(img013);
    CNF_W013 := TRUE;
END_IF;
IF REQ_R1_INT THEN
    IF r1Int THEN
        img013 := img013 OR 16#0020;
    ELSE
        img013 := img013 AND 16#FFDF;
    END_IF;
    ww013 := WORD_TO_INT(img013);
    CNF_W013 := TRUE;
END_IF;
IF REQ_R1_REV THEN
    IF r1Rev THEN
        img013 := img013 OR 16#0008;
    ELSE
        img013 := img013 AND 16#FFF7;
    END_IF;
    ww013 := WORD_TO_INT(img013);
    CNF_W013 := TRUE;
END_IF;
IF REQ_R1_VEL THEN
    ww151 := REAL_TO_INT(LIMIT(0.0, r1Vel, 100.0) * 160.0);
    CNF_V151 := TRUE;
END_IF;
IF REQ_R2_LIGA THEN
    IF r2Liga THEN
        img014 := img014 OR 16#0001;
    ELSE
        img014 := img014 AND 16#FFFE;
    END_IF;
    ww014 := WORD_TO_INT(img014);
    CNF_W014 := TRUE;
END_IF;
IF REQ_R2_INT THEN
    IF r2Int THEN
        img014 := img014 OR 16#0020;
    ELSE
        img014 := img014 AND 16#FFDF;
    END_IF;
    ww014 := WORD_TO_INT(img014);
    CNF_W014 := TRUE;
END_IF;
IF REQ_R2_REV THEN
    IF r2Rev THEN
        img014 := img014 OR 16#0008;
    ELSE
        img014 := img014 AND 16#FFF7;
    END_IF;
    ww014 := WORD_TO_INT(img014);
    CNF_W014 := TRUE;
END_IF;
IF REQ_R2_VEL THEN
    ww161 := REAL_TO_INT(LIMIT(0.0, r2Vel, 100.0) * 160.0);
    CNF_V161 := TRUE;
END_IF;
IF REQ_LIGA_PEN THEN
    IF hmiLigaPeneira THEN
        img015 := img015 OR 16#0001;
    ELSE
        img015 := img015 AND 16#FFFE;
    END_IF;
    ww015 := WORD_TO_INT(img015);
    CNF_W015 := TRUE;
END_IF;
IF REQ_SEL_PEN THEN
    IF hmiSelPeneira THEN
        img015 := img015 OR 16#0004;
    ELSE
        img015 := img015 AND 16#FFFB;
    END_IF;
    ww015 := WORD_TO_INT(img015);
    CNF_W015 := TRUE;
END_IF;
IF REQ_LIGA_ROS THEN
    IF hmiLigaRoscas THEN
        img016 := img016 OR 16#0001;
    ELSE
        img016 := img016 AND 16#FFFE;
    END_IF;
    ww016 := WORD_TO_INT(img016);
    CNF_W016 := TRUE;
END_IF;
IF REQ_SEL_ROS THEN
    IF hmiSelRoscas THEN
        img016 := img016 OR 16#0004;
    ELSE
        img016 := img016 AND 16#FFFB;
    END_IF;
    ww016 := WORD_TO_INT(img016);
    CNF_W016 := TRUE;
END_IF;
IF REQ_LIGA_RC THEN
    IF hmiLigaRaspComp THEN
        img017 := img017 OR 16#0001;
    ELSE
        img017 := img017 AND 16#FFFE;
    END_IF;
    ww017 := WORD_TO_INT(img017);
    CNF_W017 := TRUE;
END_IF;
IF REQ_SEL_RC THEN
    IF hmiSelRaspComp THEN
        img017 := img017 OR 16#0004;
    ELSE
        img017 := img017 AND 16#FFFB;
    END_IF;
    ww017 := WORD_TO_INT(img017);
    CNF_W017 := TRUE;
END_IF;
IF REQ_SEL_BOMBA THEN
    IF hmiSelBomba THEN
        img007 := img007 OR 16#0008;
    ELSE
        img007 := img007 AND 16#FFF7;
    END_IF;
    ww007 := WORD_TO_INT(img007);
    CNF_W007 := TRUE;
END_IF;

(* ---- 5. Reset: pulso em 40005.3, bomba de gordura e reconhecimento ---- *)
bReset := (REQ_RESET AND hmiReset) OR (REQ_RESET_PROC AND cmdResetFalhas);
IF bReset THEN
    img005 := img005 OR 16#0008;
    ww005 := WORD_TO_INT(img005);
    CNF_W005 := TRUE;
    uSegReset := cfgTempoReset;
    IF uSegReset = 0 THEN
        uSegReset := 1;
    END_IF;
    resetBomba := TRUE;
    CNF_RESET := TRUE;
ELSIF TICK AND uSegReset > 0 THEN
    uSegReset := uSegReset - 1;
    IF uSegReset = 0 THEN
        img005 := img005 AND 16#FFF7;
        ww005 := WORD_TO_INT(img005);
        CNF_W005 := TRUE;
    END_IF;
END_IF;

(* ---- 6. Disponibilidade (condicoes para o AND editavel do CAT) e cadeia das UCTs ---- *)
habilitada := cfgInstalada AND stpHabilitada;
okComunicacao := bComOK;
okEmergencia := bComOK AND NOT stsEmergenciaUCT;
okPeneira := bComOK AND NOT penDef;
okMotores := bComOK AND NOT (b1Def OR b2Def OR cmpDef OR rspDef OR r1Def OR r2Def);
stsDisponivel := disponivel AND habilitada;
stsAlgumaHabilitada := habilitada OR antHabilitada;
stsAlgumaDisponivel := stsDisponivel OR antDisponivel;
stsBloqueioEEE := stsAlgumaHabilitada AND NOT stsAlgumaDisponivel;

(* ---- 7. Bomba de gordura e valvula de lavagem ---- *)
bNivelAltoG := stsNivelAltoGordura;
IF emergencia OR NOT bombaAutomatico THEN
    uEtapa := 0;
    uSegEtapa := 0;
    uSegValv := 0;
    cmdLigarBomba := FALSE;
    bValvAuto := FALSE;
ELSE
    IF TICK THEN
        uSegEtapa := uSegEtapa + 1;
        IF uEtapa >= 2 THEN
            uSegValv := uSegValv + 1;
        END_IF;
    END_IF;
    IF uEtapa = 0 THEN
        IF bNivelAltoG THEN
            uEtapa := 1;
            uSegEtapa := 0;
        END_IF;
    END_IF;
    IF uEtapa = 1 THEN
        IF uSegEtapa >= UINT_TO_UDINT(stpTempoPreLavagem) THEN
            uEtapa := 2;
            uSegEtapa := 0;
            uSegValv := 0;
        END_IF;
    END_IF;
    IF uEtapa = 2 THEN
        IF NOT bNivelAltoG THEN
            uEtapa := 3;
            uSegEtapa := 0;
        END_IF;
    ELSIF uEtapa = 3 THEN
        IF bNivelAltoG THEN
            uEtapa := 2;
            uSegEtapa := 0;
        ELSIF uSegEtapa >= UINT_TO_UDINT(stpTempoDesliga) THEN
            uEtapa := 0;
            uSegEtapa := 0;
        END_IF;
    END_IF;
    cmdLigarBomba := uEtapa >= 2;
    bValvAuto := (uEtapa = 1) OR (uEtapa >= 2 AND uSegValv < UINT_TO_UDINT(stpTempoValvula));
END_IF;
stpVelBombaOut := stpVelBomba;
IF emergencia THEN
    cmdValvula := FALSE;
ELSIF bombaAutomatico THEN
    cmdValvula := bValvAuto;
ELSE
    cmdValvula := hmiValvula;
END_IF;
stsValvula := cmdValvula;
IF NOT bombaAutomatico THEN
    stsEtapaGordura := 4;
ELSE
    stsEtapaGordura := uEtapa;
END_IF;
IF bombaAutomatico AND uEtapa = 1 THEN
    stsTempoRestante := UDINT_TO_INT(UINT_TO_UDINT(stpTempoPreLavagem) - MIN(uSegEtapa, UINT_TO_UDINT(stpTempoPreLavagem)));
ELSIF bombaAutomatico AND uEtapa = 3 THEN
    stsTempoRestante := UDINT_TO_INT(UINT_TO_UDINT(stpTempoDesliga) - MIN(uSegEtapa, UINT_TO_UDINT(stpTempoDesliga)));
ELSE
    stsTempoRestante := 0;
END_IF;

(* ---- 8. Alarmes (UCT nao instalada nao alarma) ---- *)
almCom := stsFalhaComunicacao;
almEmergencia := stsEmergenciaUCT;
almDefPEN := penDef;
almDefB1 := b1Def;
almDefB2 := b2Def;
almDefCMP := cmpDef;
almDefRSP := rspDef;
almDefR1 := r1Def;
almDefR2 := r2Def;
almNivelAgua := stsNivelBaixoAgua;
almNivelPeneira := stsNivelAltoPeneira;
stsAlarme := almCom OR almEmergencia OR almDefPEN OR almDefB1 OR almDefB2 OR almDefCMP OR almDefRSP OR almDefR1 OR almDefR2 OR almNivelAgua OR almNivelPeneira;

(* ---- 9. Eventos so na mudanca ---- *)
wD := 0;
IF okEmergencia THEN wD := wD OR 16#0001; END_IF;
IF okPeneira THEN wD := wD OR 16#0002; END_IF;
IF okMotores THEN wD := wD OR 16#0004; END_IF;
IF okComunicacao THEN wD := wD OR 16#0008; END_IF;
IF habilitada THEN wD := wD OR 16#0010; END_IF;
CNF_DISP := initPass OR (wD <> oldD);
oldD := wD;
wP := 0;
IF stsDisponivel THEN wP := wP OR 16#00000001; END_IF;
IF stsAlgumaHabilitada THEN wP := wP OR 16#00000002; END_IF;
IF stsAlgumaDisponivel THEN wP := wP OR 16#00000004; END_IF;
IF stsBloqueioEEE THEN wP := wP OR 16#00000008; END_IF;
IF stsFalhaComunicacao THEN wP := wP OR 16#00000010; END_IF;
IF stsEmergenciaUCT THEN wP := wP OR 16#00000020; END_IF;
IF stsNivelAltoGordura THEN wP := wP OR 16#00000040; END_IF;
IF stsAlarme THEN wP := wP OR 16#00000080; END_IF;
IF stsNivelBaixoPeneira THEN wP := wP OR 16#00000100; END_IF;
IF stsNivelAltoPeneira THEN wP := wP OR 16#00000200; END_IF;
IF stsNivelBaixoAgua THEN wP := wP OR 16#00000400; END_IF;
IF stsAutoPeneira THEN wP := wP OR 16#00000800; END_IF;
IF stsAutoRoscas THEN wP := wP OR 16#00001000; END_IF;
IF stsAutoRaspComp THEN wP := wP OR 16#00002000; END_IF;
IF stsLigaAutoPeneira THEN wP := wP OR 16#00004000; END_IF;
IF stsLigaAutoRoscas THEN wP := wP OR 16#00008000; END_IF;
IF stsLigaAutoRaspComp THEN wP := wP OR 16#00010000; END_IF;
IF stsSelecaoBomba THEN wP := wP OR 16#00020000; END_IF;
IF stsValvula THEN wP := wP OR 16#00040000; END_IF;
CNF := initPass OR ((wP AND 16#000000FF) <> (oldP AND 16#000000FF));
bMudou := (wP <> oldP) OR (wD <> oldD);
IF stsNivelPeneira <> o_stsNivelPeneira THEN bMudou := TRUE; o_stsNivelPeneira := stsNivelPeneira; END_IF;
IF stsEtapaGordura <> o_stsEtapaGordura THEN bMudou := TRUE; o_stsEtapaGordura := stsEtapaGordura; END_IF;
IF stsTempoRestante <> o_stsTempoRestante THEN bMudou := TRUE; o_stsTempoRestante := stsTempoRestante; END_IF;
CNF_HMI := initPass OR bMudou;
oldP := wP;
bMudou := FALSE;
IF penAnim <> o_penAnim THEN bMudou := TRUE; o_penAnim := penAnim; END_IF;
IF penDef <> o_penDef THEN bMudou := TRUE; o_penDef := penDef; END_IF;
IF penHor <> o_penHor THEN bMudou := TRUE; o_penHor := penHor; END_IF;
IF penAuto <> o_penAuto THEN bMudou := TRUE; o_penAuto := penAuto; END_IF;
IF penVelSts <> o_penVelSts THEN bMudou := TRUE; o_penVelSts := penVelSts; END_IF;
IF penFbLiga <> o_penFbLiga THEN bMudou := TRUE; o_penFbLiga := penFbLiga; END_IF;
IF penFbInt <> o_penFbInt THEN bMudou := TRUE; o_penFbInt := penFbInt; END_IF;
IF penFbRev <> o_penFbRev THEN bMudou := TRUE; o_penFbRev := penFbRev; END_IF;
IF b1Anim <> o_b1Anim THEN bMudou := TRUE; o_b1Anim := b1Anim; END_IF;
IF b1Def <> o_b1Def THEN bMudou := TRUE; o_b1Def := b1Def; END_IF;
IF b1Hor <> o_b1Hor THEN bMudou := TRUE; o_b1Hor := b1Hor; END_IF;
IF b1Auto <> o_b1Auto THEN bMudou := TRUE; o_b1Auto := b1Auto; END_IF;
IF b1VelSts <> o_b1VelSts THEN bMudou := TRUE; o_b1VelSts := b1VelSts; END_IF;
IF b1FbLiga <> o_b1FbLiga THEN bMudou := TRUE; o_b1FbLiga := b1FbLiga; END_IF;
IF b1FbInt <> o_b1FbInt THEN bMudou := TRUE; o_b1FbInt := b1FbInt; END_IF;
IF b1FbRev <> o_b1FbRev THEN bMudou := TRUE; o_b1FbRev := b1FbRev; END_IF;
IF b2Anim <> o_b2Anim THEN bMudou := TRUE; o_b2Anim := b2Anim; END_IF;
IF b2Def <> o_b2Def THEN bMudou := TRUE; o_b2Def := b2Def; END_IF;
IF b2Hor <> o_b2Hor THEN bMudou := TRUE; o_b2Hor := b2Hor; END_IF;
IF b2Auto <> o_b2Auto THEN bMudou := TRUE; o_b2Auto := b2Auto; END_IF;
