<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="5e930f1d-9944-7b5a-7924-0ab22959189d" Name="Preparador_Vibropac" Comment="Preparador de polimero Vibropac VIB-3000 - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="19/10/2026" Remarks="1.0: Preparador de polimero Vibropac VIB-3000 - tabela Modbus TCP Inovaisa (PV-36142). Campo por symlink ${PATH}: leitura mbR4005..mbR4019 (INT, nome = mbR + registro), mbConexao (connStatusInt, 1 = online); escrita mbW4001 (ciclo remoto 0/1) e mbW4002 (reset 0/1). cfgHabilitada = FALSE para equipamento futuro." />
  <InterfaceList>
    <EventInputs>
      <Event ID="8E41CA7EF16C6739" Name="REQ" Comment="Atualizacao do processo">
        <With Var="cmdLigarCiclo" />
      </Event>
      <Event ID="92DC3CE3AA129B98" Name="E_RESET_FALHAS" Comment="Reset pelo processo (com cmdResetFalhas = TRUE)">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="0264E737EBBCA257" Name="CNF" Comment="Status">
        <With Var="stsComunicacaoOK" />
        <With Var="stsDisponivel" />
        <With Var="stsCicloLigado" />
        <With Var="stsFalha" />
        <With Var="stsEmergencia" />
        <With Var="stsDosando" />
        <With Var="stsSiloBaixo" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="DB86CBF02B2705F4" Name="cmdLigarCiclo" Type="BOOL" Comment="TRUE = liga o ciclo remoto do skid (automatico)" />
      <VarDeclaration ID="1C1DE110A3771399" Name="cmdResetFalhas" Type="BOOL" Comment="TRUE = reset (com o evento E_RESET_FALHAS)" />
      <VarDeclaration ID="334F8D59FCE9448A" Name="cfgHabilitada" Type="BOOL" InitialValue="TRUE" Comment="FALSE = instancia desabilitada (equipamento futuro)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="0DF3666BA9A5E692" Name="stsComunicacaoOK" Type="BOOL" Comment="Comunicacao Modbus com o CLP do skid OK" />
      <VarDeclaration ID="5924057DB679FD7F" Name="stsDisponivel" Type="BOOL" Comment="Pode ser ligado pelo automatico agora" />
      <VarDeclaration ID="3C195410EA98A3B5" Name="stsCicloLigado" Type="BOOL" Comment="Comando de ciclo remoto ligado (4001 = 1)" />
      <VarDeclaration ID="278FA7DE98B71B84" Name="stsFalha" Type="BOOL" Comment="Skid em falha (alarme, emergencia ou motor)" />
      <VarDeclaration ID="704BDFA3DE5017A3" Name="stsEmergencia" Type="BOOL" Comment="Botao de emergencia do skid acionado (4006)" />
      <VarDeclaration ID="1330DA43C77FB0EB" Name="stsDosando" Type="BOOL" Comment="Bomba dosadora M4 ou M5 funcionando" />
      <VarDeclaration ID="9418D505A34C3324" Name="stsSiloBaixo" Type="BOOL" Comment="Silo de polimero em po com nivel baixo LSL-01 (4013 = 0)" />
    </OutputVars>
  </InterfaceList>
