  <BasicFB ID="3c3160e1-9cb2-4bbf-a356-e07f84e31ae0">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="INIT,REQ" />
    <InternalVars>
      <VarDeclaration ID="A6A39719CEF792D0" Name="iEstado" Type="INT" />
      <VarDeclaration ID="9076947849A6AF16" Name="idxDuty1" Type="INT" />
      <VarDeclaration ID="75F25884CF68FEF7" Name="idxDuty2" Type="INT" />
      <VarDeclaration ID="76434DE0116B7718" Name="tEsperaQuim" Type="TIME" />
      <VarDeclaration ID="CC4AB514746C014F" Name="tAcel" Type="TIME" />
      <VarDeclaration ID="2A22C3BB19A88A50" Name="tC1" Type="TIME" />
      <VarDeclaration ID="099255DAE1F3A730" Name="tC3" Type="TIME" />
      <VarDeclaration ID="F1CCF73047D649EA" Name="bQuimOkAnt" Type="BOOL" />
      <VarDeclaration ID="563C27C41B78BF90" Name="rSaida" Type="REAL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="552.9412" y="429.4117" />
      <ECState Name="INIT" x="1228" y="423.9999">
        <ECAction Algorithm="INIT" />
      </ECState>
      <ECState Name="REQ" x="1096" y="928">
        <ECAction Algorithm="REQ" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="INIT" Condition="INIT" x="913.4838" y="342.7588">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="210.1519,82.26099,247.3385,81.98772" />
      </ECTransition>
      <ECTransition Source="INIT" Destination="START" Condition="1" x="909.594" y="512.062">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="246.3355,131.4866,208.5617,131.7895" />
      </ECTransition>
      <ECTransition Source="START" Destination="REQ" Condition="REQ" x="883.6307" y="624.1142">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="205.0982,136.008,238.7846,166.9505" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="1" x="808.7417" y="753.6766">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="220.2081,209.5188,186.9007,178.9414" />
      </ECTransition>
    </ECC>
    <Algorithm Name="INIT" Comment="Initialization algorithm">
      <ST><![CDATA[
iEstado := 0;
idxDuty1 := 0;
idxDuty2 := 0;
tEsperaQuim := stpTempoEsperaQuimicos;
tAcel := stpTempoAceleracao;
tC1 := stpTempoC1;
tC3 := stpTempoC3;
bQuimOkAnt := FALSE;
rSaida := 0.0;
cmdLigarBomba1 := FALSE; cmdLigarBomba2 := FALSE; cmdLigarBomba3 := FALSE;
stpCapacidadeBomba1 := 0.0; stpCapacidadeBomba2 := 0.0; stpCapacidadeBomba3 := 0.0;
cmdLigarMisturadorA := FALSE; cmdLigarMisturadorB := FALSE;
stsCondicaoOperacaoBuffer := FALSE;
stsSemNivelHBuffer := TRUE;
stsSemNivelHHBuffer := TRUE;
stsMedicaoNivelDisponivel := FALSE;
stsStartEmergencyRecipe := FALSE;
stpSetpointPID := 0.0;
cmdPIDAuto := FALSE;
stpPresetPID := 0.0;
stsTempoEsperaRestante := T#0s;
stsBombaPrincipal := 0;
stsNumeroBombasOperando := 0;
stsMalhaAberta := FALSE;
stsEstado := 0;

;]]></ST>
    </Algorithm>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <VarDeclaration Name="bFeedAtivo" Type="BOOL" />
      <VarDeclaration Name="bQuimOk" Type="BOOL" />
      <VarDeclaration Name="bBombaDisp" Type="BOOL" />
      <VarDeclaration Name="bVazaoLL" Type="BOOL" />
      <VarDeclaration Name="bReadyD1" Type="BOOL" />
      <VarDeclaration Name="bReadyD2" Type="BOOL" />
      <VarDeclaration Name="rSpBruto" Type="REAL" />
      <VarDeclaration Name="nLigadas" Type="INT" />
      <VarDeclaration Name="idxCand" Type="INT" />
      <VarDeclaration Name="tMenor" Type="TIME" />
      <ST><![CDATA[stsSemNivelHBuffer := NOT ISts40LT0001_FbAlarmeH;
stsSemNivelHHBuffer := NOT stsBoiaHH;
stsMedicaoNivelDisponivel := NOT ISts40LT0001_FbFailure;
stsStartEmergencyRecipe := ISts40LT0001_FbAlarmeHH
AND NOT ISts40LT0001_FbFailure;
(*------------------------------------------------------------------
2. QUÍMICOS — narrativa 2.2, 2.3.6 e 2.3.7
pH ou condutividade fora de faixa, ou falha de medição de
qualquer um dos dois, param a alimentação.
Temporizador de retomada: conta apenas com AMBOS dentro da
faixa. Qualquer saída de faixa rearma do zero.
------------------------------------------------------------------*)
bQuimOk := NOT ISts40QT0005_FbAlarmeL AND NOT ISts40QT0005_FbAlarmeH
AND NOT ISts40QT0004_FbAlarmeL AND NOT ISts40QT0004_FbAlarmeH
AND NOT ISts40QT0005_FbFailure AND NOT ISts40QT0004_FbFailure;
IF bQuimOk THEN
	IF NOT bQuimOkAnt THEN
		tEsperaQuim := stpTempoEsperaQuimicos; (* borda: arma *)
	ELSIF tEsperaQuim > stpPeriodoTick THEN
		tEsperaQuim := tEsperaQuim - stpPeriodoTick;
	ELSE
		tEsperaQuim := T#0s; (* expirou *)
	END_IF;
ELSE
	tEsperaQuim := stpTempoEsperaQuimicos; (* rearma *)
END_IF;
bQuimOkAnt := bQuimOk;
stsTempoEsperaRestante := tEsperaQuim;
(*------------------------------------------------------------------
3. BOMBAS RODANDO E LL DE VAZÃO
O atraso do alarme é feito pelo bloco de sensor. Aqui só a
supressão: com bomba parada a vazão é zero por definição, e o
alarme não pode bloquear a alimentação.
------------------------------------------------------------------*)
nLigadas := 0;
IF P4001_FbRunning THEN nLigadas := nLigadas + 1; END_IF;
IF P4002_FbRunning THEN nLigadas := nLigadas + 1; END_IF;
IF P4003_FbRunning THEN nLigadas := nLigadas + 1; END_IF;
stsNumeroBombasOperando := nLigadas;
bVazaoLL := (nLigadas > 0)
AND ISts40FT05_FbAlarmeLL
AND NOT ISts40FT05_FbFailure;
(*------------------------------------------------------------------
4. DISPONIBILIDADE — narrativa 1.4.2
------------------------------------------------------------------*)
bBombaDisp := P4001_FbReady OR P4002_FbReady OR P4003_FbReady;
(*------------------------------------------------------------------
5. CONDIÇÃO DE OPERAÇÃO DO BUFFER
Vai para a operating condition da fase Feed dos dois reatores.
Narrativa 2.2: a alimentação para em LL de nível, pH fora de
faixa e condutividade fora de faixa.
------------------------------------------------------------------*)
stsCondicaoOperacaoBuffer := bBombaDisp
AND bQuimOk
AND (tEsperaQuim = T#0s)
AND NOT ISts40LT0001_FbAlarmeLL
AND NOT ISts40LT0001_FbFailure
AND NOT bVazaoLL;
(*------------------------------------------------------------------
6. SETPOINT DE VAZÃO — narrativa 2.2 e 3.2.1
O Nereda envia m³/h; o PI converte em capacidade.
Apenas uma fase Feed pode estar em RUN por vez.
------------------------------------------------------------------*)
bFeedAtivo := stsFeedR1 OR stsFeedR2;
IF stsFeedR1 THEN rSpBruto := stpFlowR1;
ELSIF stsFeedR2 THEN rSpBruto := stpFlowR2;
ELSE rSpBruto := 0.0;
END_IF;
IF rSpBruto < 0.0 THEN rSpBruto := 0.0; END_IF;
stpSetpointPID := rSpBruto;
(*------------------------------------------------------------------
7. ESCOLHA DAS BOMBAS — narrativa 1.4.9
idxCand = próxima candidata: disponível, ainda não comandada,
de MENOR horímetro (FbHorimetro = tempo de operação).
Em modo fixo, a candidata é a bomba escolhida pelo operador.
------------------------------------------------------------------*)
idxCand := 0;
tMenor := T#999999s;
IF cmdSelecaoBomba = 1 THEN
IF P4001_FbReady AND (idxDuty1 <> 1) AND (idxDuty2 <> 1) THEN idxCand := 1; END_IF;
ELSIF cmdSelecaoBomba = 2 THEN
IF P4002_FbReady AND (idxDuty1 <> 2) AND (idxDuty2 <> 2) THEN idxCand := 2; END_IF;
ELSIF cmdSelecaoBomba = 3 THEN
IF P4003_FbReady AND (idxDuty1 <> 3) AND (idxDuty2 <> 3) THEN idxCand := 3; END_IF;
ELSE
IF P4001_FbReady AND (idxDuty1 <> 1) AND (idxDuty2 <> 1)
AND (P4001_FbHorimetro <= tMenor) THEN
idxCand := 1; tMenor := P4001_FbHorimetro;
END_IF;
IF P4002_FbReady AND (idxDuty1 <> 2) AND (idxDuty2 <> 2)
AND (P4002_FbHorimetro < tMenor) THEN
idxCand := 2; tMenor := P4002_FbHorimetro;
END_IF;
IF P4003_FbReady AND (idxDuty1 <> 3) AND (idxDuty2 <> 3)
AND (P4003_FbHorimetro < tMenor) THEN
idxCand := 3; tMenor := P4003_FbHorimetro;
END_IF;
END_IF;
(* Disponibilidade das bombas atualmente comandadas *)
bReadyD1 := FALSE;
CASE idxDuty1 OF
1: bReadyD1 := P4001_FbReady;
2: bReadyD1 := P4002_FbReady;
3: bReadyD1 := P4003_FbReady;
END_CASE;
bReadyD2 := FALSE;
CASE idxDuty2 OF
1: bReadyD2 := P4001_FbReady;
2: bReadyD2 := P4002_FbReady;
3: bReadyD2 := P4003_FbReady;
END_CASE;
stsBombaPrincipal := idxDuty1;
(*------------------------------------------------------------------
8. MÁQUINA DE ESTADOS — narrativa 2.2
0 Parado · 1 Partindo · 2 Uma bomba · 3 Sobe (C2)
4 Duas bombas · 5 Desce · 6 Parando
Na partida não há capacidade fixa: o PI assume desde o início e
a rampa do inversor cuida do transitório. C2 é usado apenas na
transição de uma para duas bombas.
------------------------------------------------------------------*)
CASE iEstado OF
0: (*--- PARADO ---*)
idxDuty1 := 0; idxDuty2 := 0;
cmdPIDAuto := FALSE; stpPresetPID := 0.0; rSaida := 0.0;
tC1 := stpTempoC1; tC3 := stpTempoC3; tAcel := stpTempoAceleracao;
IF bFeedAtivo AND stsCondicaoOperacaoBuffer AND (idxCand <> 0) THEN
idxDuty1 := idxCand;
iEstado := 1;
END_IF;
1: (*--- PARTINDO: comanda a duty, PI já em automático ---*)
cmdPIDAuto := NOT ISts40FT05_FbFailure;
IF NOT bFeedAtivo OR NOT stsCondicaoOperacaoBuffer THEN
iEstado := 6;
ELSIF NOT bReadyD1 THEN
(* Perdeu antes de confirmar: troca direta pela candidata *)
IF idxCand <> 0 THEN idxDuty1 := idxCand;
ELSE idxDuty1 := 0; iEstado := 6;
END_IF;
ELSIF ((idxDuty1 = 1) AND P4001_FbRunning)
OR ((idxDuty1 = 2) AND P4002_FbRunning)
OR ((idxDuty1 = 3) AND P4003_FbRunning) THEN
iEstado := 2;
END_IF;
2: (*--- UMA BOMBA EM CONTROLE ---*)
cmdPIDAuto := NOT ISts40FT05_FbFailure;
idxDuty2 := 0;
IF rSaida >= stpC1 THEN
IF tC1 > stpPeriodoTick THEN tC1 := tC1 - stpPeriodoTick;
ELSE tC1 := T#0s; END_IF;
ELSE
tC1 := stpTempoC1;
END_IF;
IF NOT bFeedAtivo OR NOT stsCondicaoOperacaoBuffer THEN
iEstado := 6;
ELSIF NOT bReadyD1 THEN
(* Troca direta, sem passar pelo Parado *)
IF idxCand <> 0 THEN
idxDuty1 := idxCand;
iEstado := 1; (* aguarda o FbRunning da nova *)
ELSE
idxDuty1 := 0;
iEstado := 6;
END_IF;
ELSIF (tC1 = T#0s) AND (idxCand <> 0) THEN
idxDuty2 := idxCand;
tAcel := stpTempoAceleracao;
iEstado := 3;
END_IF;
3: (*--- SOBE: transição de uma para duas bombas — narrativa 2.2 ---
Única etapa em que C2 é usado. A primeira cai para C2, a
segunda parte em C2, e o PI fica em manual travado nesse
valor durante a aceleração. *)
cmdPIDAuto := FALSE;
stpPresetPID := stpC2;
rSaida := stpC2;
IF tAcel > stpPeriodoTick THEN tAcel := tAcel - stpPeriodoTick;
ELSE tAcel := T#0s; END_IF;
IF NOT bFeedAtivo OR NOT stsCondicaoOperacaoBuffer THEN
iEstado := 6;
ELSIF NOT bReadyD1 THEN
(* A principal caiu durante a transição: a segunda assume *)
idxDuty1 := idxDuty2; idxDuty2 := 0;
tC1 := stpTempoC1;
iEstado := 2;
ELSIF NOT bReadyD2 THEN
idxDuty2 := 0;
tC1 := stpTempoC1;
iEstado := 2;
ELSIF tAcel = T#0s THEN
tC3 := stpTempoC3;
iEstado := 4;
END_IF;
4: (*--- DUAS BOMBAS EM CONTROLE CONJUNTO ---*)
cmdPIDAuto := NOT ISts40FT05_FbFailure;
IF rSaida <= stpC3 THEN
IF tC3 > stpPeriodoTick THEN tC3 := tC3 - stpPeriodoTick;
ELSE tC3 := T#0s; END_IF;
ELSE
tC3 := stpTempoC3;
END_IF;
IF NOT bFeedAtivo OR NOT stsCondicaoOperacaoBuffer THEN
iEstado := 6;
ELSIF NOT bReadyD1 THEN
(* Perdeu a principal: a segunda passa a ser a principal *)
idxDuty1 := idxDuty2;
IF idxCand <> 0 THEN
idxDuty2 := idxCand;
tAcel := stpTempoAceleracao; (* recontado do início *)
iEstado := 3;
ELSE
idxDuty2 := 0;
tC1 := stpTempoC1;
iEstado := 2;
END_IF;
ELSIF NOT bReadyD2 THEN
IF idxCand <> 0 THEN
idxDuty2 := idxCand;
tAcel := stpTempoAceleracao; (* recontado do início *)
iEstado := 3;
ELSE
idxDuty2 := 0;
tC1 := stpTempoC1;
iEstado := 2;
END_IF;
ELSIF tC3 = T#0s THEN
iEstado := 5;
END_IF;
5: (*--- DESCE: volta para uma bomba ---
Sai a que está em operação há mais tempo, ou seja, a
primeira que entrou — narrativa 1.4.9. *)
idxDuty1 := idxDuty2;
idxDuty2 := 0;
tC1 := stpTempoC1;
iEstado := 2;
6: (*--- PARANDO ---*)
idxDuty1 := 0; idxDuty2 := 0;
cmdPIDAuto := FALSE; stpPresetPID := 0.0; rSaida := 0.0;
IF nLigadas = 0 THEN
iEstado := 0;
END_IF;
END_CASE;
stsEstado := iEstado;
(*------------------------------------------------------------------
9. CAPACIDADE — narrativa 2.2
Falha do medidor: converte o setpoint em capacidade pela
capacidade teórica (malha aberta).
Nos estados 3, 5 e 6 a capacidade já foi definida pelo estado.
------------------------------------------------------------------*)
IF ISts40FT05_FbFailure AND (iEstado >= 1) AND (iEstado <= 4) THEN
stsMalhaAberta := TRUE;
IF stpCapacidadeTeorica > 0.0 THEN
IF idxDuty2 <> 0 THEN
rSaida := 100.0 * stpSetpointPID / (2.0 * stpCapacidadeTeorica);
ELSE
rSaida := 100.0 * stpSetpointPID / stpCapacidadeTeorica;
END_IF;
ELSE
rSaida := 0.0;
END_IF;
IF rSaida > 100.0 THEN rSaida := 100.0; END_IF;
stpPresetPID := rSaida; (* mantém o PI acompanhando *)
ELSE
stsMalhaAberta := FALSE;
IF (iEstado = 1) OR (iEstado = 2) OR (iEstado = 4) THEN
rSaida := stsSaidaPID;
END_IF;
END_IF;
(*------------------------------------------------------------------
10. COMANDOS DAS BOMBAS
Derivados de idxDuty1 e idxDuty2 — fonte única, sem comando
espalhado pelos estados. A capacidade é a MESMA para todas as
bombas em operação (narrativa 2.2).
------------------------------------------------------------------*)
cmdLigarBomba1 := (idxDuty1 = 1) OR (idxDuty2 = 1);
cmdLigarBomba2 := (idxDuty1 = 2) OR (idxDuty2 = 2);
cmdLigarBomba3 := (idxDuty1 = 3) OR (idxDuty2 = 3);
stpCapacidadeBomba1 := 0.0;
stpCapacidadeBomba2 := 0.0;
stpCapacidadeBomba3 := 0.0;
IF cmdLigarBomba1 THEN stpCapacidadeBomba1 := rSaida; END_IF;
IF cmdLigarBomba2 THEN stpCapacidadeBomba2 := rSaida; END_IF;
IF cmdLigarBomba3 THEN stpCapacidadeBomba3 := rSaida; END_IF;
(*------------------------------------------------------------------
11. MISTURADORES — narrativa 2.3.2
Em automático operam continuamente. Nível baixo e LL são
condição de Ready do próprio misturador — não duplicar
intertravamento aqui.
------------------------------------------------------------------*)
cmdLigarMisturadorA := TRUE;
cmdLigarMisturadorB := TRUE;
;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>