<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="48f7af8f-3f6d-fa13-779f-f44080d94d76" Name="basicAlimentacaoPrensas" Comment="Alimentacao das prensas C-Press: rotas do barrilete, bombas helicoidais, PID de vazao, preparador, painel" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.3" Author="Hidryco" Date="04/11/2026" Remarks="1.3: FT desabilitado conta como falha (ftNHab); rota so e liberada com a bomba parada; CNF_BO tambem na mudanca de comando/emergencia. 1.2: emergencia do PCM LODO NA (TRUE = emergencia), confirmado em campo. 1.1: velocidade de partida (stpVelInicial) e PIDs das prensas em Hz (60 Hz = 100 %); bombas continuam em %. 1.0: maquina de estados por prensa (valvulas, bomba, PID, suspensao por floculador/tanque), alocacao de bombas por no do barrilete, BO-02 reserva comum com rodizio na partida, horimetro persistente, ciclo das prensas e do preparador, SV manual, emergencia NF e disjuntores" />
