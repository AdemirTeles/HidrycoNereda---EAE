      <VarDeclaration ID="393E9D8F5F7E8405" Name="boL" Type="BOOL" ArraySize="3" />
      <VarDeclaration ID="D02479B5777A9A68" Name="boF" Type="BOOL" ArraySize="3" />
      <VarDeclaration ID="B36B3F71ABD90AAE" Name="uso" Type="INT" ArraySize="3" />
      <VarDeclaration ID="F337D47FE7AFB9AF" Name="cB" Type="BOOL" ArraySize="3" />
      <VarDeclaration ID="672E3636983D7B6D" Name="vB" Type="REAL" ArraySize="3" />
      <VarDeclaration ID="23877AB082E559D5" Name="minB" Type="UDINT" ArraySize="3" />
      <VarDeclaration ID="EA2B06A2E09B0A46" Name="segB" Type="INT" ArraySize="3" />
      <VarDeclaration ID="6B3414867FE9440F" Name="vaA" Type="BOOL" ArraySize="8" />
      <VarDeclaration ID="10A2E5BBF2709F46" Name="vaCmd" Type="BOOL" ArraySize="8" />
      <VarDeclaration ID="D3DB92808A7576A2" Name="vaF" Type="BOOL" ArraySize="8" />
      <VarDeclaration ID="5E8310FE77F60E73" Name="vaD" Type="BOOL" ArraySize="8" />
      <VarDeclaration ID="00987B86D044F5E1" Name="vaBloq" Type="BOOL" ArraySize="8" Comment="Valvula bloqueada por falha de rota (ate o reset)" />
      <VarDeclaration ID="C53C6FE767D47EB3" Name="tPerda" Type="INT" ArraySize="3" />
      <VarDeclaration ID="6D070475CEBC8F5D" Name="rotaIso" Type="WORD" ArraySize="9" Comment="Valvulas que isolam cada rota (VA-09/10 e entradas de prensa ligadas aos nos usados e fora da rota): devem estar fechadas" />
      <VarDeclaration ID="78C3653EF8BA0354" Name="mIso" Type="WORD" />
      <VarDeclaration ID="24C6139B30661823" Name="rotaOk" Type="BOOL" ArraySize="3" />
      <VarDeclaration ID="089F0B3F7CEB344F" Name="mCulpa" Type="WORD" />
      <VarDeclaration ID="184301F75A853A35" Name="vHold" Type="REAL" ArraySize="3" Comment="Ultima velocidade do PID valida" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Estado inicial" x="1500" y="640" />
      <ECState Name="EXEC" Comment="Executa a logica; o algoritmo decide quais eventos saem" x="1500" y="1100">
        <ECAction Algorithm="algAlimentacao" Output="INITO" />
        <ECAction Output="CNF_BO" />
        <ECAction Output="CNF_VA" />
        <ECAction Output="CNF_AD" />
        <ECAction Output="CNF_PP" />
        <ECAction Output="CNF_PID" />
        <ECAction Output="CNF_SV" />
        <ECAction Output="CNF_PERS" />
        <ECAction Output="CNF" />
        <ECAction Output="CNF_HMI" />
      </ECState>
      <ECTransition Source="START" Destination="EXEC" Condition="INIT OR REQ_AD OR REQ_BO OR REQ_VA OR REQ_FT OR REQ_PID OR REQ_PP OR REQ_TQ OR REQ_PAINEL OR REQ_REM1 OR REQ_REM2 OR REQ_DJ OR REQ_PARA OR REQ_CMD OR REQ_SV OR REQ_PERS OR REQ_RESET OR REQ_RESET_PROC OR TICK" x="1580" y="860" />
      <ECTransition Source="EXEC" Destination="START" Condition="1" x="1420" y="860" />
    </ECC>
    <Algorithm Name="algAlimentacao" Comment="Logica completa (um unico algoritmo)">
      <ST><![CDATA[(* =====================================================================
   basicAlimentacaoPrensas v1.0 - alimentacao das prensas C-Press (900)
   Logica aprovada pelo usuario (out/2026):
   - a prensa nao pede lodo: o CLP liga o ciclo remoto da prensa, abre a
     rota do barrilete (tabela 5 da EF), confirma as valvulas abertas, parte
     a bomba e controla a vazao da linha da prensa por PID (FT da linha,
     setpoint em m3/h do operador); a prensa liga sozinha pelo nivel do
     floculador (LT1-L agitador, LT1-O prensa);
   - LT1 so como protecao: suspende a bomba acima de stpNivelSuspende e
     retoma abaixo de stpNivelRetoma; tanque de estocagem baixo tambem
     suspende;
   - uma bomba por prensa: BO-01 -> AD-01 e BO-03 -> AD-02 (titulares),
     BO-02 reserva comum; rotas que ocupam um no do barrilete ja em uso nao
     sao permitidas (prensas juntas sem misturar fluxo); rodizio na partida
     (BO-02 assume quando a titular tem stpDifHorasBO horas a mais);
     bomba que falha e substituida (a prensa reinicia com outra bomba);
   - FT em falha durante a alimentacao: velocidade mantida + aviso;
   - preparador de polimero com ciclo ligado enquanto houver prensa ativa;
   - booster e solenoides so em manual (SV pela IHM);
   - emergencia do PCM LODO (contato NA: TRUE = emergencia, confirmado em campo) para
     tudo; disjuntores de equipamentos existentes desligados geram aviso.
   ===================================================================== *)

INITO    := FALSE;
CNF_BO   := FALSE;
CNF_VA   := FALSE;
CNF_AD   := FALSE;
CNF_PP   := FALSE;
CNF_PID  := FALSE;
CNF_SV   := FALSE;
CNF_PERS := FALSE;
CNF      := FALSE;
CNF_HMI  := FALSE;

IF REQ_REM2 THEN
    rem2Recebido := TRUE;
END_IF;
IF REQ_PAINEL THEN
    pnRecebido := TRUE;
END_IF;
IF REQ_DJ THEN
    djRecebido := TRUE;
END_IF;
IF INIT THEN
    (* rotas: indice = bomba*3 + prensa (bomba 0 = BO-01, prensa 0 = AD-01); bits: 0 VA-06, 1 VA-07, 2 VA-08, 3 VA-09, 4 VA-10, 5 VA-11, 6 VA-12, 7 VA-13 *)
    rotaVal[0] := 16#0021; rotaNo[0] := 16#0001;   (* BO-01 -> AD-01: VA-06, VA-11 *)
    rotaVal[1] := 16#0099; rotaNo[1] := 16#0007;   (* BO-01 -> AD-02: VA-06, VA-09, VA-10, VA-13 *)
    rotaVal[2] := 16#0059; rotaNo[2] := 16#0007;   (* BO-01 -> AD-03: VA-06, VA-09, VA-10, VA-12 *)
    rotaVal[3] := 16#002A; rotaNo[3] := 16#0003;   (* BO-02 -> AD-01: VA-07, VA-09, VA-11 *)
    rotaVal[4] := 16#0092; rotaNo[4] := 16#0006;   (* BO-02 -> AD-02: VA-07, VA-10, VA-13 *)
    rotaVal[5] := 16#0052; rotaNo[5] := 16#0006;   (* BO-02 -> AD-03: VA-07, VA-10, VA-12 *)
    rotaVal[6] := 16#003C; rotaNo[6] := 16#0007;   (* BO-03 -> AD-01: VA-08, VA-10, VA-09, VA-11 *)
    rotaVal[7] := 16#0084; rotaNo[7] := 16#0004;   (* BO-03 -> AD-02: VA-08, VA-13 *)
    rotaVal[8] := 16#0044; rotaNo[8] := 16#0004;   (* BO-03 -> AD-03: VA-08, VA-12 *)
    (* isolamento: interligacoes dos nos (VA-09, VA-10) e entradas das outras prensas (VA-11, VA-12, VA-13) ligadas aos nos da rota
       e fora dela; o recalque de bomba parada (VA-06/07/08) nao entra: bomba helicoidal parada nao deixa passar fluxo *)
    rotaIso[0] := 16#0008; rotaIso[1] := 16#0060; rotaIso[2] := 16#00A0;
    rotaIso[3] := 16#0010; rotaIso[4] := 16#0048; rotaIso[5] := 16#0088;
    rotaIso[6] := 16#00C0; rotaIso[7] := 16#0050; rotaIso[8] := 16#0090;
    pref[0] := 0; pref[1] := 1; pref[2] := 2;      (* AD-01: BO-01, BO-02, BO-03 *)
    pref[3] := 2; pref[4] := 1; pref[5] := 0;      (* AD-02: BO-03, BO-02, BO-01 *)
    pref[6] := 2; pref[7] := 1; pref[8] := 0;      (* AD-03: BO-03, BO-02, BO-01 *)
    bitv[0] := 16#0001; bitv[1] := 16#0002; bitv[2] := 16#0004; bitv[3] := 16#0008;
    bitv[4] := 16#0010; bitv[5] := 16#0020; bitv[6] := 16#0040; bitv[7] := 16#0080;
    bitd[0] := 16#00000001; bitd[1] := 16#00000002; bitd[2] := 16#00000004; bitd[3] := 16#00000008; bitd[4] := 16#00000010; bitd[5] := 16#00000020; bitd[6] := 16#00000040; bitd[7] := 16#00000080;
    bitd[8] := 16#00000100; bitd[9] := 16#00000200; bitd[10] := 16#00000400; bitd[11] := 16#00000800; bitd[12] := 16#00001000; bitd[13] := 16#00002000; bitd[14] := 16#00004000; bitd[15] := 16#00008000;
    FOR k := 0 TO 2 DO
        est[k] := 0; bomba[k] := -1; uso[k] := 0;
    END_FOR;
    initDone := TRUE;
    INITO := TRUE;
END_IF;
IF NOT initDone THEN
    RETURN;
END_IF;

(* ---- 1. Entradas em tabelas ---- *)
aDsp[0] := ad1Disp; adF[0] := ad1Func; adN[0] := ad1Nivel;
aDsp[1] := ad2Disp; adF[1] := ad2Func; adN[1] := ad2Nivel;
aDsp[2] := ad3Disp; adF[2] := ad3Func; adN[2] := ad3Nivel;
ftF[0] := ft1Falha OR NOT ft1Hab; ftF[1] := ft2Falha OR NOT ft2Hab; ftF[2] := ft3Falha OR NOT ft3Hab;   (* FT desabilitado = sem medicao: PID em manual *)
pOut[0] := pid1Out / 0.6; pOut[1] := pid2Out / 0.6; pOut[2] := pid3Out / 0.6;   (* PIDs em Hz -> % das bombas *)
sp[0] := stpVazao1; sp[1] := stpVazao2; sp[2] := stpVazao3;
ped[0] := hmiAD1; ped[1] := hmiAD2; ped[2] := hmiAD3;
boD[0] := bo1Disp; boL[0] := bo1Lig; boF[0] := bo1Falha;
boD[1] := bo2Disp; boL[1] := bo2Lig; boF[1] := bo2Falha;
boD[2] := bo3Disp; boL[2] := bo3Lig; boF[2] := bo3Falha;
vaA[0] := va06Aberta; vaA[1] := va07Aberta; vaA[2] := va08Aberta; vaA[3] := va09Aberta;
vaA[4] := va10Aberta; vaA[5] := va11Aberta; vaA[6] := va12Aberta; vaA[7] := va13Aberta;
vaF[0] := va06Fechada; vaF[1] := va07Fechada; vaF[2] := va08Fechada; vaF[3] := va09Fechada;
vaF[4] := va10Fechada; vaF[5] := va11Fechada; vaF[6] := va12Fechada; vaF[7] := va13Fechada;
vaD[0] := va06Disp; vaD[1] := va07Disp; vaD[2] := va08Disp; vaD[3] := va09Disp;
vaD[4] := va10Disp; vaD[5] := va11Disp; vaD[6] := va12Disp; vaD[7] := va13Disp;
mAbertas := 16#0000;
mFechadas := 16#0040;                      (* VA-12 (segunda fase, sem comunicacao) considerada fechada *)
mInd := 16#0000;
mBloq := 16#0000;
FOR v := 0 TO 7 DO
    IF vaA[v] THEN mAbertas := mAbertas OR bitv[v]; END_IF;
    IF vaF[v] THEN mFechadas := mFechadas OR bitv[v]; END_IF;
    IF NOT vaD[v] OR vaBloq[v] THEN mInd := mInd OR bitv[v]; END_IF;
    IF vaBloq[v] THEN mBloq := mBloq OR bitv[v]; END_IF;
END_FOR;

(* ---- 2. Painel: emergencia (NA), remotas e disjuntores ---- *)
stsRemota1Ok := pnRemota1Ok;
stsRemota2Ok := rem2Recebido AND (pnRemota2Conexao = 1);
stsFalhaRemota := NOT pnRemota1Ok OR NOT stsRemota2Ok;
emerg := pnRecebido AND pnRemota1Ok AND pnEmergencia;
stsEmergencia := emerg;
stsMonitTrafo := pnMonitTrafo;
stsMonitFonte := pnMonitFonte;
d1 := 16#00000000;
IF djPCE THEN d1 := d1 OR bitd[0]; END_IF;
IF djPCM THEN d1 := d1 OR bitd[1]; END_IF;
IF djSO01 THEN d1 := d1 OR bitd[2]; END_IF;
IF djSO02 THEN d1 := d1 OR bitd[3]; END_IF;
IF djAD01 THEN d1 := d1 OR bitd[4]; END_IF;
IF djAD02 THEN d1 := d1 OR bitd[5]; END_IF;
IF djAD03 THEN d1 := d1 OR bitd[6]; END_IF;
IF djPP01 THEN d1 := d1 OR bitd[7]; END_IF;
IF djMN01 THEN d1 := d1 OR bitd[8]; END_IF;
IF djMN02 THEN d1 := d1 OR bitd[9]; END_IF;
IF djMN03 THEN d1 := d1 OR bitd[10]; END_IF;
IF djMN04 THEN d1 := d1 OR bitd[11]; END_IF;
IF djMN05 THEN d1 := d1 OR bitd[12]; END_IF;
IF djBO01 THEN d1 := d1 OR bitd[13]; END_IF;
IF djBO02 THEN d1 := d1 OR bitd[14]; END_IF;
IF djBO03 THEN d1 := d1 OR bitd[15]; END_IF;
d2 := 16#00000000;
IF djBR01 THEN d2 := d2 OR bitd[0]; END_IF;
IF djBR02 THEN d2 := d2 OR bitd[1]; END_IF;
IF djVA01 THEN d2 := d2 OR bitd[2]; END_IF;
IF djVA02 THEN d2 := d2 OR bitd[3]; END_IF;
IF djVE01 THEN d2 := d2 OR bitd[4]; END_IF;
IF djVE02 THEN d2 := d2 OR bitd[5]; END_IF;
IF djVA06 THEN d2 := d2 OR bitd[6]; END_IF;
IF djVA07 THEN d2 := d2 OR bitd[7]; END_IF;
IF djVA08 THEN d2 := d2 OR bitd[8]; END_IF;
IF djVA09 THEN d2 := d2 OR bitd[9]; END_IF;
IF djVA10 THEN d2 := d2 OR bitd[10]; END_IF;
IF djVA11 THEN d2 := d2 OR bitd[11]; END_IF;
IF djVA12 THEN d2 := d2 OR bitd[12]; END_IF;
IF djVA13 THEN d2 := d2 OR bitd[13]; END_IF;
IF djVB03 THEN d2 := d2 OR bitd[14]; END_IF;
IF djVB04 THEN d2 := d2 OR bitd[15]; END_IF;
stsDj1 := DWORD_TO_DINT(d1);
stsDj2 := DWORD_TO_DINT(d2);
stsAvisoDisjuntor := djRecebido AND pnRemota1Ok AND (((d1 AND 16#0000FBBE) <> 16#0000FBBE) OR ((d2 AND 16#0000EFCF) <> 16#0000EFCF));

(* ---- 3. Reset ---- *)
IF (REQ_RESET AND hmiReset) OR (REQ_RESET_PROC AND cmdResetFalhas) THEN
    FOR k := 0 TO 2 DO
        alRota[k] := FALSE; avSemP[k] := FALSE; tSemP[k] := 0;
    END_FOR;
    FOR v := 0 TO 7 DO
        vaBloq[v] := FALSE;
    END_FOR;
END_IF;

(* ---- 4. Horimetro das bombas (minutos, persistente) ---- *)
IF REQ_PERS THEN
    IF perMin1 > minB[0] THEN minB[0] := perMin1; END_IF;
    IF perMin2 > minB[1] THEN minB[1] := perMin2; END_IF;
    IF perMin3 > minB[2] THEN minB[2] := perMin3; END_IF;
END_IF;
IF TICK THEN
    FOR b := 0 TO 2 DO
        IF boL[b] THEN
            segB[b] := segB[b] + 1;
            IF segB[b] >= 60 THEN
                segB[b] := 0;
                minB[b] := minB[b] + uUm;
                sujo := TRUE;
            END_IF;
        END_IF;
    END_FOR;
    tGrava := tGrava + 1;
    IF sujo AND (tGrava >= 600) THEN
        CNF_PERS := TRUE;
    END_IF;
END_IF;
IF CNF_PERS THEN
    perMin1Out := minB[0]; perMin2Out := minB[1]; perMin3Out := minB[2];
    sujo := FALSE; tGrava := 0;
END_IF;

(* ---- 5. Maquina de estados de cada prensa ---- *)
(* nos ocupados pelas prensas ativas *)
ocup := 16#0000;
FOR k := 0 TO 2 DO
    IF (est[k] > 0) AND (bomba[k] >= 0) THEN
        ocup := ocup OR rotaNo[bomba[k] * 3 + k];
    END_IF;
END_FOR;
FOR k := 0 TO 2 DO
    IF TICK AND (tEst[k] < 32000) THEN
        tEst[k] := tEst[k] + 1;
    END_IF;
    pode := ped[k] AND aDsp[k] AND (sp[k] > 0.0) AND NOT emerg;
    (* rota aberta e isolada agora (intertravamento da bomba) *)
    rotaOk[k] := FALSE;
    IF bomba[k] >= 0 THEN
        mRota := rotaVal[bomba[k] * 3 + k];
        mIso := rotaIso[bomba[k] * 3 + k];
        rotaOk[k] := ((mAbertas AND mRota) = mRota) AND ((mFechadas AND mIso) = mIso);
    END_IF;
    (* floculador cheio com histerese (0 = protecao desligada) *)
    IF stpNivelSuspende <= 0.0 THEN
        suspF[k] := FALSE;
    ELSIF adN[k] >= stpNivelSuspende THEN
        suspF[k] := TRUE;
    ELSIF adN[k] <= MIN(stpNivelRetoma, stpNivelSuspende) THEN
        suspF[k] := FALSE;
    END_IF;
    susp := suspF[k] OR tqNivelBaixo;
    b := bomba[k];
    semB[k] := FALSE;
    CASE est[k] OF
    0:  IF pode THEN
            (* ordem das bombas: titular, reserva, outra; rodizio: BO-02 primeiro se a titular tem horas a mais *)
            ordem[0] := pref[k * 3]; ordem[1] := pref[k * 3 + 1]; ordem[2] := pref[k * 3 + 2];
            dHoras := INT_TO_DINT(stpDifHorasBO) * 60;
            IF (stpDifHorasBO > 0) AND (ordem[0] <> 1) AND
               (UDINT_TO_DINT(minB[ordem[0]]) >= UDINT_TO_DINT(minB[1]) + dHoras) THEN
                ordem[1] := ordem[0];
                ordem[0] := 1;
            END_IF;
            achou := FALSE;
            FOR i := 0 TO 2 DO
                bb := ordem[i];
                IF NOT achou AND boD[bb] AND (uso[bb] = 0) AND ((ocup AND rotaNo[bb * 3 + k]) = 16#0000) AND
                   ((rotaVal[bb * 3 + k] AND mInd) = 16#0000) AND
                   ((rotaIso[bb * 3 + k] AND mInd AND NOT mFechadas) = 16#0000) THEN
                    achou := TRUE;
                    bomba[k] := bb;
                    uso[bb] := k + 1;
                    ocup := ocup OR rotaNo[bb * 3 + k];
                    est[k] := 1;
                    tEst[k] := 0;
                END_IF;
            END_FOR;
            semB[k] := NOT achou;
        END_IF;
    1:  (* abrindo as valvulas da rota (e fechando as de isolamento) *)
        IF NOT pode THEN
            est[k] := 5; tEst[k] := 0;
        ELSIF rotaOk[k] THEN
            est[k] := 2; tEst[k] := 0;
        ELSIF (stpTempoValvulas > 0) AND (tEst[k] >= stpTempoValvulas) THEN
            (* valvulas que nao abriram ou nao fecharam ficam bloqueadas; a prensa tenta outra rota *)
            mCulpa := (mRota AND NOT mAbertas) OR (mIso AND NOT mFechadas);
            FOR v := 0 TO 7 DO
                IF (mCulpa AND bitv[v]) <> 16#0000 THEN vaBloq[v] := TRUE; END_IF;
            END_FOR;
            alRota[k] := TRUE;
            est[k] := 5; tEst[k] := 0;
        END_IF;
    2:  (* partindo a bomba (velocidade de partida) *)
        IF NOT pode OR NOT boD[b] OR boF[b] THEN
            est[k] := 5; tEst[k] := 0;
        ELSIF susp THEN
            est[k] := 4; tEst[k] := 0;
        ELSIF boL[b] THEN
            est[k] := 3; tEst[k] := 0;
        END_IF;
    3:  (* alimentando (PID) *)
        IF NOT pode OR NOT boD[b] OR boF[b] THEN
            est[k] := 5; tEst[k] := 0;
        ELSIF susp THEN
            est[k] := 4; tEst[k] := 0;
        END_IF;
    4:  (* suspenso: bomba parada, valvulas abertas *)
        IF NOT pode OR NOT boD[b] OR boF[b] THEN
            est[k] := 5; tEst[k] := 0;
        ELSIF NOT susp THEN
            est[k] := 2; tEst[k] := 0;
        END_IF;
    5:  (* parando: espera a bomba parar e libera a rota *)
        IF NOT boL[b] THEN                 (* so libera a rota com a bomba parada: valvulas nunca fecham contra a bomba *)
            uso[b] := 0;
            bomba[k] := -1;
            est[k] := 0; tEst[k] := 0;
        END_IF;
    END_CASE;
    (* rota perdida com a bomba em uso: 3 s para confirmar, bloqueia as culpadas e tenta outra rota *)
    IF (est[k] >= 2) AND (est[k] <= 4) AND NOT rotaOk[k] THEN
        IF TICK THEN
            tPerda[k] := tPerda[k] + 1;
        END_IF;
        IF tPerda[k] >= 3 THEN
            mCulpa := (mRota AND NOT mAbertas) OR (mIso AND NOT mFechadas);
            FOR v := 0 TO 7 DO
                IF (mCulpa AND bitv[v]) <> 16#0000 THEN vaBloq[v] := TRUE; END_IF;
            END_FOR;
            alRota[k] := TRUE;
            est[k] := 5; tEst[k] := 0; tPerda[k] := 0;
        END_IF;
    ELSE
        tPerda[k] := 0;
    END_IF;
    (* prensa nao partiu *)
    IF ((est[k] = 3) OR (est[k] = 4)) AND NOT adF[k] THEN
        IF TICK AND (tSemP[k] < 32000) THEN
            tSemP[k] := tSemP[k] + 1;
        END_IF;
        IF (stpTempoSemPartir > 0) AND (tSemP[k] >= stpTempoSemPartir * 60) THEN
            avSemP[k] := TRUE;
        END_IF;
    ELSE
        tSemP[k] := 0;
    END_IF;
    (* motivo para a IHM *)
    IF emerg AND ped[k] THEN mot[k] := 5;
    ELSIF ped[k] AND NOT aDsp[k] THEN mot[k] := 1;
    ELSIF ped[k] AND (sp[k] <= 0.0) THEN mot[k] := 2;
    ELSIF semB[k] THEN mot[k] := 3;
    ELSIF (est[k] = 4) AND suspF[k] THEN mot[k] := 6;
    ELSIF (est[k] = 4) AND tqNivelBaixo THEN mot[k] := 7;
    ELSIF (est[k] = 3) AND ftF[k] THEN mot[k] := 8;
    ELSIF avSemP[k] THEN mot[k] := 9;
    ELSIF alRota[k] THEN mot[k] := 4;
    ELSE mot[k] := 0;
    END_IF;
END_FOR;

(* ---- 6. Saidas: valvulas, bombas, PID, prensas, preparador ---- *)
mAbr := 16#0000;
FOR k := 0 TO 2 DO
    IF (est[k] >= 1) AND (bomba[k] >= 0) THEN
        mAbr := mAbr OR rotaVal[bomba[k] * 3 + k];
    END_IF;
END_FOR;
FOR v := 0 TO 7 DO
    vaCmd[v] := (mAbr AND bitv[v]) <> 16#0000;
END_FOR;
abr06 := vaCmd[0]; abr07 := vaCmd[1]; abr08 := vaCmd[2]; abr09 := vaCmd[3];
abr10 := vaCmd[4]; abr11 := vaCmd[5]; abr12 := vaCmd[6]; abr13 := vaCmd[7];
fec06 := NOT vaCmd[0]; fec07 := NOT vaCmd[1]; fec08 := NOT vaCmd[2]; fec09 := NOT vaCmd[3];
fec10 := NOT vaCmd[4]; fec11 := NOT vaCmd[5]; fec12 := NOT vaCmd[6]; fec13 := NOT vaCmd[7];
stsValvulasCmd := WORD_TO_INT(mAbr);
stsValvulasBloq := WORD_TO_INT(mBloq);
FOR b := 0 TO 2 DO
    cB[b] := FALSE;
    vB[b] := 0.0;
END_FOR;
FOR k := 0 TO 2 DO
    pMod[k] := (est[k] = 3) AND NOT ftF[k];
    IF pMod[k] THEN
        vHold[k] := pOut[k];
    END_IF;
    IF est[k] = 3 THEN
        pPre[k] := vHold[k];               (* FT em falha: mantem a ultima velocidade valida *)
    ELSE
        pPre[k] := stpVelInicial / 0.6;    (* IHM/SCADA em Hz -> % *)
        vHold[k] := stpVelInicial / 0.6;
    END_IF;
    b := bomba[k];
    IF (b >= 0) AND ((est[k] = 2) OR (est[k] = 3)) AND rotaOk[k] THEN   (* bomba so com a rota aberta e isolada *)
        cB[b] := TRUE;
        vB[b] := pOut[k];
    END_IF;
    cic[k] := est[k] >= 1;
END_FOR;
cmdBO1 := cB[0]; velBO1 := vB[0];
cmdBO2 := cB[1]; velBO2 := vB[1];
cmdBO3 := cB[2]; velBO3 := vB[2];
emergOut := emerg;
pid1Modo := pMod[0]; pid1Preset := pPre[0] * 0.6;   (* preset dos PIDs em Hz *)
pid2Modo := pMod[1]; pid2Preset := pPre[1] * 0.6;
pid3Modo := pMod[2]; pid3Preset := pPre[2] * 0.6;
ciclo1 := cic[0]; ciclo2 := cic[1]; ciclo3 := cic[2];
cicloPP := cic[0] OR cic[1] OR cic[2];
stsCicloPP := cicloPP;
nMod := 0;
IF pMod[0] THEN nMod := nMod + 1; END_IF;
IF pMod[1] THEN nMod := nMod + 2; END_IF;
IF pMod[2] THEN nMod := nMod + 4; END_IF;
nCic := 0;
IF cic[0] THEN nCic := nCic + 1; END_IF;
IF cic[1] THEN nCic := nCic + 2; END_IF;
IF cic[2] THEN nCic := nCic + 4; END_IF;
IF TICK THEN
    tBo := tBo + 1;
END_IF;
IF primeiro OR TICK OR (nMod <> oldMod) THEN
    CNF_PID := TRUE;                       (* tracking a cada 1 s e na troca de modo *)
    oldMod := nMod;
END_IF;
nBo := 0;
IF cB[0] THEN nBo := nBo + 1; END_IF;
IF cB[1] THEN nBo := nBo + 2; END_IF;
IF cB[2] THEN nBo := nBo + 4; END_IF;
IF emerg THEN nBo := nBo + 8; END_IF;
IF primeiro OR TICK OR (nCic <> oldCic) OR (nBo <> oldBo) THEN
    CNF_BO := TRUE;                        (* velocidade a cada 1 s; comando e emergencia na hora *)
    oldBo := nBo;
END_IF;
IF primeiro OR (mAbr <> oldVa) OR (tBo >= 10) THEN
    CNF_VA := TRUE;
    oldVa := mAbr;
END_IF;
IF primeiro OR (nCic <> oldCic) OR (tBo >= 10) THEN
    CNF_AD := TRUE;
    CNF_PP := TRUE;
    oldCic := nCic;
END_IF;
IF tBo >= 10 THEN
    tBo := 0;
END_IF;

(* ---- 7. Solenoides (so manual; fecham na emergencia) ---- *)
IF emerg THEN
    sv01 := FALSE; sv02 := FALSE; sv03 := FALSE; sv04 := FALSE; sv06 := FALSE; sv08 := FALSE;
ELSIF REQ_SV THEN
    sv01 := hmiSV01; sv02 := hmiSV02; sv03 := hmiSV03; sv04 := hmiSV04; sv06 := hmiSV06; sv08 := hmiSV08;
END_IF;
wSv := 0;
IF sv01 THEN wSv := wSv + 1; END_IF;
IF sv02 THEN wSv := wSv + 2; END_IF;
IF sv03 THEN wSv := wSv + 4; END_IF;
IF sv04 THEN wSv := wSv + 8; END_IF;
IF sv06 THEN wSv := wSv + 16; END_IF;
IF sv08 THEN wSv := wSv + 32; END_IF;
stsSV := wSv;
IF primeiro OR (wSv <> oldSv) THEN
    CNF_SV := TRUE;
    oldSv := wSv;
END_IF;

(* ---- 8. Status ---- *)
stsEst1 := est[0]; stsEst2 := est[1]; stsEst3 := est[2];
stsMotivo1 := mot[0]; stsMotivo2 := mot[1]; stsMotivo3 := mot[2];
stsBomba1 := bomba[0] + 1; stsBomba2 := bomba[1] + 1; stsBomba3 := bomba[2] + 1;
stsAlimentando1 := est[0] = 3; stsAlimentando2 := est[1] = 3; stsAlimentando3 := est[2] = 3;
stsFalhaRota1 := alRota[0]; stsFalhaRota2 := alRota[1]; stsFalhaRota3 := alRota[2];
stsSemPartir1 := avSemP[0]; stsSemPartir2 := avSemP[1]; stsSemPartir3 := avSemP[2];
stsHorasBO1 := UDINT_TO_DINT(minB[0]) / 60; stsHorasBO2 := UDINT_TO_DINT(minB[1]) / 60; stsHorasBO3 := UDINT_TO_DINT(minB[2]) / 60;
stsUsoBO1 := uso[0]; stsUsoBO2 := uso[1]; stsUsoBO3 := uso[2];
stsSemBomba := semB[0] OR semB[1] OR semB[2];
stsFalhaRota := alRota[0] OR alRota[1] OR alRota[2];
stsSemPartir := avSemP[0] OR avSemP[1] OR avSemP[2];
stsFtFalha := ((est[0] = 3) AND ftF[0]) OR ((est[1] = 3) AND ftF[1]) OR ((est[2] = 3) AND ftF[2]);
stsAlarme := emerg OR stsFalhaRemota OR stsAvisoDisjuntor OR stsSemBomba OR stsFalhaRota OR stsSemPartir OR stsFtFalha;
sig := INT_TO_DINT(est[0] + est[1] * 8 + est[2] * 64) + INT_TO_DINT(mot[0] + mot[1] * 16 + mot[2] * 256) * 512;
IF stsAlarme THEN sig := sig + 1; END_IF;
IF primeiro OR TICK OR REQ_PARA OR REQ_CMD OR REQ_RESET OR (sig <> oldSig) THEN
    CNF_HMI := TRUE;
END_IF;
IF primeiro OR TICK OR (sig <> oldSig) THEN
    CNF := TRUE;
END_IF;
oldSig := sig;
primeiro := FALSE;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
