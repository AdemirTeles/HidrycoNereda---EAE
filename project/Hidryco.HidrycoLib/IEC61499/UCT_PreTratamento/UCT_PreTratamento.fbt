<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="aa59e0e6-ea94-4040-a5c0-0e7aa7c5cdd7" Name="UCT_PreTratamento" Format="2.0" Comment="UCT Fast de tratamento preliminar + bomba de gordura - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Attribute Name="HMI.Alias" Value="" />
  <Attribute Name="Configuration.FB.IDCounter" Value="32" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.4" Author="Hidryco" Date="16/10/2026" Remarks="1.4: simbolo sGordura (tanque de gordura e valvula de lavagem) para a tela do pre-tratamento. 1.3: sSkid reorganizado (tubos atras, equipamentos alinhados as portas), SymbolSize nos simbolos. 1.2: simbolo sSkid (desenho ISA-101 do skid, com os simbolos dos equipamentos e da bomba de gordura). 1.0: UCT Fast (tratamento preliminar, memorial PR-809) por Modbus TCP. Leitura pela configuracao de hardware (MODBUSGENTCPS + MODBUSRREG8/2 em 40005, 40013, 40081, 40101, 40116, 40127, 40136, 40151, 40161, 40230, 40500, 40508, 40516) nos symlinks ${PATH}mbW005..mbH517 (INT) e connStatusInt em ${PATH}mbConexao; escrita por MODBUSWREG1 em requestwrite nos symlinks ${PATH}mbEscW005..mbEscW017 e ${PATH}mbEscV101..mbEscV161 (INT), so quando o operador comanda. Equipamentos (sub-CATs UCT_Equipamento): Peneira, Bomba1, Bomba2, Valvula1, Valvula2, Compressor, Raspador, Rosca1, Rosca2. Disponibilidade pelo AND editavel (AND_UCT_OK e AND_DISPONIVEL); cadeia antHabilitada/antDisponivel -&gt; stsBloqueioEEE. Bomba de gordura 200-BR-0x (Motor_Generico BombaGordura: E/S por ${PATH}BombaGordura.stsLocal/... e ATV: ComStatus direto em ${PATH}BombaGordura.stsFalhaComunicacao, o motor inverte) e valvula de lavagem ${PATH}cmdValvulaLavagem (BOOL)." />
  <InterfaceList>
    <EventInputs>
      <Event ID="0B595E2D755381E4" Name="REQ" Comment="Atualizacao do processo">
        <With Var="stsEmergencia" />
        <With Var="geradorConectado" />
        <With Var="geradorHabilita" />
        <With Var="stsGerador" />
        <With Var="antHabilitada" />
        <With Var="antDisponivel" />
      </Event>
      <Event ID="72C647E766878D0B" Name="E_RESET_FALHAS" Comment="Reset pelo processo (UCT e bomba de gordura) com cmdResetFalhas = TRUE">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="5A6CC858EDC95420" Name="CNF" Comment="Disponibilidade, cadeia das UCTs e estados (so na mudanca)">
        <With Var="stsDisponivel" />
        <With Var="stsAlgumaHabilitada" />
        <With Var="stsAlgumaDisponivel" />
        <With Var="stsBloqueioEEE" />
        <With Var="stsFalhaComunicacao" />
        <With Var="stsEmergenciaUCT" />
        <With Var="stsNivelAltoGordura" />
        <With Var="stsAlarme" />
        <With Var="stsBombaGorduraLigada" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="C5903F2E5D830F7B" Name="stsEmergencia" Type="BOOL" Comment="Emergencia pelo processo: retira o comando da bomba de gordura e fecha a valvula de lavagem" />
      <VarDeclaration ID="1FBC57FAC80B15F5" Name="geradorConectado" Type="BOOL" InitialValue="TRUE" Comment="A bomba de gordura pode ser alimentada pelo gerador" />
      <VarDeclaration ID="D205F407BC981FB4" Name="geradorHabilita" Type="BOOL" Comment="Bomba de gordura liberada para operar com a planta no gerador (HAB_UCT_200_0x do CAT Subestacao)" />
      <VarDeclaration ID="2C19134423AEFFAA" Name="stsGerador" Type="BOOL" Comment="Planta alimentada pelo gerador" />
      <VarDeclaration ID="3F3598C544A33E47" Name="antHabilitada" Type="BOOL" Comment="Cadeia: alguma UCT anterior habilitada (stsAlgumaHabilitada da UCT anterior)" />
      <VarDeclaration ID="BFB78C58CA08F906" Name="antDisponivel" Type="BOOL" Comment="Cadeia: alguma UCT anterior disponivel (stsAlgumaDisponivel da UCT anterior)" />
      <VarDeclaration ID="C1E015E41EC5467F" Name="cmdResetFalhas" Type="BOOL" Comment="TRUE = reset (com o evento E_RESET_FALHAS)" />
      <VarDeclaration ID="ECF576962B69CE1F" Name="cfgInstalada" Type="BOOL" InitialValue="TRUE" Comment="FALSE = UCT ainda nao existe em campo (sem comunicacao, sem alarmes, fora do bloqueio da EEE)" />
      <VarDeclaration ID="CEE0293F869BED62" Name="cfgTempoCom" Type="UINT" InitialValue="10" Comment="Tempo (s) sem comunicacao com a UCT para confirmar a falha" />
      <VarDeclaration ID="42A842293EF3D57E" Name="cfgTempoReset" Type="UINT" InitialValue="2" Comment="Tempo (s) do pulso de reset escrito na UCT (40005.3)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="4C8FFD598073F118" Name="stsDisponivel" Type="BOOL" Comment="UCT disponivel (saida do AND)" />
      <VarDeclaration ID="1F8CA54F12D8796B" Name="stsAlgumaHabilitada" Type="BOOL" Comment="Esta UCT ou alguma anterior habilitada" />
      <VarDeclaration ID="A737D1113B918FC6" Name="stsAlgumaDisponivel" Type="BOOL" Comment="Esta UCT ou alguma anterior disponivel" />
      <VarDeclaration ID="6948495C8744310C" Name="stsBloqueioEEE" Type="BOOL" Comment="Bloqueio do automatico da EEE Bruto: ha UCT habilitada e nenhuma disponivel" />
      <VarDeclaration ID="C537A53640EEDFDE" Name="stsFalhaComunicacao" Type="BOOL" Comment="Falha de comunicacao com a UCT" />
      <VarDeclaration ID="D1F6B6FFF799FD86" Name="stsEmergenciaUCT" Type="BOOL" Comment="Emergencia acionada na UCT" />
      <VarDeclaration ID="3C094C85CA401B59" Name="stsNivelAltoGordura" Type="BOOL" Comment="Nivel alto do tanque de gordura (UCT)" />
      <VarDeclaration ID="A3F697B8D5D1E927" Name="stsAlarme" Type="BOOL" Comment="Algum alarme da UCT" />
      <VarDeclaration ID="3235AC6565BE9BE9" Name="stsBombaGorduraLigada" Type="BOOL" Comment="Bomba de gordura ligada" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
