<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="61a9092d-9d4c-1099-bf9a-6e80dae54faf" Name="UV_Trojan" Comment="Sistema UV Trojan UV3000Plus (monitoracao Modbus TCP) - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="19/10/2026" Remarks="1.0: Trojan UV3000Plus (SCC M580, servidor Modbus TCP, CP141200010 p.606-611). Campo por symlink ${PATH}: leitura mbR41001..mbR41191 (INT, registro = nome), mbConexao (connStatusInt, 1 = online); escrita mbW40006 (heartbeat bit 1). Somente monitoracao: o SCC nao aceita comandos por rede." />
  <InterfaceList>
    <EventOutputs>
      <Event ID="41148E14CCAE49D5" Name="CNF" Comment="Status (alarmes na hora, valores a cada 1 s)">
        <With Var="stsComunicacaoOK" />
        <With Var="stsAlarmeCritico" />
        <With Var="stsCanal1Operando" />
        <With Var="stsCanal2Operando" />
        <With Var="stsCanaisInsuficientes" />
        <With Var="stsDoseBaixa" />
        <With Var="stsVazao" />
        <With Var="stsDose" />
        <With Var="stsUVT" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="BDB67EB10EE3CF24" Name="cfgTimeoutHeartbeat" Type="INT" InitialValue="10" Comment="Tempo sem alternar o heartbeat do SCC para falha de comunicacao (s)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="8A986F32247F8461" Name="stsComunicacaoOK" Type="BOOL" Comment="Comunicacao Modbus e heartbeat do SCC OK" />
      <VarDeclaration ID="EDFBC67855FC1BF4" Name="stsAlarmeCritico" Type="BOOL" Comment="Alarme comum critico (41001.2)" />
      <VarDeclaration ID="B5E6F2B1B4A7F74D" Name="stsCanal1Operando" Type="BOOL" Comment="Canal 1 em operacao" />
      <VarDeclaration ID="2373201554B21091" Name="stsCanal2Operando" Type="BOOL" Comment="Canal 2 em operacao" />
      <VarDeclaration ID="53F24ADA26C29448" Name="stsCanaisInsuficientes" Type="BOOL" Comment="Canais saudaveis insuficientes (41003.1)" />
      <VarDeclaration ID="E73DB33437F0D160" Name="stsDoseBaixa" Type="BOOL" Comment="Dose abaixo do alvo (41003.0)" />
      <VarDeclaration ID="706F0B2F3146D1E8" Name="stsVazao" Type="REAL" Comment="Vazao do sistema no SCC (41005 x fator 41008)" />
      <VarDeclaration ID="A5241531661A5802" Name="stsDose" Type="REAL" Comment="Dose equivalente RED (mJ/cm2)" />
      <VarDeclaration ID="1649013B97F8C71B" Name="stsUVT" Type="REAL" Comment="Transmitancia UV (%)" />
    </OutputVars>
  </InterfaceList>
