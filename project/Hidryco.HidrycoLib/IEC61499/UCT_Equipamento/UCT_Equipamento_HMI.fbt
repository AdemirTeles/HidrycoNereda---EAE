<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="287810a1-1264-459f-a5ce-f3003e312f4f" Name="UCT_Equipamento_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.4" Author="Hidryco" Date="16/10/2026" Remarks="IHM de um equipamento da UCT (nomes dos CATs Peneira_Rotativa/Bomba_Higienizacao/Rosca...)" />
  <InterfaceList>
    <EventInputs>
      <Event ID="1CEAFF8E38E7E4D9" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="54AE3FB5011654E8" Name="REQ" Comment="Atualizacao de status">
        <With Var="STS_ANIMACAO" />
        <With Var="STS_DEFEITO" />
        <With Var="STS_HORIMETRO_HORA" />
        <With Var="STS_AUTOMATICO_SUBSISTEMA" />
        <With Var="STS_VELOCIDADE" />
        <With Var="fbkCmdLigaManual" />
        <With Var="fbkCmdLigaIntermitente" />
        <With Var="fbkHabilitaReversao" />
        <With Var="CFG_VELOCIDADE" />
        <With Var="CFG_INTERMITENTE" />
        <With Var="CFG_REVERSAO" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="F20AF722FCD3D50F" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="E0B5E0321E48297B" Name="E_ATUALIZA_COMANDO_LIGA_MANUAL">
        <With Var="cmdLigaManual" />
      </Event>
      <Event ID="881A83865101816A" Name="E_ATUALIZA_SETPOINT">
        <With Var="stpVelocidade" />
      </Event>
      <Event ID="1A8D658BBAFE222A" Name="E_ATUALIZA_COMANDO_LIGA_INTERMITENTE">
        <With Var="cmdLigaIntermitente" />
      </Event>
      <Event ID="2737A4116453BCC4" Name="E_ATUALIZA_HABILITA_REVERSAO">
        <With Var="habilitaReversao" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="5D1B6C6BF3A4B682" Name="QI" Type="BOOL" />
      <VarDeclaration ID="4B4FDE552ADC9C68" Name="STS_ANIMACAO" Type="INT" Comment="Estado do equipamento na UCT: 0 desligado, 1 ligado, 2 falha, 3 manutencao, 4 sem comunicacao" />
      <VarDeclaration ID="EA31C60917FB1D6D" Name="STS_DEFEITO" Type="BOOL" Comment="Defeito do equipamento (palavra 40081 da UCT)" />
      <VarDeclaration ID="4B54BB6144F3C46D" Name="STS_HORIMETRO_HORA" Type="DINT" Comment="Horimetro do equipamento (h, lido da UCT)" />
      <VarDeclaration ID="9D0C0EF6DB35F17D" Name="STS_AUTOMATICO_SUBSISTEMA" Type="BOOL" Comment="Subsistema do equipamento em automatico (comandos manuais bloqueados)" />
      <VarDeclaration ID="D888240C745C63F3" Name="STS_VELOCIDADE" Type="REAL" Comment="Velocidade ajustada na UCT (%)" />
      <VarDeclaration ID="6A12125F513587DD" Name="fbkCmdLigaManual" Type="BOOL" Comment="Comando liga em vigor na UCT" />
      <VarDeclaration ID="7FF4E2EA17E78B93" Name="fbkCmdLigaIntermitente" Type="BOOL" Comment="Modo intermitente em vigor na UCT" />
      <VarDeclaration ID="9580F45AE22E60AB" Name="fbkHabilitaReversao" Type="BOOL" Comment="Reversao habilitada na UCT" />
      <VarDeclaration ID="A1C7BF12A409E820" Name="CFG_VELOCIDADE" Type="BOOL" Comment="TRUE = equipamento com ajuste de velocidade" />
      <VarDeclaration ID="D4414309B266F29F" Name="CFG_INTERMITENTE" Type="BOOL" Comment="TRUE = equipamento com modo intermitente" />
      <VarDeclaration ID="0DAE64C721A46F8B" Name="CFG_REVERSAO" Type="BOOL" Comment="TRUE = equipamento com reversao" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="3BE825FAECAAB006" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="1CA52FCE30CDB939" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="66C22661E31C14BE" Name="cmdLigaManual" Type="BOOL" Comment="IHM: liga (TRUE) / desliga (FALSE) em manual" />
      <VarDeclaration ID="089274AC41F05D45" Name="stpVelocidade" Type="REAL" Comment="IHM: velocidade (%)" />
      <VarDeclaration ID="AB4A6D17BD605B89" Name="cmdLigaIntermitente" Type="BOOL" Comment="IHM: liga (TRUE) / desliga (FALSE) o intermitente" />
      <VarDeclaration ID="C63DB02CB8A0FA97" Name="habilitaReversao" Type="BOOL" Comment="IHM: habilita (TRUE) / desabilita (FALSE) a reversao" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>