<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="85e91d08-610c-4eac-a11c-3a45cde114e5" Name="UCT_Equipamento" Format="2.0" Comment="Equipamento de uma UCT (so IHM) - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Attribute Name="HMI.Alias" Value="" />
  <Attribute Name="Configuration.FB.IDCounter" Value="2" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.4" Author="Hidryco" Date="16/10/2026" Remarks="1.4: motor da rosca inclinada virado para a calha, A/M centralizado na caixa. 1.3: simbolos no padrao do Motor_Generico (graficos da HidrycoLib com Animacao e cores HidrycoColors, falha de comunicacao, A/M, nome), formas sobrepostas na ordem certa, area do simbolo (SymbolSize). 1.2: simbolos graficos por tipo de equipamento (sPeneira, sBomba, sValvula, sRosca, sRoscaInclinada, sCompressor, sRaspador) para o desenho do skid. 1.0: simbolo e faceplate de um equipamento da UCT Fast (peneira, bombas e valvulas de higienizacao, compressor, raspador, roscas). Recebe o estado lido da UCT pelo CAT UCT_PreTratamento e devolve os comandos da IHM (liga manual, velocidade, intermitente, reversao), um evento por comando. Nomes do IThis iguais aos dos CATs antigos da biblioteca." />
  <InterfaceList>
    <EventInputs>
      <Event ID="70A516C5CA4155CA" Name="REQ" Comment="Estado da UCT">
        <With Var="STS_ANIMACAO" />
        <With Var="STS_DEFEITO" />
        <With Var="STS_HORIMETRO_HORA" />
        <With Var="STS_AUTOMATICO_SUBSISTEMA" />
        <With Var="STS_VELOCIDADE" />
        <With Var="fbkCmdLigaManual" />
        <With Var="fbkCmdLigaIntermitente" />
        <With Var="fbkHabilitaReversao" />
        <With Var="CFG_VELOCIDADE" />
        <With Var="CFG_INTERMITENTE" />
        <With Var="CFG_REVERSAO" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="0ECDAB45E7B0C5AF" Name="E_ATUALIZA_COMANDO_LIGA_MANUAL" Comment="IHM: liga (TRUE) / desliga (FALSE) em manual">
        <With Var="cmdLigaManual" />
      </Event>
      <Event ID="2D7A148B2A7AA879" Name="E_ATUALIZA_SETPOINT" Comment="IHM: velocidade (%)">
        <With Var="stpVelocidade" />
      </Event>
      <Event ID="453EBF0958E76CD5" Name="E_ATUALIZA_COMANDO_LIGA_INTERMITENTE" Comment="IHM: liga (TRUE) / desliga (FALSE) o intermitente">
        <With Var="cmdLigaIntermitente" />
      </Event>
      <Event ID="D9A88CBEE21DBA8E" Name="E_ATUALIZA_HABILITA_REVERSAO" Comment="IHM: habilita (TRUE) / desabilita (FALSE) a reversao">
        <With Var="habilitaReversao" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="93B31B867A532500" Name="STS_ANIMACAO" Type="INT" Comment="Estado do equipamento na UCT: 0 desligado, 1 ligado, 2 falha, 3 manutencao, 4 sem comunicacao" />
      <VarDeclaration ID="98FD5EAA90BD9629" Name="STS_DEFEITO" Type="BOOL" Comment="Defeito do equipamento (palavra 40081 da UCT)" />
      <VarDeclaration ID="96E48787F8AC58C3" Name="STS_HORIMETRO_HORA" Type="DINT" Comment="Horimetro do equipamento (h, lido da UCT)" />
      <VarDeclaration ID="CC220F735371196B" Name="STS_AUTOMATICO_SUBSISTEMA" Type="BOOL" Comment="Subsistema do equipamento em automatico (comandos manuais bloqueados)" />
      <VarDeclaration ID="33285C93B9AAB2BC" Name="STS_VELOCIDADE" Type="REAL" Comment="Velocidade ajustada na UCT (%)" />
      <VarDeclaration ID="3F39B194DE4581AB" Name="fbkCmdLigaManual" Type="BOOL" Comment="Comando liga em vigor na UCT" />
      <VarDeclaration ID="F6AE4997ED76CC8B" Name="fbkCmdLigaIntermitente" Type="BOOL" Comment="Modo intermitente em vigor na UCT" />
      <VarDeclaration ID="0E2695E0A2003068" Name="fbkHabilitaReversao" Type="BOOL" Comment="Reversao habilitada na UCT" />
      <VarDeclaration ID="6729E072E11CC02E" Name="CFG_VELOCIDADE" Type="BOOL" Comment="TRUE = equipamento com ajuste de velocidade" />
      <VarDeclaration ID="B3CA2188BE2BF3D0" Name="CFG_INTERMITENTE" Type="BOOL" Comment="TRUE = equipamento com modo intermitente" />
      <VarDeclaration ID="E5B528FA2A3E5A83" Name="CFG_REVERSAO" Type="BOOL" Comment="TRUE = equipamento com reversao" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="074D328E856330C0" Name="cmdLigaManual" Type="BOOL" Comment="IHM: liga (TRUE) / desliga (FALSE) em manual" />
      <VarDeclaration ID="520AB5A4EADBD8AE" Name="stpVelocidade" Type="REAL" Comment="IHM: velocidade (%)" />
      <VarDeclaration ID="C49C9947FE6383D2" Name="cmdLigaIntermitente" Type="BOOL" Comment="IHM: liga (TRUE) / desliga (FALSE) o intermitente" />
      <VarDeclaration ID="E18D01D6E7CD5F0A" Name="habilitaReversao" Type="BOOL" Comment="IHM: habilita (TRUE) / desabilita (FALSE) a reversao" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <FB ID="3D0AD884E2E13669" Name="IThis" Type="UCT_Equipamento_HMI" x="1400" y="400" Namespace="Hidryco.HidrycoLib">
