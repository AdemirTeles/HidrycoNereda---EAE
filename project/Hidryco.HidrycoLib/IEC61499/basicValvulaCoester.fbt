    </InputVars>
    <OutputVars>
      <VarDeclaration ID="AC804A87A5A79AB2" Name="acmW01" Type="INT" Comment="Word 1 escrita: b0 abrir, b1 fechar, b2 parar, b4 posicionar, b8 quitar alarmes" />
