<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="b35c8a41-0d79-3721-eaed-dd872cf5fd7c" Name="basicValvulaCoester" Comment="Logica do atuador Coester CSR (Modbus TCP)" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="19/10/2026" Remarks="1.0: leitura Words 1-9/36/86/87, escrita Words 1-2; modulante (posicionamento continuo) ou on/off; falhas memorizadas, posicao nao atingida, quitar alarmes por 3 s" />
  <InterfaceList>
    <EventInputs>
      <Event ID="BC3FDAAC48C266C9" Name="INIT" Comment="Inicializacao (configuracao da instancia)">
        <With Var="cfgModulante" />
        <With Var="cfgPosicaoMin" />
        <With Var="cfgPosicaoMax" />
        <With Var="cfgPartidasDiaMax" />
      </Event>
      <Event ID="439C5B98809C2189" Name="REQ_CMD" Comment="Comando do processo (automatico)">
        <With Var="cmdAbrirAutomatico" />
        <With Var="cmdFecharAutomatico" />
        <With Var="stpPosicaoAutomatico" />
      </Event>
      <Event ID="9A76CBB51054FCFA" Name="REQ_ILCK" Comment="Intertravamentos">
        <With Var="ilkGeral" />
        <With Var="ilkAutomatico" />
        <With Var="ilkManual" />
      </Event>
      <Event ID="B53852AF9F22A018" Name="REQ_FB1" Comment="Leitura Modbus: status 1/2 e alarmes 1/2 (Words 1 a 4)">
        <With Var="fldW01" />
        <With Var="fldW02" />
        <With Var="fldW03" />
        <With Var="fldW04" />
      </Event>
      <Event ID="1122F70F08541858" Name="REQ_FB2" Comment="Leitura Modbus: posicao, torque, tempo de percurso, temperatura (Words 5 a 8)">
        <With Var="fldW05" />
        <With Var="fldW06" />
        <With Var="fldW07" />
        <With Var="fldW08" />
      </Event>
      <Event ID="A294594AC3667AFD" Name="REQ_FB3" Comment="Leitura Modbus: torque %, opcionais, partidas/dia (Words 9, 36, 86, 87)">
        <With Var="fldW09" />
        <With Var="fldW36" />
        <With Var="fldW86" />
        <With Var="fldW87" />
      </Event>
      <Event ID="45BC53B715393160" Name="REQ_COM" Comment="Status da conexao Modbus (connStatusInt)">
        <With Var="fldConexao" />
      </Event>
      <Event ID="38061816A8BE25E9" Name="REQ_MODE" Comment="IHM: modo de operacao">
        <With Var="hmiAutomatico" />
      </Event>
      <Event ID="381236404F15E6E1" Name="REQ_MANUAL" Comment="IHM: comando manual">
        <With Var="hmiCmdManual" />
        <With Var="hmiPosicaoManual" />
      </Event>
      <Event ID="0278FF007F66B823" Name="REQ_PARA" Comment="IHM: parametros">
        <With Var="stpTempoFalhaPosicao" />
        <With Var="stpToleranciaPosicao" />
      </Event>
      <Event ID="3A4B67BCD45EEA9F" Name="REQ_RESET" Comment="IHM: reset de falhas">
        <With Var="hmiResetFalha" />
      </Event>
      <Event ID="E0357D841C57E206" Name="REQ_RESET_PROC" Comment="Processo: reset de falhas">
        <With Var="cmdResetFalhas" />
      </Event>
      <Event ID="AEE5258FE28533BC" Name="TICK" Comment="Base de tempo de 1 s" />
    </EventInputs>
    <EventOutputs>
      <Event ID="2C2FA7A6E9BF9047" Name="INITO" Comment="Inicializacao concluida" />
      <Event ID="5BDBF19AA0AAE2FE" Name="CNF_OUT" Comment="Escrita Modbus (Word 1 comando, Word 2 posicao)">
        <With Var="acmW01" />
        <With Var="acmW02" />
      </Event>
      <Event ID="8A6711B6046FDA6A" Name="CNF" Comment="Status para o processo (so na mudanca)">
        <With Var="stsDisponivelAutomatico" />
        <With Var="stsAberta" />
        <With Var="stsFechada" />
        <With Var="stsPosicao" />
        <With Var="stsRemoto" />
        <With Var="stsAutomatico" />
        <With Var="stsFalha" />
        <With Var="stsComunicacaoOK" />
      </Event>
      <Event ID="990117E8CD2B8B73" Name="CNF_HMI" Comment="Status para a IHM e alarmes">
        <With Var="stsComunicacaoOK" />
        <With Var="stsRemoto" />
        <With Var="stsLocal" />
        <With Var="stsDesligado" />
        <With Var="stsAutomatico" />
        <With Var="stsAberta" />
        <With Var="stsFechada" />
        <With Var="stsIntermediaria" />
        <With Var="stsAbrindo" />
        <With Var="stsFechando" />
        <With Var="stsVolante" />
        <With Var="stsPosicao" />
        <With Var="stsPosicaoReferencia" />
        <With Var="stsTorque" />
        <With Var="stsTorquePct" />
        <With Var="stsTemperatura" />
        <With Var="stsTempoPercurso" />
        <With Var="stsPartidasDia" />
        <With Var="stsPartidasDiaMax" />
        <With Var="stsModoContinuo" />
        <With Var="stsModulante" />
        <With Var="stsCmdManual" />
        <With Var="stsFalhaComunicacao" />
        <With Var="stsFalhaAtuador" />
        <With Var="stsFalhaPosicao" />
        <With Var="stsCodigoFalha" />
        <With Var="stsBloqueado" />
        <With Var="stsDisponivelAutomatico" />
        <With Var="stsAlarme" />
        <With Var="stsAvisoConfig" />
        <With Var="stsAvisoPartidas" />
        <With Var="stsAnimacao" />
        <With Var="stsStatus2" />
        <With Var="stsAlarme1" />
        <With Var="stsAlarme2" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="EC14950A36464D14" Name="cfgModulante" Type="BOOL" InitialValue="FALSE" Comment="TRUE = valvula modulante: atuador em posicionamento continuo, CLP escreve so a posicao (Word 2)" />
      <VarDeclaration ID="410C490809D6916D" Name="cfgPosicaoMin" Type="REAL" InitialValue="0.0" Comment="Limite minimo da posicao no automatico (%)" />
      <VarDeclaration ID="9DB83B313D3D4707" Name="cfgPosicaoMax" Type="REAL" InitialValue="100.0" Comment="Limite maximo da posicao no automatico (%)" />
      <VarDeclaration ID="0008094B2F324685" Name="cfgPartidasDiaMax" Type="INT" InitialValue="0" Comment="Aviso se as partidas do dia anterior passarem disto (0 = sem aviso)" />
