      <VarDeclaration ID="02686A07CF0DEA75" Name="fldW04" Type="INT" Comment="Word 4: bits de alarme 2" />
      <VarDeclaration ID="4CF28D0E5B603273" Name="fldW05" Type="INT" Comment="Word 5: posicao (%)" />
      <VarDeclaration ID="71BCBB12C2AF0796" Name="fldW06" Type="INT" Comment="Word 6: torque (Nm)" />
      <VarDeclaration ID="A8A879D27B091910" Name="fldW07" Type="INT" Comment="Word 7: tempo de percurso (s)" />
      <VarDeclaration ID="5FC4C940D239F7B7" Name="fldW08" Type="INT" Comment="Word 8: temperatura (valor - 19 = graus C)" />
      <VarDeclaration ID="8966B61142E1C2AB" Name="fldW09" Type="INT" Comment="Word 9: torque (%)" />
      <VarDeclaration ID="B732CC35D8316C22" Name="fldW36" Type="INT" Comment="Word 36: bits de opcionais" />
      <VarDeclaration ID="B639CAC66B51D265" Name="fldW86" Type="INT" Comment="Word 86: partidas no dia anterior" />
      <VarDeclaration ID="530128CBF41BDA17" Name="fldW87" Type="INT" Comment="Word 87: maximo de partidas por dia" />
      <VarDeclaration ID="93F81E7F7C459083" Name="fldConexao" Type="INT" Comment="connStatusInt do escravo Modbus (1 = online)" />
      <VarDeclaration ID="FE01ADD91E2DE6AA" Name="hmiAutomatico" Type="BOOL" Comment="IHM: TRUE = automatico" />
      <VarDeclaration ID="0AFFB7CCAAAE4650" Name="hmiCmdManual" Type="INT" Comment="IHM: 0 parar, 1 abrir, 2 fechar, 3 posicionar" />
      <VarDeclaration ID="2953209EDB5B5D08" Name="hmiPosicaoManual" Type="REAL" Comment="IHM: posicao manual (%)" />
      <VarDeclaration ID="C7AB5DFE5DE027AD" Name="stpTempoFalhaPosicao" Type="INT" Comment="Tempo maximo para atingir a posicao (s); 0 = sem supervisao" />
