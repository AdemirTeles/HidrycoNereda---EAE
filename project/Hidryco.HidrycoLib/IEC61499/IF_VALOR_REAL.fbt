    <Algorithm Name="INIT" Comment="Initialization algorithm">
      <ST><![CDATA[;]]></ST>
    </Algorithm>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[IF (CONDICAO) THEN
	VALOR_OUT := VALOR_TRUE;
ELSE
	VALOR_OUT := VALOR_FALSE;
END_IF
;]]></ST>
    </Algorithm>
