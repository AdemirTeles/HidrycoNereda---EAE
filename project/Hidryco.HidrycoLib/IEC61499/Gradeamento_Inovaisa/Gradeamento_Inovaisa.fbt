<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="442e55ee-a2c7-edc6-56a2-898c58faa625" Name="Gradeamento_Inovaisa" Comment="Gradeamento mecanizado (area 100) - painel Vibropac, grades, rosca e comportas - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.1" Author="Hidryco" Date="22/10/2026" Remarks="1.1: carga no gerador: REQ_GERADOR (geradorHabilita, stsGerador; Subestacao HAB_GM_100_01 e stsPlantaNoGerador) bloqueia o ciclo remoto na Logica e anima o raio do simbolo (AnimGerador -> STS_ANIMACAO_GERADOR). 1.0: gradeamento mecanizado da area 100 (painel Vibropac PV-35524, CLP TM241, tabela Modbus TCP Inovaisa Rev.B). Instancia &quot;Gradeamento&quot; com os caminhos do legado: Grade_Status1 (Controle_Gradeamento), GM_100_01/02 (Grade_Inovaisa: SensorMontante, SensorJusante, SensorDiferencial, Grade_Mecanizada_Inovaisa1), RT_100_01 (Motor_Inovaisa, rosca), CO_100_01..04 (Valvula_Coester on/off, comandadas pela IHM). Campo por symlink ${PATH}: leitura mbR4005..mbR4018 (INT), mbConexao (connStatusInt); escrita mbW4001 (ciclo), mbW4002 (reset), mbW4003/mbW4004 (setpoints 0-1000). O reset (cmdResetFalhas no E_RESET_FALHAS_PROCESSO) inclui o 4002 do painel, as grades, os sensores e as comportas." />
  <InterfaceList>
    <EventInputs>
      <Event ID="7776DF3575084C20" Name="E_RESET_FALHAS" Comment="Reset pelo processo (painel, grades, sensores e comportas) com cmdResetFalhas = TRUE">
        <With Var="cmdResetFalhas" />
      </Event>
      <Event ID="D1B66AFAEC6D2FF0" Name="REQ_GERADOR" Comment="Planta no gerador e liberacao da grade (Subestacao)">
        <With Var="geradorHabilita" />
        <With Var="stsGerador" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="C3050231836E51CB" Name="CNF" Comment="Status">
        <With Var="stsAlarme" />
        <With Var="stsEmergencia" />
        <With Var="stsComunicacaoOK" />
        <With Var="stsFuncionando" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="0E787FBCD5903656" Name="cmdResetFalhas" Type="BOOL" Comment="TRUE = reset (com o evento E_RESET_FALHAS)" />
      <VarDeclaration ID="358F3774D14189DB" Name="geradorHabilita" Type="BOOL" Comment="100-GM-01 liberada para operar com a planta nos geradores" />
      <VarDeclaration ID="98A20843E1C25CF2" Name="stsGerador" Type="BOOL" Comment="TRUE = planta alimentada pelos geradores" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="E2311DC6D94C7749" Name="stsAlarme" Type="BOOL" Comment="Algum alarme do gradeamento (comunicacao, painel, emergencia, motores)" />
      <VarDeclaration ID="DD34A80A5B7D99F1" Name="stsEmergencia" Type="BOOL" Comment="Botao de emergencia do painel acionado (4006)" />
      <VarDeclaration ID="EB86BB347ADEFCE7" Name="stsComunicacaoOK" Type="BOOL" Comment="Comunicacao Modbus com o CLP do painel OK" />
      <VarDeclaration ID="5CFDB068ED148D6C" Name="stsFuncionando" Type="BOOL" Comment="Alguma grade ou a rosca funcionando" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
