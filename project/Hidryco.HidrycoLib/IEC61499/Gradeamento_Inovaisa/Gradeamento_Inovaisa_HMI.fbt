<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="74677a85-4009-9e96-3319-038b8e2903be" Name="Gradeamento_Inovaisa_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="22/10/2026" Remarks="IHM do Gradeamento_Inovaisa" />
  <InterfaceList>
    <EventInputs>
      <Event ID="ECC090163CC0B000" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="1F8E1DFC4C0C24D0" Name="LOAD_PERS_DATA" Comment="Reenvia os parametros persistentes" />
      <Event ID="38275147D3F77B46" Name="REQ" Comment="Atualizacao de status">
        <With Var="STS_ALARME" />
        <With Var="STS_EMERGENCIA" />
        <With Var="STS_COMUNICACAO_OK" />
        <With Var="STS_FALHA_COMUNICACAO" />
        <With Var="STS_ALARME_ACIONADO" />
        <With Var="STS_CICLO_LIGADO" />
        <With Var="STS_FALHA_MOTOR" />
        <With Var="STS_FUNCIONANDO" />
        <With Var="STS_ALM_COMUNICACAO_EST" />
        <With Var="STS_ALM_EMERGENCIA_EST" />
        <With Var="STS_ALM_PAINEL_EST" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="CB22FE61A9101ECA" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="242F922354BD23C9" Name="E_RESET_FALHAS_PROCESSO">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="4E6248A1E91A26C9" Name="QI" Type="BOOL" />
      <VarDeclaration ID="6FCA39A2D147DE77" Name="STS_ALARME" Type="BOOL" Comment="Algum alarme do gradeamento (comunicacao, painel, emergencia, motores)" />
      <VarDeclaration ID="F045091C645F3312" Name="STS_EMERGENCIA" Type="BOOL" Comment="Botao de emergencia do painel acionado (4006)" />
      <VarDeclaration ID="5A984024F490CFC5" Name="STS_COMUNICACAO_OK" Type="BOOL" Comment="Comunicacao Modbus com o CLP do painel OK" />
      <VarDeclaration ID="39BED905FADF3373" Name="STS_FALHA_COMUNICACAO" Type="BOOL" Comment="Falha de comunicacao com o CLP do painel" />
      <VarDeclaration ID="A5523AEDFD3969A6" Name="STS_ALARME_ACIONADO" Type="BOOL" Comment="Alarme acionado no painel (4005)" />
      <VarDeclaration ID="51D5459D1498110E" Name="STS_CICLO_LIGADO" Type="BOOL" Comment="Comando de ciclo remoto ligado (4001 = 1)" />
      <VarDeclaration ID="1D655E340905F44F" Name="STS_FALHA_MOTOR" Type="BOOL" Comment="Grade ou rosca em falha ou sobretorque" />
      <VarDeclaration ID="9512D253D4D322C2" Name="STS_FUNCIONANDO" Type="BOOL" Comment="Alguma grade ou a rosca funcionando" />
      <VarDeclaration ID="4E0788183C903F3D" Name="STS_ALM_COMUNICACAO_EST" Type="USINT" Comment="Estado do ALARM_BIT (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="27D2486D2537D0D5" Name="STS_ALM_EMERGENCIA_EST" Type="USINT" Comment="Estado do ALARM_BIT (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="9BCF8DFF4840D2B4" Name="STS_ALM_PAINEL_EST" Type="USINT" Comment="Estado do ALARM_BIT (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="7631E042DBBF052D" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="4F10F9FA398F6007" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="6A21846A09042795" Name="cmdResetFalhas" Type="BOOL" Comment="Reset do painel (4002), dos sensores e reconhecimento dos alarmes do gradeamento" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>
