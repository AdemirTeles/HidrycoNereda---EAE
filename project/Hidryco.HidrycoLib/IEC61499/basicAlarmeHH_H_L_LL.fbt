      </ECTransition>
      <ECTransition Source="AVALIA" Destination="PARA_DELAY" Condition="timerCmd = 2" x="1205.916" y="1551.365">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="369.5573,412.5557,234.5214,373.3394" />
      </ECTransition>
      <ECTransition Source="AVALIA" Destination="REINICIA_DELAY" Condition="timerCmd = 3" x="1321.182" y="1868.49">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="385.0202,467.3684,273.739,474.1951" />
      </ECTransition>
      <ECTransition Source="AVALIA" Destination="INICIA_DELAY" Condition="timerCmd = 1" x="1270.128" y="1195.672">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="377.86,347.7744,258.0115,261.6738" />
      </ECTransition>
      <ECTransition Source="AVALIA" Destination="START" Condition="1" x="1934.389" y="1317.567">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="515.1667,406.5083,465.9431,294.4186" />
      </ECTransition>
      <ECTransition Source="INICIA_DELAY" Destination="START" Condition="1" x="960.3657" y="363.9237">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="199.0226,91.19733,273.6372,83.08014" />
      </ECTransition>
      <ECTransition Source="PARA_DELAY" Destination="START" Condition="1" x="821.2079" y="806.8622">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="150.6296,233.0353,245.4526,173.0885" />
      </ECTransition>
      <ECTransition Source="REINICIA_DELAY" Destination="START" Condition="1" x="931.4269" y="1101.794">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="184.0003,331.3705,273.7998,216.3744" />
      </ECTransition>
    </ECC>
    <Algorithm ID="c0478f3d-b09d-41c9-aaf8-2f00834c7f74" Name="algMarcaFimDelay">
      <ST><![CDATA[bTimerExpirou := bTimerAtivo;
;]]></ST>
    </Algorithm>
    <Algorithm ID="00eee1e1-c9e2-4231-a659-e8921690c749" Name="algReq">
      <ST><![CDATA[timerCmd := 0;

(* ---- Sensor desabilitado: zera tudo ---- *)
IF NOT stsSensorHabilitado THEN
    stsAlarmeHH := FALSE;
    stsAlarmeH  := FALSE;
    stsAlarmeL  := FALSE;
    stsAlarmeLL := FALSE;
    bResetPedido  := FALSE;
    bTimerExpirou := FALSE;
    IF bTimerAtivo THEN
        timerCmd := 2;
    END_IF;
    bTimerAtivo := FALSE;
    iNivelTimer := 0;
    RETURN;
END_IF;

(* ---- Condições atuais ---- *)
bCondHH := cmdHabilitaAlarmeHH AND (stsEntradaAlarme > stpAlarmeHH);
bCondH  := cmdHabilitaAlarmeH  AND (stsEntradaAlarme > stpAlarmeH);
bCondL  := cmdHabilitaAlarmeL  AND (stsEntradaAlarme < stpAlarmeL);
bCondLL := cmdHabilitaAlarmeLL AND (stsEntradaAlarme < stpAlarmeLL);

(* ---- Alarme desabilitado zera o próprio alarme ---- *)
IF NOT cmdHabilitaAlarmeHH THEN stsAlarmeHH := FALSE; END_IF;
IF NOT cmdHabilitaAlarmeH  THEN stsAlarmeH  := FALSE; END_IF;
IF NOT cmdHabilitaAlarmeL  THEN stsAlarmeL  := FALSE; END_IF;
IF NOT cmdHabilitaAlarmeLL THEN stsAlarmeLL := FALSE; END_IF;

(* ---- Tempo esgotado: ativa todos cuja condição persiste ---- *)
IF bTimerExpirou THEN
    IF bCondHH THEN stsAlarmeHH := TRUE; END_IF;
    IF bCondH  THEN stsAlarmeH  := TRUE; END_IF;
    IF bCondL  THEN stsAlarmeL  := TRUE; END_IF;
    IF bCondLL THEN stsAlarmeLL := TRUE; END_IF;
    bTimerExpirou := FALSE;
    bTimerAtivo   := FALSE;
    iNivelTimer   := 0;
END_IF;

(* ---- Reset ---- *)
IF modoAlarme = 0 THEN
    (* automático, histerese de 10% do setpoint *)
    IF stsAlarmeHH AND (stsEntradaAlarme <= stpAlarmeHH - ABS(stpAlarmeHH) * 0.1) THEN stsAlarmeHH := FALSE; END_IF;
    IF stsAlarmeH  AND (stsEntradaAlarme <= stpAlarmeH  - ABS(stpAlarmeH)  * 0.1) THEN stsAlarmeH  := FALSE; END_IF;
    IF stsAlarmeL  AND (stsEntradaAlarme >= stpAlarmeL  + ABS(stpAlarmeL)  * 0.1) THEN stsAlarmeL  := FALSE; END_IF;
    IF stsAlarmeLL AND (stsEntradaAlarme >= stpAlarmeLL + ABS(stpAlarmeLL) * 0.1) THEN stsAlarmeLL := FALSE; END_IF;
ELSIF bResetPedido THEN
    (* manual, sem histerese: só zera se o valor já voltou *)
    IF stsAlarmeHH AND (stsEntradaAlarme <= stpAlarmeHH) THEN stsAlarmeHH := FALSE; END_IF;
    IF stsAlarmeH  AND (stsEntradaAlarme <= stpAlarmeH)  THEN stsAlarmeH  := FALSE; END_IF;
    IF stsAlarmeL  AND (stsEntradaAlarme >= stpAlarmeL)  THEN stsAlarmeL  := FALSE; END_IF;
    IF stsAlarmeLL AND (stsEntradaAlarme >= stpAlarmeLL) THEN stsAlarmeLL := FALSE; END_IF;
END_IF;
bResetPedido := FALSE;

(* ---- Pendente de maior prioridade (HH > H > LL > L) ---- *)
iNivelNovo := 0;
IF bCondHH AND NOT stsAlarmeHH THEN
    iNivelNovo := 1; tNovo := DINT_TO_TIME(UINT_TO_DINT(stpTempoAlarmeHH) * 1000);
ELSIF bCondH AND NOT stsAlarmeH THEN
    iNivelNovo := 2; tNovo := DINT_TO_TIME(UINT_TO_DINT(stpTempoAlarmeH) * 1000);
ELSIF bCondLL AND NOT stsAlarmeLL THEN
    iNivelNovo := 3; tNovo := DINT_TO_TIME(UINT_TO_DINT(stpTempoAlarmeLL) * 1000);
ELSIF bCondL AND NOT stsAlarmeL THEN
    iNivelNovo := 4; tNovo := DINT_TO_TIME(UINT_TO_DINT(stpTempoAlarmeL) * 1000);
END_IF;

(* ---- Decisão do temporizador ---- *)
IF iNivelNovo = 0 THEN
    IF bTimerAtivo THEN
        timerCmd := 2;                  (* condição sumiu: cancela *)
    END_IF;
    bTimerAtivo := FALSE;
    iNivelTimer := 0;
ELSIF NOT bTimerAtivo THEN
    delayTime   := tNovo;
    timerCmd    := 1;                   (* inicia *)
    bTimerAtivo := TRUE;
    iNivelTimer := iNivelNovo;
ELSIF iNivelNovo <> iNivelTimer THEN
    delayTime   := tNovo;
    timerCmd    := 3;                   (* troca de nível: reinicia com o novo tempo *)
    iNivelTimer := iNivelNovo;
END_IF;
;]]></ST>
    </Algorithm>
    <Algorithm ID="b8bed43b-d46d-47be-a45e-1d3c4d948c9e" Name="algMarcaReset">
      <ST><![CDATA[bResetPedido := cmdReset;
;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>