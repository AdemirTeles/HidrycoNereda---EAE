      <VarDeclaration Name="stsAlarmeH" Type="BOOL" />
      <VarDeclaration Name="stsAlarmeL" Type="BOOL" />
      <VarDeclaration Name="stsAlarmeLL" Type="BOOL" />
      <VarDeclaration Name="delayTime" Type="TIME" />
