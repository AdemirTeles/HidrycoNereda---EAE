        <ECAction Output="STOP_DELAY" />
      </ECState>
      <ECState Name="REINICIA_DELAY" x="400" y="1860">
        <ECAction Output="STOP_DELAY" />
        <ECAction Output="START_DELAY" />
      </ECState>
      <ECState Name="RESET" x="2160" y="216">
        <ECAction Algorithm="algMarcaReset" />
      </ECState>
      <ECTransition Source="START" Destination="AVALIA" Condition="REQ" x="1993.985" y="920.6455">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="452.4042,195.3127,564,241" />
      </ECTransition>
      <ECTransition Source="START" Destination="RESET" Condition="E_RESET_ALARMES" x="1904.248" y="211.2976">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="470.9885,51.16471,490.4537,46.02129" />
      </ECTransition>
      <ECTransition Source="START" Destination="FIM_DELAY" Condition="END_DELAY" x="2091.077" y="631.4614">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="497.772,133.2412,554.7719,175.0176" />
      </ECTransition>
      <ECTransition Source="RESET" Destination="AVALIA" Condition="1" x="2227.464" y="982.9791">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="563.2745,186.3415,561.7213,305.3112" />
      </ECTransition>
