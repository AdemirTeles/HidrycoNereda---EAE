<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="72bdd8a6-aa5f-44a8-b181-9c65804a2759" Name="basicAlarmeHH_H_L_LL" Comment="Basic Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="1/23/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="E_RESET_ALARMES" />
      <Event Name="E_ATUALIZA_STP">
        <With Var="cmdHabilitaAlarmeHH" />
        <With Var="cmdHabilitaAlarmeH" />
        <With Var="cmdHabilitaAlarmeL" />
        <With Var="cmdHabilitaAlarmeLL" />
        <With Var="stpTempoAlarmeHH" />
        <With Var="stpTempoAlarmeH" />
        <With Var="stpTempoAlarmeL" />
        <With Var="stpTempoAlarmeLL" />
        <With Var="stpAlarmeHH" />
        <With Var="stpAlarmeH" />
        <With Var="stpAlarmeL" />
        <With Var="stpAlarmeLL" />
        <With Var="modoAlarme" />
        <With Var="stsSensorHabilitado" />
      </Event>
      <Event Name="E_ATUALIZA_ENTRADA">
        <With Var="stsEntradaAlarme" />
      </Event>
      <Event Name="END_DELAY" />
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="stsAlarmeH" />
        <With Var="stsAlarmeL" />
        <With Var="stsAlarmeLL" />
        <With Var="stsAlarmeHH" />
      </Event>
      <Event Name="START_DELAY">
        <With Var="delayTime" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="modoAlarme" Type="UINT" Comment="Modo do alarme: 0 - AutoReset, 1 - Comando de Reset" />
      <VarDeclaration Name="stsSensorHabilitado" Type="BOOL" />
      <VarDeclaration Name="cmdHabilitaAlarmeHH" Type="BOOL" />
      <VarDeclaration Name="cmdHabilitaAlarmeH" Type="BOOL" />
      <VarDeclaration Name="cmdHabilitaAlarmeL" Type="BOOL" />
      <VarDeclaration Name="cmdHabilitaAlarmeLL" Type="BOOL" />
      <VarDeclaration Name="stpTempoAlarmeHH" Type="UINT" />
      <VarDeclaration Name="stpTempoAlarmeH" Type="UINT" />
      <VarDeclaration Name="stpTempoAlarmeL" Type="UINT" />
      <VarDeclaration Name="stpTempoAlarmeLL" Type="UINT" />
      <VarDeclaration Name="stpAlarmeHH" Type="REAL" />
      <VarDeclaration Name="stpAlarmeH" Type="REAL" />
      <VarDeclaration Name="stpAlarmeL" Type="REAL" />
      <VarDeclaration Name="stpAlarmeLL" Type="REAL" />
      <VarDeclaration Name="stsEntradaAlarme" Type="REAL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="stsAlarmeHH" Type="BOOL" Comment="Output event qualifier" />
      <VarDeclaration Name="stsAlarmeH" Type="BOOL" />
      <VarDeclaration Name="stsAlarmeL" Type="BOOL" />
      <VarDeclaration Name="stsAlarmeLL" Type="BOOL" />
      <VarDeclaration Name="delayTime" Type="TIME" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="AlarmeHH,AtivaAlarme,ResetAlarmesManual,ResetAlarmesAutomatico,ResetAlarmesSensorDesabilitado" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="1244.941" y="381.4117" />
      <ECState Name="STATE2" x="2244" y="2132">
        <ECAction Algorithm="AlarmeHH" Output="START_DELAY" />
      </ECState>
      <ECState Name="STATE1" x="2756" y="1696">
        <ECAction Algorithm="AtivaAlarme" Output="CNF" />
      </ECState>
      <ECState Name="STATE3" x="648" y="1860">
        <ECAction Algorithm="ResetAlarmesManual" Output="CNF" />
      </ECState>
      <ECState Name="STATE4" x="224" y="1380">
        <ECAction Algorithm="ResetAlarmesAutomatico" Output="CNF" />
      </ECState>
      <ECState Name="STATE5" x="1424" y="928.0001" />
      <ECState Name="STATE6" x="2100" y="416">
        <ECAction Algorithm="ResetAlarmesSensorDesabilitado" />
      </ECState>
      <ECTransition Source="START" Destination="STATE5" Condition="stsSensorHabilitado" x="1412.793" y="631.3573">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="351.3391,137.4676,363.4116,174.3196" />
      </ECTransition>
      <ECTransition Source="STATE5" Destination="STATE1" Condition="END_DELAY" x="2363.26" y="1432.158">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="571.1469,342.9008,652.7144,393.2049" />
      </ECTransition>
      <ECTransition Source="STATE1" Destination="STATE5" Condition="1" x="2339.435" y="1087.259">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="691.0005,286.634,508.3286,224.4746" />
      </ECTransition>
      <ECTransition Source="STATE5" Destination="STATE2" Condition="E_ATUALIZA_ENTRADA" x="1889.506" y="1483.559">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="445.209,322.3358,506.4559,411.7038" />
      </ECTransition>
      <ECTransition Source="STATE2" Destination="STATE5" Condition="1" x="1805.258" y="1601.11">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="481.0981,451.3896,418.8789,361.017" />
      </ECTransition>
      <ECTransition Source="STATE5" Destination="STATE3" Condition="modoAlarme = 1 AND E_RESET_ALARMES" x="1155.409" y="1491.412">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="322.3625,346.7281,267.3195,415.213" />
      </ECTransition>
      <ECTransition Source="STATE3" Destination="STATE5" Condition="1" x="1042.395" y="1239.526">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="210.5502,313.4688,314.0749,280.5485" />
      </ECTransition>
      <ECTransition Source="STATE5" Destination="STATE4" Condition="modoAlarme = 0" x="768.9833" y="1230.385">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="211.0552,304.2968,161.0878,321.8938" />
      </ECTransition>
      <ECTransition Source="STATE4" Destination="STATE5" Condition="1" x="858.8951" y="1037.704">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="195.3764,260.8038,244.5859,241.9513" />
      </ECTransition>
      <ECTransition Source="STATE5" Destination="START" Condition="1" x="1331.612" y="729.7059">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="339.6539,207.1025,327.5814,170.2505" />
      </ECTransition>
      <ECTransition Source="START" Destination="STATE6" Condition="NOT stsSensorHabilitado" x="1660.78" y="320.1744">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="391.505,75.78776,438.0497,77.45992" />
      </ECTransition>
      <ECTransition Source="STATE6" Destination="START" Condition="1" x="1671.739" y="474.7105">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="442.2721,122.8541,394.5888,121.1017" />
      </ECTransition>
    </ECC>
    <Algorithm Name="AlarmeHH">
      <ST><![CDATA[IF cmdHabilitaAlarmeHH AND (stsEntradaAlarme > stpAlarmeHH) THEN
	delayTime := DINT_TO_TIME(UINT_TO_DINT(stpTempoAlarmeHH) * 1000);
	
ELSIF cmdHabilitaAlarmeH AND (stsEntradaAlarme > stpAlarmeH) THEN
	delayTime := DINT_TO_TIME(UINT_TO_DINT(stpTempoAlarmeH) * 1000);
	
ELSIF cmdHabilitaAlarmeLL AND (stsEntradaAlarme < stpAlarmeLL) THEN
	delayTime := DINT_TO_TIME(UINT_TO_DINT(stpTempoAlarmeLL) * 1000);
	
ELSIF cmdHabilitaAlarmeL AND (stsEntradaAlarme < stpAlarmeL) THEN
	delayTime := DINT_TO_TIME(UINT_TO_DINT(stpTempoAlarmeL) * 1000);
END_IF
;]]></ST>
    </Algorithm>
    <Algorithm Name="AtivaAlarme">
      <ST><![CDATA[IF cmdHabilitaAlarmeHH AND (stsEntradaAlarme > stpAlarmeHH) THEN
	stsAlarmeHH := TRUE;
	
ELSIF cmdHabilitaAlarmeH AND (stsEntradaAlarme > stpAlarmeH) THEN
	stsAlarmeH := TRUE;
	
ELSIF cmdHabilitaAlarmeLL AND (stsEntradaAlarme < stpAlarmeLL) THEN
	stsAlarmeLL := TRUE;
	
ELSIF cmdHabilitaAlarmeL AND (stsEntradaAlarme < stpAlarmeL) THEN
	stsAlarmeL := TRUE;
END_IF
;]]></ST>
    </Algorithm>
    <Algorithm Name="ResetAlarmesManual">
      <ST><![CDATA[stsAlarmeHH := FALSE;
stsAlarmeH := FALSE;
stsAlarmeL := FALSE;
stsAlarmeLL := FALSE;
;]]></ST>
    </Algorithm>
    <Algorithm Name="ResetAlarmesAutomatico">
      <ST><![CDATA[IF cmdHabilitaAlarmeHH AND (stsEntradaAlarme <= stpAlarmeHH) THEN
   stsAlarmeHH := FALSE;
END_IF;

IF cmdHabilitaAlarmeH AND (stsEntradaAlarme <= stpAlarmeH) THEN
   stsAlarmeH := FALSE;
END_IF;

IF cmdHabilitaAlarmeLL AND (stsEntradaAlarme >= stpAlarmeLL) THEN
   stsAlarmeLL := FALSE;
END_IF;

IF cmdHabilitaAlarmeL AND (stsEntradaAlarme >= stpAlarmeL) THEN
   stsAlarmeL := FALSE;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="ResetAlarmesSensorDesabilitado">
      <ST><![CDATA[stsAlarmeHH := FALSE;
stsAlarmeH := FALSE;
stsAlarmeL := FALSE;
stsAlarmeLL := FALSE;
;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>