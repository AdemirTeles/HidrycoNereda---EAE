  </InterfaceList>
  <BasicFB ID="e5f6e7c1-b06d-4580-b72b-8258508c3ba1">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="algMarcaFimDelay,algReq,algMarcaReset" />
    <InternalVars>
      <VarDeclaration ID="C61AA7648953FEE4" Name="bResetPedido" Type="BOOL" />
      <VarDeclaration ID="0D1F8070B0B50B9E" Name="bTimerExpirou" Type="BOOL" />
      <VarDeclaration ID="9BDA289C7B0F683B" Name="bTimerAtivo" Type="BOOL" />
      <VarDeclaration ID="C80B30200E7644C3" Name="iNivelTimer" Type="INT" />
      <VarDeclaration ID="98D59377CD380165" Name="iNivelNovo" Type="INT" />
      <VarDeclaration ID="6492BDB8F65163E5" Name="timerCmd" Type="INT" />
      <VarDeclaration ID="178E85DF5AAC3748" Name="tNovo" Type="TIME" />
      <VarDeclaration ID="A08A8D65C20FF485" Name="bCondHH" Type="BOOL" />
      <VarDeclaration ID="AE85AA08E813A010" Name="bCondH" Type="BOOL" />
      <VarDeclaration ID="300D56215A7FA107" Name="bCondL" Type="BOOL" />
      <VarDeclaration ID="B448415932E15A12" Name="bCondLL" Type="BOOL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="1576.941" y="381.4117" />
      <ECState Name="AVALIA" x="2140" y="1748">
        <ECAction Algorithm="algReq" Output="CNF" />
      </ECState>
      <ECState Name="FIM_DELAY" x="2432" y="976.0001">
        <ECAction Algorithm="algMarcaFimDelay" />
      </ECState>
      <ECState Name="INICIA_DELAY" x="423.9999" y="504">
        <ECAction Output="START_DELAY" />
      </ECState>
