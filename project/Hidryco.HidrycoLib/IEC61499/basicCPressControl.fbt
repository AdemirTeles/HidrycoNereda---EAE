    </ECC>
    <Algorithm Name="ALG_INIT">
      <ST><![CDATA[cmdAbre_900_VA_1:=FALSE; cmdFecha_900_VA_1:=TRUE;
cmdAbre_900_VA_2:=FALSE; cmdFecha_900_VA_2:=TRUE;
cmdAbre_900_VA_3:=FALSE; cmdFecha_900_VA_3:=TRUE;
cmdAbre_900_VA_4:=FALSE; cmdFecha_900_VA_4:=TRUE;
cmdAbre_900_VA_5:=FALSE; cmdFecha_900_VA_5:=TRUE;
cmdAbre_900_VA_6:=FALSE; cmdFecha_900_VA_6:=TRUE;
cmdAbre_900_VA_7:=FALSE; cmdFecha_900_VA_7:=TRUE;
cmdAbre_900_VA_8:=FALSE; cmdFecha_900_VA_8:=TRUE;
cmdAbre_900_VA_9:=FALSE; cmdFecha_900_VA_9:=TRUE;
cmdAbre_900_VA_10:=FALSE; cmdFecha_900_VA_10:=TRUE;
cmdAbre_900_VA_11:=FALSE; cmdFecha_900_VA_11:=TRUE;
cmdAbre_900_VA_12:=FALSE; cmdFecha_900_VA_12:=TRUE;
cmdAbre_900_VA_13:=FALSE; cmdFecha_900_VA_13:=TRUE;

acmEquipamento1:=FALSE;
acmEquipamento2:=FALSE;
acmEquipamento3:=FALSE;

delayTimeOut:=T#0s;
timedPump:=0;
timerActive:=FALSE;
needStartDelay:=FALSE;

pump1InUse:=FALSE; pump2InUse:=FALSE; pump3InUse:=FALSE;
crossInUse:=FALSE;

cp1State:=0; cp2State:=0; cp3State:=0;
cp1Pump:=0;  cp2Pump:=0;  cp3Pump:=0;
cp1UsesCross:=FALSE; cp2UsesCross:=FALSE; cp3UsesCross:=FALSE;
lastPumpCP1:=0; lastPumpCP2:=0; lastPumpCP3:=0;

rotationNeeded:=FALSE;
cpTarget:=0;
cpNewPump:=0;
;]]></ST>
    </Algorithm>
    <Algorithm Name="ALG_MAIN">
      <ST><![CDATA[needStartDelay := FALSE;
 
(* ============================================================== *)
(* SEÇÃO 1: MODO AUTOMÁTICO                                       *)
(* ============================================================== *)
IF NOT cmdStsAutomatico THEN
	(* Estado seguro *)
	acmEquipamento1:=FALSE; acmEquipamento2:=FALSE; acmEquipamento3:=FALSE;
	cmdAbre_900_VA_1:=FALSE; cmdFecha_900_VA_1:=TRUE;
	cmdAbre_900_VA_2:=FALSE; cmdFecha_900_VA_2:=TRUE;
	cmdAbre_900_VA_3:=FALSE; cmdFecha_900_VA_3:=TRUE;
	cmdAbre_900_VA_4:=FALSE; cmdFecha_900_VA_4:=TRUE;
	cmdAbre_900_VA_5:=FALSE; cmdFecha_900_VA_5:=TRUE;
	cmdAbre_900_VA_6:=FALSE; cmdFecha_900_VA_6:=TRUE;
	cmdAbre_900_VA_7:=FALSE; cmdFecha_900_VA_7:=TRUE;
	cmdAbre_900_VA_8:=FALSE; cmdFecha_900_VA_8:=TRUE;
	cmdAbre_900_VA_9:=FALSE; cmdFecha_900_VA_9:=TRUE;
	cmdAbre_900_VA_10:=FALSE; cmdFecha_900_VA_10:=TRUE;
	cmdAbre_900_VA_11:=FALSE; cmdFecha_900_VA_11:=TRUE;
	cmdAbre_900_VA_12:=FALSE; cmdFecha_900_VA_12:=TRUE;
	cmdAbre_900_VA_13:=FALSE; cmdFecha_900_VA_13:=TRUE;
	pump1InUse:=FALSE; pump2InUse:=FALSE; pump3InUse:=FALSE;
	crossInUse:=FALSE;
	cp1State:=0; cp2State:=0; cp3State:=0;
	cp1Pump:=0; cp2Pump:=0; cp3Pump:=0;
	cp1UsesCross:=FALSE; cp2UsesCross:=FALSE; cp3UsesCross:=FALSE;
	rotationNeeded:=FALSE; timedPump:=0; timerActive:=FALSE;
	
ELSE
	(* Modo automático ativo *)
	
	(* ========================================================== *)
	(* SEÇÃO 2: VÁLVULAS DOS TANQUES                              *)
	(* ========================================================== *)
	IF stsDisponivel_900_VA_1 AND (stsAnimacao_900_VA_1 <> 2) THEN
		cmdAbre_900_VA_1:=TRUE; cmdFecha_900_VA_1:=FALSE;
	ELSE
		cmdAbre_900_VA_1:=FALSE; cmdFecha_900_VA_1:=TRUE;
	END_IF;
	IF stsDisponivel_900_VA_2 AND (stsAnimacao_900_VA_2 <> 2) THEN
		cmdAbre_900_VA_2:=TRUE; cmdFecha_900_VA_2:=FALSE;
	ELSE
		cmdAbre_900_VA_2:=FALSE; cmdFecha_900_VA_2:=TRUE;
	END_IF;
		
	tankAvailable := stsDisponivel_900_VA_1 OR stsDisponivel_900_VA_2;
	IF NOT tankAvailable THEN
		acmEquipamento1:=FALSE; acmEquipamento2:=FALSE; acmEquipamento3:=FALSE;
		IF cp1State = 2 THEN cp1State:=3; END_IF;
		IF cp2State = 2 THEN cp2State:=3; END_IF;
		IF cp3State = 2 THEN cp3State:=3; END_IF;
	END_IF;
		
		(* ========================================================== *)
		(* SEÇÃO 3: DISPONIBILIDADE + DETECÇÃO DE FALHA EM OPERAÇÃO   *)
		(* ========================================================== *)
	pump1Available := equipamentoDisponivel_1 AND (stsAnimacaoEquipamento1 <> 2);
	pump2Available := equipamentoDisponivel_2 AND (stsAnimacaoEquipamento2 <> 2);
	pump3Available := equipamentoDisponivel_3 AND (stsAnimacaoEquipamento3 <> 2);
	
    IF pump1InUse AND NOT pump1Available THEN
        IF cp1Pump=1 AND (cp1State=1 OR cp1State=2 OR cp1State=12) THEN cp1State:=3; END_IF;
        IF cp2Pump=1 AND (cp2State=1 OR cp2State=2 OR cp2State=12) THEN cp2State:=3; END_IF;
        IF cp3Pump=1 AND (cp3State=1 OR cp3State=2 OR cp3State=12) THEN cp3State:=3; END_IF;
    END_IF;
    IF pump2InUse AND NOT pump2Available THEN
        IF cp1Pump=2 AND (cp1State=1 OR cp1State=2 OR cp1State=12) THEN cp1State:=3; END_IF;
        IF cp2Pump=2 AND (cp2State=1 OR cp2State=2 OR cp2State=12) THEN cp2State:=3; END_IF;
        IF cp3Pump=2 AND (cp3State=1 OR cp3State=2 OR cp3State=12) THEN cp3State:=3; END_IF;
    END_IF;
    IF pump3InUse AND NOT pump3Available THEN
        IF cp1Pump=3 AND (cp1State=1 OR cp1State=2 OR cp1State=12) THEN cp1State:=3; END_IF;
        IF cp2Pump=3 AND (cp2State=1 OR cp2State=2 OR cp2State=12) THEN cp2State:=3; END_IF;
        IF cp3Pump=3 AND (cp3State=1 OR cp3State=2 OR cp3State=12) THEN cp3State:=3; END_IF;
    END_IF;
 
    IF crossInUse AND ((stsAnimacao_900_VA_9=2) OR (stsAnimacao_900_VA_10=2)) THEN
        IF cp1UsesCross AND (cp1State=1 OR cp1State=2 OR cp1State=12) THEN cp1State:=3; END_IF;
        IF cp2UsesCross AND (cp2State=1 OR cp2State=2 OR cp2State=12) THEN cp2State:=3; END_IF;
        IF cp3UsesCross AND (cp3State=1 OR cp3State=2 OR cp3State=12) THEN cp3State:=3; END_IF;
    END_IF;
		
	IF crossInUse AND ((stsAnimacao_900_VA_9=2) OR (stsAnimacao_900_VA_10=2)) THEN
		IF cp1UsesCross AND cp1State=2 THEN cp1State:=3; END_IF;
		IF cp2UsesCross AND cp2State=2 THEN cp2State:=3; END_IF;
		IF cp3UsesCross AND cp3State=2 THEN cp3State:=3; END_IF;
	END_IF;
		
		(* Timer: bomba temporizada saiu de operação *)
	IF timerActive THEN
		IF (timedPump=1 AND NOT pump1InUse) OR
			(timedPump=2 AND NOT pump2InUse) OR
			(timedPump=3 AND NOT pump3InUse) THEN
			timedPump:=0; timerActive:=FALSE;
		END_IF;
	END_IF;
		
		(* ========================================================== *)
		(* SEÇÃO 4: PARADAS (cpStop) — PRIORIDADE                     *)
		(* ========================================================== *)
	IF cpStop_1 THEN
		CASE cp1State OF
			1: cp1State:=4;
			2: CASE cp1Pump OF 1:acmEquipamento1:=FALSE; 2:acmEquipamento2:=FALSE; 3:acmEquipamento3:=FALSE; END_CASE; cp1State:=3;
			10: cp1State:=3;
			11: cp1State:=4;
			12: cp1State:=4;
		END_CASE;
	END_IF;
	IF cpStop_2 THEN
		CASE cp2State OF
			1: cp2State:=4;
			2: CASE cp2Pump OF 1:acmEquipamento1:=FALSE; 2:acmEquipamento2:=FALSE; 3:acmEquipamento3:=FALSE; END_CASE; cp2State:=3;
			10: cp2State:=3;
			11: cp2State:=4;
			12: cp2State:=4;
		END_CASE;
	END_IF;
	IF cpStop_3 THEN
		CASE cp3State OF
			1: cp3State:=4;
			2: CASE cp3Pump OF 1:acmEquipamento1:=FALSE; 2:acmEquipamento2:=FALSE; 3:acmEquipamento3:=FALSE; END_CASE; cp3State:=3;
			10: cp3State:=3;
			11: cp3State:=4;
			12: cp3State:=4;
		END_CASE;
	END_IF;
	
	    (* ========================================================== *)
    (* SEÇÃO 4B: RETOMADA POR PRIORIDADE (sem revezamento)        *)
    (* Se bomba está em CP não-prioritário e o CP prioritário     *)
    (* solicita, forçar liberação da bomba                         *)
    (* ========================================================== *)
    IF NOT cmdHabilitaRevezamento THEN
 
        (* Bomba 1: prioridade = CP1 *)
        IF cpRequest_1 AND NOT cpStop_1 AND cp1State=0 AND tankAvailable AND pump1Available THEN
            IF pump1InUse THEN
                IF cp2Pump=1 THEN
                    CASE cp2State OF
                        1: cp2State:=4;
                        2: acmEquipamento1:=FALSE; cp2State:=3;
                        10: cp2State:=3;
                        11: cp2State:=4;
                        12: cp2State:=4;
                    END_CASE;
                END_IF;
                IF cp3Pump=1 THEN
                    CASE cp3State OF
                        1: cp3State:=4;
                        2: acmEquipamento1:=FALSE; cp3State:=3;
                        10: cp3State:=3;
                        11: cp3State:=4;
                        12: cp3State:=4;
                    END_CASE;
                END_IF;
            END_IF;
        END_IF;
 
        (* Bomba 2: prioridade = CP2 *)
        IF cpRequest_2 AND NOT cpStop_2 AND cp2State=0 AND tankAvailable AND pump2Available THEN
            IF pump2InUse THEN
                IF cp1Pump=2 THEN
                    CASE cp1State OF
                        1: cp1State:=4;
                        2: acmEquipamento2:=FALSE; cp1State:=3;
                        10: cp1State:=3;
                        11: cp1State:=4;
                        12: cp1State:=4;
                    END_CASE;
                END_IF;
                IF cp3Pump=2 THEN
                    CASE cp3State OF
                        1: cp3State:=4;
                        2: acmEquipamento2:=FALSE; cp3State:=3;
                        10: cp3State:=3;
                        11: cp3State:=4;
                        12: cp3State:=4;
                    END_CASE;
                END_IF;
            END_IF;
        END_IF;
 
        (* Bomba 3: prioridade = CP3 *)
        IF cpRequest_3 AND NOT cpStop_3 AND cp3State=0 AND tankAvailable AND pump3Available THEN
            IF pump3InUse THEN
                IF cp1Pump=3 THEN
                    CASE cp1State OF
                        1: cp1State:=4;
                        2: acmEquipamento3:=FALSE; cp1State:=3;
                        10: cp1State:=3;
                        11: cp1State:=4;
                        12: cp1State:=4;
                    END_CASE;
                END_IF;
                IF cp2Pump=3 THEN
                    CASE cp2State OF
                        1: cp2State:=4;
                        2: acmEquipamento3:=FALSE; cp2State:=3;
                        10: cp2State:=3;
                        11: cp2State:=4;
                        12: cp2State:=4;
                    END_CASE;
                END_IF;
            END_IF;
        END_IF;
 
    END_IF;
		
		(* ========================================================== *)
		(* SEÇÃO 5: REVEZAMENTO PENDENTE                              *)
		(* ========================================================== *)
	IF rotationNeeded THEN
		rotationNeeded:=FALSE;
		cpTarget:=0;
		IF cp1Pump=timedPump AND cp1State=2 AND NOT cpStop_1 THEN cpTarget:=1;
		ELSIF cp2Pump=timedPump AND cp2State=2 AND NOT cpStop_2 THEN cpTarget:=2;
		ELSIF cp3Pump=timedPump AND cp3State=2 AND NOT cpStop_3 THEN cpTarget:=3;
		END_IF;
			
		IF cpTarget > 0 THEN
			cpNewPump:=0;
			CASE timedPump OF
				1: IF pump2Available AND NOT pump2InUse THEN cpNewPump:=2; ELSIF pump3Available AND NOT pump3InUse THEN cpNewPump:=3; END_IF;
				2: IF pump3Available AND NOT pump3InUse THEN cpNewPump:=3; ELSIF pump1Available AND NOT pump1InUse THEN cpNewPump:=1; END_IF;
				3: IF pump1Available AND NOT pump1InUse THEN cpNewPump:=1; ELSIF pump2Available AND NOT pump2InUse THEN cpNewPump:=2; END_IF;
			END_CASE;
				
			IF cpNewPump > 0 THEN
				IF NOT ((cpTarget=1 AND cpNewPump=1) OR (cpTarget=2 AND cpNewPump=2) OR (cpTarget=3 AND cpNewPump=3)) THEN
					CASE cpTarget OF
						1: IF crossInUse AND NOT cp1UsesCross THEN cpNewPump:=0; END_IF;
						2: IF crossInUse AND NOT cp2UsesCross THEN cpNewPump:=0; END_IF;
						3: IF crossInUse AND NOT cp3UsesCross THEN cpNewPump:=0; END_IF;
					END_CASE;
				END_IF;
			END_IF;
				
			IF cpNewPump > 0 THEN
				CASE timedPump OF 1:acmEquipamento1:=FALSE; 2:acmEquipamento2:=FALSE; 3:acmEquipamento3:=FALSE; END_CASE;
				CASE cpTarget OF 1:cp1State:=10; 2:cp2State:=10; 3:cp3State:=10; END_CASE;
			ELSE
				needStartDelay:=TRUE;
				CASE timedPump OF
					1: delayTimeOut:=stpTempoRevezamentoEquipamento1;
					2: delayTimeOut:=stpTempoRevezamentoEquipamento2;
					3: delayTimeOut:=stpTempoRevezamentoEquipamento3;
				END_CASE;
				timerActive:=TRUE;
			END_IF;
		END_IF;
	END_IF;
		
		(* ========================================================== *)
		(* SEÇÃO 6: SEQUÊNCIA DE REVEZAMENTO (10/11/12)               *)
		(* ========================================================== *)
		
		(* CP1 - AD-01: BO-01=VA3,6,11 | BO-02=VA4,7,9,11 | BO-03=VA5,8,10,9,11 *)
	IF cp1State=10 THEN
		CASE cp1Pump OF 1:acmEquipamento1:=FALSE; 2:acmEquipamento2:=FALSE; 3:acmEquipamento3:=FALSE; END_CASE;
		IF (cp1Pump=1 AND stsAnimacaoEquipamento1=0) OR (cp1Pump=2 AND stsAnimacaoEquipamento2=0) OR (cp1Pump=3 AND stsAnimacaoEquipamento3=0) THEN
			CASE cp1Pump OF 1:pump1InUse:=FALSE; 2:pump2InUse:=FALSE; 3:pump3InUse:=FALSE; END_CASE;
			IF cp1UsesCross THEN crossInUse:=FALSE; cp1UsesCross:=FALSE; END_IF;
			lastPumpCP1:=cp1Pump; cp1State:=11;
		END_IF;
	END_IF;
	IF cp1State=11 THEN
		cp1Pump:=cpNewPump; cpNewPump:=0;
		CASE cp1Pump OF 1:pump1InUse:=TRUE; 2:pump2InUse:=TRUE; 3:pump3InUse:=TRUE; END_CASE;
		IF cp1Pump<>1 THEN cp1UsesCross:=TRUE; crossInUse:=TRUE; ELSE cp1UsesCross:=FALSE; END_IF;
		cp1State:=12;
	END_IF;
	IF cp1State=12 THEN
		CASE cp1Pump OF
			1: IF (stsAnimacao_900_VA_3=1) AND (stsAnimacao_900_VA_6=1) AND (stsAnimacao_900_VA_11=1) THEN
					acmEquipamento1:=TRUE; cp1State:=2;
					IF cmdHabilitaRevezamento THEN timedPump:=1; delayTimeOut:=stpTempoRevezamentoEquipamento1; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
			2: IF (stsAnimacao_900_VA_4=1) AND (stsAnimacao_900_VA_7=1) AND (stsAnimacao_900_VA_9=1) AND (stsAnimacao_900_VA_11=1) THEN
					acmEquipamento2:=TRUE; cp1State:=2;
					IF cmdHabilitaRevezamento THEN timedPump:=2; delayTimeOut:=stpTempoRevezamentoEquipamento2; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
			3: IF (stsAnimacao_900_VA_5=1) AND (stsAnimacao_900_VA_8=1) AND (stsAnimacao_900_VA_10=1) AND (stsAnimacao_900_VA_9=1) AND (stsAnimacao_900_VA_11=1) THEN
					acmEquipamento3:=TRUE; cp1State:=2;
					IF cmdHabilitaRevezamento THEN timedPump:=3; delayTimeOut:=stpTempoRevezamentoEquipamento3; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
		END_CASE;
	END_IF;
		
		(* CP2 - AD-02: BO-01=VA3,6,9,10,13 | BO-02=VA4,7,10,13 | BO-03=VA5,8,13 *)
	IF cp2State=10 THEN
		CASE cp2Pump OF 1:acmEquipamento1:=FALSE; 2:acmEquipamento2:=FALSE; 3:acmEquipamento3:=FALSE; END_CASE;
		IF (cp2Pump=1 AND stsAnimacaoEquipamento1=0) OR (cp2Pump=2 AND stsAnimacaoEquipamento2=0) OR (cp2Pump=3 AND stsAnimacaoEquipamento3=0) THEN
			CASE cp2Pump OF 1:pump1InUse:=FALSE; 2:pump2InUse:=FALSE; 3:pump3InUse:=FALSE; END_CASE;
			IF cp2UsesCross THEN crossInUse:=FALSE; cp2UsesCross:=FALSE; END_IF;
			lastPumpCP2:=cp2Pump; cp2State:=11;
		END_IF;
	END_IF;
	IF cp2State=11 THEN
		cp2Pump:=cpNewPump; cpNewPump:=0;
		CASE cp2Pump OF 1:pump1InUse:=TRUE; 2:pump2InUse:=TRUE; 3:pump3InUse:=TRUE; END_CASE;
		IF cp2Pump<>2 THEN cp2UsesCross:=TRUE; crossInUse:=TRUE; ELSE cp2UsesCross:=FALSE; END_IF;
		cp2State:=12;
	END_IF;
	IF cp2State=12 THEN
		CASE cp2Pump OF
			1: IF (stsAnimacao_900_VA_3=1) AND (stsAnimacao_900_VA_6=1) AND (stsAnimacao_900_VA_9=1) AND (stsAnimacao_900_VA_10=1) AND (stsAnimacao_900_VA_13=1) THEN
					acmEquipamento1:=TRUE; cp2State:=2;
					IF cmdHabilitaRevezamento THEN timedPump:=1; delayTimeOut:=stpTempoRevezamentoEquipamento1; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
			2: IF (stsAnimacao_900_VA_4=1) AND (stsAnimacao_900_VA_7=1) AND (stsAnimacao_900_VA_10=1) AND (stsAnimacao_900_VA_13=1) THEN
					acmEquipamento2:=TRUE; cp2State:=2;
					IF cmdHabilitaRevezamento THEN timedPump:=2; delayTimeOut:=stpTempoRevezamentoEquipamento2; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
			3: IF (stsAnimacao_900_VA_5=1) AND (stsAnimacao_900_VA_8=1) AND (stsAnimacao_900_VA_13=1) THEN
					acmEquipamento3:=TRUE; cp2State:=2;
					IF cmdHabilitaRevezamento THEN timedPump:=3; delayTimeOut:=stpTempoRevezamentoEquipamento3; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
		END_CASE;
	END_IF;
		
		(* CP3 - AD-03: BO-01=VA3,6,9,10,12 | BO-02=VA4,7,10,12 | BO-03=VA5,8,12 *)
	IF cp3State=10 THEN
		CASE cp3Pump OF 1:acmEquipamento1:=FALSE; 2:acmEquipamento2:=FALSE; 3:acmEquipamento3:=FALSE; END_CASE;
		IF (cp3Pump=1 AND stsAnimacaoEquipamento1=0) OR (cp3Pump=2 AND stsAnimacaoEquipamento2=0) OR (cp3Pump=3 AND stsAnimacaoEquipamento3=0) THEN
			CASE cp3Pump OF 1:pump1InUse:=FALSE; 2:pump2InUse:=FALSE; 3:pump3InUse:=FALSE; END_CASE;
			IF cp3UsesCross THEN crossInUse:=FALSE; cp3UsesCross:=FALSE; END_IF;
			lastPumpCP3:=cp3Pump; cp3State:=11;
		END_IF;
	END_IF;
	IF cp3State=11 THEN
		cp3Pump:=cpNewPump; cpNewPump:=0;
		CASE cp3Pump OF 1:pump1InUse:=TRUE; 2:pump2InUse:=TRUE; 3:pump3InUse:=TRUE; END_CASE;
		IF cp3Pump<>3 THEN cp3UsesCross:=TRUE; crossInUse:=TRUE; ELSE cp3UsesCross:=FALSE; END_IF;
		cp3State:=12;
	END_IF;
	IF cp3State=12 THEN
		CASE cp3Pump OF
			1: IF (stsAnimacao_900_VA_3=1) AND (stsAnimacao_900_VA_6=1) AND (stsAnimacao_900_VA_9=1) AND (stsAnimacao_900_VA_10=1) AND (stsAnimacao_900_VA_12=1) THEN
					acmEquipamento1:=TRUE; cp3State:=2;
					IF cmdHabilitaRevezamento THEN timedPump:=1; delayTimeOut:=stpTempoRevezamentoEquipamento1; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
			2: IF (stsAnimacao_900_VA_4=1) AND (stsAnimacao_900_VA_7=1) AND (stsAnimacao_900_VA_10=1) AND (stsAnimacao_900_VA_12=1) THEN
					acmEquipamento2:=TRUE; cp3State:=2;
					IF cmdHabilitaRevezamento THEN timedPump:=2; delayTimeOut:=stpTempoRevezamentoEquipamento2; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
			3: IF (stsAnimacao_900_VA_5=1) AND (stsAnimacao_900_VA_8=1) AND (stsAnimacao_900_VA_12=1) THEN
					acmEquipamento3:=TRUE; cp3State:=2;
					IF cmdHabilitaRevezamento THEN timedPump:=3; delayTimeOut:=stpTempoRevezamentoEquipamento3; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
		END_CASE;
	END_IF;
		
		(* ========================================================== *)
		(* SEÇÃO 7: REQUESTS (cpRequest)                              *)
		(* ========================================================== *)
		
		(* CP1 *)
	IF cpRequest_1 AND NOT cpStop_1 AND cp1State=0 AND tankAvailable THEN
		cp1Pump:=0;
		IF cmdHabilitaRevezamento THEN
			IF lastPumpCP1=0 THEN lastPumpCP1:=3; END_IF;
			CASE lastPumpCP1 OF
				1: IF pump2Available AND NOT pump2InUse THEN cp1Pump:=2; ELSIF pump3Available AND NOT pump3InUse THEN cp1Pump:=3; ELSIF pump1Available AND NOT pump1InUse THEN cp1Pump:=1; END_IF;
				2: IF pump3Available AND NOT pump3InUse THEN cp1Pump:=3; ELSIF pump1Available AND NOT pump1InUse THEN cp1Pump:=1; ELSIF pump2Available AND NOT pump2InUse THEN cp1Pump:=2; END_IF;
				3: IF pump1Available AND NOT pump1InUse THEN cp1Pump:=1; ELSIF pump2Available AND NOT pump2InUse THEN cp1Pump:=2; ELSIF pump3Available AND NOT pump3InUse THEN cp1Pump:=3; END_IF;
			END_CASE;
		ELSE
			IF pump1Available AND NOT pump1InUse THEN cp1Pump:=1; ELSIF pump2Available AND NOT pump2InUse THEN cp1Pump:=2; ELSIF pump3Available AND NOT pump3InUse THEN cp1Pump:=3; END_IF;
		END_IF;
		IF cp1Pump>0 THEN
			IF cp1Pump<>1 THEN IF crossInUse THEN cp1Pump:=0; ELSE cp1UsesCross:=TRUE; crossInUse:=TRUE; END_IF; ELSE cp1UsesCross:=FALSE; END_IF;
		END_IF;
		IF cp1Pump>0 THEN
			CASE cp1Pump OF 1:pump1InUse:=TRUE; 2:pump2InUse:=TRUE; 3:pump3InUse:=TRUE; END_CASE;
			cp1State:=1;
		END_IF;
	END_IF;
		
		(* CP2 *)
	IF cpRequest_2 AND NOT cpStop_2 AND cp2State=0 AND tankAvailable THEN
		cp2Pump:=0;
		IF cmdHabilitaRevezamento THEN
			IF lastPumpCP2=0 THEN lastPumpCP2:=1; END_IF;
			CASE lastPumpCP2 OF
				1: IF pump2Available AND NOT pump2InUse THEN cp2Pump:=2; ELSIF pump3Available AND NOT pump3InUse THEN cp2Pump:=3; ELSIF pump1Available AND NOT pump1InUse THEN cp2Pump:=1; END_IF;
				2: IF pump3Available AND NOT pump3InUse THEN cp2Pump:=3; ELSIF pump1Available AND NOT pump1InUse THEN cp2Pump:=1; ELSIF pump2Available AND NOT pump2InUse THEN cp2Pump:=2; END_IF;
				3: IF pump1Available AND NOT pump1InUse THEN cp2Pump:=1; ELSIF pump2Available AND NOT pump2InUse THEN cp2Pump:=2; ELSIF pump3Available AND NOT pump3InUse THEN cp2Pump:=3; END_IF;
			END_CASE;
		ELSE
			IF pump2Available AND NOT pump2InUse THEN cp2Pump:=2; ELSIF pump1Available AND NOT pump1InUse THEN cp2Pump:=1; ELSIF pump3Available AND NOT pump3InUse THEN cp2Pump:=3; END_IF;
		END_IF;
		IF cp2Pump>0 THEN
			IF cp2Pump<>2 THEN IF crossInUse THEN cp2Pump:=0; ELSE cp2UsesCross:=TRUE; crossInUse:=TRUE; END_IF; ELSE cp2UsesCross:=FALSE; END_IF;
		END_IF;
		IF cp2Pump>0 THEN
			CASE cp2Pump OF 1:pump1InUse:=TRUE; 2:pump2InUse:=TRUE; 3:pump3InUse:=TRUE; END_CASE;
			cp2State:=1;
		END_IF;
	END_IF;
		
		(* CP3 *)
	IF cpRequest_3 AND NOT cpStop_3 AND cp3State=0 AND tankAvailable THEN
		cp3Pump:=0;
		IF cmdHabilitaRevezamento THEN
			IF lastPumpCP3=0 THEN lastPumpCP3:=2; END_IF;
			CASE lastPumpCP3 OF
				1: IF pump2Available AND NOT pump2InUse THEN cp3Pump:=2; ELSIF pump3Available AND NOT pump3InUse THEN cp3Pump:=3; ELSIF pump1Available AND NOT pump1InUse THEN cp3Pump:=1; END_IF;
				2: IF pump3Available AND NOT pump3InUse THEN cp3Pump:=3; ELSIF pump1Available AND NOT pump1InUse THEN cp3Pump:=1; ELSIF pump2Available AND NOT pump2InUse THEN cp3Pump:=2; END_IF;
				3: IF pump1Available AND NOT pump1InUse THEN cp3Pump:=1; ELSIF pump2Available AND NOT pump2InUse THEN cp3Pump:=2; ELSIF pump3Available AND NOT pump3InUse THEN cp3Pump:=3; END_IF;
			END_CASE;
		ELSE
			IF pump3Available AND NOT pump3InUse THEN cp3Pump:=3; ELSIF pump1Available AND NOT pump1InUse THEN cp3Pump:=1; ELSIF pump2Available AND NOT pump2InUse THEN cp3Pump:=2; END_IF;
		END_IF;
		IF cp3Pump>0 THEN
			IF cp3Pump<>3 THEN IF crossInUse THEN cp3Pump:=0; ELSE cp3UsesCross:=TRUE; crossInUse:=TRUE; END_IF; ELSE cp3UsesCross:=FALSE; END_IF;
		END_IF;
		IF cp3Pump>0 THEN
			CASE cp3Pump OF 1:pump1InUse:=TRUE; 2:pump2InUse:=TRUE; 3:pump3InUse:=TRUE; END_CASE;
			cp3State:=1;
		END_IF;
	END_IF;
		
		(* ========================================================== *)
		(* SEÇÃO 8: ABERTURA VÁLVULAS → LIGAR BOMBA (estado 1 → 2)   *)
		(* ========================================================== *)
		
		(* CP1 - AD-01: BO-01=VA3,6,11 | BO-02=VA4,7,9,11 | BO-03=VA5,8,10,9,11 *)
	IF cp1State=1 AND NOT cpStop_1 THEN
		CASE cp1Pump OF
			1: IF (stsAnimacao_900_VA_3=1) AND (stsAnimacao_900_VA_6=1) AND (stsAnimacao_900_VA_11=1) THEN
					acmEquipamento1:=TRUE; cp1State:=2;
					IF cmdHabilitaRevezamento AND NOT timerActive THEN timedPump:=1; delayTimeOut:=stpTempoRevezamentoEquipamento1; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
			2: IF (stsAnimacao_900_VA_4=1) AND (stsAnimacao_900_VA_7=1) AND (stsAnimacao_900_VA_9=1) AND (stsAnimacao_900_VA_11=1) THEN
					acmEquipamento2:=TRUE; cp1State:=2;
					IF cmdHabilitaRevezamento AND NOT timerActive THEN timedPump:=2; delayTimeOut:=stpTempoRevezamentoEquipamento2; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
			3: IF (stsAnimacao_900_VA_5=1) AND (stsAnimacao_900_VA_8=1) AND (stsAnimacao_900_VA_10=1) AND (stsAnimacao_900_VA_9=1) AND (stsAnimacao_900_VA_11=1) THEN
					acmEquipamento3:=TRUE; cp1State:=2;
					IF cmdHabilitaRevezamento AND NOT timerActive THEN timedPump:=3; delayTimeOut:=stpTempoRevezamentoEquipamento3; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
		END_CASE;
	END_IF;
	
		(* CP2 - AD-02: BO-01=VA3,6,9,10,13 | BO-02=VA4,7,10,13 | BO-03=VA5,8,13 *)
	IF cp2State=1 AND NOT cpStop_2 THEN
		CASE cp2Pump OF
			1: IF (stsAnimacao_900_VA_3=1) AND (stsAnimacao_900_VA_6=1) AND (stsAnimacao_900_VA_9=1) AND (stsAnimacao_900_VA_10=1) AND (stsAnimacao_900_VA_13=1) THEN
					acmEquipamento1:=TRUE; cp2State:=2;
					IF cmdHabilitaRevezamento AND NOT timerActive THEN timedPump:=1; delayTimeOut:=stpTempoRevezamentoEquipamento1; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
			2: IF (stsAnimacao_900_VA_4=1) AND (stsAnimacao_900_VA_7=1) AND (stsAnimacao_900_VA_10=1) AND (stsAnimacao_900_VA_13=1) THEN
					acmEquipamento2:=TRUE; cp2State:=2;
					IF cmdHabilitaRevezamento AND NOT timerActive THEN timedPump:=2; delayTimeOut:=stpTempoRevezamentoEquipamento2; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
			3: IF (stsAnimacao_900_VA_5=1) AND (stsAnimacao_900_VA_8=1) AND (stsAnimacao_900_VA_13=1) THEN
					acmEquipamento3:=TRUE; cp2State:=2;
					IF cmdHabilitaRevezamento AND NOT timerActive THEN timedPump:=3; delayTimeOut:=stpTempoRevezamentoEquipamento3; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
		END_CASE;
	END_IF;
	
		(* CP3 - AD-03: BO-01=VA3,6,9,10,12 | BO-02=VA4,7,10,12 | BO-03=VA5,8,12 *)
	IF cp3State=1 AND NOT cpStop_3 THEN
		CASE cp3Pump OF
			1: IF (stsAnimacao_900_VA_3=1) AND (stsAnimacao_900_VA_6=1) AND (stsAnimacao_900_VA_9=1) AND (stsAnimacao_900_VA_10=1) AND (stsAnimacao_900_VA_12=1) THEN
					acmEquipamento1:=TRUE; cp3State:=2;
					IF cmdHabilitaRevezamento AND NOT timerActive THEN timedPump:=1; delayTimeOut:=stpTempoRevezamentoEquipamento1; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
			2: IF (stsAnimacao_900_VA_4=1) AND (stsAnimacao_900_VA_7=1) AND (stsAnimacao_900_VA_10=1) AND (stsAnimacao_900_VA_12=1) THEN
					acmEquipamento2:=TRUE; cp3State:=2;
					IF cmdHabilitaRevezamento AND NOT timerActive THEN timedPump:=2; delayTimeOut:=stpTempoRevezamentoEquipamento2; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
			3: IF (stsAnimacao_900_VA_5=1) AND (stsAnimacao_900_VA_8=1) AND (stsAnimacao_900_VA_12=1) THEN
					acmEquipamento3:=TRUE; cp3State:=2;
					IF cmdHabilitaRevezamento AND NOT timerActive THEN timedPump:=3; delayTimeOut:=stpTempoRevezamentoEquipamento3; timerActive:=TRUE; needStartDelay:=TRUE; END_IF;
			END_IF;
		END_CASE;
	END_IF;
		
		(* ========================================================== *)
		(* SEÇÃO 9: PARADA (estados 3 e 4)                            *)
		(* ========================================================== *)
	IF cp1State=3 THEN
		CASE cp1Pump OF 1:acmEquipamento1:=FALSE; 2:acmEquipamento2:=FALSE; 3:acmEquipamento3:=FALSE; END_CASE;
		IF (cp1Pump=1 AND stsAnimacaoEquipamento1=0) OR (cp1Pump=2 AND stsAnimacaoEquipamento2=0) OR (cp1Pump=3 AND stsAnimacaoEquipamento3=0) OR (cp1Pump=0) THEN cp1State:=4; END_IF;
	END_IF;
	IF cp2State=3 THEN
		CASE cp2Pump OF 1:acmEquipamento1:=FALSE; 2:acmEquipamento2:=FALSE; 3:acmEquipamento3:=FALSE; END_CASE;
		IF (cp2Pump=1 AND stsAnimacaoEquipamento1=0) OR (cp2Pump=2 AND stsAnimacaoEquipamento2=0) OR (cp2Pump=3 AND stsAnimacaoEquipamento3=0) OR (cp2Pump=0) THEN cp2State:=4; END_IF;
	END_IF;
	IF cp3State=3 THEN
		CASE cp3Pump OF 1:acmEquipamento1:=FALSE; 2:acmEquipamento2:=FALSE; 3:acmEquipamento3:=FALSE; END_CASE;
		IF (cp3Pump=1 AND stsAnimacaoEquipamento1=0) OR (cp3Pump=2 AND stsAnimacaoEquipamento2=0) OR (cp3Pump=3 AND stsAnimacaoEquipamento3=0) OR (cp3Pump=0) THEN cp3State:=4; END_IF;
	END_IF;
		
	IF cp1State=4 THEN
		CASE cp1Pump OF 1:pump1InUse:=FALSE; 2:pump2InUse:=FALSE; 3:pump3InUse:=FALSE; END_CASE;
		IF cp1UsesCross THEN crossInUse:=FALSE; cp1UsesCross:=FALSE; END_IF;
		lastPumpCP1:=cp1Pump; cp1Pump:=0; cp1State:=0;
	END_IF;
	IF cp2State=4 THEN
		CASE cp2Pump OF 1:pump1InUse:=FALSE; 2:pump2InUse:=FALSE; 3:pump3InUse:=FALSE; END_CASE;
		IF cp2UsesCross THEN crossInUse:=FALSE; cp2UsesCross:=FALSE; END_IF;
		lastPumpCP2:=cp2Pump; cp2Pump:=0; cp2State:=0;
	END_IF;
	IF cp3State=4 THEN
		CASE cp3Pump OF 1:pump1InUse:=FALSE; 2:pump2InUse:=FALSE; 3:pump3InUse:=FALSE; END_CASE;
		IF cp3UsesCross THEN crossInUse:=FALSE; cp3UsesCross:=FALSE; END_IF;
		lastPumpCP3:=cp3Pump; cp3Pump:=0; cp3State:=0;
	END_IF;
		
		(* ========================================================== *)
		(* SEÇÃO 10: GERAÇÃO DE COMANDOS DE VÁLVULAS                  *)
		(* CP1=AD-01 usa VA-11 | CP2=AD-02 usa VA-13 | CP3=AD-03 usa VA-12 *)
		(* ========================================================== *)
	reqVA3:=FALSE; reqVA4:=FALSE; reqVA5:=FALSE;
	reqVA6:=FALSE; reqVA7:=FALSE; reqVA8:=FALSE;
	reqVA9:=FALSE; reqVA10:=FALSE;
	reqVA11:=FALSE; reqVA12:=FALSE; reqVA13:=FALSE;
	
		(* CP1 - AD-01 *)
	IF (cp1State=1) OR (cp1State=2) OR (cp1State=3) OR (cp1State=10) OR (cp1State=12) THEN
		CASE cp1Pump OF
			1: reqVA3:=TRUE; reqVA6:=TRUE; reqVA11:=TRUE;
			2: reqVA4:=TRUE; reqVA7:=TRUE; reqVA9:=TRUE; reqVA11:=TRUE;
			3: reqVA5:=TRUE; reqVA8:=TRUE; reqVA10:=TRUE; reqVA9:=TRUE; reqVA11:=TRUE;
		END_CASE;
	END_IF;
		(* CP2 - AD-02: BO-01=VA3,6,9,10,13 | BO-02=VA4,7,10,13 | BO-03=VA5,8,13 *)
	IF (cp2State=1) OR (cp2State=2) OR (cp2State=3) OR (cp2State=10) OR (cp2State=12) THEN
		CASE cp2Pump OF
			1: reqVA3:=TRUE; reqVA6:=TRUE; reqVA9:=TRUE; reqVA10:=TRUE; reqVA13:=TRUE;
			2: reqVA4:=TRUE; reqVA7:=TRUE; reqVA10:=TRUE; reqVA13:=TRUE;
			3: reqVA5:=TRUE; reqVA8:=TRUE; reqVA13:=TRUE;
		END_CASE;
	END_IF;
		(* CP3 - AD-03: BO-01=VA3,6,9,10,12 | BO-02=VA4,7,10,12 | BO-03=VA5,8,12 *)
	IF (cp3State=1) OR (cp3State=2) OR (cp3State=3) OR (cp3State=10) OR (cp3State=12) THEN
		CASE cp3Pump OF
			1: reqVA3:=TRUE; reqVA6:=TRUE; reqVA9:=TRUE; reqVA10:=TRUE; reqVA12:=TRUE;
			2: reqVA4:=TRUE; reqVA7:=TRUE; reqVA10:=TRUE; reqVA12:=TRUE;
			3: reqVA5:=TRUE; reqVA8:=TRUE; reqVA12:=TRUE;
		END_CASE;
	END_IF;
		
		(* Aplicar comandos com verificação de falha *)
	IF stsAnimacao_900_VA_3<>2  THEN cmdAbre_900_VA_3:=reqVA3;   cmdFecha_900_VA_3:=NOT reqVA3;   ELSE cmdAbre_900_VA_3:=FALSE;  cmdFecha_900_VA_3:=FALSE;  END_IF;
	IF stsAnimacao_900_VA_4<>2  THEN cmdAbre_900_VA_4:=reqVA4;   cmdFecha_900_VA_4:=NOT reqVA4;   ELSE cmdAbre_900_VA_4:=FALSE;  cmdFecha_900_VA_4:=FALSE;  END_IF;
	IF stsAnimacao_900_VA_5<>2  THEN cmdAbre_900_VA_5:=reqVA5;   cmdFecha_900_VA_5:=NOT reqVA5;   ELSE cmdAbre_900_VA_5:=FALSE;  cmdFecha_900_VA_5:=FALSE;  END_IF;
	IF stsAnimacao_900_VA_6<>2  THEN cmdAbre_900_VA_6:=reqVA6;   cmdFecha_900_VA_6:=NOT reqVA6;   ELSE cmdAbre_900_VA_6:=FALSE;  cmdFecha_900_VA_6:=FALSE;  END_IF;
	IF stsAnimacao_900_VA_7<>2  THEN cmdAbre_900_VA_7:=reqVA7;   cmdFecha_900_VA_7:=NOT reqVA7;   ELSE cmdAbre_900_VA_7:=FALSE;  cmdFecha_900_VA_7:=FALSE;  END_IF;
	IF stsAnimacao_900_VA_8<>2  THEN cmdAbre_900_VA_8:=reqVA8;   cmdFecha_900_VA_8:=NOT reqVA8;   ELSE cmdAbre_900_VA_8:=FALSE;  cmdFecha_900_VA_8:=FALSE;  END_IF;
	IF stsAnimacao_900_VA_9<>2  THEN cmdAbre_900_VA_9:=reqVA9;   cmdFecha_900_VA_9:=NOT reqVA9;   ELSE cmdAbre_900_VA_9:=FALSE;  cmdFecha_900_VA_9:=FALSE;  END_IF;
	IF stsAnimacao_900_VA_10<>2 THEN cmdAbre_900_VA_10:=reqVA10; cmdFecha_900_VA_10:=NOT reqVA10; ELSE cmdAbre_900_VA_10:=FALSE; cmdFecha_900_VA_10:=FALSE; END_IF;
	IF stsAnimacao_900_VA_11<>2 THEN cmdAbre_900_VA_11:=reqVA11; cmdFecha_900_VA_11:=NOT reqVA11; ELSE cmdAbre_900_VA_11:=FALSE; cmdFecha_900_VA_11:=FALSE; END_IF;
	IF stsAnimacao_900_VA_12<>2 THEN cmdAbre_900_VA_12:=reqVA12; cmdFecha_900_VA_12:=NOT reqVA12; ELSE cmdAbre_900_VA_12:=FALSE; cmdFecha_900_VA_12:=FALSE; END_IF;
	IF stsAnimacao_900_VA_13<>2 THEN cmdAbre_900_VA_13:=reqVA13; cmdFecha_900_VA_13:=NOT reqVA13; ELSE cmdAbre_900_VA_13:=FALSE; cmdFecha_900_VA_13:=FALSE; END_IF;
		
		(* ========================================================== *)
		(* SEÇÃO 11: INTERTRAVAMENTOS — DUPLA PROTEÇÃO                *)
		(* CP2=AD-02 usa VA-13 | CP3=AD-03 usa VA-12                 *)
		(* ========================================================== *)
	IF acmEquipamento1 THEN
		IF NOT (
			(cp1Pump=1 AND cp1State=2 AND stsAnimacao_900_VA_3=1 AND stsAnimacao_900_VA_6=1 AND stsAnimacao_900_VA_11=1)
			OR (cp2Pump=1 AND cp2State=2 AND stsAnimacao_900_VA_3=1 AND stsAnimacao_900_VA_6=1 AND stsAnimacao_900_VA_9=1 AND stsAnimacao_900_VA_10=1 AND stsAnimacao_900_VA_13=1)
			OR (cp3Pump=1 AND cp3State=2 AND stsAnimacao_900_VA_3=1 AND stsAnimacao_900_VA_6=1 AND stsAnimacao_900_VA_9=1 AND stsAnimacao_900_VA_10=1 AND stsAnimacao_900_VA_12=1)
			) THEN acmEquipamento1:=FALSE; END_IF;
	END_IF;
	IF acmEquipamento2 THEN
		IF NOT (
			(cp1Pump=2 AND cp1State=2 AND stsAnimacao_900_VA_4=1 AND stsAnimacao_900_VA_7=1 AND stsAnimacao_900_VA_9=1 AND stsAnimacao_900_VA_11=1)
			OR (cp2Pump=2 AND cp2State=2 AND stsAnimacao_900_VA_4=1 AND stsAnimacao_900_VA_7=1 AND stsAnimacao_900_VA_10=1 AND stsAnimacao_900_VA_13=1)
			OR (cp3Pump=2 AND cp3State=2 AND stsAnimacao_900_VA_4=1 AND stsAnimacao_900_VA_7=1 AND stsAnimacao_900_VA_10=1 AND stsAnimacao_900_VA_12=1)
			) THEN acmEquipamento2:=FALSE; END_IF;
	END_IF;
	IF acmEquipamento3 THEN
		IF NOT (
			(cp1Pump=3 AND cp1State=2 AND stsAnimacao_900_VA_5=1 AND stsAnimacao_900_VA_8=1 AND stsAnimacao_900_VA_10=1 AND stsAnimacao_900_VA_9=1 AND stsAnimacao_900_VA_11=1)
			OR (cp2Pump=3 AND cp2State=2 AND stsAnimacao_900_VA_5=1 AND stsAnimacao_900_VA_8=1 AND stsAnimacao_900_VA_13=1)
			OR (cp3Pump=3 AND cp3State=2 AND stsAnimacao_900_VA_5=1 AND stsAnimacao_900_VA_8=1 AND stsAnimacao_900_VA_12=1)
			) THEN acmEquipamento3:=FALSE; END_IF;
	END_IF;
	
    (* ========================================================== *)
    (* SEÇÃO 12: ALARMES                                          *)
    (* ========================================================== *)
 
    (* Verificar se alguma bomba está sendo liberada (estado 3/4) *)
    pumpBecomingFree := FALSE;
    IF pump1Available AND pump1InUse THEN
        IF (cp1Pump=1 AND (cp1State=3 OR cp1State=4)) OR
           (cp2Pump=1 AND (cp2State=3 OR cp2State=4)) OR
           (cp3Pump=1 AND (cp3State=3 OR cp3State=4)) THEN
            pumpBecomingFree := TRUE;
        END_IF;
    END_IF;
    IF NOT pumpBecomingFree AND pump2Available AND pump2InUse THEN
        IF (cp1Pump=2 AND (cp1State=3 OR cp1State=4)) OR
           (cp2Pump=2 AND (cp2State=3 OR cp2State=4)) OR
           (cp3Pump=2 AND (cp3State=3 OR cp3State=4)) THEN
            pumpBecomingFree := TRUE;
        END_IF;
    END_IF;
    IF NOT pumpBecomingFree AND pump3Available AND pump3InUse THEN
        IF (cp1Pump=3 AND (cp1State=3 OR cp1State=4)) OR
           (cp2Pump=3 AND (cp2State=3 OR cp2State=4)) OR
           (cp3Pump=3 AND (cp3State=3 OR cp3State=4)) THEN
            pumpBecomingFree := TRUE;
        END_IF;
    END_IF;
 
    (* Alarma somente se NENHUMA bomba livre E nenhuma sendo liberada *)
    almSemBombaDisp_1 := cpRequest_1 AND NOT cpStop_1 AND (cp1State=0) AND tankAvailable
        AND NOT (pump1Available AND NOT pump1InUse)
        AND NOT (pump2Available AND NOT pump2InUse)
        AND NOT (pump3Available AND NOT pump3InUse)
        AND NOT pumpBecomingFree;
 
    almSemBombaDisp_2 := cpRequest_2 AND NOT cpStop_2 AND (cp2State=0) AND tankAvailable
        AND NOT (pump1Available AND NOT pump1InUse)
        AND NOT (pump2Available AND NOT pump2InUse)
        AND NOT (pump3Available AND NOT pump3InUse)
        AND NOT pumpBecomingFree;
 
    almSemBombaDisp_3 := cpRequest_3 AND NOT cpStop_3 AND (cp3State=0) AND tankAvailable
        AND NOT (pump1Available AND NOT pump1InUse)
        AND NOT (pump2Available AND NOT pump2InUse)
        AND NOT (pump3Available AND NOT pump3InUse)
        AND NOT pumpBecomingFree;
        
END_IF;]]></ST>
    </Algorithm>
    <Algorithm Name="ALG_ROTATION">
      <ST><![CDATA[timerActive := FALSE;
needStartDelay := FALSE;

IF timedPump = 0 THEN
    (* Timer expirou mas bomba já foi liberada *)
    IF cmdHabilitaRevezamento THEN
        IF cp1State=2 AND cp1Pump>0 THEN timedPump:=cp1Pump;
        ELSIF cp2State=2 AND cp2Pump>0 THEN timedPump:=cp2Pump;
        ELSIF cp3State=2 AND cp3Pump>0 THEN timedPump:=cp3Pump;
        END_IF;
        IF timedPump > 0 THEN
            CASE timedPump OF
                1: delayTimeOut:=stpTempoRevezamentoEquipamento1;
                2: delayTimeOut:=stpTempoRevezamentoEquipamento2;
                3: delayTimeOut:=stpTempoRevezamentoEquipamento3;
            END_CASE;
            timerActive:=TRUE;
            needStartDelay:=TRUE;
        END_IF;
    END_IF;

ELSE
    IF cmdHabilitaRevezamento THEN
        IF (cp1Pump=timedPump AND cp1State=2 AND NOT cpStop_1) OR
           (cp2Pump=timedPump AND cp2State=2 AND NOT cpStop_2) OR
           (cp3Pump=timedPump AND cp3State=2 AND NOT cpStop_3) THEN
            (* Bomba ainda ativa → sinalizar revezamento *)
            rotationNeeded := TRUE;
            (* Será processado pelo próximo REQ → ALG_MAIN SEÇÃO 5 *)
        ELSE
            (* Bomba não está mais rodando → procurar outra *)
            timedPump := 0;
            IF cp1State=2 AND cp1Pump>0 THEN timedPump:=cp1Pump;
            ELSIF cp2State=2 AND cp2Pump>0 THEN timedPump:=cp2Pump;
            ELSIF cp3State=2 AND cp3Pump>0 THEN timedPump:=cp3Pump;
            END_IF;
            IF timedPump > 0 THEN
                CASE timedPump OF
                    1: delayTimeOut:=stpTempoRevezamentoEquipamento1;
                    2: delayTimeOut:=stpTempoRevezamentoEquipamento2;
                    3: delayTimeOut:=stpTempoRevezamentoEquipamento3;
                END_CASE;
                timerActive:=TRUE;
                needStartDelay:=TRUE;
            END_IF;
        END_IF;
    ELSE
        timedPump := 0;
    END_IF;

END_IF;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>