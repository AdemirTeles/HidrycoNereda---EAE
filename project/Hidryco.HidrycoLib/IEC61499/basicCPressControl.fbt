      <VarDeclaration Name="pump1Available" Type="BOOL" />
      <VarDeclaration Name="pump2Available" Type="BOOL" />
      <VarDeclaration Name="pump3Available" Type="BOOL" />
      <VarDeclaration Name="tankAvailable" Type="BOOL" />
      <VarDeclaration Name="reqVA3" Type="BOOL" />
      <VarDeclaration Name="reqVA4" Type="BOOL" />
      <VarDeclaration Name="reqVA5" Type="BOOL" />
