        <Attribute Name="Configuration.Transaction.BezierPoints" Value="447.265,505.0037,374.0567,438.5593" />
      </ECTransition>
      <ECTransition Source="CHECK_DELAY" Destination="PAUSED" Condition="NOT needStartDelay" x="2285.318" y="1879.821">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="545.1243,478.4443,593.9913,453.6241" />
      </ECTransition>
      <ECTransition Source="FIRE_DELAY" Destination="PAUSED" Condition="1" x="1955.845" y="1435.18">
