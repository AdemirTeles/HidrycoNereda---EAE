        <ECAction Output="CNF" />
      </ECState>
      <ECState Name="PAUSED" x="2753.687" y="1759.403" />
      <ECState Name="EXECUTE" x="2473.132" y="3072.181">
        <ECAction Algorithm="ALG_MAIN" Output="CNF" />
      </ECState>
