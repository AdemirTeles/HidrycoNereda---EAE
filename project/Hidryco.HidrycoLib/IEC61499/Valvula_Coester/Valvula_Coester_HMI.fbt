        <With Var="STS_POSICAO" />
        <With Var="STS_POSICAO_REFERENCIA" />
        <With Var="STS_TORQUE" />
        <With Var="STS_TORQUE_PCT" />
        <With Var="STS_TEMPERATURA" />
        <With Var="STS_TEMPO_PERCURSO" />
        <With Var="STS_PARTIDAS_DIA" />
        <With Var="STS_PARTIDAS_DIA_MAX" />
        <With Var="STS_MODO_CONTINUO" />
        <With Var="STS_MODULANTE" />
        <With Var="STS_CMD_MANUAL" />
