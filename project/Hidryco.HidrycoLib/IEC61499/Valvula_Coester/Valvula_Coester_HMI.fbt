      </Event>
      <Event ID="0672F0082C9E8761" Name="E_COMANDO_MANUAL">
        <With Var="CMD_MANUAL" />
        <With Var="STP_POSICAO_MANUAL" />
      </Event>
      <Event ID="E86F0A936DC9D9A2" Name="E_PARAMETROS">
        <With Var="STP_TEMPO_FALHA_POSICAO" />
        <With Var="STP_TOLERANCIA_POSICAO" />
      </Event>
      <Event ID="F0C1E431EEC29CAD" Name="E_RESET_FALHA">
        <With Var="CMD_RESET_FALHA" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="C373CB1AC84369E8" Name="QI" Type="BOOL" />
      <VarDeclaration ID="B969FCDEF96130B5" Name="STS_COMUNICACAO_OK" Type="BOOL" Comment="Comunicacao Modbus com o atuador OK" />
      <VarDeclaration ID="C3A21C41518F8C92" Name="STS_REMOTO" Type="BOOL" Comment="Seletor do atuador em Remoto" />
      <VarDeclaration ID="56BCE793160E4F9B" Name="STS_LOCAL" Type="BOOL" Comment="Seletor do atuador em Local" />
      <VarDeclaration ID="E869DDA43722D98D" Name="STS_DESLIGADO" Type="BOOL" Comment="Seletor do atuador em Desligado" />
      <VarDeclaration ID="0DA1E5C3B5E4734A" Name="STS_AUTOMATICO" Type="BOOL" Comment="Modo automatico (CLP)" />
      <VarDeclaration ID="585941C85BCE83DA" Name="STS_ABERTA" Type="BOOL" Comment="Posicao aberta" />
      <VarDeclaration ID="118709CAD5681177" Name="STS_FECHADA" Type="BOOL" Comment="Posicao fechada" />
      <VarDeclaration ID="C04F7AF04E6EFF5A" Name="STS_INTERMEDIARIA" Type="BOOL" Comment="Posicao intermediaria" />
      <VarDeclaration ID="4D2B4ABC1DF87081" Name="STS_ABRINDO" Type="BOOL" Comment="Em movimento de abertura" />
      <VarDeclaration ID="8BD21E91EDBEE9FF" Name="STS_FECHANDO" Type="BOOL" Comment="Em movimento de fechamento" />
      <VarDeclaration ID="4CCAE5CDCC0013D9" Name="STS_VOLANTE" Type="BOOL" Comment="Movimento manual pelo volante" />
      <VarDeclaration ID="E92EDC6467677974" Name="STS_POSICAO" Type="REAL" Comment="Posicao atual (%)" />
      <VarDeclaration ID="53B5F5D2A95335A0" Name="STS_POSICAO_REFERENCIA" Type="REAL" Comment="Posicao enviada ao atuador (%)" />
      <VarDeclaration ID="F8D90F2913DF52AF" Name="STS_TORQUE" Type="INT" Comment="Torque maximo do ultimo comando (Nm)" />
      <VarDeclaration ID="F9AC7CF3C819F645" Name="STS_TORQUE_PCT" Type="INT" Comment="Torque relativo ao limite programado (%)" />
      <VarDeclaration ID="DC69038179C46D37" Name="STS_TEMPERATURA" Type="INT" Comment="Temperatura interna do atuador (graus C)" />
      <VarDeclaration ID="2BAF0C38CF5B5251" Name="STS_TEMPO_PERCURSO" Type="INT" Comment="Tempo do ultimo movimento (s)" />
      <VarDeclaration ID="8B113EA8C9590EE1" Name="STS_PARTIDAS_DIA" Type="INT" Comment="Partidas do motor no dia anterior" />
      <VarDeclaration ID="44D930D90C400D59" Name="STS_PARTIDAS_DIA_MAX" Type="INT" Comment="Maior numero de partidas por dia registrado" />
      <VarDeclaration ID="3E19F65A533EE5A5" Name="STS_MODO_CONTINUO" Type="BOOL" Comment="Atuador programado em posicionamento continuo (Word 36 b12)" />
      <VarDeclaration ID="F43B41AD347B286F" Name="STS_MODULANTE" Type="BOOL" Comment="Configuracao da instancia: valvula modulante" />
      <VarDeclaration ID="8E15E2F3411058A4" Name="STS_CMD_MANUAL" Type="INT" Comment="Comando manual atual: 0 parar, 1 abrir, 2 fechar, 3 posicionar" />
      <VarDeclaration ID="3445C45C8D3C07B1" Name="STS_FALHA_COMUNICACAO" Type="BOOL" Comment="Falha de comunicacao Modbus" />
      <VarDeclaration ID="CAA9E8865AA9CC43" Name="STS_FALHA_ATUADOR" Type="BOOL" Comment="Falha do atuador memorizada (exige reset)" />
      <VarDeclaration ID="3C283C97FD003068" Name="STS_FALHA_POSICAO" Type="BOOL" Comment="Posicao nao atingida no tempo (memorizada)" />
      <VarDeclaration ID="A6CED4D4BB171668" Name="STS_CODIGO_FALHA" Type="INT" Comment="Codigo da falha do atuador (texto na IHM)" />
      <VarDeclaration ID="B295DEC4D3864237" Name="STS_BLOQUEADO" Type="BOOL" Comment="Intertravamento ativo" />
      <VarDeclaration ID="683B1DD33BEC1F11" Name="STS_DISPONIVEL_AUTOMATICO" Type="BOOL" Comment="Pode ser comandada pelo automatico agora" />
      <VarDeclaration ID="3A63C12BF7F645F0" Name="STS_ALARME" Type="BOOL" Comment="Algum alarme da valvula" />
      <VarDeclaration ID="C6F00665AAAB8CE6" Name="STS_AVISO_CONFIG" Type="BOOL" Comment="Valvula modulante com o atuador fora do posicionamento continuo" />
      <VarDeclaration ID="917E2B83F09385E4" Name="STS_AVISO_PARTIDAS" Type="BOOL" Comment="Partidas do dia anterior acima do limite configurado" />
      <VarDeclaration ID="DEDA62E0EBADEB17" Name="STS_ANIMACAO" Type="INT" Comment="0 fechada, 1 aberta, 2 intermediaria, 3 em movimento, 4 falha, 5 fora de remoto, 6 sem comunicacao" />
      <VarDeclaration ID="DA6223C9ED3732BE" Name="STS_STATUS2" Type="INT" Comment="Word 2 do atuador (diagnostico)" />
      <VarDeclaration ID="0CDC22B197562BCC" Name="STS_ALARME1" Type="INT" Comment="Word 3 do atuador (diagnostico)" />
      <VarDeclaration ID="2D2E2A67F151864E" Name="STS_ALARME2" Type="INT" Comment="Word 4 do atuador (diagnostico)" />
      <VarDeclaration ID="B89204E4643E3E78" Name="STS_ALM_COMUNICACAO_EST" Type="USINT" Comment="Estado do ALARM_BIT comunicacao (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="E687D663B06D7C72" Name="STS_ALM_ATUADOR_EST" Type="USINT" Comment="Estado do ALARM_BIT falha do atuador (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="C3B11476CBB5BCEC" Name="STS_ALM_POSICAO_EST" Type="USINT" Comment="Estado do ALARM_BIT posicao nao atingida (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="BC56D3CF1064CF02" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="6518857412A3CBC2" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="53A3AB6327E89C55" Name="CMD_AUTOMATICO" Type="BOOL" Comment="0 = manual, 1 = automatico (nao persistente; a valvula parte em automatico)" />
      <VarDeclaration ID="C8717224C3197895" Name="CMD_MANUAL" Type="INT" Comment="0 parar, 1 abrir, 2 fechar, 3 posicionar (nao persistente)" />
      <VarDeclaration ID="1251CADB2D4C88BA" Name="STP_POSICAO_MANUAL" Type="REAL" Comment="Posicao manual (%)" />
      <VarDeclaration ID="03F077E155752540" Name="STP_TEMPO_FALHA_POSICAO" Type="INT" Comment="Tempo maximo para atingir a posicao (s); 0 = sem supervisao" />
      <VarDeclaration ID="4BBF2344676F45C3" Name="STP_TOLERANCIA_POSICAO" Type="REAL" Comment="Tolerancia da posicao (%); 0 = 2 %" />
      <VarDeclaration ID="71ABA80F1E8A7A1D" Name="CMD_RESET_FALHA" Type="BOOL" Comment="Reset de falhas e reconhecimento dos alarmes" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>
