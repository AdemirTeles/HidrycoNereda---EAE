<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="3a371151-7963-52f7-eadd-94c221e86dca" Name="Valvula_Coester_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="19/10/2026" Remarks="IHM da Valvula_Coester" />
  <InterfaceList>
    <EventInputs>
