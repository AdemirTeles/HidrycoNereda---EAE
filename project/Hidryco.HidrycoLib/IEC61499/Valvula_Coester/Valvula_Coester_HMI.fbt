        <With Var="STS_CODIGO_FALHA" />
        <With Var="STS_BLOQUEADO" />
        <With Var="STS_DISPONIVEL_AUTOMATICO" />
        <With Var="STS_ALARME" />
        <With Var="STS_AVISO_CONFIG" />
        <With Var="STS_AVISO_PARTIDAS" />
        <With Var="STS_ANIMACAO" />
        <With Var="STS_STATUS2" />
        <With Var="STS_ALARME1" />
        <With Var="STS_ALARME2" />
        <With Var="STS_ALM_COMUNICACAO_EST" />
        <With Var="STS_ALM_ATUADOR_EST" />
        <With Var="STS_ALM_POSICAO_EST" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="E11CDC2FD3197EF0" Name="INITO">
        <With Var="QO" />
