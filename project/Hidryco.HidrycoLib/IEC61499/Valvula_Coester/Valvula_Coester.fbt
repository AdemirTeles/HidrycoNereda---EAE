<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="29340048-6f4b-0e5b-280d-202d50f3544a" Name="Valvula_Coester" Comment="Valvula com atuador Coester CSR (Modbus TCP) - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="19/10/2026" Remarks="1.0: atuador Coester CSR por Modbus TCP (MN_123_01). Campo por symlink ${PATH}: leitura mbW01..mbW09, mbW36, mbW86, mbW87 (INT, Words do atuador), mbConexao (connStatusInt, 1 = online); escrita mbCmdW01 (Word 1 comando) e mbCmdW02 (Word 2 posicao). cfgModulante = TRUE exige o atuador em posicionamento continuo (Word 36 b12)." />
  <InterfaceList>
    <EventInputs>
      <Event ID="6AE7937B5439A162" Name="REQ" Comment="Atualizacao do processo">
        <With Var="cmdAbrirAutomatico" />
        <With Var="cmdFecharAutomatico" />
        <With Var="stpPosicaoAutomatico" />
        <With Var="ilkGeral" />
        <With Var="ilkAutomatico" />
        <With Var="ilkManual" />
      </Event>
      <Event ID="D903CD18EBE204D1" Name="E_RESET_FALHAS" Comment="Reset de falhas pelo processo (com cmdResetFalhas = TRUE)">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="CF6616D3CB5312F6" Name="CNF" Comment="Status (so na mudanca)">
        <With Var="stsDisponivelAutomatico" />
        <With Var="stsAberta" />
        <With Var="stsFechada" />
        <With Var="stsPosicao" />
        <With Var="stsRemoto" />
        <With Var="stsAutomatico" />
        <With Var="stsFalha" />
        <With Var="stsComunicacaoOK" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="05903B4B679AA14E" Name="cmdAbrirAutomatico" Type="BOOL" Comment="Abrir (valvula on/off, automatico)" />
      <VarDeclaration ID="DD850CDC4ADBDD2B" Name="cmdFecharAutomatico" Type="BOOL" Comment="Fechar (valvula on/off, automatico)" />
      <VarDeclaration ID="B08C4ED4004BD1E2" Name="stpPosicaoAutomatico" Type="REAL" Comment="Posicao desejada no automatico (%) - modulante" />
      <VarDeclaration ID="9B339F9277A6A0C4" Name="ilkGeral" Type="BOOL" Comment="Intertravamento geral (mantem a posicao)" />
      <VarDeclaration ID="3CF911DD39649E19" Name="ilkAutomatico" Type="BOOL" Comment="Intertravamento so do automatico" />
      <VarDeclaration ID="9035BBA9DB82E02B" Name="ilkManual" Type="BOOL" Comment="Intertravamento so do manual" />
      <VarDeclaration ID="C82CBBE25FC56079" Name="cmdResetFalhas" Type="BOOL" Comment="Processo: reset de falhas (vale com TRUE)" />
      <VarDeclaration ID="FC8FD119D7FC211F" Name="cfgModulante" Type="BOOL" InitialValue="FALSE" Comment="TRUE = modulante: atuador programado em posicionamento continuo (Word 36 b12)" />
      <VarDeclaration ID="DF6900A72D5BDD75" Name="cfgPosicaoMin" Type="REAL" InitialValue="0.0" Comment="Limite minimo da posicao no automatico (%)" />
      <VarDeclaration ID="A05C536BD229E019" Name="cfgPosicaoMax" Type="REAL" InitialValue="100.0" Comment="Limite maximo da posicao no automatico (%)" />
      <VarDeclaration ID="454E6238573E4508" Name="cfgPartidasDiaMax" Type="INT" InitialValue="0" Comment="Aviso de partidas/dia acima disto (0 = sem aviso)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="904DD3246D8E0F2F" Name="stsDisponivelAutomatico" Type="BOOL" Comment="Pode ser comandada pelo automatico agora" />
      <VarDeclaration ID="5EDB2238B0F9A6B6" Name="stsAberta" Type="BOOL" Comment="Posicao aberta" />
      <VarDeclaration ID="C1396A09200C7A2F" Name="stsFechada" Type="BOOL" Comment="Posicao fechada" />
      <VarDeclaration ID="259F220E31BE1DFA" Name="stsPosicao" Type="REAL" Comment="Posicao atual (%)" />
      <VarDeclaration ID="5173A0E658D4250F" Name="stsRemoto" Type="BOOL" Comment="Seletor em remoto" />
      <VarDeclaration ID="378CDAA06C4824E3" Name="stsAutomatico" Type="BOOL" Comment="Modo automatico" />
      <VarDeclaration ID="6DEFE77C970ED010" Name="stsFalha" Type="BOOL" Comment="Alguma falha memorizada" />
      <VarDeclaration ID="5B46E3B5D12031DA" Name="stsComunicacaoOK" Type="BOOL" Comment="Comunicacao OK" />
    </OutputVars>
  </InterfaceList>
