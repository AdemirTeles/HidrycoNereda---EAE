<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="29340048-6f4b-0e5b-280d-202d50f3544a" Name="Atuador_Coester" Format="2.0" Comment="Valvula com atuador Coester CSR (Modbus TCP) - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Attribute Name="HMI.Alias" Value="" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="2.2" Author="Hidryco" Date="04/11/2026" Remarks="2.2: IThis.STS_ALARME (IO List da Nereda). 2.1: campo por symlink ${PATH}: mbW01..mbW09 (leitura 100 a 108), mbConexao (connStatusInt), mbCmdW01 (comando, endereco 0, em pulso) e mbCmdW02 (posicao desejada, endereco 1, so no posicionador). cfgPosicionador = TRUE: posicionar e parar (700-VC-01). Alarmes: comunicacao, falha do atuador, nao abriu/fechou/posicionou. 2.0: refeito simples." />
  <InterfaceList>
    <EventInputs>
      <Event ID="6AE7937B5439A162" Name="REQ" Comment="Atualizacao do processo">
        <With Var="cmdAbrirAutomatico" />
        <With Var="cmdFecharAutomatico" />
        <With Var="stpPosicaoAutomatico" />
      </Event>
      <Event ID="D903CD18EBE204D1" Name="E_RESET_FALHAS" Comment="Reset de falhas pelo processo (com cmdResetFalhas = TRUE)">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="CF6616D3CB5312F6" Name="CNF" Comment="Status (na mudanca)">
        <With Var="stsDisponivelAutomatico" />
        <With Var="stsAberta" />
        <With Var="stsFechada" />
        <With Var="stsPosicao" />
        <With Var="stsAutomatico" />
        <With Var="stsComunicacaoOK" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="05903B4B679AA14E" Name="cmdAbrirAutomatico" Type="BOOL" Comment="Automatico: abrir (valvula so abrir/fechar)" />
      <VarDeclaration ID="DD850CDC4ADBDD2B" Name="cmdFecharAutomatico" Type="BOOL" Comment="Automatico: fechar (valvula so abrir/fechar)" />
      <VarDeclaration ID="B08C4ED4004BD1E2" Name="stpPosicaoAutomatico" Type="REAL" Comment="Automatico: posicao desejada (%) - so com cfgPosicionador = TRUE" />
      <VarDeclaration ID="C82CBBE25FC56079" Name="cmdResetFalhas" Type="BOOL" Comment="Processo: reset de falhas (vale com TRUE)" />
      <VarDeclaration ID="FFAFC48D6FD3FF02" Name="cfgHabilitada" Type="BOOL" InitialValue="TRUE" Comment="FALSE = instancia desabilitada (equipamento futuro): sem alarme de comunicacao e fora do automatico" />
      <VarDeclaration ID="C65F121E4D57852C" Name="cfgPosicionador" Type="BOOL" InitialValue="FALSE" Comment="TRUE = posicionar e parar (so 700-VC-01; o .hcf escreve tambem a Word 2, endereco 1); FALSE = so abrir e fechar" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="904DD3246D8E0F2F" Name="stsDisponivelAutomatico" Type="BOOL" Comment="Pode ser comandada pelo automatico agora" />
      <VarDeclaration ID="5EDB2238B0F9A6B6" Name="stsAberta" Type="BOOL" Comment="Posicao aberta" />
      <VarDeclaration ID="C1396A09200C7A2F" Name="stsFechada" Type="BOOL" Comment="Posicao fechada" />
      <VarDeclaration ID="259F220E31BE1DFA" Name="stsPosicao" Type="REAL" Comment="Posicao real (%) - Word 5" />
      <VarDeclaration ID="378CDAA06C4824E3" Name="stsAutomatico" Type="BOOL" Comment="Modo automatico" />
      <VarDeclaration ID="5B46E3B5D12031DA" Name="stsComunicacaoOK" Type="BOOL" Comment="Comunicacao OK" />
    </OutputVars>
  </InterfaceList>
