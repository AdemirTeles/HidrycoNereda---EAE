<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="3a371151-7963-52f7-eadd-94c221e86dca" Name="Atuador_Coester_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="2.2" Author="Hidryco" Date="04/11/2026" Remarks="2.2: STS_ALARME (IO List da Nereda). 2.1: restante das tags (posicao, torque, temperatura, tempo de percurso, status 2, alarmes), posicionar/parar so no posicionador, falha do atuador e faceplate de diagnostico. 2.0: refeito simples." />
  <InterfaceList>
    <EventInputs>
      <Event ID="2EABC7344B56B5EA" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="BE814A344599F8CD" Name="LOAD_PERS_DATA" Comment="Reenvia os parametros persistentes" />
      <Event ID="481FCEE46722FF01" Name="REQ" Comment="Atualizacao de status">
        <With Var="STS_COMUNICACAO_OK" />
        <With Var="STS_FALHA_COMUNICACAO" />
        <With Var="STS_REMOTO" />
        <With Var="STS_LOCAL" />
        <With Var="STS_DESLIGADO" />
        <With Var="STS_ABERTO" />
        <With Var="STS_FECHADO" />
        <With Var="STS_ABRINDO" />
        <With Var="STS_FECHANDO" />
        <With Var="STS_ANIMACAO" />
        <With Var="fbkStsAutomatico" />
        <With Var="STS_DISPONIVEL_AUTOMATICO" />
        <With Var="STS_FALHA_POSICAO" />
        <With Var="STS_ALM_COMUNICACAO_EST" />
        <With Var="STS_ALM_POSICAO_EST" />
        <With Var="STS_POSICIONADOR" />
        <With Var="STS_POSICAO" />
        <With Var="STS_POSICAO_REFERENCIA" />
        <With Var="STS_FALHA_ATUADOR" />
        <With Var="STS_CODIGO_FALHA" />
        <With Var="STS_ALM_ATUADOR_EST" />
        <With Var="STS_TORQUE" />
        <With Var="STS_TEMPO_PERCURSO" />
        <With Var="STS_TEMPERATURA" />
        <With Var="STS_TORQUE_PCT" />
        <With Var="STS_STATUS2" />
        <With Var="STS_ALARME1" />
        <With Var="STS_ALARME2" />
        <With Var="STS_ALARME" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="E11CDC2FD3197EF0" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="63B34773AE652DFD" Name="E_STS_AUTOMATICO">
        <With Var="STS_AUTOMATICO" />
      </Event>
      <Event ID="71CB1D0924F3BFDA" Name="E_CMD_ABRIR_MANUAL">
        <With Var="CMD_ABRIR_MANUAL" />
      </Event>
      <Event ID="911B24FA4AD76ACA" Name="E_CMD_FECHAR_MANUAL">
        <With Var="CMD_FECHAR_MANUAL" />
      </Event>
      <Event ID="155C5D6A800071CB" Name="E_CMD_PARAR_MANUAL">
        <With Var="CMD_PARAR_MANUAL" />
      </Event>
      <Event ID="30C7D4C005DA551B" Name="E_CMD_POSICIONAR_MANUAL">
        <With Var="CMD_POSICIONAR_MANUAL" />
      </Event>
      <Event ID="F0C1E431EEC29CAD" Name="E_CMD_RESET_FALHA">
        <With Var="CMD_RESET_FALHA" />
      </Event>
      <Event ID="13888B810B977A05" Name="CNF">
        <With Var="STP_FALHA_ABERTURA" />
        <With Var="STP_FALHA_FECHAMENTO" />
        <With Var="STP_POSICAO_DESEJADA_MANUAL" />
        <With Var="STP_TOLERANCIA_POSICAO" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="C373CB1AC84369E8" Name="QI" Type="BOOL" />
      <VarDeclaration ID="B969FCDEF96130B5" Name="STS_COMUNICACAO_OK" Type="BOOL" Comment="Comunicacao Modbus com o atuador OK" />
      <VarDeclaration ID="3445C45C8D3C07B1" Name="STS_FALHA_COMUNICACAO" Type="BOOL" Comment="Falha de comunicacao Modbus" />
      <VarDeclaration ID="C3A21C41518F8C92" Name="STS_REMOTO" Type="BOOL" Comment="Seletor do atuador em Remoto" />
      <VarDeclaration ID="56BCE793160E4F9B" Name="STS_LOCAL" Type="BOOL" Comment="Seletor do atuador em Local" />
      <VarDeclaration ID="E869DDA43722D98D" Name="STS_DESLIGADO" Type="BOOL" Comment="Seletor do atuador em Desligado" />
      <VarDeclaration ID="585941C85BCE83DA" Name="STS_ABERTO" Type="BOOL" Comment="Posicao aberta" />
      <VarDeclaration ID="118709CAD5681177" Name="STS_FECHADO" Type="BOOL" Comment="Posicao fechada" />
      <VarDeclaration ID="4D2B4ABC1DF87081" Name="STS_ABRINDO" Type="BOOL" Comment="Em movimento de abertura" />
      <VarDeclaration ID="8BD21E91EDBEE9FF" Name="STS_FECHANDO" Type="BOOL" Comment="Em movimento de fechamento" />
      <VarDeclaration ID="DEDA62E0EBADEB17" Name="STS_ANIMACAO" Type="INT" Comment="0 fechada, 1 aberta, 2 falha, 3 intermediaria parada, 4 abrindo, 5 fechando" />
      <VarDeclaration ID="0DA1E5C3B5E4734A" Name="fbkStsAutomatico" Type="BOOL" Comment="Retorno do modo: TRUE = automatico" />
      <VarDeclaration ID="683B1DD33BEC1F11" Name="STS_DISPONIVEL_AUTOMATICO" Type="BOOL" Comment="Pode ser comandada pelo automatico agora" />
      <VarDeclaration ID="3C283C97FD003068" Name="STS_FALHA_POSICAO" Type="BOOL" Comment="Nao abriu / nao fechou / nao posicionou no tempo (memorizada ate o reset)" />
      <VarDeclaration ID="B89204E4643E3E78" Name="STS_ALM_COMUNICACAO_EST" Type="USINT" Comment="Estado do ALARM_BIT comunicacao" />
      <VarDeclaration ID="C3B11476CBB5BCEC" Name="STS_ALM_POSICAO_EST" Type="USINT" Comment="Estado do ALARM_BIT posicao" />
      <VarDeclaration ID="EAB8CECDEE47F405" Name="STS_POSICIONADOR" Type="BOOL" Comment="TRUE = instancia com posicionar e parar (cfgPosicionador)" />
      <VarDeclaration ID="E92EDC6467677974" Name="STS_POSICAO" Type="REAL" Comment="Posicao real (%) - Word 5" />
      <VarDeclaration ID="53B5F5D2A95335A0" Name="STS_POSICAO_REFERENCIA" Type="REAL" Comment="Ultima posicao enviada ao atuador (%)" />
      <VarDeclaration ID="CAA9E8865AA9CC43" Name="STS_FALHA_ATUADOR" Type="BOOL" Comment="Falha do atuador (memorizada ate o reset)" />
      <VarDeclaration ID="A6CED4D4BB171668" Name="STS_CODIGO_FALHA" Type="INT" Comment="Codigo da falha do atuador (texto na IHM)" />
      <VarDeclaration ID="E687D663B06D7C72" Name="STS_ALM_ATUADOR_EST" Type="USINT" Comment="Estado do ALARM_BIT falha do atuador" />
      <VarDeclaration ID="F8D90F2913DF52AF" Name="STS_TORQUE" Type="INT" Comment="Torque do ultimo comando (Nm) - Word 6" />
      <VarDeclaration ID="2BAF0C38CF5B5251" Name="STS_TEMPO_PERCURSO" Type="INT" Comment="Tempo do ultimo percurso (s) - Word 7" />
      <VarDeclaration ID="DC69038179C46D37" Name="STS_TEMPERATURA" Type="INT" Comment="Temperatura interna (graus C) - Word 8 - 19" />
      <VarDeclaration ID="F9AC7CF3C819F645" Name="STS_TORQUE_PCT" Type="INT" Comment="Torque do ultimo comando (%) - Word 9" />
      <VarDeclaration ID="DA6223C9ED3732BE" Name="STS_STATUS2" Type="INT" Comment="Word 2 - status 2" />
      <VarDeclaration ID="0CDC22B197562BCC" Name="STS_ALARME1" Type="INT" Comment="Word 3 - alarmes 1" />
      <VarDeclaration ID="2D2E2A67F151864E" Name="STS_ALARME2" Type="INT" Comment="Word 4 - alarmes 2" />
      <VarDeclaration ID="661CD66C2E0B4EB7" Name="STS_ALARME" Type="BOOL" Comment="Alarme da valvula: falha de comunicacao OU falha do atuador OU nao abriu/fechou/posicionou" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="BC56D3CF1064CF02" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="6518857412A3CBC2" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="53A3AB6327E89C55" Name="STS_AUTOMATICO" Type="BOOL" Comment="Modo: TRUE = automatico (nao persistente; parte em automatico)" />
      <VarDeclaration ID="782E32D396726508" Name="CMD_ABRIR_MANUAL" Type="BOOL" Comment="TRUE = abrir (manual)" />
      <VarDeclaration ID="25AE4D0A97EEDA36" Name="CMD_FECHAR_MANUAL" Type="BOOL" Comment="TRUE = fechar (manual)" />
      <VarDeclaration ID="00ADEFE9AF996DF4" Name="CMD_PARAR_MANUAL" Type="BOOL" Comment="TRUE = parar (manual, so posicionador)" />
      <VarDeclaration ID="D18E1EEBEE97BF05" Name="CMD_POSICIONAR_MANUAL" Type="BOOL" Comment="TRUE = posicionar em STP_POSICAO_DESEJADA_MANUAL (so posicionador)" />
      <VarDeclaration ID="71ABA80F1E8A7A1D" Name="CMD_RESET_FALHA" Type="BOOL" Comment="Reset das falhas e reconhecimento dos alarmes" />
      <VarDeclaration ID="8ABE92B23ED26038" Name="STP_FALHA_ABERTURA" Type="UINT" Comment="Tempo maximo para abrir/posicionar abrindo (s); 0 = sem supervisao" />
      <VarDeclaration ID="9FC046F40A62517B" Name="STP_FALHA_FECHAMENTO" Type="UINT" Comment="Tempo maximo para fechar/posicionar fechando (s); 0 = sem supervisao" />
      <VarDeclaration ID="95CEB40D72985F2C" Name="STP_POSICAO_DESEJADA_MANUAL" Type="INT" Comment="Posicao desejada em manual (%)" />
      <VarDeclaration ID="4BBF2344676F45C3" Name="STP_TOLERANCIA_POSICAO" Type="REAL" Comment="Tolerancia da posicao (%); 0 = 2 %" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>