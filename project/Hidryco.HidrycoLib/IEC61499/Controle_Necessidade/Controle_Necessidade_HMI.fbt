<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="9c0c42c3-5fda-ba8d-d676-5898abdb8744" Name="Controle_Necessidade_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="21/10/2026" Remarks="IHM do Controle_Necessidade" />
  <InterfaceList>
    <EventInputs>
      <Event ID="621A81CCC76CE764" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="9CCC6FC2F9BF33EE" Name="LOAD_PERS_DATA" Comment="Reenvia os parametros persistentes" />
      <Event ID="E60345B826CCA0C2" Name="E_ATUALIZA_NECESSIDADE" Comment="Status do processo">
        <With Var="STS_NECESSIDADE_EQUIPAMENTO" />
        <With Var="STS_NIVEL" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="7544B3F7FE08F707" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="D720E0780C9D82EF" Name="E_ATUALIZA_SETPOINT" Comment="Ajustes (IHM/OPC UA e LOAD_PERS_DATA)">
        <With Var="STP_LIMITE_FAIXA_1" />
        <With Var="STP_LIMITE_FAIXA_2" />
        <With Var="STP_LIMITE_FAIXA_3" />
        <With Var="STP_LIMITE_FAIXA_4" />
        <With Var="CMD_HABILITA" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="1F30796EB21014F5" Name="QI" Type="BOOL" />
      <VarDeclaration ID="8ECDDE4E7698AB8E" Name="STS_NECESSIDADE_EQUIPAMENTO" Type="UINT" Comment="Equipamentos pedidos pelas faixas" />
      <VarDeclaration ID="B9B5554694A72450" Name="STS_NIVEL" Type="REAL" Comment="Nivel comparado com as faixas (% da altura)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="442275F39E6F8C27" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="36E320FB5C8C6C4B" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="055DC002B3EB601B" Name="CMD_HABILITA" Type="BOOL" Comment="Habilitado" />
      <VarDeclaration ID="7967017B37F460AF" Name="STP_LIMITE_FAIXA_1" Type="REAL" Comment="Limite da faixa 1" />
      <VarDeclaration ID="DE7F0A130D074041" Name="STP_LIMITE_FAIXA_2" Type="REAL" Comment="Limite da faixa 2" />
      <VarDeclaration ID="AFA8C0022DDE1D97" Name="STP_LIMITE_FAIXA_3" Type="REAL" Comment="Limite da faixa 3" />
      <VarDeclaration ID="F27B7873DE3AF3B0" Name="STP_LIMITE_FAIXA_4" Type="REAL" Comment="Limite da faixa 4" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>
