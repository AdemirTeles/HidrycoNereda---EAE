<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="1395495b-5ad5-f5a3-7f91-474596830f87" Name="Controle_Revezamento_2_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="21/10/2026" Remarks="IHM do Controle_Revezamento_2" />
  <InterfaceList>
    <EventInputs>
      <Event ID="8D9701AA22B9132B" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="5B4E32F67D7CF5C3" Name="LOAD_PERS_DATA" Comment="Reenvia os parametros persistentes" />
      <Event ID="0382B9FD366ED0CC" Name="E_ATUALIZA_TEMPO_RESTANTE" Comment="Status do processo">
        <With Var="STS_RESTANTE_HOR" />
        <With Var="STS_RESTANTE_MIN" />
        <With Var="STS_RESTANTE_SEG" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="7ED418785803A45B" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="777E712B3DABFF77" Name="E_ATUALIZA_SETPOINT" Comment="Ajustes (IHM/OPC UA e LOAD_PERS_DATA)">
        <With Var="CMD_HABILITA" />
        <With Var="STP_TEMPO_B1" />
        <With Var="STP_TEMPO_B2" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="50ED8914D1AA0BF0" Name="QI" Type="BOOL" />
      <VarDeclaration ID="59A064F64394E76F" Name="STS_RESTANTE_HOR" Type="UINT" Comment="Tempo para a troca da principal (h)" />
      <VarDeclaration ID="EA4DFD7352FB5555" Name="STS_RESTANTE_MIN" Type="UINT" Comment="Tempo para a troca da principal (min)" />
      <VarDeclaration ID="C6D602205CB24305" Name="STS_RESTANTE_SEG" Type="UINT" Comment="Tempo para a troca da principal (s)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="B9E60CDE645120BF" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="F7311077CB4F843E" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="F9D72DA0A2A475DA" Name="CMD_HABILITA" Type="BOOL" Comment="Troca da principal por tempo" />
      <VarDeclaration ID="211B081D528B52A6" Name="STP_TEMPO_B1" Type="UINT" Comment="Horas do equipamento 1 como principal" />
      <VarDeclaration ID="0250E3372A5D5ADE" Name="STP_TEMPO_B2" Type="UINT" Comment="Horas do equipamento 2 como principal" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>
