<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="2c2ac61b-6a87-4796-a11e-9800abb62fce" Name="EEE_Bruto" Format="2.0" Comment="Elevatoria de esgoto bruto - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Attribute Name="HMI.Alias" Value="" />
  <Attribute Name="Configuration.FB.IDCounter" Value="5" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.3" Author="Hidryco" Date="15/10/2026" Remarks="1.3: selecao do gerador bomba por bomba (geradorHabilitaBS01/02/03, cada uma so na sua bomba; antes geradorHabilita unica). 1.2: emergencia do PCM NF (stsEmergenciaPainel FALSE = em emergencia, so depois da 1a leitura); FALHA UCP das bombas NF (cfgTermicaNF TRUE: FALSE no campo = falha); rede do CAT reorganizada. 1.1: emergencia do PCM pelo symlink ${PATH}stsEmergenciaPainel (soma com stsEmergencia do processo); comunicacao dos ATV630 pelos symlinks ${PATH}atvComunicacaoBS01..03 (ComStatus do HW CAT ATVSpeedControlMbtcp) publicada como ${PATH}BS_100_0x.stsFalhaComunicacao; cfgUsaFalhaComunicacao TRUE; estado 7 = emergencia. 1.0: elevatoria de esgoto bruto (3 bombas 100-BS-01/02/03, 2 + 1 reserva). Faixas de nivel do LIT-03, revezamento por tempo, velocidade pelo PID de nivel, HH do Nereda segura o esgoto ate o H do poco, operacao pelas boias com o LIT-03 em falha, falha de recalque pelo PIT-01. Campo por symlink ${PATH}: stsBoiaNivelBaixo (LSL-04), stsBoiaNivelAlto (LSH-05); bombas e sensores pelos symlinks dos proprios CATs (${PATH}BS_100_0x., ${PATH}LIT_100_03., ${PATH}PIT_100_01.)." />
  <InterfaceList>
    <EventInputs>
      <Event ID="2B02D319AFE26590" Name="REQ" Comment="Atualizacao do processo">
        <With Var="stsBufferHH" />
        <With Var="stsEmergencia" />
        <With Var="ilkExterno" />
        <With Var="geradorConectado" />
        <With Var="geradorHabilitaBS01" />
        <With Var="geradorHabilitaBS02" />
        <With Var="geradorHabilitaBS03" />
        <With Var="stsGerador" />
      </Event>
      <Event ID="8F5050B9F80FFADD" Name="E_RESET_FALHAS" Comment="Reset pelo processo (elevatoria, bombas e sensores) com cmdResetFalhas = TRUE">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="270B73CF2899A09E" Name="CNF" Comment="Status (so na mudanca)">
        <With Var="stsNecessidade" />
        <With Var="stsBombasLigadas" />
        <With Var="stsSegurandoBuffer" />
        <With Var="stsModoBoias" />
        <With Var="stsFalhaRecalque" />
        <With Var="stsAlarme" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="6E1BAD215E3925FE" Name="stsBufferHH" Type="BOOL" Comment="Alarme HH do nivel do tanque de equalizacao do Nereda (40-LT-0001): a elevatoria segura o esgoto" />
      <VarDeclaration ID="8264E888669A2A8A" Name="stsEmergencia" Type="BOOL" Comment="Emergencia pelo processo (soma com a emergencia do PCM lida pelo symlink stsEmergenciaPainel): retira o comando das bombas" />
      <VarDeclaration ID="83B944A122866558" Name="ilkExterno" Type="BOOL" Comment="Intertravamento externo do automatico das bombas (ex.: falha das UCTs, futuro)" />
      <VarDeclaration ID="CCA47B2A19E0B699" Name="geradorConectado" Type="BOOL" Comment="O gerador pode alimentar as bombas" />
      <VarDeclaration ID="B9262C2637F95B4A" Name="geradorHabilitaBS01" Type="BOOL" Comment="Bomba 100-BS-01 liberada para operar com a planta no gerador (HAB_BS_100_01 do CAT Subestacao)" />
      <VarDeclaration ID="011919C853DE622C" Name="geradorHabilitaBS02" Type="BOOL" Comment="Bomba 100-BS-02 liberada para operar com a planta no gerador (HAB_BS_100_02 do CAT Subestacao)" />
      <VarDeclaration ID="EC0B0545A7F8DBEB" Name="geradorHabilitaBS03" Type="BOOL" Comment="Bomba 100-BS-03 liberada para operar com a planta no gerador (HAB_BS_100_03 do CAT Subestacao)" />
      <VarDeclaration ID="D20C22571F86F121" Name="stsGerador" Type="BOOL" Comment="Planta alimentada pelo gerador" />
      <VarDeclaration ID="A9A978573B917A62" Name="cmdResetFalhas" Type="BOOL" Comment="TRUE = reset (com o evento E_RESET_FALHAS)" />
      <VarDeclaration ID="9D7FBB09B4CC60DC" Name="cfgTempoFalhaBoiaL" Type="UINT" InitialValue="10" Comment="Operacao pelas boias com a boia LSL com defeito: bombas ficam ligadas este tempo (min) depois que a LSH desce" />
      <VarDeclaration ID="570615C81CD900CD" Name="cfgTempoPartidaPressao" Type="UINT" InitialValue="30" Comment="Alarmes L/LL do PIT-01 inibidos ate a bomba estar ligada ha este tempo (s); tambem inibidos com as bombas paradas" />
      <VarDeclaration ID="6CCB246A38C176FA" Name="cfgUsaFalhaComunicacao" Type="BOOL" InitialValue="TRUE" Comment="Bombas: TRUE = falha de comunicacao com o ATV630 (symlink atvComunicacaoBS0x = ComStatus do HW CAT) tira a bomba do automatico" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="6B7CBCB551D1074A" Name="stsNecessidade" Type="UINT" Comment="Numero de bombas pedidas (0, 1, 2)" />
      <VarDeclaration ID="2D4F8423C2DCEDCF" Name="stsBombasLigadas" Type="UINT" Comment="Bombas ligadas" />
      <VarDeclaration ID="6BA798D6A0F58995" Name="stsSegurandoBuffer" Type="BOOL" Comment="Elevatoria parada segurando o esgoto (HH do tanque do Nereda)" />
      <VarDeclaration ID="E2351657A0B1DCEE" Name="stsModoBoias" Type="BOOL" Comment="Operacao de emergencia pelas boias (LIT-03 em falha)" />
      <VarDeclaration ID="3056E203DCC8E843" Name="stsFalhaRecalque" Type="BOOL" Comment="Falha de recalque (pressao LL com bomba ligada) - memorizada ate o reset" />
      <VarDeclaration ID="886858021A9F6CC0" Name="stsAlarme" Type="BOOL" Comment="Algum alarme da elevatoria" />
    </OutputVars>
  </InterfaceList>
