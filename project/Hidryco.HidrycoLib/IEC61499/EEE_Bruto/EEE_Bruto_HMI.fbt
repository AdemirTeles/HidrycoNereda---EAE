<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="d6a3cb2a-bba4-4ee3-ae41-e98a9ecb1a8e" Name="EEE_Bruto_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.3" Author="Hidryco" Date="21/10/2026" Remarks="IHM da EEE_Bruto 1.3: ajustes nos sub-CATs Necessidade/Revezamento/PID; reset cmdResetFalhas / E_RESET_FALHAS_PROCESSO (legado)" />
  <InterfaceList>
    <EventInputs>
      <Event ID="9E38A1961DA6B101" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="8A9BE89122F8493C" Name="REQ" Comment="Atualizacao de status">
        <With Var="STS_PRINCIPAL" />
        <With Var="STS_SEGUNDA" />
        <With Var="STS_BOMBAS_LIGADAS" />
        <With Var="STS_VELOCIDADE" />
        <With Var="STS_NIVEL" />
        <With Var="STS_ESTADO" />
        <With Var="STS_MODO_BOIAS" />
        <With Var="STS_SEGURANDO_BUFFER" />
        <With Var="STS_FALHA_RECALQUE" />
        <With Var="STS_FALHA_BOIA_L" />
        <With Var="STS_NIVEL_BAIXO" />
        <With Var="STS_BOIA_L" />
        <With Var="STS_BOIA_H" />
        <With Var="STS_BUFFER_HH" />
        <With Var="STS_ALARME" />
        <With Var="STS_ALM_RECALQUE_EST" />
        <With Var="STS_ALM_NIVEL_ALTO_EST" />
        <With Var="STS_ALM_FALHA_BOIA_EST" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="5F0B40587FEFE3C8" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="6B160DD0F34FB9C9" Name="E_RESET_FALHAS_PROCESSO">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="5F1475034ADC5EE8" Name="QI" Type="BOOL" />
      <VarDeclaration ID="850B1619B9DA198C" Name="STS_PRINCIPAL" Type="UINT" Comment="Bomba principal" />
      <VarDeclaration ID="944B5897BE0574B9" Name="STS_SEGUNDA" Type="UINT" Comment="Bomba que entra como 2a" />
      <VarDeclaration ID="2C1A9CF4B602EE39" Name="STS_BOMBAS_LIGADAS" Type="UINT" Comment="Bombas ligadas" />
      <VarDeclaration ID="51564348690894F5" Name="STS_VELOCIDADE" Type="REAL" Comment="Velocidade enviada as bombas (Hz)" />
      <VarDeclaration ID="7E6F53D9C30EBF39" Name="STS_NIVEL" Type="REAL" Comment="Nivel do poco (LIT-03)" />
      <VarDeclaration ID="65049BBD5A4BB493" Name="STS_ESTADO" Type="INT" Comment="0 parada, 1 bombeando, 2 segurando (HH Nereda), 3 pelas boias, 4 falha de recalque, 5 nivel baixo (LSL), 6 automatico desabilitado, 7 emergencia" />
      <VarDeclaration ID="AF62408DEC77723C" Name="STS_MODO_BOIAS" Type="BOOL" Comment="Operacao pelas boias (LIT-03 em falha)" />
      <VarDeclaration ID="291D653F26E2F3DA" Name="STS_SEGURANDO_BUFFER" Type="BOOL" Comment="Segurando o esgoto (HH do tanque do Nereda)" />
      <VarDeclaration ID="61AA8C54482A7A9B" Name="STS_FALHA_RECALQUE" Type="BOOL" Comment="Falha de recalque" />
      <VarDeclaration ID="EE7C6C6858FFBB22" Name="STS_FALHA_BOIA_L" Type="BOOL" Comment="Boia LSL com defeito" />
      <VarDeclaration ID="AAD965D400369960" Name="STS_NIVEL_BAIXO" Type="BOOL" Comment="LSL abaixada: bombas intertravadas" />
      <VarDeclaration ID="FE4CB77CC09B077D" Name="STS_BOIA_L" Type="BOOL" Comment="LSL-04 levantada" />
      <VarDeclaration ID="AFD72C4363D47798" Name="STS_BOIA_H" Type="BOOL" Comment="LSH-05 levantada" />
      <VarDeclaration ID="23E5A2CBCEA0A47D" Name="STS_BUFFER_HH" Type="BOOL" Comment="HH do tanque do Nereda" />
      <VarDeclaration ID="55636688498925A1" Name="STS_ALARME" Type="BOOL" Comment="Algum alarme da elevatoria" />
      <VarDeclaration ID="8C8C7B22E6752219" Name="STS_ALM_RECALQUE_EST" Type="USINT" Comment="Estado do ALARM_BIT falha de recalque (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="458D5DB98E9425A3" Name="STS_ALM_NIVEL_ALTO_EST" Type="USINT" Comment="Estado do ALARM_BIT nivel alto (LSH) (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="0DFF34EDE3D642CE" Name="STS_ALM_FALHA_BOIA_EST" Type="USINT" Comment="Estado do ALARM_BIT defeito da boia LSL (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="2F5149FDD09CBB12" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="B1B1A39230AD6007" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="8DA339BF859A8E5F" Name="cmdResetFalhas" Type="BOOL" Comment="Reset das falhas da elevatoria (recalque, boia) e reconhecimento" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>