<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="99d5c233-81b2-84f1-d6f8-ca5565bf5256" Name="Status_Remota_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="23/10/2026" Remarks="IHM do Status_Remota" />
  <InterfaceList>
    <EventInputs>
      <Event ID="2CB1913F2D84E8BE" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="61B137DBE3C45E48" Name="LOAD_PERS_DATA" Comment="Reenvia os parametros persistentes" />
      <Event ID="889D8869974C8F09" Name="E_ATUALIZA" Comment="Atualizacao de status">
        <With Var="STS_ESTADO" />
        <With Var="STS_COMUNICANDO" />
        <With Var="STS_VIVO" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="DB913E98B1D32C77" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="DE8A485AA6FEB6A8" Name="QI" Type="BOOL" />
      <VarDeclaration ID="3D6FE37D230CC7E1" Name="STS_ESTADO" Type="INT" Comment="0 aguardando, 1 comunicando, 2 sem comunicacao" />
      <VarDeclaration ID="8262B86748C46F85" Name="STS_COMUNICANDO" Type="BOOL" Comment="Remota comunicando" />
      <VarDeclaration ID="42A72EE74D073CF1" Name="STS_VIVO" Type="INT" Comment="Sinal de vida (muda a cada 2 s): a IHM acusa CLP sem dados se parar" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="DA5E4B76DDFC0754" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="B336701B90F2AF9D" Name="STATUS" Type="STRING" Comment="Service Status" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>
