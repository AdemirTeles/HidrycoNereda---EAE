    <Algorithm Name="AcionaEquipamento1">
      <ST><![CDATA[acmMotor1 := TRUE;
acmMotor2 := FALSE;
;]]></ST>
    </Algorithm>
    <Algorithm Name="AcionaEquipamento1_2">
      <ST><![CDATA[acmMotor1 := TRUE;
acmMotor2 := TRUE;
;]]></ST>
    </Algorithm>
    <Algorithm Name="AconaEquipamento2">
      <ST><![CDATA[acmMotor1 := FALSE;
acmMotor2 := TRUE;
;]]></ST>
    </Algorithm>
    <Algorithm Name="Principal1Delay">
      <ST><![CDATA[delayTimeMotor1 := stpTempoRevezamentoMotor1;
;]]></ST>
    </Algorithm>
    <Algorithm Name="Principal2Delay">
      <ST><![CDATA[delayTimeMotor2 := stpTempoRevezamentoMotor2;
;]]></ST>
    </Algorithm>
    <Algorithm Name="MudaPrincipal">
      <ST><![CDATA[IF equipamentoPrincipal = 1 THEN
	equipamentoPrincipal := equipamentoPrincipal + 1;
ELSE 
	equipamentoPrincipal := 1;
END_IF;
;]]></ST>
    </Algorithm>
