<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="b166bf19-cdaa-4cbc-a1d1-32dbd2a9700f" Name="animacaoAbrirFechar" Comment="Basic Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="1/26/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Comment="Normal Execution Request">
        <With Var="stsAberto" />
        <With Var="stsFechado" />
        <With Var="stsFalha" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="stsAnimacao" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="stsAberto" Type="BOOL" />
      <VarDeclaration Name="stsFechado" Type="BOOL" />
      <VarDeclaration Name="stsFalha" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="stsAnimacao" Type="INT" Comment="0-Off; 1-On; 2-Fail; 3-Manut; 4-Transition" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="93875181-edb4-4f5d-890f-804f6a765d8a">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="algREQ" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="1788.941" y="1057.412" />
      <ECState Name="REQ" x="1776" y="500" />
    </ECC>
    <Algorithm ID="c8d31269-c2a2-41ce-ae08-85eefad553ef" Name="algREQ">
      <ST><![CDATA[IF stsFalha THEN
    stsAnimacao := 2;       (* falha *)
ELSIF stsAberto AND stsFechado THEN
    stsAnimacao := 99;      (* fins de curso incoerentes: desconhecido *)
ELSIF stsAberto THEN
    stsAnimacao := 1;       (* aberto *)
ELSIF stsFechado THEN
    stsAnimacao := 0;       (* fechado *)
ELSE
    stsAnimacao := 4;       (* em trânsito *)
END_IF;
;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>