<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="8dee52c4-2864-4ce6-a3ba-f2821a6fbe0e" Name="Subestacao" Format="2.0" Comment="Subestacao / QGBT e geradores - ETE Tijuco Preto" Namespace="Hidryco.HidrycoLib">
  <Attribute Name="HMI.Alias" Value="" />
  <Attribute Name="Configuration.FB.IDCounter" Value="6" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.1" Author="Hidryco" Date="15/10/2026" Remarks="1.0: QGBT 440 V da ETE Tijuco Preto (unifilar HID-PE-DE-ETE-ELE-002): QTAM 1 (G2) -&gt; 1Q1 -&gt; barra A, QTAM 2 (G1) -&gt; 1Q2 -&gt; barra B, 1Q0 acoplamento. Disjuntores pelos DIs da remota 1 (A3/A4/A5 TM3DI32K do PCE SUBESTACAO) publicados por IO_DI32 em ${PATH}dj&lt;nome&gt;, ${PATH}mp&lt;sinal&gt;_1q&lt;n&gt; e ${PATH}stsFalhaRemota1. Geradores pelos Gerador_Generico internos GMG_G1 (QTAM 2) e GMG_G2 (QTAM 1). Cargas liberadas no gerador escolhidas na IHM (persistentes, padrao liberado): saidas HAB_* e stsPlantaNoGerador para os CATs de processo. v1.1: comandos de abrir/fechar dos Masterpact pela IHM (fpComandos) com intertravamentos, publicados em ${PATH}cmdAbrir1q1 ... ${PATH}cmdFechar1q2 para o IO_DQ32 do A8 TM3DQ32TK da remota 1 (word 0 b05..b10, escrita pelo M262_Substacao); reservas no unifilar." />
  <InterfaceList>
    <EventInputs>
      <Event ID="AFE3943D783C7378" Name="E_RESET_FALHAS" Comment="Reconhecimento pelo processo com cmdResetFalhas = TRUE">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
