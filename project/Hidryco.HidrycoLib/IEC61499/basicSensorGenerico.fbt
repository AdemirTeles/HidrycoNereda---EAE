        <With Var="stpTempoAlarmeH" />
        <With Var="stpTempoAlarmeL" />
        <With Var="stpTempoAlarmeLL" />
      </Event>
      <Event ID="BB3A40EF748E4AD2" Name="REQ_FB" Comment="Leitura 4-20 mA">
        <With Var="fldBruto" />
      </Event>
      <Event ID="85BF8544E9C17F76" Name="REQ_FB_COM" Comment="Leitura por comunicacao">
