<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="024198ab-e6ed-4357-bf39-bdd2a7c5fcc4" Name="basicSensorGenerico" Comment="Logica unica do sensor generico (4-20 mA ou comunicacao)" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.2" Author="Hidryco" Date="16/10/2026" Remarks="1.2: falha do sinal tambem pelo status da conexao Modbus (fldConexao INT, 1 = online) com cfgUsaConexao, nos dois modos (4-20 mA lido por remota e comunicacao). 1.1: inibicao de L/LL pelo processo e condicao instantanea de cada limite. 1.0: padrao SE.App2CommonProcess - escala, falha NAMUR confirmada por tempo, alarmes HH/H/L/LL com tempo proprio e memoria ate o reset, supressao em falha" />
  <InterfaceList>
    <EventInputs>
      <Event ID="A313A1584C9E1BE5" Name="INIT" Comment="Inicializacao">
        <With Var="cfgComunicacao" />
        <With Var="cfgNivel" />
        <With Var="cfgBrutoMin" />
