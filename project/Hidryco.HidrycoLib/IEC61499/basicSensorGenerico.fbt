      <VarDeclaration ID="1B30B39C75AABA90" Name="stpAlarmeH" Type="REAL" Comment="IHM: setpoint do alarme H" />
      <VarDeclaration ID="3B12D5C113628B3D" Name="stpAlarmeL" Type="REAL" Comment="IHM: setpoint do alarme L" />
      <VarDeclaration ID="0C17F55C15BCD39D" Name="stpAlarmeLL" Type="REAL" Comment="IHM: setpoint do alarme LL" />
      <VarDeclaration ID="275E0286C790B3B5" Name="stpTempoAlarmeHH" Type="UINT" Comment="IHM: tempo do alarme HH (s)" />
      <VarDeclaration ID="91055F2FEA3A7CFE" Name="stpTempoAlarmeH" Type="UINT" Comment="IHM: tempo do alarme H (s)" />
      <VarDeclaration ID="5837C50851352086" Name="stpTempoAlarmeL" Type="UINT" Comment="IHM: tempo do alarme L (s)" />
