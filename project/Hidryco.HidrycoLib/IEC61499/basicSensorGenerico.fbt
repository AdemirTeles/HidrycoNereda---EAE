        <With Var="cmdResetFalhas" />
      </Event>
      <Event ID="C81E4D5CD6D5669B" Name="REQ_RESET_PLUG" Comment="Reset pelo plug ISensorStatus">
        <With Var="plgReset" />
      </Event>
      <Event ID="F6476A371C298363" Name="REQ_INIBE" Comment="Inibicao dos alarmes L e LL pelo processo">
        <With Var="inibeBaixos" />
      </Event>
      <Event ID="79D90CC239980ABE" Name="FALHA_MAX" Comment="Fim do tempo de confirmacao da falha (E_DELAY)" />
      <Event ID="0507438F316FE05A" Name="HH_MAX" Comment="Fim do tempo do alarme HH (E_DELAY)" />
      <Event ID="60C0262360B78E5E" Name="H_MAX" Comment="Fim do tempo do alarme H (E_DELAY)" />
      <Event ID="2ED9A6722EA41B53" Name="L_MAX" Comment="Fim do tempo do alarme L (E_DELAY)" />
      <Event ID="1B3FD32E01035504" Name="LL_MAX" Comment="Fim do tempo do alarme LL (E_DELAY)" />
    </EventInputs>
