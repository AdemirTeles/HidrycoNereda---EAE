    <Algorithm Name="algSensor" Comment="Logica completa do sensor (um unico algoritmo)">
      <ST><![CDATA[(* =====================================================================
   basicSensorGenerico v1.1 - logica do CAT Sensor_Generico (HidrycoLib)
   Padrao das bibliotecas Schneider (SE.App2CommonProcess):
   - eventos de saida desligados no inicio e ligados so na mudanca;
   - tempos por E_DELAY externo (X_T / X_RESET / X_MAX), um por alarme;
   - alarmes para o sistema de alarmes do EAE por ALARM_BIT (no CAT).
   Regras (definidas pelo usuario):
   - origem 4-20 mA (escala bruta e limites NAMUR offline) ou comunicacao
     (valor ja em unidade de engenharia);
   - falha do sinal confirmada apos cfgTempoFalha: valor vai a 0 e os
     alarmes ficam suprimidos; a falha fica memorizada ate o reset, mas o
     sensor volta a funcionar assim que o sinal volta;
   - durante a confirmacao o valor fica congelado (nao vai a 0 por um pico);
   - alarmes HH/H/L/LL sem histerese, cada um com o proprio tempo,
     memorizados ate o reset (IHM, processo ou plug);
   - sensor desabilitado: valor 0, sem falha e sem alarmes.
   v1.1: inibeBaixos (processo) inibe L/LL e libera a memoria deles;
         stsCondicaoX = valor alem do setpoint X agora (sem tempo, sem memoria).
   ===================================================================== *)

(* ---- 0. Eventos de saida: so sai o que for ligado abaixo ---- *)
INITO       := FALSE;
CNF         := FALSE;
CNF_PV      := FALSE;
CNF_STATUS  := FALSE;
CNF_HMI     := FALSE;
CNF_ALM     := FALSE;
FALHA_RESET := FALSE;
FALHA_T     := FALSE;
HH_RESET := FALSE; HH_T := FALSE;
H_RESET  := FALSE; H_T  := FALSE;
L_RESET  := FALSE; L_T  := FALSE;
LL_RESET := FALSE; LL_T := FALSE;

IF REQ_FB OR REQ_FB_COM OR REQ_FB_CON THEN
    fbRecebido := TRUE;                    (* campo valido a partir da 1a leitura *)
END_IF;

(* ---- 1. Inicializacao ---- *)
IF INIT THEN
    qiBruto       := NOT cfgComunicacao;   (* so assina o symlink da origem configurada *)
    qiComunicacao := cfgComunicacao;
    qiConexao     := cfgUsaConexao;           (* status da conexao: vale para 4-20 mA lido por remota e para comunicacao *)
    initDone := TRUE;
    initPass := TRUE;
    INITO    := TRUE;
END_IF;
IF NOT initDone THEN
    RETURN;
END_IF;

(* ---- 2. Sinal ---- *)
IF cfgComunicacao THEN
    rBruto     := fldValor;
    bRuimAgora := fbRecebido AND (fldFalhaSensor OR fldFalhaComunicacao OR (cfgUsaConexao AND fldConexao <> 1));
ELSE
    rBruto     := INT_TO_REAL(fldBruto);
    bRuimAgora := fbRecebido AND ((rBruto < cfgFalhaMin) OR (rBruto > cfgFalhaMax) OR (cfgUsaConexao AND fldConexao <> 1));
END_IF;

(* ---- 3. Falha do sensor: confirmada pelo tempo, memorizada ate o reset ---- *)
bReset := (REQ_RESET AND hmiReset) OR (REQ_RESET_PROC AND cmdResetFalhas) OR (REQ_RESET_PLUG AND plgReset);
IF NOT hmiHabilitaSensor THEN
    stsFalhaAtiva  := FALSE;
    stsFalhaSensor := FALSE;
ELSE
    IF FALHA_MAX AND bRuimAgora THEN
        stsFalhaAtiva  := TRUE;            (* falha confirmada *)
        stsFalhaSensor := TRUE;
    END_IF;
    IF NOT bRuimAgora THEN
        stsFalhaAtiva := FALSE;            (* sinal voltou: o sensor volta a funcionar *)
    END_IF;
    IF bReset AND NOT bRuimAgora THEN
        stsFalhaSensor := FALSE;           (* memoria so sai com reset e sinal bom *)
    END_IF;
END_IF;
bTimFalha := hmiHabilitaSensor AND bRuimAgora AND NOT stsFalhaAtiva;
IF bTimFalha <> oldTimFalha THEN
    IF bTimFalha THEN
        TempoFalha := TO_TIME(UINT_TO_DINT(cfgTempoFalha) * 1000);
        FALHA_T := TRUE;
    ELSE
        FALHA_RESET := TRUE;
    END_IF;
    oldTimFalha := bTimFalha;
END_IF;

(* ---- 4. Valor em unidade de engenharia ---- *)
IF NOT hmiHabilitaSensor OR NOT fbRecebido OR stsFalhaAtiva THEN
    stsValor := 0.0;                       (* desabilitado, sem leitura ou falha confirmada *)
ELSIF bRuimAgora THEN
    ;                                      (* confirmando a falha: valor congelado *)
ELSIF cfgComunicacao THEN
    stsValor := fldValor;                  (* ja chega em unidade de engenharia *)
ELSE
    rFaixa := cfgBrutoMax - cfgBrutoMin;
    IF rFaixa <> 0.0 THEN
        stsValor := stpRangeMinimo + (rBruto - cfgBrutoMin) * (stpRangeMaximo - stpRangeMinimo) / rFaixa;
        rMin := MIN(stpRangeMinimo, stpRangeMaximo);
        rMax := MAX(stpRangeMinimo, stpRangeMaximo);
        stsValor := LIMIT(rMin, stsValor, rMax);
    ELSE
        stsValor := 0.0;                   (* escala bruta invalida *)
    END_IF;
END_IF;
IF cfgNivel AND stpAlturaMaxima > 0.0 THEN
    stsPorcentagem := stsValor * 100.0 / stpAlturaMaxima;
ELSE
    stsPorcentagem := 0.0;
END_IF;
stsBruto := rBruto;

(* ---- 5. Alarmes (suprimidos com o sensor desabilitado, sem leitura ou em falha) ---- *)
bSuprimido := NOT hmiHabilitaSensor OR NOT fbRecebido OR bRuimAgora OR stsFalhaAtiva;
bAcimaHH := stsValor > stpAlarmeHH;
bCondHH := hmiHabilitaAlarmeHH AND NOT bSuprimido AND bAcimaHH;
stsCondicaoHH := bCondHH;
IF HH_MAX AND bCondHH THEN
    bMemHH := TRUE;                       (* tempo do alarme HH venceu com a condicao presente *)
END_IF;
IF bReset AND NOT bCondHH THEN
    bMemHH := FALSE;                      (* reset so libera se a condicao ja sumiu *)
END_IF;
IF NOT hmiHabilitaAlarmeHH OR NOT hmiHabilitaSensor THEN
    bMemHH := FALSE;                      (* alarme ou sensor desabilitado zera o alarme *)
END_IF;
bTimHH := bCondHH AND NOT bMemHH;
IF bTimHH <> oldTimHH THEN
    IF bTimHH THEN
        TempoHH := TO_TIME(UINT_TO_DINT(stpTempoAlarmeHH) * 1000);
        HH_T := TRUE;
    ELSE
        HH_RESET := TRUE;
    END_IF;
    oldTimHH := bTimHH;
END_IF;
stsAlarmeHH := bMemHH AND NOT bSuprimido;

bAcimaH := stsValor > stpAlarmeH;
bCondH := hmiHabilitaAlarmeH AND NOT bSuprimido AND bAcimaH;
stsCondicaoH := bCondH;
IF H_MAX AND bCondH THEN
    bMemH := TRUE;                       (* tempo do alarme H venceu com a condicao presente *)
END_IF;
IF bReset AND NOT bCondH THEN
    bMemH := FALSE;                      (* reset so libera se a condicao ja sumiu *)
END_IF;
IF NOT hmiHabilitaAlarmeH OR NOT hmiHabilitaSensor THEN
    bMemH := FALSE;                      (* alarme ou sensor desabilitado zera o alarme *)
END_IF;
bTimH := bCondH AND NOT bMemH;
IF bTimH <> oldTimH THEN
    IF bTimH THEN
        TempoH := TO_TIME(UINT_TO_DINT(stpTempoAlarmeH) * 1000);
        H_T := TRUE;
    ELSE
        H_RESET := TRUE;
    END_IF;
    oldTimH := bTimH;
END_IF;
stsAlarmeH := bMemH AND NOT bSuprimido;

bAcimaL := stsValor < stpAlarmeL;
bCondL := hmiHabilitaAlarmeL AND NOT bSuprimido AND bAcimaL AND NOT inibeBaixos;
stsCondicaoL := bCondL;
IF inibeBaixos THEN
    bMemL := FALSE;                      (* inibido pelo processo: libera o que estava memorizado *)
END_IF;
IF L_MAX AND bCondL THEN
    bMemL := TRUE;                       (* tempo do alarme L venceu com a condicao presente *)
END_IF;
IF bReset AND NOT bCondL THEN
    bMemL := FALSE;                      (* reset so libera se a condicao ja sumiu *)
END_IF;
IF NOT hmiHabilitaAlarmeL OR NOT hmiHabilitaSensor THEN
    bMemL := FALSE;                      (* alarme ou sensor desabilitado zera o alarme *)
END_IF;
bTimL := bCondL AND NOT bMemL;
IF bTimL <> oldTimL THEN
    IF bTimL THEN
        TempoL := TO_TIME(UINT_TO_DINT(stpTempoAlarmeL) * 1000);
        L_T := TRUE;
    ELSE
        L_RESET := TRUE;
    END_IF;
    oldTimL := bTimL;
END_IF;
stsAlarmeL := bMemL AND NOT bSuprimido;

bAcimaLL := stsValor < stpAlarmeLL;
bCondLL := hmiHabilitaAlarmeLL AND NOT bSuprimido AND bAcimaLL AND NOT inibeBaixos;
stsCondicaoLL := bCondLL;
IF inibeBaixos THEN
    bMemLL := FALSE;                      (* inibido pelo processo: libera o que estava memorizado *)
END_IF;
IF LL_MAX AND bCondLL THEN
    bMemLL := TRUE;                       (* tempo do alarme LL venceu com a condicao presente *)
END_IF;
IF bReset AND NOT bCondLL THEN
    bMemLL := FALSE;                      (* reset so libera se a condicao ja sumiu *)
END_IF;
IF NOT hmiHabilitaAlarmeLL OR NOT hmiHabilitaSensor THEN
    bMemLL := FALSE;                      (* alarme ou sensor desabilitado zera o alarme *)
END_IF;
bTimLL := bCondLL AND NOT bMemLL;
IF bTimLL <> oldTimLL THEN
    IF bTimLL THEN
        TempoLL := TO_TIME(UINT_TO_DINT(stpTempoAlarmeLL) * 1000);
        LL_T := TRUE;
    ELSE
        LL_RESET := TRUE;
    END_IF;
    oldTimLL := bTimLL;
END_IF;
stsAlarmeLL := bMemLL AND NOT bSuprimido;

stsAlarme := stsAlarmeHH OR stsAlarmeH OR stsAlarmeL OR stsAlarmeLL;
stsHabilitado := hmiHabilitaSensor;

(* ---- 6. Entradas dos ALARM_BIT (lista de alarmes do EAE) ---- *)
almHH := stsAlarmeHH;
almH  := stsAlarmeH;
almL  := stsAlarmeL;
almLL := stsAlarmeLL;
almFalha := stsFalhaSensor;

(* ---- 7. Estado para o simbolo ---- *)
IF NOT hmiHabilitaSensor THEN
    stsEstado := 4;
ELSIF stsFalhaSensor OR stsFalhaAtiva THEN
    stsEstado := 3;
ELSIF stsAlarmeHH OR stsAlarmeLL THEN
    stsEstado := 2;
ELSIF stsAlarmeH OR stsAlarmeL THEN
    stsEstado := 1;
ELSE
    stsEstado := 0;
END_IF;

(* ---- 8. Eventos so na mudanca ---- *)
wSts := 0;
IF stsFalhaSensor THEN wSts := wSts OR 16#0001; END_IF;
IF stsFalhaAtiva  THEN wSts := wSts OR 16#0002; END_IF;
IF stsHabilitado  THEN wSts := wSts OR 16#0004; END_IF;
IF stsAlarmeHH    THEN wSts := wSts OR 16#0010; END_IF;
IF stsAlarmeH     THEN wSts := wSts OR 16#0020; END_IF;
IF stsAlarmeL     THEN wSts := wSts OR 16#0040; END_IF;
IF stsAlarmeLL    THEN wSts := wSts OR 16#0080; END_IF;
IF stsCondicaoHH  THEN wSts := wSts OR 16#0100; END_IF;
IF stsCondicaoH   THEN wSts := wSts OR 16#0200; END_IF;
IF stsCondicaoL   THEN wSts := wSts OR 16#0400; END_IF;
IF stsCondicaoLL  THEN wSts := wSts OR 16#0800; END_IF;
wAlm := 0;
IF almHH    THEN wAlm := wAlm OR 16#0001; END_IF;
IF almH     THEN wAlm := wAlm OR 16#0002; END_IF;
IF almL     THEN wAlm := wAlm OR 16#0004; END_IF;
IF almLL    THEN wAlm := wAlm OR 16#0008; END_IF;
IF almFalha THEN wAlm := wAlm OR 16#0010; END_IF;

CNF_PV     := initPass OR (stsValor <> oldValor);
CNF_STATUS := initPass OR ((wSts AND 16#00F2) <> (oldSts AND 16#00F2));
CNF        := initPass OR (stsValor <> oldValor) OR (stsPorcentagem <> oldPct) OR (wSts <> oldSts);
CNF_HMI    := CNF OR (stsEstado <> oldEstado) OR (rBruto <> oldBruto);
CNF_ALM    := initPass OR (wAlm <> oldAlm);
oldValor  := stsValor;
oldPct    := stsPorcentagem;
oldBruto  := rBruto;
oldSts    := wSts;
oldAlm    := wAlm;
oldEstado := stsEstado;

initPass := FALSE;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>