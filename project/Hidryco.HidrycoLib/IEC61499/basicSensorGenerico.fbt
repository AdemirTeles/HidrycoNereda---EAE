      <VarDeclaration ID="5C7B1A72AEA1734C" Name="stsCondicaoHH" Type="BOOL" Comment="Valor alem do setpoint HH agora (sem tempo e sem memoria; so com o alarme habilitado e o sinal bom)" />
      <VarDeclaration ID="B271C2D0A9370A7F" Name="stsCondicaoH" Type="BOOL" Comment="Valor alem do setpoint H agora (sem tempo e sem memoria; so com o alarme habilitado e o sinal bom)" />
      <VarDeclaration ID="80C046EE3841337A" Name="stsCondicaoL" Type="BOOL" Comment="Valor alem do setpoint L agora (sem tempo e sem memoria; so com o alarme habilitado e o sinal bom)" />
      <VarDeclaration ID="46248A230C3897E2" Name="stsCondicaoLL" Type="BOOL" Comment="Valor alem do setpoint LL agora (sem tempo e sem memoria; so com o alarme habilitado e o sinal bom)" />
