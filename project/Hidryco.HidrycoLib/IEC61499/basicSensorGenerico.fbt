        <With Var="TempoH" />
      </Event>
      <Event ID="64E82BD205C26648" Name="L_RESET" Comment="Cancela o tempo do alarme L - sai antes do L_T" />
      <Event ID="A5C367FB8CC6123F" Name="L_T" Comment="Inicia o tempo do alarme L">
        <With Var="TempoL" />
      </Event>
      <Event ID="F8318F17CCD7636C" Name="LL_RESET" Comment="Cancela o tempo do alarme LL - sai antes do LL_T" />
      <Event ID="48A9F0D2C448300B" Name="LL_T" Comment="Inicia o tempo do alarme LL">
        <With Var="TempoLL" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="BDC9951972159B49" Name="cfgComunicacao" Type="BOOL" InitialValue="FALSE" Comment="FALSE = entrada 4-20 mA (stsSensorBruto), TRUE = valor por comunicacao (stsEntrada, ja em unidade de engenharia)" />
      <VarDeclaration ID="A121066C0B4E396A" Name="cfgNivel" Type="BOOL" InitialValue="FALSE" Comment="TRUE = sensor de nivel: calcula % sobre a altura maxima" />
      <VarDeclaration ID="08668FFBD0D4C224" Name="cfgBrutoMin" Type="REAL" InitialValue="4000.0" Comment="Valor bruto em 4 mA (TM3: 4000)" />
      <VarDeclaration ID="5C5752CDF95E2D99" Name="cfgBrutoMax" Type="REAL" InitialValue="20000.0" Comment="Valor bruto em 20 mA (TM3: 20000)" />
      <VarDeclaration ID="D75E79B6B7019547" Name="cfgFalhaMin" Type="REAL" InitialValue="3600.0" Comment="Abaixo deste bruto = falha (NAMUR NE43: 3,6 mA)" />
      <VarDeclaration ID="E942EB878618E7C8" Name="cfgFalhaMax" Type="REAL" InitialValue="21000.0" Comment="Acima deste bruto = falha (NAMUR NE43: 21,0 mA)" />
