<FBType GUID="7fba978b-ff61-40c5-9a08-1a715208b732" Name="IO_DI32" Format="2.0" Comment="Cartao TM3DI32K da remota TM3BCEIP: separa as 2 words lidas em 32 bits e publica cada bit por symlink, com depurador" Namespace="Hidryco.HidrycoLib">
  <Attribute Name="HMI.Alias" Value="" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.1" Author="Hidryco" Date="10/6/2026" Remarks="1.1: bits nao sao mais zerados pela comunicacao; status da remota so gera FALHA_COM/COM_OK" />
  <InterfaceList>
