      <VarDeclaration ID="D1D2DBA1BD18FB75" Name="oldSts" Type="DWORD" InitialValue="16#FFFFFFFF" />
      <VarDeclaration ID="80850D556875C135" Name="wAlm" Type="WORD" />
      <VarDeclaration ID="3B12C1D9E50B3041" Name="oldAlm" Type="WORD" InitialValue="16#FFFF" />
      <VarDeclaration ID="D21646F099DE6BC9" Name="iOld" Type="INT" />
      <VarDeclaration ID="C23EC639F1A8B432" Name="uCmd" Type="UINT" Comment="Segundos restantes do pulso de comando" />
      <VarDeclaration ID="9E05B879C233CD5A" Name="wPerm" Type="WORD" />
      <VarDeclaration ID="A24FFD7906396813" Name="oldPerm" Type="WORD" InitialValue="16#FFFF" />
      <VarDeclaration ID="0127D1FF1264A1BE" Name="o_stsTensaoAB" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="E250EF5D850D06A7" Name="o_stsTensaoBC" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="11FE2F54EED9DBC7" Name="o_stsTensaoCA" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="09A80057B54DA879" Name="o_stsTensaoAN" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="45179808F76AB2BD" Name="o_stsTensaoBN" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="1ED34966C099597D" Name="o_stsTensaoCN" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="39A3F78D5A309AA0" Name="o_stsTensaoMediaLL" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="07FF9AAA41A994E7" Name="o_stsFrequencia" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="C16E90F4DD2A5A29" Name="o_stsCorrenteA" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="C0D407910CAEB8D4" Name="o_stsCorrenteB" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="4638C61C5C10D6C8" Name="o_stsCorrenteC" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="A992FA43CF5920DF" Name="o_stsPotenciaAtiva" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="B81C436F2E18503D" Name="o_stsPotenciaReativa" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="D8D7A5AD47531C13" Name="o_stsPotenciaAparente" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="54B29459BC9D3499" Name="o_stsFatorPotencia" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="091EA5E6AFEE58A7" Name="o_stsTensaoBarra" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="019D58EEABB90CDD" Name="o_stsEnergiaAtiva" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="16197853F4BA937F" Name="o_stsHorasOperacao" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="A493F611EDBCEBFF" Name="o_stsTensaoBateria" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="AB9FA2893AAA05B0" Name="o_stsRotacao" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="D60DC80E3AA538BC" Name="o_stsTempArrefecimento" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="E550989C471A1CD1" Name="o_stsPressaoOleo" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="26C73C4D1C4B2B8C" Name="o_stsTempOleo" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="3B68912CCE1C25AA" Name="o_stsNumAlarmesAGC" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="413ABB7C0518D900" Name="o_stsNumAlarmesNaoRecAGC" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="6306FCA4F090D698" Name="o_stsDisjuntorGerador" Type="INT" InitialValue="-1" />
      <VarDeclaration ID="A56B0E513B13FD4F" Name="o_stsDisjuntorRede" Type="INT" InitialValue="-1" />
      <VarDeclaration ID="7A60F62CC3A6A306" Name="o_stsModo" Type="INT" InitialValue="-1" />
      <VarDeclaration ID="BDDFDFCF7DC9201C" Name="o_stsFonte" Type="INT" InitialValue="-1" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Estado inicial" x="1500" y="640" />
      <ECState Name="EXEC" Comment="Executa a logica; o algoritmo decide quais eventos saem" x="1500" y="1100">
        <ECAction Algorithm="algGerador" Output="INITO" />
        <ECAction Output="CNF" />
        <ECAction Output="CNF_HMI" />
        <ECAction Output="CNF_CMD" />
        <ECAction Output="CNF_ALM" />
      </ECState>
      <ECTransition Source="START" Destination="EXEC" Condition="INIT OR REQ_L1 OR REQ_L2 OR REQ_L3 OR REQ_COM OR REQ_RESET OR REQ_RESET_PROC OR REQ_CMD OR TICK" x="1580" y="860" />
      <ECTransition Source="EXEC" Destination="START" Condition="1" x="1420" y="860" />
    </ECC>
    <Algorithm Name="algGerador" Comment="Logica completa do gerador (um unico algoritmo)">
      <ST><![CDATA[(* =====================================================================
   basicGeradorGenerico v1.0 - grupo gerador com controlador DEIF AGC 150
   (aplicacao GEN: QTA com disjuntor do gerador GB e de rede MB)
   Registradores de entrada (FC04) da tabela DEIF "AGC 150 Modbus server
   tables" rev. S (software 1.19). v1.1: comandos basicos nas palavras de
   comando 5 e 6 (pulso de cfgTempoComando s; depois as palavras voltam a 0).
   Padrao das bibliotecas Schneider: eventos de saida desligados no inicio e
   ligados so na mudanca; tempos contados pelo TICK de 1 s (E_CYCLE do CAT).
   - escalas da tabela: frequencia e FP 0,01; bateria, temperaturas 0,1;
     pressao do oleo 0,01 bar; energia e horas INT32 (ABCD, palavra alta 1o);
   - falha de comunicacao: connStatusInt <> 1 por cfgTempoCom s; com a
     falha os estados ficam indefinidos e os demais alarmes suprimidos;
   - alarmes seguem o AGC (nao memorizados aqui): o reconhecimento na IHM
     reconhece os ALARM_BIT; os alarmes do AGC sao reconhecidos no AGC.
   ===================================================================== *)

INITO   := FALSE;
CNF     := FALSE;
CNF_HMI := FALSE;
CNF_CMD := FALSE;
CNF_ALM := FALSE;

IF REQ_COM THEN
    bComRecebida := TRUE;
END_IF;
IF INIT THEN
    initDone := TRUE;
    initPass := TRUE;
    INITO    := TRUE;
END_IF;
IF NOT initDone THEN
    RETURN;
END_IF;

(* ---- 1. Comunicacao ---- *)
IF comInt <> 1 THEN
    IF TICK AND uSegCom < UINT_TO_UDINT(cfgTempoCom) THEN
        uSegCom := uSegCom + 1;
    END_IF;
ELSE
    uSegCom := 0;
END_IF;
stsFalhaComunicacao := comInt <> 1 AND uSegCom >= UINT_TO_UDINT(cfgTempoCom);
bValido := bComRecebida AND comInt = 1;

(* ---- 2. Valores (ficam congelados sem comunicacao) ---- *)
stsTensaoAB := INT_TO_REAL(rVAB);
stsTensaoBC := INT_TO_REAL(rVBC);
stsTensaoCA := INT_TO_REAL(rVCA);
stsTensaoAN := INT_TO_REAL(rVAN);
stsTensaoBN := INT_TO_REAL(rVBN);
stsTensaoCN := INT_TO_REAL(rVCN);
stsTensaoMediaLL := (INT_TO_REAL(rVAB) + INT_TO_REAL(rVBC) + INT_TO_REAL(rVCA)) / 3.0;
stsFrequencia := INT_TO_REAL(rFreq) / 100.0;
stsCorrenteA := INT_TO_REAL(rIA);
stsCorrenteB := INT_TO_REAL(rIB);
stsCorrenteC := INT_TO_REAL(rIC);
stsPotenciaAtiva := INT_TO_REAL(rPAtiva);
stsPotenciaReativa := INT_TO_REAL(rQReativa);
stsPotenciaAparente := INT_TO_REAL(rSAparente);
stsFatorPotencia := INT_TO_REAL(rFP) / 100.0;
stsTensaoBarra := INT_TO_REAL(rVBarra);
stsEnergiaAtiva := DINT_TO_REAL(DWORD_TO_DINT(SHL(WORD_TO_DWORD(INT_TO_WORD(rEnergiaH)), 16) OR WORD_TO_DWORD(INT_TO_WORD(rEnergiaL))));
stsHorasOperacao := DINT_TO_REAL(DWORD_TO_DINT(SHL(WORD_TO_DWORD(INT_TO_WORD(rHorasH)), 16) OR WORD_TO_DWORD(INT_TO_WORD(rHorasL))));
stsTensaoBateria := INT_TO_REAL(rBateria) / 10.0;
stsRotacao := INT_TO_REAL(rRPM);
stsTempArrefecimento := INT_TO_REAL(rTempAgua) / 10.0;
stsPressaoOleo := INT_TO_REAL(rPressOleo) / 100.0;
stsTempOleo := INT_TO_REAL(rTempOleo) / 10.0;
stsNumAlarmesAGC := INT_TO_REAL(rNumAlm);
stsNumAlarmesNaoRecAGC := INT_TO_REAL(rNumAlmNR);

(* ---- 3. Palavras de estado e alarme ---- *)
w05 := INT_TO_WORD(rW1005);
w10 := INT_TO_WORD(rW1010);
w13 := INT_TO_WORD(rW1013);
w18 := INT_TO_WORD(rW1018);
w19 := INT_TO_WORD(rW1019);
w20 := INT_TO_WORD(rW1020);
bGBon  := (w18 AND 16#0010) <> 16#0000;
bGBoff := (w18 AND 16#0800) <> 16#0000;
bMBon  := (w18 AND 16#0002) <> 16#0000;
bMBoff := (w18 AND 16#1000) <> 16#0000;

stsFaltaRede := bValido AND ((w18 AND 16#0001) <> 16#0000);
stsMotorOperando := bValido AND ((w18 AND 16#0040) <> 16#0000);
stsGeradorTensaoOK := bValido AND ((w18 AND 16#0100) <> 16#0000);

(* disjuntores: 2 fechado, 1 aberto, 0 indefinido (transicao ou sem comunicacao) *)
IF NOT bValido THEN
    stsDisjuntorGerador := 0;
    stsDisjuntorRede := 0;
ELSE
    IF bGBon AND NOT bGBoff THEN stsDisjuntorGerador := 2;
    ELSIF bGBoff AND NOT bGBon THEN stsDisjuntorGerador := 1;
    ELSE stsDisjuntorGerador := 0;
    END_IF;
    IF bMBon AND NOT bMBoff THEN stsDisjuntorRede := 2;
    ELSIF bMBoff AND NOT bMBon THEN stsDisjuntorRede := 1;
    ELSE stsDisjuntorRede := 0;
    END_IF;
END_IF;

(* modo: teste > bloqueio > manual > semi > auto *)
IF NOT bValido THEN stsModo := 0;
ELSIF (w19 AND 16#0010) <> 16#0000 THEN stsModo := 5;
ELSIF (w19 AND 16#0001) <> 16#0000 THEN stsModo := 4;
ELSIF (w19 AND 16#0002) <> 16#0000 THEN stsModo := 3;
ELSIF (w19 AND 16#0004) <> 16#0000 THEN stsModo := 2;
ELSIF (w19 AND 16#0008) <> 16#0000 THEN stsModo := 1;
ELSE stsModo := 0;
END_IF;

(* fonte da saida do QTA *)
IF NOT bValido THEN stsFonte := 3;
ELSIF stsDisjuntorGerador = 2 THEN stsFonte := 2;
ELSIF stsDisjuntorRede = 2 THEN stsFonte := 1;
ELSE stsFonte := 0;
END_IF;

(* ---- 4. Alarmes (seguem o AGC; so com comunicacao) ---- *)
stsAlarmeAGC := bValido AND (rNumAlm > 0);
stsFalhaPartida := bValido AND ((w13 AND 16#8800) <> 16#0000);
stsDesligamentoMotor := bValido AND (((w20 AND 16#0004) <> 16#0000) OR ((w13 AND 16#0600) <> 16#0000));
stsParadaEmergencia := bValido AND ((w10 AND 16#1000) <> 16#0000);
stsFalhaDisjuntor := bValido AND ((w05 AND 16#03F0) <> 16#0000);
stsAvisoFaltaRede := bValido AND ((w18 AND 16#0001) <> 16#0000);
stsForaAutomatico := bValido AND ((w19 AND 16#0008) = 16#0000);

almCom := stsFalhaComunicacao;
almAGC := stsAlarmeAGC;
almPartida := stsFalhaPartida;
almMotor := stsDesligamentoMotor;
almEmergencia := stsParadaEmergencia;
almDisjuntor := stsFalhaDisjuntor;
almFaltaRede := stsAvisoFaltaRede;
almForaAuto := stsForaAutomatico;
stsAlarme := almCom OR almAGC OR almPartida OR almMotor OR almEmergencia OR almDisjuntor OR almFaltaRede OR almForaAuto;

(* ---- 5. Comandos basicos (IHM) nas palavras 5 e 6 do AGC ---- *)
stsPermAuto := bValido AND stsModo <> 1;
stsPermSemi := bValido AND stsModo <> 2;
stsPermPartir := bValido AND stsModo = 2 AND NOT stsMotorOperando;
stsPermParar := bValido AND stsModo = 2 AND stsMotorOperando;
stsPermReconhecerAGC := bValido;
IF REQ_CMD AND uCmd = 0 THEN
    IF hmiComando = 1 AND stsPermAuto THEN
        cmdPalavra6 := 8193; cmdPalavra5 := 0;
        uCmd := cfgTempoComando + 1;
        CNF_CMD := TRUE;
    ELSIF hmiComando = 2 AND stsPermSemi THEN
        cmdPalavra6 := 16385; cmdPalavra5 := 0;
        uCmd := cfgTempoComando + 1;
        CNF_CMD := TRUE;
    ELSIF hmiComando = 3 AND stsPermPartir THEN
        cmdPalavra5 := 3; cmdPalavra6 := 0;
        uCmd := cfgTempoComando + 1;
        CNF_CMD := TRUE;
    ELSIF hmiComando = 4 AND stsPermParar THEN
        cmdPalavra5 := 17; cmdPalavra6 := 0;
        uCmd := cfgTempoComando + 1;
        CNF_CMD := TRUE;
    ELSIF hmiComando = 5 AND stsPermReconhecerAGC THEN
        cmdPalavra5 := 1025; cmdPalavra6 := 0;
        uCmd := cfgTempoComando + 1;
        CNF_CMD := TRUE;
    END_IF;
END_IF;
IF TICK AND uCmd > 0 THEN
    uCmd := uCmd - 1;
    IF uCmd = 0 THEN
        cmdPalavra5 := 0;
        cmdPalavra6 := 0;
        CNF_CMD := TRUE;
    END_IF;
END_IF;
IF NOT bValido AND uCmd > 0 THEN
    uCmd := 0;
    cmdPalavra5 := 0;
    cmdPalavra6 := 0;
    CNF_CMD := TRUE;
END_IF;
stsComandoAtivo := uCmd > 0;
wPerm := 0;
IF stsPermAuto THEN wPerm := wPerm OR 16#0001; END_IF;
IF stsPermSemi THEN wPerm := wPerm OR 16#0002; END_IF;
IF stsPermPartir THEN wPerm := wPerm OR 16#0004; END_IF;
IF stsPermParar THEN wPerm := wPerm OR 16#0008; END_IF;
IF stsPermReconhecerAGC THEN wPerm := wPerm OR 16#0010; END_IF;
IF stsComandoAtivo THEN wPerm := wPerm OR 16#0020; END_IF;

(* ---- 6. Eventos so na mudanca ---- *)
bMudou := FALSE;
IF stsTensaoAB <> o_stsTensaoAB THEN bMudou := TRUE; o_stsTensaoAB := stsTensaoAB; END_IF;
IF stsTensaoBC <> o_stsTensaoBC THEN bMudou := TRUE; o_stsTensaoBC := stsTensaoBC; END_IF;
IF stsTensaoCA <> o_stsTensaoCA THEN bMudou := TRUE; o_stsTensaoCA := stsTensaoCA; END_IF;
IF stsTensaoAN <> o_stsTensaoAN THEN bMudou := TRUE; o_stsTensaoAN := stsTensaoAN; END_IF;
IF stsTensaoBN <> o_stsTensaoBN THEN bMudou := TRUE; o_stsTensaoBN := stsTensaoBN; END_IF;
IF stsTensaoCN <> o_stsTensaoCN THEN bMudou := TRUE; o_stsTensaoCN := stsTensaoCN; END_IF;
IF stsTensaoMediaLL <> o_stsTensaoMediaLL THEN bMudou := TRUE; o_stsTensaoMediaLL := stsTensaoMediaLL; END_IF;
IF stsFrequencia <> o_stsFrequencia THEN bMudou := TRUE; o_stsFrequencia := stsFrequencia; END_IF;
IF stsCorrenteA <> o_stsCorrenteA THEN bMudou := TRUE; o_stsCorrenteA := stsCorrenteA; END_IF;
IF stsCorrenteB <> o_stsCorrenteB THEN bMudou := TRUE; o_stsCorrenteB := stsCorrenteB; END_IF;
IF stsCorrenteC <> o_stsCorrenteC THEN bMudou := TRUE; o_stsCorrenteC := stsCorrenteC; END_IF;
IF stsPotenciaAtiva <> o_stsPotenciaAtiva THEN bMudou := TRUE; o_stsPotenciaAtiva := stsPotenciaAtiva; END_IF;
IF stsPotenciaReativa <> o_stsPotenciaReativa THEN bMudou := TRUE; o_stsPotenciaReativa := stsPotenciaReativa; END_IF;
IF stsPotenciaAparente <> o_stsPotenciaAparente THEN bMudou := TRUE; o_stsPotenciaAparente := stsPotenciaAparente; END_IF;
IF stsFatorPotencia <> o_stsFatorPotencia THEN bMudou := TRUE; o_stsFatorPotencia := stsFatorPotencia; END_IF;
IF stsTensaoBarra <> o_stsTensaoBarra THEN bMudou := TRUE; o_stsTensaoBarra := stsTensaoBarra; END_IF;
IF stsEnergiaAtiva <> o_stsEnergiaAtiva THEN bMudou := TRUE; o_stsEnergiaAtiva := stsEnergiaAtiva; END_IF;
IF stsHorasOperacao <> o_stsHorasOperacao THEN bMudou := TRUE; o_stsHorasOperacao := stsHorasOperacao; END_IF;
IF stsTensaoBateria <> o_stsTensaoBateria THEN bMudou := TRUE; o_stsTensaoBateria := stsTensaoBateria; END_IF;
IF stsRotacao <> o_stsRotacao THEN bMudou := TRUE; o_stsRotacao := stsRotacao; END_IF;
IF stsTempArrefecimento <> o_stsTempArrefecimento THEN bMudou := TRUE; o_stsTempArrefecimento := stsTempArrefecimento; END_IF;
IF stsPressaoOleo <> o_stsPressaoOleo THEN bMudou := TRUE; o_stsPressaoOleo := stsPressaoOleo; END_IF;
IF stsTempOleo <> o_stsTempOleo THEN bMudou := TRUE; o_stsTempOleo := stsTempOleo; END_IF;
IF stsNumAlarmesAGC <> o_stsNumAlarmesAGC THEN bMudou := TRUE; o_stsNumAlarmesAGC := stsNumAlarmesAGC; END_IF;
IF stsNumAlarmesNaoRecAGC <> o_stsNumAlarmesNaoRecAGC THEN bMudou := TRUE; o_stsNumAlarmesNaoRecAGC := stsNumAlarmesNaoRecAGC; END_IF;
IF stsDisjuntorGerador <> o_stsDisjuntorGerador THEN bMudou := TRUE; o_stsDisjuntorGerador := stsDisjuntorGerador; END_IF;
IF stsDisjuntorRede <> o_stsDisjuntorRede THEN bMudou := TRUE; o_stsDisjuntorRede := stsDisjuntorRede; END_IF;
IF stsModo <> o_stsModo THEN bMudou := TRUE; o_stsModo := stsModo; END_IF;
IF stsFonte <> o_stsFonte THEN bMudou := TRUE; o_stsFonte := stsFonte; END_IF;
wSts := 0;
IF stsFaltaRede THEN wSts := wSts OR 16#00000001; END_IF;
IF stsMotorOperando THEN wSts := wSts OR 16#00000002; END_IF;
IF stsGeradorTensaoOK THEN wSts := wSts OR 16#00000004; END_IF;
IF stsAlarmeAGC THEN wSts := wSts OR 16#00000008; END_IF;
IF stsFalhaPartida THEN wSts := wSts OR 16#00000010; END_IF;
IF stsDesligamentoMotor THEN wSts := wSts OR 16#00000020; END_IF;
IF stsParadaEmergencia THEN wSts := wSts OR 16#00000040; END_IF;
IF stsFalhaDisjuntor THEN wSts := wSts OR 16#00000080; END_IF;
IF stsAvisoFaltaRede THEN wSts := wSts OR 16#00000100; END_IF;
IF stsForaAutomatico THEN wSts := wSts OR 16#00000200; END_IF;
IF stsFalhaComunicacao THEN wSts := wSts OR 16#00000400; END_IF;
IF stsAlarme THEN wSts := wSts OR 16#00000800; END_IF;
wAlm := 0;
IF almCom THEN wAlm := wAlm OR 16#0001; END_IF;
IF almAGC THEN wAlm := wAlm OR 16#0002; END_IF;
IF almPartida THEN wAlm := wAlm OR 16#0004; END_IF;
IF almMotor THEN wAlm := wAlm OR 16#0008; END_IF;
IF almEmergencia THEN wAlm := wAlm OR 16#0010; END_IF;
IF almDisjuntor THEN wAlm := wAlm OR 16#0020; END_IF;
IF almFaltaRede THEN wAlm := wAlm OR 16#0040; END_IF;
IF almForaAuto THEN wAlm := wAlm OR 16#0080; END_IF;
CNF := initPass OR bMudou OR (wSts <> oldSts);
CNF_HMI := CNF OR (wPerm <> oldPerm);
IF initPass THEN
    CNF_CMD := TRUE;
END_IF;
CNF_ALM := initPass OR (wAlm <> oldAlm);
oldSts := wSts;
oldPerm := wPerm;
oldAlm := wAlm;
initPass := FALSE;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>