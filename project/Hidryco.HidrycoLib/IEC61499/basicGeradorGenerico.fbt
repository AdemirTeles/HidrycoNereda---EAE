<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="34c301df-2e07-499a-ba87-fb6f781d34ac" Name="basicGeradorGenerico" Comment="Logica unica do grupo gerador (DEIF AGC 150): valores, estado do QTA, modo e alarmes" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.1" Author="Hidryco" Date="15/10/2026" Remarks="1.1: comandos basicos (automatico, semiautomatico, partir, parar, reconhecer alarmes do AGC) nas palavras 5 e 6. 1.0: AGC 150 (GEN) por Modbus TCP FC04, tabela DEIF rev. S; so supervisao" />
