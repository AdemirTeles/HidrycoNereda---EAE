<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="f24429e5-1b77-21e3-e19a-96a7cf799feb" Name="Controle_Gradeamento_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="21/10/2026" Remarks="IHM do Controle_Gradeamento" />
  <InterfaceList>
    <EventInputs>
      <Event ID="78D060DDF0D6C29B" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="EB84A4D09D4A561C" Name="LOAD_PERS_DATA" Comment="Reenvia os parametros persistentes" />
      <Event ID="3B0B4B327E0E53A5" Name="E_ATUALIZA_NIVEL" Comment="Status do processo">
        <With Var="STS_DIFERENCIAL_GRADE1" />
        <With Var="STS_DIFERENCIAL_GRADE2" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="096E3F14444C7AE4" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="C21A00BE6F76DA69" Name="E_ATUALIZA_SETPOINT" Comment="Ajustes (IHM/OPC UA e LOAD_PERS_DATA)">
        <With Var="CMD_LIGA_CICLO_REMOTO" />
        <With Var="STP_DIFERENCIAL_NIVEL_GRADE1" />
        <With Var="STP_DIFERENCIAL_NIVEL_GRADE2" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="8224027113271FAA" Name="QI" Type="BOOL" />
      <VarDeclaration ID="BBB488887FAB7468" Name="STS_DIFERENCIAL_GRADE1" Type="REAL" Comment="Nivel diferencial da grade 1 agora (%)" />
      <VarDeclaration ID="B366ED964F960D7B" Name="STS_DIFERENCIAL_GRADE2" Type="REAL" Comment="Nivel diferencial da grade 2 agora (%)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="7552614A13A6DE86" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="722C332A405644EF" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="E35995B34DA02859" Name="CMD_LIGA_CICLO_REMOTO" Type="BOOL" Comment="Ciclo remoto" />
      <VarDeclaration ID="1D4739E4AA7907D3" Name="STP_DIFERENCIAL_NIVEL_GRADE1" Type="REAL" Comment="Diferencial de nível para limpar a grade 1" />
      <VarDeclaration ID="42EA1CA3AF8E6D51" Name="STP_DIFERENCIAL_NIVEL_GRADE2" Type="REAL" Comment="Diferencial de nível para limpar a grade 2" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>
