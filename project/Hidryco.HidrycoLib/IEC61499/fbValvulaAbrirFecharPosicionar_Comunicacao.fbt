        <Attribute Name="Configuration.Transaction.BezierPoints" Value="552.6643,333.2607,593.1545,485.2622" />
      </ECTransition>
      <ECTransition Source="START" Destination="EXEC_SEGURO" Condition="(REQ AND (NOT stsRemoto OR (NOT stsAutomatico AND bloqueioManual) OR (stsAutomatico AND bloqueioAutomatico)) AND NOT stsEmergencia)" x="1897.825" y="1798.098">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="485.838,359.2376,470.5798,539.7101" />
      </ECTransition>
      <ECTransition Source="EXEC_MANUAL" Destination="START" Condition="1" x="2482.318" y="896.5355">
