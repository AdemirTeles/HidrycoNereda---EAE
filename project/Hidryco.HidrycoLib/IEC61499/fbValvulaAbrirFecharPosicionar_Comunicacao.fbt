<FBType GUID="0a5bcad1-8a6e-4e05-abee-e1daca33bb16" Name="fbValvulaAbrirFecharPosicionar_Comunicacao" Comment="Basic Function Block Type" Namespace="Hidryco.HidrycoLib">
