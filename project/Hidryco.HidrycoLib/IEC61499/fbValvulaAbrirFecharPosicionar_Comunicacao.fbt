      </ECTransition>
      <ECTransition Source="START" Destination="EMERGENCIA" Condition="stsEmergencia" x="2028.082" y="375.7059">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="502.503,100.8868,514.7323,74.46617" />
      </ECTransition>
      <ECTransition Source="EMERGENCIA" Destination="START" Condition="1" x="2112.333" y="482.21">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="537.4197,109.9675,525.1904,136.3881" />
      </ECTransition>
    </ECC>
    <Algorithm Name="ALG_MANUAL">
      <ST><![CDATA[acmAbrir       := cmdAbrirManual;
acmFechar      := cmdFecharManual;
acmPosicionar  := cmdPosicionarManual;
acmParar		:= cmdPararManual;

IF cmdPosicionarManual THEN
    stpPosicaoDesejada := stpPosicaoDesejadaManual;
END_IF;
;]]></ST>
    </Algorithm>
    <Algorithm Name="ALG_AUTO_PID">
      <ST><![CDATA[acmAbrir  := FALSE;
acmFechar := FALSE;
acmParar := FALSE;

IF stpPosicaoDesejadaAutomatico <> prevStpAuto THEN
    stpPosicaoDesejada := stpPosicaoDesejadaAutomatico;
    acmPosicionar      := TRUE; 
ELSE
    acmPosicionar := FALSE;
END_IF;

prevStpAuto := stpPosicaoDesejadaAutomatico;
;]]></ST>
    </Algorithm>
    <Algorithm Name="ALG_AUTO_DIRETO">
      <ST><![CDATA[acmAbrir       := cmdAbrirAutomatico;
acmFechar      := cmdFecharAutomatico;
acmPosicionar  := FALSE;
acmParar		:= FALSE;
;]]></ST>
    </Algorithm>
    <Algorithm Name="ALG_SEGURO">
      <ST><![CDATA[acmAbrir       := FALSE;
acmFechar      := FALSE;
acmPosicionar  := FALSE;
acmParar		:= TRUE;
;]]></ST>
    </Algorithm>
    <Algorithm ID="87da86ab-020d-4dae-80f4-9fd887ccc513" Name="ALG_EMERGENCIA">
      <ST><![CDATA[
acmAbrir       := FALSE;
acmFechar      := FALSE;
acmPosicionar  := FALSE;
acmParar		:= TRUE;

;

]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>