  <BasicFB ID="9f897768-a5cb-408d-9fe7-a0604b1039c9">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="ALG_MANUAL,ALG_AUTO_PID,ALG_AUTO_DIRETO,ALG_SEGURO,ALG_EMERGENCIA" />
    <InternalVars>
      <VarDeclaration Name="prevStpAuto" Type="INT" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="1936.941" y="661.4117" />
      <ECState Name="EXEC_MANUAL" x="2996" y="963.9998">
        <ECAction Algorithm="ALG_MANUAL" Output="CNF" />
      </ECState>
      <ECState Name="EXEC_AUTO_PID" x="2976" y="1764">
        <ECAction Algorithm="ALG_AUTO_PID" Output="CNF" />
      </ECState>
      <ECState Name="EXEC_AUTO_DIRETO" x="2456" y="2564">
        <ECAction Algorithm="ALG_AUTO_DIRETO" Output="CNF" />
      </ECState>
      <ECState Name="EXEC_SEGURO" x="1760" y="2936">
        <ECAction Algorithm="ALG_SEGURO" Output="CNF" />
      </ECState>
      <ECState Name="EMERGENCIA" x="2132" y="240">
        <ECAction Algorithm="ALG_EMERGENCIA" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="EXEC_MANUAL" Condition="REQ AND stsRemoto AND NOT stsAutomatico AND NOT bloqueioManual AND NOT stsEmergencia" x="2450.983" y="732.5157">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="578.027,169.7458,642.6613,186.9905" />
