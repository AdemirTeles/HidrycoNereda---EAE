        <Attribute Name="Configuration.Transaction.BezierPoints" Value="670.7879,379.541,592.2861,296.3802" />
      </ECTransition>
      <ECTransition Source="EXEC_AUTO_DIRETO" Destination="START" Condition="1" x="2116.359" y="1491.173">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="543.1665,438.7553,502.5279,286.5757" />
