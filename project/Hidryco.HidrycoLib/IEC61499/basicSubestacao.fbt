      <VarDeclaration ID="9C7D356999E24140" Name="cmdAbrir1q2" Type="BOOL" Comment="Pulso de abrir o 1Q2 (bobina MX)" />
      <VarDeclaration ID="79D1A92C98189F87" Name="cmdFechar1q2" Type="BOOL" Comment="Pulso de fechar o 1Q2 (bobina XF)" />
      <VarDeclaration ID="1E69EF563D08B70A" Name="almF1q1" Type="BOOL" Comment="ALARM_BIT Disjuntor 1Q1 em falha (desarmado)" />
