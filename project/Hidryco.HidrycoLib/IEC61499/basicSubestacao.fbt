      <VarDeclaration ID="F22ECF93013CE9A0" Name="almC1q0" Type="BOOL" Comment="ALARM_BIT Disjuntor 1Q0 não respondeu ao comando de abrir/fechar" />
      <VarDeclaration ID="BE9CBAB94EB8A2EC" Name="almC1q2" Type="BOOL" Comment="ALARM_BIT Disjuntor 1Q2 não respondeu ao comando de abrir/fechar" />
