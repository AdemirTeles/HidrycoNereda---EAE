      <VarDeclaration ID="38C923E8FBD45478" Name="almD1q0" Type="BOOL" Comment="ALARM_BIT Disjuntor 1Q0: posição indefinida (aberto e fechado discordantes)" />
      <VarDeclaration ID="03139EE3DCF8782D" Name="almD1q2" Type="BOOL" Comment="ALARM_BIT Disjuntor 1Q2: posição indefinida (aberto e fechado discordantes)" />
