  <BasicFB ID="3b06d150-056f-4599-a57c-bc15cc53e082">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="algSubestacao" />
    <InternalVars>
      <VarDeclaration ID="34B92B6144712A5F" Name="initDone" Type="BOOL" />
      <VarDeclaration ID="DAAC96608921FFF7" Name="initPass" Type="BOOL" />
      <VarDeclaration ID="BA4312A45442C1A2" Name="bMudou" Type="BOOL" />
      <VarDeclaration ID="C613F0701A352FD9" Name="u1q1" Type="UDINT" Comment="Segundos com aberto/fechado discordantes" />
      <VarDeclaration ID="DB7699528A34F10A" Name="u1q0" Type="UDINT" Comment="Segundos com aberto/fechado discordantes" />
      <VarDeclaration ID="EAA0E686C5B14B1E" Name="u1q2" Type="UDINT" Comment="Segundos com aberto/fechado discordantes" />
      <VarDeclaration ID="24415C4F778AB82C" Name="e1q1" Type="INT" />
      <VarDeclaration ID="610B81D611202B31" Name="e1q0" Type="INT" />
      <VarDeclaration ID="846A939D7CEF5D6E" Name="e1q2" Type="INT" />
      <VarDeclaration ID="FBED3B1D937503FE" Name="wSts" Type="DWORD" />
      <VarDeclaration ID="37C6DDC1DFEC780D" Name="oldSts" Type="DWORD" InitialValue="16#FFFFFFFF" />
      <VarDeclaration ID="844B0B03596DAE98" Name="wHab" Type="DWORD" />
      <VarDeclaration ID="FBC34A8227AA823B" Name="oldHab" Type="DWORD" InitialValue="16#FFFFFFFF" />
      <VarDeclaration ID="E2CDEE8689A099BC" Name="wHab2" Type="DWORD" />
      <VarDeclaration ID="534D095875E05F11" Name="oldHab2" Type="DWORD" InitialValue="16#FFFFFFFF" />
      <VarDeclaration ID="FC2F614CE59D85B0" Name="wAlm" Type="WORD" />
      <VarDeclaration ID="6A0DF84C3715C69B" Name="oldAlm" Type="WORD" InitialValue="16#FFFF" />
      <VarDeclaration ID="9F99F0C6C86845A2" Name="wPerm" Type="WORD" />
      <VarDeclaration ID="C118AACB4C567D9F" Name="oldPerm" Type="WORD" InitialValue="16#FFFF" />
      <VarDeclaration ID="14AB203F8D7D90E8" Name="wDo" Type="WORD" />
      <VarDeclaration ID="ED9E57174A980BDE" Name="oldDo" Type="WORD" InitialValue="16#FFFF" />
      <VarDeclaration ID="D57F86F30EAFBEBF" Name="o_stsEstado1q1" Type="INT" InitialValue="-1" />
      <VarDeclaration ID="4F0DB2E6320562BA" Name="o_stsEstado1q0" Type="INT" InitialValue="-1" />
      <VarDeclaration ID="207BD40CEC1302DF" Name="o_stsEstado1q2" Type="INT" InitialValue="-1" />
      <VarDeclaration ID="62C55543EED4C3F8" Name="o_stsBarraA" Type="INT" InitialValue="-1" />
      <VarDeclaration ID="8DF19983036C4F89" Name="o_stsBarraB" Type="INT" InitialValue="-1" />
      <VarDeclaration ID="80BE5DB94A950AB8" Name="tA1q1" Type="UINT" Comment="Pulso de abrir restante (s)" />
      <VarDeclaration ID="39C3FF1E94018216" Name="tF1q1" Type="UINT" Comment="Pulso de fechar restante (s)" />
      <VarDeclaration ID="128519094801BF39" Name="uR1q1" Type="UINT" Comment="Tempo restante para a resposta (s)" />
      <VarDeclaration ID="54A87F911E8591F5" Name="tA1q0" Type="UINT" Comment="Pulso de abrir restante (s)" />
      <VarDeclaration ID="BAB98F59BB581B50" Name="tF1q0" Type="UINT" Comment="Pulso de fechar restante (s)" />
      <VarDeclaration ID="CD27A7DE00DD6CF4" Name="uR1q0" Type="UINT" Comment="Tempo restante para a resposta (s)" />
      <VarDeclaration ID="14D3F48CA88F73BE" Name="tA1q2" Type="UINT" Comment="Pulso de abrir restante (s)" />
      <VarDeclaration ID="32711EE78697A569" Name="tF1q2" Type="UINT" Comment="Pulso de fechar restante (s)" />
      <VarDeclaration ID="349435A12B7B2AC3" Name="uR1q2" Type="UINT" Comment="Tempo restante para a resposta (s)" />
      <VarDeclaration ID="377FC957EC07AB24" Name="alvo1q1" Type="INT" Comment="Estado esperado depois do comando (0 nenhum, 1 aberto, 2 fechado)" />
      <VarDeclaration ID="D7F8416CCA0C2C5E" Name="alvo1q0" Type="INT" Comment="Estado esperado depois do comando (0 nenhum, 1 aberto, 2 fechado)" />
      <VarDeclaration ID="0DB9D41E139911C2" Name="alvo1q2" Type="INT" Comment="Estado esperado depois do comando (0 nenhum, 1 aberto, 2 fechado)" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Estado inicial" x="1500" y="640" />
      <ECState Name="EXEC" Comment="Executa a logica; o algoritmo decide quais eventos saem" x="1500" y="1100">
        <ECAction Algorithm="algSubestacao" Output="INITO" />
        <ECAction Output="CNF" />
        <ECAction Output="CNF_HMI" />
        <ECAction Output="CNF_DO" />
        <ECAction Output="CNF_ALM" />
      </ECState>
      <ECTransition Source="START" Destination="EXEC" Condition="INIT OR REQ_MP OR REQ_G OR REQ_PARA OR REQ_RESET OR REQ_RESET_PROC OR REQ_CMD OR TICK" x="1580" y="860" />
      <ECTransition Source="EXEC" Destination="START" Condition="1" x="1420" y="860" />
    </ECC>
    <Algorithm Name="algSubestacao" Comment="Logica completa do QGBT (um unico algoritmo)">
      <ST><![CDATA[(* =====================================================================
   basicSubestacao v1.1 - QGBT 440 V da ETE Tijuco Preto
   QTAM 1 (G2) -> 1Q1 -> barra A; QTAM 2 (G1) -> 1Q2 -> barra B; 1Q0 acopla.
   - Masterpact: 2 fechado, 1 aberto, 3 aberto/fechado discordantes,
     0 indefinido (remota 1 sem comunicacao); aviso de discordancia apos
     cfgTempoDiscordancia s; alarme de falha com "sem falha" = FALSE;
   - fonte de cada barra pelo seu Masterpact ou pelo acoplamento 1Q0;
   - planta nos geradores = alguma QTAM com o disjuntor do gerador fechado
     (vale mesmo com a remota 1 sem comunicacao);
   - cargas liberadas no gerador: escolha do operador (persistente), saidas
     HAB_* para os CATs de processo (geradorHabilita);
   - v1.1: comandos de abrir/fechar dos Masterpact com intertravamentos.
   ===================================================================== *)

INITO   := FALSE;
CNF     := FALSE;
CNF_HMI := FALSE;
CNF_DO  := FALSE;
CNF_ALM := FALSE;
IF INIT THEN
    initDone := TRUE;
    initPass := TRUE;
    INITO    := TRUE;
END_IF;
IF NOT initDone THEN
    RETURN;
END_IF;

(* ---- 1Q1 ---- *)
IF stsFalhaRemota1 THEN
    e1q1 := 0;
ELSIF mpAB_1q1 AND NOT mpFE_1q1 THEN
    e1q1 := 1;
ELSIF mpFE_1q1 AND NOT mpAB_1q1 THEN
    e1q1 := 2;
ELSE
    e1q1 := 3;
END_IF;
IF e1q1 = 3 THEN
    IF TICK AND u1q1 < UINT_TO_UDINT(cfgTempoDiscordancia) THEN
        u1q1 := u1q1 + 1;
    END_IF;
ELSE
    u1q1 := 0;
END_IF;
stsEstado1q1 := e1q1;
stsDiscordancia1q1 := e1q1 = 3 AND u1q1 >= UINT_TO_UDINT(cfgTempoDiscordancia);
stsFalha1q1 := NOT stsFalhaRemota1 AND NOT mpSF_1q1;

(* ---- 1Q0 ---- *)
IF stsFalhaRemota1 THEN
    e1q0 := 0;
ELSIF mpAB_1q0 AND NOT mpFE_1q0 THEN
    e1q0 := 1;
ELSIF mpFE_1q0 AND NOT mpAB_1q0 THEN
    e1q0 := 2;
ELSE
    e1q0 := 3;
END_IF;
IF e1q0 = 3 THEN
    IF TICK AND u1q0 < UINT_TO_UDINT(cfgTempoDiscordancia) THEN
        u1q0 := u1q0 + 1;
    END_IF;
ELSE
    u1q0 := 0;
END_IF;
stsEstado1q0 := e1q0;
stsDiscordancia1q0 := e1q0 = 3 AND u1q0 >= UINT_TO_UDINT(cfgTempoDiscordancia);
stsFalha1q0 := NOT stsFalhaRemota1 AND NOT mpSF_1q0;

(* ---- 1Q2 ---- *)
IF stsFalhaRemota1 THEN
    e1q2 := 0;
ELSIF mpAB_1q2 AND NOT mpFE_1q2 THEN
    e1q2 := 1;
ELSIF mpFE_1q2 AND NOT mpAB_1q2 THEN
    e1q2 := 2;
ELSE
    e1q2 := 3;
END_IF;
IF e1q2 = 3 THEN
    IF TICK AND u1q2 < UINT_TO_UDINT(cfgTempoDiscordancia) THEN
        u1q2 := u1q2 + 1;
    END_IF;
ELSE
    u1q2 := 0;
END_IF;
stsEstado1q2 := e1q2;
stsDiscordancia1q2 := e1q2 = 3 AND u1q2 >= UINT_TO_UDINT(cfgTempoDiscordancia);
stsFalha1q2 := NOT stsFalhaRemota1 AND NOT mpSF_1q2;

(* ---- fonte das barras: 0 sem alimentacao, 1 rede, 2 gerador, 3 indefinida ---- *)
IF e1q1 = 2 THEN
    stsBarraA := g2Fonte;
ELSIF e1q1 = 1 AND e1q0 = 2 AND e1q2 = 2 THEN
    stsBarraA := g1Fonte;
ELSIF e1q1 = 1 AND (e1q0 = 1 OR e1q2 = 1) THEN
    stsBarraA := 0;
ELSE
    stsBarraA := 3;
END_IF;
IF e1q2 = 2 THEN
    stsBarraB := g1Fonte;
ELSIF e1q2 = 1 AND e1q0 = 2 AND e1q1 = 2 THEN
    stsBarraB := g2Fonte;
ELSIF e1q2 = 1 AND (e1q0 = 1 OR e1q1 = 1) THEN
    stsBarraB := 0;
ELSE
    stsBarraB := 3;
END_IF;
stsPlantaNoGerador := g1Fonte = 2 OR g2Fonte = 2;

(* ---- cargas liberadas no gerador (escolha do operador) ---- *)
HAB_V4601 := habV4601;
HAB_V4602 := habV4602;
HAB_V4603 := habV4603;
HAB_V4604 := habV4604;
HAB_EX_500_01 := habEX_500_01;
HAB_EX_500_02 := habEX_500_02;
HAB_EX_500_03 := habEX_500_03;
HAB_EX_500_04 := habEX_500_04;
HAB_EX_500_05 := habEX_500_05;
HAB_COMP_500_01 := habCOMP_500_01;
HAB_COMP_500_02 := habCOMP_500_02;
HAB_UCT_200_01 := habUCT_200_01;
HAB_UCT_200_02 := habUCT_200_02;
HAB_UCT_200_03 := habUCT_200_03;
HAB_BS_100_01 := habBS_100_01;
HAB_BS_100_02 := habBS_100_02;
HAB_BS_100_03 := habBS_100_03;
HAB_GM_100_01 := habGM_100_01;
HAB_UV_700_01 := habUV_700_01;
HAB_UV_700_02 := habUV_700_02;
HAB_DO_800_04 := habDO_800_04;
HAB_DO_800_05 := habDO_800_05;
HAB_P4901 := habP4901;
HAB_P4902 := habP4902;
HAB_P4903 := habP4903;
HAB_R4005A := habR4005A;
HAB_R4005B := habR4005B;
HAB_MO_300_01 := habMO_300_01;
HAB_QL_PORTARIA := habQL_PORTARIA;
HAB_QL_ADM := habQL_ADM;
HAB_QL_LODO := habQL_LODO;
HAB_QLSL := habQLSL;
HAB_QL_ILUMINACAO := habQL_ILUMINACAO;

(* ---- comandos dos Masterpact (IHM) ----
   abrir: remota OK, fechado, em remoto (nao local);
   fechar: remota OK, aberto, remoto, pronto para fechar, mola carregada, sem falha
           e sem fechar o anel: 1Q1 e 1Q2 so com o 1Q0 ou o outro aberto;
           1Q0 so com o 1Q1 ou o 1Q2 aberto (nunca as duas QTAM em paralelo);
   pulso de cfgTempoPulsoDisjuntor s (acaba antes se o disjuntor mudar);
   sem mudanca em cfgTempoRespostaDisjuntor s: aviso de sem resposta. *)
stsPermAbrir1q1 := NOT stsFalhaRemota1 AND e1q1 = 2 AND mpR_1q1 AND NOT mpL_1q1;
stsPermFechar1q1 := NOT stsFalhaRemota1 AND e1q1 = 1 AND mpR_1q1 AND NOT mpL_1q1 AND mpP_1q1 AND mpC_1q1 AND mpSF_1q1 AND (e1q0 = 1 OR e1q2 = 1);
stsPermAbrir1q0 := NOT stsFalhaRemota1 AND e1q0 = 2 AND mpR_1q0 AND NOT mpL_1q0;
stsPermFechar1q0 := NOT stsFalhaRemota1 AND e1q0 = 1 AND mpR_1q0 AND NOT mpL_1q0 AND mpP_1q0 AND mpC_1q0 AND mpSF_1q0 AND (e1q1 = 1 OR e1q2 = 1);
stsPermAbrir1q2 := NOT stsFalhaRemota1 AND e1q2 = 2 AND mpR_1q2 AND NOT mpL_1q2;
stsPermFechar1q2 := NOT stsFalhaRemota1 AND e1q2 = 1 AND mpR_1q2 AND NOT mpL_1q2 AND mpP_1q2 AND mpC_1q2 AND mpSF_1q2 AND (e1q0 = 1 OR e1q1 = 1);
IF REQ_CMD THEN
    IF hmiCmdDisjuntor = 1 AND stsPermAbrir1q1 THEN
        tF1q1 := 0;
        tA1q1 := cfgTempoPulsoDisjuntor + 1;
        alvo1q1 := 1;
        uR1q1 := cfgTempoRespostaDisjuntor;
        stsFalhaComando1q1 := FALSE;
    ELSIF hmiCmdDisjuntor = 2 AND stsPermFechar1q1 THEN
        tA1q1 := 0;
        tF1q1 := cfgTempoPulsoDisjuntor + 1;
        alvo1q1 := 2;
        uR1q1 := cfgTempoRespostaDisjuntor;
        stsFalhaComando1q1 := FALSE;
    ELSIF hmiCmdDisjuntor = 3 AND stsPermAbrir1q0 THEN
        tF1q0 := 0;
        tA1q0 := cfgTempoPulsoDisjuntor + 1;
        alvo1q0 := 1;
        uR1q0 := cfgTempoRespostaDisjuntor;
        stsFalhaComando1q0 := FALSE;
    ELSIF hmiCmdDisjuntor = 4 AND stsPermFechar1q0 THEN
        tA1q0 := 0;
        tF1q0 := cfgTempoPulsoDisjuntor + 1;
        alvo1q0 := 2;
        uR1q0 := cfgTempoRespostaDisjuntor;
        stsFalhaComando1q0 := FALSE;
    ELSIF hmiCmdDisjuntor = 5 AND stsPermAbrir1q2 THEN
        tF1q2 := 0;
        tA1q2 := cfgTempoPulsoDisjuntor + 1;
        alvo1q2 := 1;
        uR1q2 := cfgTempoRespostaDisjuntor;
        stsFalhaComando1q2 := FALSE;
    ELSIF hmiCmdDisjuntor = 6 AND stsPermFechar1q2 THEN
        tA1q2 := 0;
        tF1q2 := cfgTempoPulsoDisjuntor + 1;
        alvo1q2 := 2;
        uR1q2 := cfgTempoRespostaDisjuntor;
        stsFalhaComando1q2 := FALSE;
    END_IF;
END_IF;
IF (REQ_RESET AND hmiReset) OR (REQ_RESET_PROC AND cmdResetFalhas) THEN
    stsFalhaComando1q1 := FALSE;
    stsFalhaComando1q0 := FALSE;
    stsFalhaComando1q2 := FALSE;
END_IF;
IF alvo1q1 > 0 AND e1q1 = alvo1q1 THEN
    tA1q1 := 0;
    tF1q1 := 0;
    alvo1q1 := 0;
    uR1q1 := 0;
END_IF;
IF TICK THEN
    IF tA1q1 > 0 THEN tA1q1 := tA1q1 - 1; END_IF;
    IF tF1q1 > 0 THEN tF1q1 := tF1q1 - 1; END_IF;
    IF alvo1q1 > 0 THEN
        IF uR1q1 > 0 THEN uR1q1 := uR1q1 - 1; END_IF;
        IF uR1q1 = 0 THEN
            stsFalhaComando1q1 := TRUE;
            alvo1q1 := 0;
            tA1q1 := 0;
            tF1q1 := 0;
        END_IF;
    END_IF;
END_IF;
IF stsFalhaRemota1 THEN
    tA1q1 := 0;
    tF1q1 := 0;
END_IF;
cmdAbrir1q1 := tA1q1 > 0;
cmdFechar1q1 := tF1q1 > 0;
IF alvo1q0 > 0 AND e1q0 = alvo1q0 THEN
    tA1q0 := 0;
    tF1q0 := 0;
    alvo1q0 := 0;
    uR1q0 := 0;
END_IF;
IF TICK THEN
    IF tA1q0 > 0 THEN tA1q0 := tA1q0 - 1; END_IF;
    IF tF1q0 > 0 THEN tF1q0 := tF1q0 - 1; END_IF;
    IF alvo1q0 > 0 THEN
        IF uR1q0 > 0 THEN uR1q0 := uR1q0 - 1; END_IF;
        IF uR1q0 = 0 THEN
            stsFalhaComando1q0 := TRUE;
            alvo1q0 := 0;
            tA1q0 := 0;
            tF1q0 := 0;
        END_IF;
    END_IF;
END_IF;
IF stsFalhaRemota1 THEN
    tA1q0 := 0;
    tF1q0 := 0;
END_IF;
cmdAbrir1q0 := tA1q0 > 0;
cmdFechar1q0 := tF1q0 > 0;
IF alvo1q2 > 0 AND e1q2 = alvo1q2 THEN
    tA1q2 := 0;
    tF1q2 := 0;
    alvo1q2 := 0;
    uR1q2 := 0;
END_IF;
IF TICK THEN
    IF tA1q2 > 0 THEN tA1q2 := tA1q2 - 1; END_IF;
    IF tF1q2 > 0 THEN tF1q2 := tF1q2 - 1; END_IF;
    IF alvo1q2 > 0 THEN
        IF uR1q2 > 0 THEN uR1q2 := uR1q2 - 1; END_IF;
        IF uR1q2 = 0 THEN
            stsFalhaComando1q2 := TRUE;
            alvo1q2 := 0;
            tA1q2 := 0;
            tF1q2 := 0;
        END_IF;
    END_IF;
END_IF;
IF stsFalhaRemota1 THEN
    tA1q2 := 0;
    tF1q2 := 0;
END_IF;
cmdAbrir1q2 := tA1q2 > 0;
cmdFechar1q2 := tF1q2 > 0;

(* ---- alarmes ---- *)
almF1q1 := stsFalha1q1;
almF1q0 := stsFalha1q0;
almF1q2 := stsFalha1q2;
almD1q1 := stsDiscordancia1q1;
almD1q0 := stsDiscordancia1q0;
almD1q2 := stsDiscordancia1q2;
almC1q1 := stsFalhaComando1q1;
almC1q0 := stsFalhaComando1q0;
almC1q2 := stsFalhaComando1q2;
stsAlarme := almF1q1 OR almF1q0 OR almF1q2 OR almD1q1 OR almD1q0 OR almD1q2 OR almC1q1 OR almC1q0 OR almC1q2;

(* ---- eventos so na mudanca ---- *)
bMudou := FALSE;
IF stsEstado1q1 <> o_stsEstado1q1 THEN bMudou := TRUE; o_stsEstado1q1 := stsEstado1q1; END_IF;
IF stsEstado1q0 <> o_stsEstado1q0 THEN bMudou := TRUE; o_stsEstado1q0 := stsEstado1q0; END_IF;
IF stsEstado1q2 <> o_stsEstado1q2 THEN bMudou := TRUE; o_stsEstado1q2 := stsEstado1q2; END_IF;
IF stsBarraA <> o_stsBarraA THEN bMudou := TRUE; o_stsBarraA := stsBarraA; END_IF;
IF stsBarraB <> o_stsBarraB THEN bMudou := TRUE; o_stsBarraB := stsBarraB; END_IF;
wSts := 0;
IF stsPlantaNoGerador THEN wSts := wSts OR 16#00000001; END_IF;
IF stsFalha1q1 THEN wSts := wSts OR 16#00000002; END_IF;
IF stsFalha1q0 THEN wSts := wSts OR 16#00000004; END_IF;
IF stsFalha1q2 THEN wSts := wSts OR 16#00000008; END_IF;
IF stsDiscordancia1q1 THEN wSts := wSts OR 16#00000010; END_IF;
IF stsDiscordancia1q0 THEN wSts := wSts OR 16#00000020; END_IF;
IF stsDiscordancia1q2 THEN wSts := wSts OR 16#00000040; END_IF;
IF stsFalhaComando1q1 THEN wSts := wSts OR 16#00000080; END_IF;
IF stsFalhaComando1q0 THEN wSts := wSts OR 16#00000100; END_IF;
IF stsFalhaComando1q2 THEN wSts := wSts OR 16#00000200; END_IF;
IF stsAlarme THEN wSts := wSts OR 16#00000400; END_IF;
wHab := 0;
wHab2 := 0;
IF HAB_V4601 THEN wHab := wHab OR 16#00000001; END_IF;
IF HAB_V4602 THEN wHab := wHab OR 16#00000002; END_IF;
IF HAB_V4603 THEN wHab := wHab OR 16#00000004; END_IF;
IF HAB_V4604 THEN wHab := wHab OR 16#00000008; END_IF;
IF HAB_EX_500_01 THEN wHab := wHab OR 16#00000010; END_IF;
IF HAB_EX_500_02 THEN wHab := wHab OR 16#00000020; END_IF;
IF HAB_EX_500_03 THEN wHab := wHab OR 16#00000040; END_IF;
IF HAB_EX_500_04 THEN wHab := wHab OR 16#00000080; END_IF;
IF HAB_EX_500_05 THEN wHab := wHab OR 16#00000100; END_IF;
IF HAB_COMP_500_01 THEN wHab := wHab OR 16#00000200; END_IF;
IF HAB_COMP_500_02 THEN wHab := wHab OR 16#00000400; END_IF;
IF HAB_UCT_200_01 THEN wHab := wHab OR 16#00000800; END_IF;
IF HAB_UCT_200_02 THEN wHab := wHab OR 16#00001000; END_IF;
IF HAB_UCT_200_03 THEN wHab := wHab OR 16#00002000; END_IF;
IF HAB_BS_100_01 THEN wHab := wHab OR 16#00004000; END_IF;
IF HAB_BS_100_02 THEN wHab := wHab OR 16#00008000; END_IF;
IF HAB_BS_100_03 THEN wHab := wHab OR 16#00010000; END_IF;
IF HAB_GM_100_01 THEN wHab := wHab OR 16#00020000; END_IF;
IF HAB_UV_700_01 THEN wHab := wHab OR 16#00040000; END_IF;
IF HAB_UV_700_02 THEN wHab := wHab OR 16#00080000; END_IF;
IF HAB_DO_800_04 THEN wHab := wHab OR 16#00100000; END_IF;
IF HAB_DO_800_05 THEN wHab := wHab OR 16#00200000; END_IF;
IF HAB_P4901 THEN wHab := wHab OR 16#00400000; END_IF;
IF HAB_P4902 THEN wHab := wHab OR 16#00800000; END_IF;
IF HAB_P4903 THEN wHab := wHab OR 16#01000000; END_IF;
IF HAB_R4005A THEN wHab := wHab OR 16#02000000; END_IF;
IF HAB_R4005B THEN wHab := wHab OR 16#04000000; END_IF;
IF HAB_MO_300_01 THEN wHab := wHab OR 16#08000000; END_IF;
IF HAB_QL_PORTARIA THEN wHab := wHab OR 16#10000000; END_IF;
IF HAB_QL_ADM THEN wHab := wHab OR 16#20000000; END_IF;
IF HAB_QL_LODO THEN wHab := wHab OR 16#40000000; END_IF;
IF HAB_QLSL THEN wHab := wHab OR 16#80000000; END_IF;
IF HAB_QL_ILUMINACAO THEN wHab2 := wHab2 OR 16#00000001; END_IF;
wAlm := 0;
IF almF1q1 THEN wAlm := wAlm OR 16#0001; END_IF;
IF almF1q0 THEN wAlm := wAlm OR 16#0002; END_IF;
IF almF1q2 THEN wAlm := wAlm OR 16#0004; END_IF;
IF almD1q1 THEN wAlm := wAlm OR 16#0008; END_IF;
IF almD1q0 THEN wAlm := wAlm OR 16#0010; END_IF;
IF almD1q2 THEN wAlm := wAlm OR 16#0020; END_IF;
IF almC1q1 THEN wAlm := wAlm OR 16#0040; END_IF;
IF almC1q0 THEN wAlm := wAlm OR 16#0080; END_IF;
IF almC1q2 THEN wAlm := wAlm OR 16#0100; END_IF;
wPerm := 0;
IF stsPermAbrir1q1 THEN wPerm := wPerm OR 16#0001; END_IF;
IF stsPermFechar1q1 THEN wPerm := wPerm OR 16#0002; END_IF;
IF stsPermAbrir1q0 THEN wPerm := wPerm OR 16#0004; END_IF;
IF stsPermFechar1q0 THEN wPerm := wPerm OR 16#0008; END_IF;
IF stsPermAbrir1q2 THEN wPerm := wPerm OR 16#0010; END_IF;
IF stsPermFechar1q2 THEN wPerm := wPerm OR 16#0020; END_IF;
wDo := 0;
IF cmdAbrir1q1 THEN wDo := wDo OR 16#0001; END_IF;
IF cmdFechar1q1 THEN wDo := wDo OR 16#0002; END_IF;
IF cmdAbrir1q0 THEN wDo := wDo OR 16#0004; END_IF;
IF cmdFechar1q0 THEN wDo := wDo OR 16#0008; END_IF;
IF cmdAbrir1q2 THEN wDo := wDo OR 16#0010; END_IF;
IF cmdFechar1q2 THEN wDo := wDo OR 16#0020; END_IF;
CNF := initPass OR bMudou OR (wSts <> oldSts) OR (wHab <> oldHab) OR (wHab2 <> oldHab2);
CNF_DO := initPass OR (wDo <> oldDo);
CNF_HMI := CNF OR (wPerm <> oldPerm) OR CNF_DO;
CNF_ALM := initPass OR (wAlm <> oldAlm);
oldPerm := wPerm;
oldDo := wDo;
oldSts := wSts;
oldHab := wHab;
oldHab2 := wHab2;
oldAlm := wAlm;
initPass := FALSE;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>