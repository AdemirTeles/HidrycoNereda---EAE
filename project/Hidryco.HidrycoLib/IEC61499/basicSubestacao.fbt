      <VarDeclaration ID="BE7FE6C40B23C154" Name="HAB_EX_500_05" Type="BOOL" Comment="500-EX-05 - Exaustor 05 liberado para operar com a planta nos geradores" />
      <VarDeclaration ID="CDE9A5680E80C4FC" Name="HAB_COMP_500_01" Type="BOOL" Comment="500-COMP-01 - Compressor 01 liberado para operar com a planta nos geradores" />
      <VarDeclaration ID="C423B287230633AC" Name="HAB_COMP_500_02" Type="BOOL" Comment="500-COMP-02 - Compressor 02 liberado para operar com a planta nos geradores" />
      <VarDeclaration ID="65AF809565D49EE4" Name="HAB_UCT_200_01" Type="BOOL" Comment="200-UCT-01 - Unid. compacta 01 liberado para operar com a planta nos geradores" />
      <VarDeclaration ID="FE43C0E5F49578C6" Name="HAB_UCT_200_02" Type="BOOL" Comment="200-UCT-02 - Unid. compacta 02 liberado para operar com a planta nos geradores" />
      <VarDeclaration ID="DFDF62B8B007BA30" Name="HAB_UCT_200_03" Type="BOOL" Comment="200-UCT-03 - Unid. compacta 03 liberado para operar com a planta nos geradores" />
      <VarDeclaration ID="A9DA853C672ACC03" Name="HAB_BS_100_01" Type="BOOL" Comment="100-BS-01 - Bomba 01 liberado para operar com a planta nos geradores" />
      <VarDeclaration ID="414CB46415187F9B" Name="HAB_BS_100_02" Type="BOOL" Comment="100-BS-02 - Bomba 02 liberado para operar com a planta nos geradores" />
