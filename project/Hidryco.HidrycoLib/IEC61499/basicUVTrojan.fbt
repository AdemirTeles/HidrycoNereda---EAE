<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="97fed741-0b90-2821-f6ea-67ee856850fa" Name="basicUVTrojan" Comment="Logica do sistema UV Trojan UV3000Plus (monitoracao Modbus TCP)" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="19/10/2026" Remarks="1.0: leitura 41001-41008, canais 1 e 2 (41021-41037, 41061-41077), limpeza 41181-41191; heartbeat 40006 b1 e vigia do heartbeat do SCC" />
