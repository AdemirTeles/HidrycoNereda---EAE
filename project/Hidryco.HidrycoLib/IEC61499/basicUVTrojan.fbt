  <BasicFB ID="78b8cb82-30d7-784b-6e47-dda1bdebe44a">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="algUV" />
    <InternalVars>
      <VarDeclaration ID="6CE6EF29D3D0DB59" Name="initDone" Type="BOOL" />
      <VarDeclaration ID="237B07FD12748F9B" Name="comRecebido" Type="BOOL" />
      <VarDeclaration ID="7F05470CCF549003" Name="fb1Recebido" Type="BOOL" />
      <VarDeclaration ID="EF99CFDD587CE5D6" Name="bComOk" Type="BOOL" />
      <VarDeclaration ID="1143599C2805613D" Name="bHb" Type="BOOL" Comment="Heartbeat enviado" />
      <VarDeclaration ID="E5062C2F5F5AAF59" Name="tHb" Type="INT" />
      <VarDeclaration ID="D01C15FF8C55437D" Name="tHbScc" Type="INT" Comment="Segundos sem alternar o heartbeat do SCC" />
      <VarDeclaration ID="43AAC08DF0152F18" Name="bHbScc" Type="BOOL" />
      <VarDeclaration ID="88D39E972AB07501" Name="oldHbScc" Type="BOOL" />
      <VarDeclaration ID="78720468FC45F103" Name="lim" Type="INT" />
      <VarDeclaration ID="1D7AF093F859A287" Name="rFator" Type="REAL" />
      <VarDeclaration ID="163A10692EF20B20" Name="w" Type="WORD" Comment="Palavra em decodificacao" />
      <VarDeclaration ID="3AC9F8532117EC5A" Name="oldHb" Type="INT" InitialValue="-1" />
      <VarDeclaration ID="EF605F9CEFF500FE" Name="primeiro" Type="BOOL" InitialValue="TRUE" />
      <VarDeclaration ID="E373D8A5AF458E1F" Name="oldAlm" Type="INT" InitialValue="-1" Comment="Assinatura dos alarmes para disparo imediato" />
      <VarDeclaration ID="EDF9CFB874A86B84" Name="sig" Type="INT" />
      <VarDeclaration ID="89AD2F17F0E38FED" Name="oldProc" Type="INT" InitialValue="-1" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Estado inicial" x="1500" y="640" />
      <ECState Name="EXEC" Comment="Executa a logica; o algoritmo decide quais eventos saem" x="1500" y="1100">
        <ECAction Algorithm="algUV" Output="INITO" />
        <ECAction Output="CNF_OUT" />
        <ECAction Output="CNF" />
        <ECAction Output="CNF_HMI" />
      </ECState>
      <ECTransition Source="START" Destination="EXEC" Condition="INIT OR REQ_FB1 OR REQ_FB2 OR REQ_FB3 OR REQ_COM OR REQ_RESET OR TICK" x="1580" y="860" />
      <ECTransition Source="EXEC" Destination="START" Condition="1" x="1420" y="860" />
    </ECC>
    <Algorithm Name="algUV" Comment="Logica completa do UV (um unico algoritmo)">
      <ST><![CDATA[(* =====================================================================
   basicUVTrojan v1.0 - logica do CAT UV_Trojan (HidrycoLib)
   Trojan UV3000Plus, SCC Modicon M580 como servidor Modbus TCP (CP141200010).
   A interface do SCC e somente leitura: o CLP nao liga, nao seleciona canal e
   nao comanda limpeza; so escreve o heartbeat (40006 bit 1, 2 s/2 s). Sem ele
   o SCC acusa SCADA Communication Fault (41004.4).
   Comunicacao OK = conexao Modbus online E heartbeat do SCC (41001.8)
   alternando dentro de cfgTimeoutHeartbeat.
   ===================================================================== *)

INITO   := FALSE;
CNF_OUT := FALSE;
CNF     := FALSE;
CNF_HMI := FALSE;

IF REQ_COM THEN
    comRecebido := TRUE;
END_IF;
IF REQ_FB1 THEN
    fb1Recebido := TRUE;
END_IF;
IF INIT THEN
    initDone := TRUE;
    INITO    := TRUE;
END_IF;
IF NOT initDone THEN
    RETURN;
END_IF;

(* ---- 1. Heartbeat para o SCC e vigia do heartbeat do SCC ---- *)
IF TICK THEN
    tHb := tHb + 1;
    IF tHb >= 2 THEN
        tHb := 0;
        bHb := NOT bHb;
    END_IF;
    IF tHbScc < 32000 THEN
        tHbScc := tHbScc + 1;
    END_IF;
END_IF;
IF bHb THEN
    acmHeartbeat := 2;
ELSE
    acmHeartbeat := 0;
END_IF;
IF (acmHeartbeat <> oldHb) OR primeiro THEN
    CNF_OUT := TRUE;
    oldHb := acmHeartbeat;
END_IF;
w := INT_TO_WORD(fldS1001);
bHbScc := (w AND 16#0100) <> 16#0000;
IF REQ_FB1 AND (bHbScc <> oldHbScc) THEN
    tHbScc := 0;
    oldHbScc := bHbScc;
END_IF;
IF cfgTimeoutHeartbeat > 0 THEN
    lim := cfgTimeoutHeartbeat;
ELSE
    lim := 10;
END_IF;
bComOk := comRecebido AND fb1Recebido AND (fldConexao = 1);
stsHeartbeatOK := bComOk AND (tHbScc < lim);
stsComunicacaoOK := stsHeartbeatOK;
stsFalhaComunicacao := NOT stsComunicacaoOK;

(* ---- 2. Decodificacao (so com comunicacao OK) ---- *)
IF stsComunicacaoOK THEN
    stsAlarmeMenor   := (w AND 16#0001) <> 16#0000;
    stsAlarmeMaior   := (w AND 16#0002) <> 16#0000;
    stsAlarmeCritico := (w AND 16#0004) <> 16#0000;
    stsAlarmeLimpeza := (w AND 16#0008) <> 16#0000;
    stsUviMw         := (w AND 16#0080) <> 16#0000;
    w := INT_TO_WORD(fldS1003);
    stsDoseBaixa := (w AND 16#0001) <> 16#0000;
    stsCanaisInsuficientes := (w AND 16#0002) <> 16#0000;
    w := INT_TO_WORD(fldS1004);
    stsScadaComFalha := (w AND 16#0010) <> 16#0000;
    stsSysW1003 := fldS1003;
    stsSysW1004 := fldS1004;
    CASE fldS1008 OF
        1: rFator := 100.0;
        2: rFator := 10.0;
        4: rFator := 0.1;
        5: rFator := 0.01;
    ELSE
        rFator := 1.0;
    END_CASE;
    stsVazao := INT_TO_REAL(fldS1005) * rFator;
    stsDose  := INT_TO_REAL(fldS1006) / 100.0;
    stsUVT   := INT_TO_REAL(fldS1007) / 10.0;
    (* canal 1 / banco 1A *)
    w := INT_TO_WORD(fldC1W21);
    IF (w AND 16#0004) <> 16#0000 THEN stsCh1Alarme := 3;
    ELSIF (w AND 16#0002) <> 16#0000 THEN stsCh1Alarme := 2;
    ELSIF (w AND 16#0001) <> 16#0000 THEN stsCh1Alarme := 1;
    ELSE stsCh1Alarme := 0;
    END_IF;
    stsCanal1Operando := (w AND 16#0010) <> 16#0000;
    stsCh1NivelBaixo  := (w AND 16#0020) <> 16#0000;
    stsCh1Offline     := (w AND 16#0200) <> 16#0000;
    w := INT_TO_WORD(fldC1W22);
    stsCh1BancosInsuf    := (w AND 16#0002) <> 16#0000;
    stsCh1LimiteLimpeza  := (w AND 16#0020) <> 16#0000;
    stsCh1Manutencao     := (w AND 16#8000) <> 16#0000;
    w := INT_TO_WORD(fldC1W34);
    stsCh1NaoRemoto := (w AND 16#0002) <> 16#0000;
    stsCh1W33 := fldC1W33;
    stsCh1W34 := fldC1W34;
    IF fldC1W35 < 0 THEN stsCh1Horas := INT_TO_DINT(fldC1W35) + 65536; ELSE stsCh1Horas := INT_TO_DINT(fldC1W35); END_IF;
    stsCh1Potencia := fldC1W36;
    stsCh1Intensidade := INT_TO_REAL(fldC1W37) / 10.0;
    (* canal 2 / banco 2A *)
    w := INT_TO_WORD(fldC2W61);
    IF (w AND 16#0004) <> 16#0000 THEN stsCh2Alarme := 3;
    ELSIF (w AND 16#0002) <> 16#0000 THEN stsCh2Alarme := 2;
    ELSIF (w AND 16#0001) <> 16#0000 THEN stsCh2Alarme := 1;
    ELSE stsCh2Alarme := 0;
    END_IF;
    stsCanal2Operando := (w AND 16#0010) <> 16#0000;
    stsCh2NivelBaixo  := (w AND 16#0020) <> 16#0000;
    stsCh2Offline     := (w AND 16#0200) <> 16#0000;
    w := INT_TO_WORD(fldC2W62);
    stsCh2BancosInsuf    := (w AND 16#0002) <> 16#0000;
    stsCh2LimiteLimpeza  := (w AND 16#0020) <> 16#0000;
    stsCh2Manutencao     := (w AND 16#8000) <> 16#0000;
    w := INT_TO_WORD(fldC2W74);
    stsCh2NaoRemoto := (w AND 16#0002) <> 16#0000;
    stsCh2W33 := fldC2W73;
    stsCh2W34 := fldC2W74;
    IF fldC2W75 < 0 THEN stsCh2Horas := INT_TO_DINT(fldC2W75) + 65536; ELSE stsCh2Horas := INT_TO_DINT(fldC2W75); END_IF;
    stsCh2Potencia := fldC2W76;
    stsCh2Intensidade := INT_TO_REAL(fldC2W77) / 10.0;
    (* limpeza (HSC1) *)
    w := INT_TO_WORD(fldH1181);
    stsLimpezaEmCiclo := (w AND 16#0004) <> 16#0000;
    stsLimpW1183 := fldH1183;
    stsLimpW1185 := fldH1185;
    stsLimpW1186 := fldH1186;
    stsLimpW1189 := fldH1189;
    stsLimpW1190 := fldH1190;
    stsLimpCiclos1 := fldH1187;
    stsLimpCiclos2 := fldH1191;
ELSE
    stsAlarmeMenor := FALSE; stsAlarmeMaior := FALSE; stsAlarmeCritico := FALSE; stsAlarmeLimpeza := FALSE;
    stsDoseBaixa := FALSE; stsCanaisInsuficientes := FALSE; stsScadaComFalha := FALSE;
    stsCh1Alarme := 0; stsCanal1Operando := FALSE; stsCh1NivelBaixo := FALSE; stsCh1Offline := FALSE;
    stsCh1BancosInsuf := FALSE; stsCh1Manutencao := FALSE; stsCh1LimiteLimpeza := FALSE; stsCh1NaoRemoto := FALSE;
    stsCh2Alarme := 0; stsCanal2Operando := FALSE; stsCh2NivelBaixo := FALSE; stsCh2Offline := FALSE;
    stsCh2BancosInsuf := FALSE; stsCh2Manutencao := FALSE; stsCh2LimiteLimpeza := FALSE; stsCh2NaoRemoto := FALSE;
    stsLimpezaEmCiclo := FALSE;
END_IF;

(* ---- 3. Eventos: alarmes e estados na hora; valores a cada 1 s ---- *)
sig := 0;
IF stsFalhaComunicacao THEN sig := sig + 1; END_IF;
IF stsAlarmeMenor THEN sig := sig + 2; END_IF;
IF stsAlarmeMaior THEN sig := sig + 4; END_IF;
IF stsAlarmeCritico THEN sig := sig + 8; END_IF;
IF stsAlarmeLimpeza THEN sig := sig + 16; END_IF;
IF stsCanal1Operando THEN sig := sig + 32; END_IF;
IF stsCanal2Operando THEN sig := sig + 64; END_IF;
IF stsCanaisInsuficientes THEN sig := sig + 128; END_IF;
IF stsDoseBaixa THEN sig := sig + 256; END_IF;
IF primeiro OR TICK OR REQ_RESET OR (sig <> oldAlm) THEN
    CNF_HMI := TRUE;
END_IF;
IF primeiro OR TICK OR (sig <> oldAlm) THEN
    CNF := TRUE;
END_IF;
oldAlm := sig;
primeiro := FALSE;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
