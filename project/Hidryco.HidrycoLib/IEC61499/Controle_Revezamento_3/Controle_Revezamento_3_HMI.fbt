<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="54c747f5-303f-d992-c917-3049d2e5f08d" Name="Controle_Revezamento_3_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="21/10/2026" Remarks="IHM do Controle_Revezamento_3" />
  <InterfaceList>
    <EventInputs>
      <Event ID="0192C87DB3A96998" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="32A5FD2F512EDDDA" Name="LOAD_PERS_DATA" Comment="Reenvia os parametros persistentes" />
      <Event ID="295C900D593A2314" Name="E_ATUALIZA_TEMPO_RESTANTE" Comment="Status do processo">
        <With Var="STS_RESTANTE_HOR" />
        <With Var="STS_RESTANTE_MIN" />
        <With Var="STS_RESTANTE_SEG" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="D1BA3C1795D37130" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="CB0061E02EEB91D1" Name="E_ATUALIZA_SETPOINT" Comment="Ajustes (IHM/OPC UA e LOAD_PERS_DATA)">
        <With Var="CMD_HABILITA" />
        <With Var="STP_TEMPO_B1" />
        <With Var="STP_TEMPO_B2" />
        <With Var="STP_TEMPO_B3" />
      </Event>
      <Event ID="E72592C0EA16EC9C" Name="E_CMD_SELECAO_BOMBA" Comment="Ajustes (IHM/OPC UA e LOAD_PERS_DATA)">
        <With Var="CMD_SELECAO_BOMBA" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="06C0C86C8D26D91E" Name="QI" Type="BOOL" />
      <VarDeclaration ID="157CF7A7DDB1868C" Name="STS_RESTANTE_HOR" Type="UINT" Comment="Tempo para a troca da principal (h)" />
      <VarDeclaration ID="3954E3DE2B1C77C4" Name="STS_RESTANTE_MIN" Type="UINT" Comment="Tempo para a troca da principal (min)" />
      <VarDeclaration ID="1F1CE5670F7852A1" Name="STS_RESTANTE_SEG" Type="UINT" Comment="Tempo para a troca da principal (s)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="6B567AE853D35D55" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="C61D6C6D6FFD4E2D" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="EBE3E78A518B8EC3" Name="CMD_HABILITA" Type="BOOL" Comment="Troca da principal por tempo" />
      <VarDeclaration ID="C87519674C1F0FBB" Name="STP_TEMPO_B1" Type="UINT" Comment="Horas do equipamento 1 como principal" />
      <VarDeclaration ID="B92A8868EF63F063" Name="STP_TEMPO_B2" Type="UINT" Comment="Horas do equipamento 2 como principal" />
      <VarDeclaration ID="977D6B81BA3FF67A" Name="STP_TEMPO_B3" Type="UINT" Comment="Horas do equipamento 3 como principal" />
      <VarDeclaration ID="CBB015BC232625A2" Name="CMD_SELECAO_BOMBA" Type="INT" Comment="Bomba principal" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>
