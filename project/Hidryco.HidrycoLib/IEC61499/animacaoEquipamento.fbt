<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="82cd825d-585c-4861-9b85-cc8839f0b732" Name="animacaoEquipamento" Comment="Basic Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="14/01/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Comment="Normal Execution Request">
        <With Var="stsFalhaGeral" />
        <With Var="stsManutencao" />
        <With Var="stsLigado" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="stsAnimacao" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="stsLigado" Type="BOOL" Comment="Input event qualifier" />
      <VarDeclaration Name="stsFalhaGeral" Type="BOOL" />
      <VarDeclaration Name="stsManutencao" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="stsAnimacao" Type="INT" Comment="Output event qualifier" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="fdd00a67-06df-4d94-a3ea-e3069e7c9528">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="algREQ" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="1376.941" y="525.4117" />
      <ECState Name="REQ" x="1404" y="820">
        <ECAction Algorithm="algREQ" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="REQ" Condition="REQ" x="1476.561" y="665.8458">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="371.7848,157.9638,373.2408,173.8158" />
      </ECTransition>
      <ECTransition Source="REQ" Destination="START" Condition="1" x="1389.434" y="747.7058">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="348.3456,201.1024,346.8896,185.2505" />
      </ECTransition>
    </ECC>
    <Algorithm ID="ca055371-be10-4ba4-93df-a0e5006604a5" Name="algREQ">
      <ST><![CDATA[IF stsManutencao THEN
    stsAnimacao := 3;
ELSIF stsFalhaGeral THEN
    stsAnimacao := 2;
ELSIF stsLigado THEN
    stsAnimacao := 1;
ELSE
    stsAnimacao := 0;
END_IF;
;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>