<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="82cd825d-585c-4861-9b85-cc8839f0b732" Name="animacaoEquipamento" Comment="Basic Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="14/01/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
