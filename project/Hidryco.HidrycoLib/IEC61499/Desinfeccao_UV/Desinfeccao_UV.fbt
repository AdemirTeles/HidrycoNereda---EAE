<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="a6411642-91f1-d62c-d6bc-747391f33726" Name="Desinfeccao_UV" Comment="Desinfeccao UV e limitacao da vazao de lancamento (700) - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="19/10/2026" Remarks="1.0: desinfeccao (700). Sub-CATs: VC_700_01 (Valvula_Coester modulante), UV (UV_Trojan), FT_700_01 (Parshall 4-20 mA, m3/h), AIT_700_001 turbidez, AIT_700_003 pH, AIT_700_004 OD (SC4500 por comunicacao). PID continuo (pidCtl, Direction TRUE: vazao acima do setpoint fecha a valvula) limita a vazao de lancamento (padrao 1242 m3/h = 345 L/s). Campo por symlink ${PATH}: djPCEDesligado, djPCMDesligado, djUV01, djUV02, djVC01, djMO01 (remota %I0.0-0.5), stsRemotaComOk (COM_OK do IO_DI32 da remota)." />
  <InterfaceList>
    <EventInputs>
      <Event ID="F61B5D54A50A440E" Name="E_RESET_FALHAS" Comment="Reset pelo processo (desinfeccao, valvula, UV e sensores) com cmdResetFalhas = TRUE">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="662F84A10221381B" Name="CNF" Comment="Status">
        <With Var="stsVazao" />
        <With Var="stsTotal" />
        <With Var="stsControleAtivo" />
        <With Var="stsAlarme" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="D75ACBAB39349035" Name="cmdResetFalhas" Type="BOOL" Comment="TRUE = reset (com o evento E_RESET_FALHAS)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="B3C085A02B02C2C4" Name="stsVazao" Type="REAL" Comment="Vazao do efluente final (m3/h)" />
      <VarDeclaration ID="97DEB8182327F657" Name="stsTotal" Type="UDINT" Comment="Volume totalizado (m3)" />
      <VarDeclaration ID="74B2B13C10E61F0E" Name="stsControleAtivo" Type="BOOL" Comment="PID controlando a 700-VC-01" />
      <VarDeclaration ID="7FCDA16AD87906A8" Name="stsAlarme" Type="BOOL" Comment="Algum alarme da desinfeccao" />
    </OutputVars>
  </InterfaceList>
