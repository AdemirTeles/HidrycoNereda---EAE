<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="862417d6-c3a9-2419-58f2-5364a94562b3" Name="Desinfeccao_UV_HMI" Comment="Service Interface Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.1" Author="Hidryco" Date="21/10/2026" Remarks="IHM da Desinfeccao_UV 1.1: ajustes do PID no sub-CAT PID_VC_700_01; reset cmdResetFalhas / E_RESET_FALHAS_PROCESSO (legado)" />
  <InterfaceList>
    <EventInputs>
      <Event ID="B18F9527B03F6368" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="B29E261CF0325DC9" Name="LOAD_PERS_DATA" Comment="Reenvia os parametros persistentes" />
      <Event ID="1B47BC94CEE432D9" Name="REQ" Comment="Atualizacao de status">
        <With Var="STS_VAZAO" />
        <With Var="STS_VAZAO_MAX" />
        <With Var="STS_TOTAL" />
        <With Var="STS_CONTROLE_ATIVO" />
        <With Var="STS_HABILITADO" />
        <With Var="STS_MOTIVO" />
        <With Var="STS_VC_POSICAO" />
        <With Var="STS_FT_FALHA" />
        <With Var="STS_UV_COM_OK" />
        <With Var="STS_UV_CANAL1" />
        <With Var="STS_UV_CANAL2" />
        <With Var="STS_DJ_PCE_DESLIGADO" />
        <With Var="STS_DJ_PCM_DESLIGADO" />
        <With Var="STS_DJ_UV01" />
        <With Var="STS_DJ_UV02" />
        <With Var="STS_DJ_VC01" />
        <With Var="STS_DJ_MO01" />
        <With Var="STS_REMOTA_OK" />
        <With Var="STS_AVISO_DISJUNTOR" />
        <With Var="STS_ALARME_VAZAO_ALTA" />
        <With Var="STS_AVISO_VARIACAO" />
        <With Var="STS_FALHA_REMOTA" />
        <With Var="STS_ALARME" />
        <With Var="STS_ALM_VAZAO_ALTA_EST" />
        <With Var="STS_ALM_VARIACAO_EST" />
        <With Var="STS_ALM_DISJUNTOR_EST" />
        <With Var="STS_ALM_REMOTA_EST" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="8DA18C8B88D861AA" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="341E4C9D143B2914" Name="E_PARAMETROS">
        <With Var="STP_TOL_VAZAO" />
        <With Var="STP_TEMPO_VAZAO" />
        <With Var="STP_VARIACAO_MAX" />
      </Event>
      <Event ID="673C9CACFA30E81B" Name="E_RESET_FALHAS_PROCESSO">
        <With Var="cmdResetFalhas" />
      </Event>
      <Event ID="A7123D0B6BA18805" Name="E_ZERA_TOTAL">
        <With Var="CMD_ZERA_TOTAL" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="9B50B64EF965A821" Name="QI" Type="BOOL" />
      <VarDeclaration ID="64C5B4D669700647" Name="STS_VAZAO" Type="REAL" Comment="Vazao do efluente final 700-FT-01 (m3/h)" />
      <VarDeclaration ID="9BBBF4F79C014F9D" Name="STS_VAZAO_MAX" Type="REAL" Comment="Vazao maxima de lancamento em uso (m3/h)" />
      <VarDeclaration ID="ED2A3A2AD9D2CEAB" Name="STS_TOTAL" Type="DINT" Comment="Volume totalizado (m3)" />
      <VarDeclaration ID="8CFA6BB1EE69DBDA" Name="STS_CONTROLE_ATIVO" Type="BOOL" Comment="PID controlando a 700-VC-01" />
      <VarDeclaration ID="9D544CFE60C51E40" Name="STS_HABILITADO" Type="BOOL" Comment="Controle de vazao habilitado pelo operador" />
      <VarDeclaration ID="00083F484189930B" Name="STS_MOTIVO" Type="INT" Comment="Controle: 0 controlando, 1 desabilitado, 2 FT-01 em falha, 3 valvula indisponivel, 4 retomando (3 s)" />
      <VarDeclaration ID="5A630CE8F223E31A" Name="STS_VC_POSICAO" Type="REAL" Comment="Posicao da 700-VC-01 (%)" />
      <VarDeclaration ID="3724F9189B78EC4D" Name="STS_FT_FALHA" Type="BOOL" Comment="700-FT-01 em falha" />
      <VarDeclaration ID="4C496D880FB42A44" Name="STS_UV_COM_OK" Type="BOOL" Comment="UV comunicando" />
      <VarDeclaration ID="DE11125D4105DF0E" Name="STS_UV_CANAL1" Type="BOOL" Comment="UV canal 1 operando" />
      <VarDeclaration ID="909A978770157DD8" Name="STS_UV_CANAL2" Type="BOOL" Comment="UV canal 2 operando" />
      <VarDeclaration ID="D8676A9461C485D9" Name="STS_DJ_PCE_DESLIGADO" Type="BOOL" Comment="Remota %I0.0: disjuntor desligado PCE" />
      <VarDeclaration ID="8155290424886535" Name="STS_DJ_PCM_DESLIGADO" Type="BOOL" Comment="Remota %I0.1: disjuntor desligado PCM desinfeccao" />
      <VarDeclaration ID="E0FD426C54E10B50" Name="STS_DJ_UV01" Type="BOOL" Comment="Remota %I0.2: disjuntor ligado 700-UV-01" />
      <VarDeclaration ID="B5278628A6F4EB0E" Name="STS_DJ_UV02" Type="BOOL" Comment="Remota %I0.3: disjuntor ligado 700-UV-02" />
      <VarDeclaration ID="3146A9607323897C" Name="STS_DJ_VC01" Type="BOOL" Comment="Remota %I0.4: disjuntor ligado 700-VC-01" />
      <VarDeclaration ID="207239DB8C69408E" Name="STS_DJ_MO01" Type="BOOL" Comment="Remota %I0.5: disjuntor ligado 700-MO-01 (monovia)" />
      <VarDeclaration ID="0DCEC12DB41BD8A9" Name="STS_REMOTA_OK" Type="BOOL" Comment="Remota da desinfeccao comunicando" />
      <VarDeclaration ID="F89132E9AC0FBE71" Name="STS_AVISO_DISJUNTOR" Type="BOOL" Comment="Disjuntor do PCE, PCM, UV ou VC-01 desligado" />
      <VarDeclaration ID="A35FB648721D6941" Name="STS_ALARME_VAZAO_ALTA" Type="BOOL" Comment="Vazao acima do limite de lancamento (memorizado)" />
      <VarDeclaration ID="2B50411206C948D5" Name="STS_AVISO_VARIACAO" Type="BOOL" Comment="Variacao brusca da vazao de lancamento (memorizado)" />
      <VarDeclaration ID="8B80C37723B8B9A9" Name="STS_FALHA_REMOTA" Type="BOOL" Comment="Falha de comunicacao com a remota da desinfeccao" />
      <VarDeclaration ID="946F4BE0E36C2836" Name="STS_ALARME" Type="BOOL" Comment="Algum alarme da desinfeccao" />
      <VarDeclaration ID="060041ABB2A0A5A2" Name="STS_ALM_VAZAO_ALTA_EST" Type="USINT" Comment="Estado do ALARM_BIT (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="3988E692C5278158" Name="STS_ALM_VARIACAO_EST" Type="USINT" Comment="Estado do ALARM_BIT (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="F7176D1924986299" Name="STS_ALM_DISJUNTOR_EST" Type="USINT" Comment="Estado do ALARM_BIT (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="6D5DB80D1692E5C6" Name="STS_ALM_REMOTA_EST" Type="USINT" Comment="Estado do ALARM_BIT (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="A24C7FAB08A8041F" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="9F7593E57A5935FD" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="975D7F4B71294A99" Name="STP_TOL_VAZAO" Type="REAL" Comment="Alarme: tolerancia acima do limite (%)" />
      <VarDeclaration ID="48B1DA7F68ECA0A8" Name="STP_TEMPO_VAZAO" Type="INT" Comment="Alarme: tempo acima do limite (s); 0 = desligado" />
      <VarDeclaration ID="BF0DC1C37334FADC" Name="STP_VARIACAO_MAX" Type="REAL" Comment="Aviso: variacao maxima da vazao em 1 min (m3/h); 0 = desligado" />
      <VarDeclaration ID="3223A03025B9D306" Name="cmdResetFalhas" Type="BOOL" Comment="Reconhece os alarmes da desinfeccao" />
      <VarDeclaration ID="133D4C207A85139E" Name="CMD_ZERA_TOTAL" Type="BOOL" Comment="Zera o totalizador" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>
