      <VarDeclaration ID="BE35A649328B8714" Name="bMudou" Type="BOOL" />
      <VarDeclaration ID="523921398BBF4AE7" Name="wSts" Type="WORD" />
      <VarDeclaration ID="1F4D2C139E96720C" Name="oldSts" Type="WORD" InitialValue="16#FFFF" />
      <VarDeclaration ID="E4E9CD353B47DE68" Name="wAlm" Type="WORD" />
      <VarDeclaration ID="79C8BA6A222E97A2" Name="oldAlm" Type="WORD" InitialValue="16#FFFF" />
      <VarDeclaration ID="76EC5D0499F6720B" Name="o_stsTensaoAB" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="C9D2AE04E268F028" Name="o_stsTensaoBC" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="633BF78D274C563D" Name="o_stsTensaoCA" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="D7267F7BD0E1C98C" Name="o_stsTensaoAN" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="AF8A1D0888F77F99" Name="o_stsTensaoBN" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="573699FAC427FFEE" Name="o_stsTensaoCN" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="4F20695BCF387176" Name="o_stsCorrenteA" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="20D07697FFDAE585" Name="o_stsCorrenteB" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="F500B015E672C071" Name="o_stsCorrenteC" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="E7F53C69F55F31EF" Name="o_stsPotenciaAtivaA" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="241EB8B49B021962" Name="o_stsPotenciaAtivaB" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="5AAC604F10A5DAD3" Name="o_stsPotenciaAtivaC" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="DA1FF0E1D588936B" Name="o_stsPotenciaAtivaTotal" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="0F8FBE99143AE8BA" Name="o_stsPotenciaReativaA" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="FEBF457ECADD92F6" Name="o_stsPotenciaReativaB" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="D9DF345D88ADC1FC" Name="o_stsPotenciaReativaC" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="9B53E7EB27F109C3" Name="o_stsPotenciaReativaTotal" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="8F6CA7D8443C8649" Name="o_stsPotenciaAparenteTotal" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="ED37029593AFF58D" Name="o_stsFatorPotencia" Type="REAL" InitialValue="-1.0" />
      <VarDeclaration ID="9C95C1403C4DF8E9" Name="o_stsFrequencia" Type="REAL" InitialValue="-1.0" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Estado inicial" x="1500" y="640" />
      <ECState Name="EXEC" Comment="Executa a logica; o algoritmo decide quais eventos saem" x="1500" y="1100">
        <ECAction Algorithm="algMGE" Output="INITO" />
        <ECAction Output="CNF" />
        <ECAction Output="CNF_HMI" />
        <ECAction Output="CNF_ALM" />
      </ECState>
      <ECTransition Source="START" Destination="EXEC" Condition="INIT OR REQ_PARA OR REQ_V OR REQ_I OR REQ_P OR REQ_E OR REQ_COM OR REQ_RESET OR REQ_RESET_PROC OR TICK" x="1580" y="860" />
      <ECTransition Source="EXEC" Destination="START" Condition="1" x="1420" y="860" />
    </ECC>
    <Algorithm Name="algMGE" Comment="Logica completa do multimedidor (um unico algoritmo)">
      <ST><![CDATA[(* =====================================================================
   basicMGEGenerico v1.5 - multimedidor PowerLogic PM5300 (HW CAT PM53xxMbtcp)
   Padrao das bibliotecas Schneider: eventos de saida desligados no inicio e
   ligados so na mudanca; tempos contados pelo TICK de 1 s (E_CYCLE do CAT).
   - valores recebidos dos symlinks VTQ do PM53xxMbtcp; energias de Wh para kWh;
   - v1.1: frequencia recebida como VTQLINT (e assim que o PM53xxMbtcp publica);
   - falha de comunicacao: ComStatus FALSE por cfgTempoCom s; com a falha,
     os alarmes de medicao ficam suprimidos (os valores ficam congelados);
   - v1.2: falta de fase (FF abaixo do ajuste); tensao entre fases e
     fase-neutro alta/baixa (as baixas nao atuam junto com a falta de
     fase); corrente A, B e C alta (um ajuste, 3 alarmes); FP baixo (so
     com carga: potencia aparente > 0); frequencia alta/baixa;
   - v1.3: so as grandezas e alarmes da especificacao (sai a falta de fase,
     as medias, o desequilibrio, a aparente por fase e as energias); valor
     de referencia por limite (0 = desligado) e um tempo de retardo por
     grupo (FP, tensao, corrente, frequencia); memorizado ate o
     reconhecimento, que so libera o que ja normalizou;
   - v1.4: corrente A, B e C baixa (um ajuste, 3 alarmes, retardo do
     grupo corrente).
   ===================================================================== *)

INITO   := FALSE;
CNF     := FALSE;
CNF_HMI := FALSE;
CNF_ALM := FALSE;

IF REQ_COM THEN
    bComRecebida := TRUE;
END_IF;
IF INIT THEN
    initDone := TRUE;
    initPass := TRUE;
    INITO    := TRUE;
END_IF;
IF NOT initDone THEN
    RETURN;
END_IF;
bReset := (REQ_RESET AND hmiReset) OR (REQ_RESET_PROC AND cmdResetFalhas);

(* ---- 1. Comunicacao ---- *)
IF NOT comOK THEN
    IF TICK AND uSegCom < UINT_TO_UDINT(cfgTempoCom) THEN
        uSegCom := uSegCom + 1;
    END_IF;
ELSE
    uSegCom := 0;
END_IF;
stsFalhaComunicacao := NOT comOK AND uSegCom >= UINT_TO_UDINT(cfgTempoCom);
bValido := bComRecebida AND comOK;

(* ---- 2. Valores ---- *)
stsTensaoAB := mVAB;
stsTensaoBC := mVBC;
stsTensaoCA := mVCA;
stsTensaoAN := mVAN;
stsTensaoBN := mVBN;
stsTensaoCN := mVCN;
stsCorrenteA := mIA;
stsCorrenteB := mIB;
stsCorrenteC := mIC;
stsPotenciaAtivaA := mPA;
stsPotenciaAtivaB := mPB;
stsPotenciaAtivaC := mPC;
stsPotenciaAtivaTotal := mPT;
stsPotenciaReativaA := mQA;
stsPotenciaReativaB := mQB;
stsPotenciaReativaC := mQC;
stsPotenciaReativaTotal := mQT;
stsPotenciaAparenteTotal := mST;
stsFatorPotencia := mFp;
stsFrequencia := LINT_TO_REAL(mFreq);

(* ---- 3. Condicoes (so com o medidor comunicando) ---- *)
cFPL := stpFPL > 0.0 AND bValido AND (mST > 0.0 AND ABS(mFp) < stpFPL);
cVFH := stpVFH > 0.0 AND bValido AND (mVAB > stpVFH OR mVBC > stpVFH OR mVCA > stpVFH);
cVFL := stpVFL > 0.0 AND bValido AND (mVAB < stpVFL OR mVBC < stpVFL OR mVCA < stpVFL);
cVNH := stpVNH > 0.0 AND bValido AND (mVAN > stpVNH OR mVBN > stpVNH OR mVCN > stpVNH);
cVNL := stpVNL > 0.0 AND bValido AND (mVAN < stpVNL OR mVBN < stpVNL OR mVCN < stpVNL);
cIAH := stpIH > 0.0 AND bValido AND (mIA > stpIH);
cIBH := stpIH > 0.0 AND bValido AND (mIB > stpIH);
cICH := stpIH > 0.0 AND bValido AND (mIC > stpIH);
cIAL := stpIL > 0.0 AND bValido AND (mIA < stpIL);
cIBL := stpIL > 0.0 AND bValido AND (mIB < stpIL);
cICL := stpIL > 0.0 AND bValido AND (mIC < stpIL);
cFRH := stpFRH > 0.0 AND bValido AND (stsFrequencia > stpFRH);
cFRL := stpFRL > 0.0 AND bValido AND (stsFrequencia < stpFRL);

(* ---- 4. Alarmes: tempo de retardo do grupo, memoria ate o reset, referencia 0 zera ---- *)
IF cFPL THEN
    IF TICK AND uFPL < UINT_TO_UDINT(tmpFP) THEN
        uFPL := uFPL + 1;
    END_IF;
    IF uFPL >= UINT_TO_UDINT(tmpFP) THEN
        stsAlarmeFPBaixo := TRUE;
    END_IF;
ELSE
    uFPL := 0;
    IF bReset THEN
        stsAlarmeFPBaixo := FALSE;
    END_IF;
END_IF;
IF stpFPL <= 0.0 THEN
    stsAlarmeFPBaixo := FALSE;
END_IF;
IF cVFH THEN
    IF TICK AND uVFH < UINT_TO_UDINT(tmpTEN) THEN
        uVFH := uVFH + 1;
    END_IF;
    IF uVFH >= UINT_TO_UDINT(tmpTEN) THEN
        stsAlarmeTensaoFFH := TRUE;
    END_IF;
ELSE
    uVFH := 0;
    IF bReset THEN
        stsAlarmeTensaoFFH := FALSE;
    END_IF;
END_IF;
IF stpVFH <= 0.0 THEN
    stsAlarmeTensaoFFH := FALSE;
END_IF;
IF cVFL THEN
    IF TICK AND uVFL < UINT_TO_UDINT(tmpTEN) THEN
        uVFL := uVFL + 1;
    END_IF;
    IF uVFL >= UINT_TO_UDINT(tmpTEN) THEN
        stsAlarmeTensaoFFL := TRUE;
    END_IF;
ELSE
    uVFL := 0;
    IF bReset THEN
        stsAlarmeTensaoFFL := FALSE;
    END_IF;
END_IF;
IF stpVFL <= 0.0 THEN
    stsAlarmeTensaoFFL := FALSE;
END_IF;
IF cVNH THEN
    IF TICK AND uVNH < UINT_TO_UDINT(tmpTEN) THEN
        uVNH := uVNH + 1;
    END_IF;
    IF uVNH >= UINT_TO_UDINT(tmpTEN) THEN
        stsAlarmeTensaoFNH := TRUE;
    END_IF;
ELSE
    uVNH := 0;
    IF bReset THEN
        stsAlarmeTensaoFNH := FALSE;
    END_IF;
END_IF;
IF stpVNH <= 0.0 THEN
    stsAlarmeTensaoFNH := FALSE;
END_IF;
IF cVNL THEN
    IF TICK AND uVNL < UINT_TO_UDINT(tmpTEN) THEN
        uVNL := uVNL + 1;
    END_IF;
    IF uVNL >= UINT_TO_UDINT(tmpTEN) THEN
        stsAlarmeTensaoFNL := TRUE;
    END_IF;
ELSE
    uVNL := 0;
    IF bReset THEN
        stsAlarmeTensaoFNL := FALSE;
    END_IF;
END_IF;
IF stpVNL <= 0.0 THEN
    stsAlarmeTensaoFNL := FALSE;
END_IF;
IF cIAH THEN
    IF TICK AND uIAH < UINT_TO_UDINT(tmpCOR) THEN
        uIAH := uIAH + 1;
    END_IF;
    IF uIAH >= UINT_TO_UDINT(tmpCOR) THEN
        stsAlarmeCorrenteAH := TRUE;
    END_IF;
ELSE
    uIAH := 0;
    IF bReset THEN
        stsAlarmeCorrenteAH := FALSE;
    END_IF;
END_IF;
IF stpIH <= 0.0 THEN
    stsAlarmeCorrenteAH := FALSE;
END_IF;
IF cIBH THEN
    IF TICK AND uIBH < UINT_TO_UDINT(tmpCOR) THEN
        uIBH := uIBH + 1;
    END_IF;
    IF uIBH >= UINT_TO_UDINT(tmpCOR) THEN
        stsAlarmeCorrenteBH := TRUE;
    END_IF;
ELSE
    uIBH := 0;
    IF bReset THEN
        stsAlarmeCorrenteBH := FALSE;
    END_IF;
END_IF;
IF stpIH <= 0.0 THEN
    stsAlarmeCorrenteBH := FALSE;
END_IF;
IF cICH THEN
    IF TICK AND uICH < UINT_TO_UDINT(tmpCOR) THEN
        uICH := uICH + 1;
    END_IF;
    IF uICH >= UINT_TO_UDINT(tmpCOR) THEN
        stsAlarmeCorrenteCH := TRUE;
    END_IF;
ELSE
    uICH := 0;
    IF bReset THEN
        stsAlarmeCorrenteCH := FALSE;
    END_IF;
END_IF;
IF stpIH <= 0.0 THEN
    stsAlarmeCorrenteCH := FALSE;
END_IF;
IF cIAL THEN
    IF TICK AND uIAL < UINT_TO_UDINT(tmpCOR) THEN
        uIAL := uIAL + 1;
    END_IF;
    IF uIAL >= UINT_TO_UDINT(tmpCOR) THEN
        stsAlarmeCorrenteAL := TRUE;
    END_IF;
ELSE
    uIAL := 0;
    IF bReset THEN
        stsAlarmeCorrenteAL := FALSE;
    END_IF;
END_IF;
IF stpIL <= 0.0 THEN
    stsAlarmeCorrenteAL := FALSE;
END_IF;
IF cIBL THEN
    IF TICK AND uIBL < UINT_TO_UDINT(tmpCOR) THEN
        uIBL := uIBL + 1;
    END_IF;
    IF uIBL >= UINT_TO_UDINT(tmpCOR) THEN
        stsAlarmeCorrenteBL := TRUE;
    END_IF;
ELSE
    uIBL := 0;
    IF bReset THEN
        stsAlarmeCorrenteBL := FALSE;
    END_IF;
END_IF;
IF stpIL <= 0.0 THEN
    stsAlarmeCorrenteBL := FALSE;
END_IF;
IF cICL THEN
    IF TICK AND uICL < UINT_TO_UDINT(tmpCOR) THEN
        uICL := uICL + 1;
    END_IF;
    IF uICL >= UINT_TO_UDINT(tmpCOR) THEN
        stsAlarmeCorrenteCL := TRUE;
    END_IF;
ELSE
    uICL := 0;
    IF bReset THEN
        stsAlarmeCorrenteCL := FALSE;
    END_IF;
END_IF;
IF stpIL <= 0.0 THEN
    stsAlarmeCorrenteCL := FALSE;
END_IF;
IF cFRH THEN
    IF TICK AND uFRH < UINT_TO_UDINT(tmpFRE) THEN
        uFRH := uFRH + 1;
    END_IF;
    IF uFRH >= UINT_TO_UDINT(tmpFRE) THEN
        stsAlarmeFrequenciaH := TRUE;
    END_IF;
ELSE
    uFRH := 0;
    IF bReset THEN
        stsAlarmeFrequenciaH := FALSE;
    END_IF;
END_IF;
IF stpFRH <= 0.0 THEN
    stsAlarmeFrequenciaH := FALSE;
END_IF;
IF cFRL THEN
    IF TICK AND uFRL < UINT_TO_UDINT(tmpFRE) THEN
        uFRL := uFRL + 1;
    END_IF;
    IF uFRL >= UINT_TO_UDINT(tmpFRE) THEN
        stsAlarmeFrequenciaL := TRUE;
    END_IF;
ELSE
    uFRL := 0;
    IF bReset THEN
        stsAlarmeFrequenciaL := FALSE;
    END_IF;
END_IF;
IF stpFRL <= 0.0 THEN
    stsAlarmeFrequenciaL := FALSE;
END_IF;

almCom := stsFalhaComunicacao;
almFPL := stsAlarmeFPBaixo;
almVFH := stsAlarmeTensaoFFH;
almVFL := stsAlarmeTensaoFFL;
almVNH := stsAlarmeTensaoFNH;
almVNL := stsAlarmeTensaoFNL;
almIAH := stsAlarmeCorrenteAH;
almIBH := stsAlarmeCorrenteBH;
almICH := stsAlarmeCorrenteCH;
almIAL := stsAlarmeCorrenteAL;
almIBL := stsAlarmeCorrenteBL;
almICL := stsAlarmeCorrenteCL;
almFRH := stsAlarmeFrequenciaH;
almFRL := stsAlarmeFrequenciaL;
stsAlarme := almCom OR almFPL OR almVFH OR almVFL OR almVNH OR almVNL OR almIAH OR almIBH OR almICH OR almIAL OR almIBL OR almICL OR almFRH OR almFRL;

(* ---- 5. Eventos so na mudanca ---- *)
bMudou := FALSE;
IF stsTensaoAB <> o_stsTensaoAB THEN bMudou := TRUE; o_stsTensaoAB := stsTensaoAB; END_IF;
IF stsTensaoBC <> o_stsTensaoBC THEN bMudou := TRUE; o_stsTensaoBC := stsTensaoBC; END_IF;
IF stsTensaoCA <> o_stsTensaoCA THEN bMudou := TRUE; o_stsTensaoCA := stsTensaoCA; END_IF;
IF stsTensaoAN <> o_stsTensaoAN THEN bMudou := TRUE; o_stsTensaoAN := stsTensaoAN; END_IF;
IF stsTensaoBN <> o_stsTensaoBN THEN bMudou := TRUE; o_stsTensaoBN := stsTensaoBN; END_IF;
IF stsTensaoCN <> o_stsTensaoCN THEN bMudou := TRUE; o_stsTensaoCN := stsTensaoCN; END_IF;
IF stsCorrenteA <> o_stsCorrenteA THEN bMudou := TRUE; o_stsCorrenteA := stsCorrenteA; END_IF;
IF stsCorrenteB <> o_stsCorrenteB THEN bMudou := TRUE; o_stsCorrenteB := stsCorrenteB; END_IF;
IF stsCorrenteC <> o_stsCorrenteC THEN bMudou := TRUE; o_stsCorrenteC := stsCorrenteC; END_IF;
IF stsPotenciaAtivaA <> o_stsPotenciaAtivaA THEN bMudou := TRUE; o_stsPotenciaAtivaA := stsPotenciaAtivaA; END_IF;
IF stsPotenciaAtivaB <> o_stsPotenciaAtivaB THEN bMudou := TRUE; o_stsPotenciaAtivaB := stsPotenciaAtivaB; END_IF;
IF stsPotenciaAtivaC <> o_stsPotenciaAtivaC THEN bMudou := TRUE; o_stsPotenciaAtivaC := stsPotenciaAtivaC; END_IF;
IF stsPotenciaAtivaTotal <> o_stsPotenciaAtivaTotal THEN bMudou := TRUE; o_stsPotenciaAtivaTotal := stsPotenciaAtivaTotal; END_IF;
IF stsPotenciaReativaA <> o_stsPotenciaReativaA THEN bMudou := TRUE; o_stsPotenciaReativaA := stsPotenciaReativaA; END_IF;
IF stsPotenciaReativaB <> o_stsPotenciaReativaB THEN bMudou := TRUE; o_stsPotenciaReativaB := stsPotenciaReativaB; END_IF;
IF stsPotenciaReativaC <> o_stsPotenciaReativaC THEN bMudou := TRUE; o_stsPotenciaReativaC := stsPotenciaReativaC; END_IF;
IF stsPotenciaReativaTotal <> o_stsPotenciaReativaTotal THEN bMudou := TRUE; o_stsPotenciaReativaTotal := stsPotenciaReativaTotal; END_IF;
IF stsPotenciaAparenteTotal <> o_stsPotenciaAparenteTotal THEN bMudou := TRUE; o_stsPotenciaAparenteTotal := stsPotenciaAparenteTotal; END_IF;
IF stsFatorPotencia <> o_stsFatorPotencia THEN bMudou := TRUE; o_stsFatorPotencia := stsFatorPotencia; END_IF;
IF stsFrequencia <> o_stsFrequencia THEN bMudou := TRUE; o_stsFrequencia := stsFrequencia; END_IF;
wSts := 0;
IF stsAlarmeFPBaixo THEN wSts := wSts OR 16#0001; END_IF;
IF stsAlarmeTensaoFFH THEN wSts := wSts OR 16#0002; END_IF;
IF stsAlarmeTensaoFFL THEN wSts := wSts OR 16#0004; END_IF;
IF stsAlarmeTensaoFNH THEN wSts := wSts OR 16#0008; END_IF;
IF stsAlarmeTensaoFNL THEN wSts := wSts OR 16#0010; END_IF;
IF stsAlarmeCorrenteAH THEN wSts := wSts OR 16#0020; END_IF;
IF stsAlarmeCorrenteBH THEN wSts := wSts OR 16#0040; END_IF;
IF stsAlarmeCorrenteCH THEN wSts := wSts OR 16#0080; END_IF;
IF stsAlarmeCorrenteAL THEN wSts := wSts OR 16#0100; END_IF;
IF stsAlarmeCorrenteBL THEN wSts := wSts OR 16#0200; END_IF;
IF stsAlarmeCorrenteCL THEN wSts := wSts OR 16#0400; END_IF;
IF stsAlarmeFrequenciaH THEN wSts := wSts OR 16#0800; END_IF;
IF stsAlarmeFrequenciaL THEN wSts := wSts OR 16#1000; END_IF;
IF stsFalhaComunicacao THEN wSts := wSts OR 16#2000; END_IF;
IF stsAlarme THEN wSts := wSts OR 16#4000; END_IF;
wAlm := 0;
IF almCom THEN wAlm := wAlm OR 16#0001; END_IF;
IF almFPL THEN wAlm := wAlm OR 16#0002; END_IF;
IF almVFH THEN wAlm := wAlm OR 16#0004; END_IF;
IF almVFL THEN wAlm := wAlm OR 16#0008; END_IF;
IF almVNH THEN wAlm := wAlm OR 16#0010; END_IF;
IF almVNL THEN wAlm := wAlm OR 16#0020; END_IF;
IF almIAH THEN wAlm := wAlm OR 16#0040; END_IF;
IF almIBH THEN wAlm := wAlm OR 16#0080; END_IF;
IF almICH THEN wAlm := wAlm OR 16#0100; END_IF;
IF almIAL THEN wAlm := wAlm OR 16#0200; END_IF;
IF almIBL THEN wAlm := wAlm OR 16#0400; END_IF;
IF almICL THEN wAlm := wAlm OR 16#0800; END_IF;
IF almFRH THEN wAlm := wAlm OR 16#1000; END_IF;
IF almFRL THEN wAlm := wAlm OR 16#2000; END_IF;
CNF := initPass OR bMudou OR (wSts <> oldSts);
CNF_HMI := CNF;
CNF_ALM := initPass OR (wAlm <> oldAlm);
oldSts := wSts;
oldAlm := wAlm;
initPass := FALSE;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>