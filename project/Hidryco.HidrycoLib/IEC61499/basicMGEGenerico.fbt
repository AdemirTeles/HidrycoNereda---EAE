<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="3a2a799b-f958-4af8-8565-a8cdf83fadd4" Name="basicMGEGenerico" Comment="Logica unica do multimedidor (PM5300): valores, falta de fase, tensao e corrente H/L, comunicacao" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.5" Author="Hidryco" Date="15/10/2026" Remarks="1.5: valores na IHM com prefixo STS_ (STS_TENSAO_AB ... STS_FREQUENCIA). 1.4: corrente A, B e C baixa (um ajuste, 3 alarmes). 1.3: so as grandezas, ajustes e alarmes da especificacao; referencia 0 = desligado; um tempo por grupo. 1.2: lista de alarmes do cliente. 1.1: frequencia como LINT (VTQLINT do PM53xxMbtcp). 1.0: PM5300 pelo HW CAT PM53xxMbtcp; falta de fase, tensao H/L e corrente H/L ajustaveis na IHM" />
