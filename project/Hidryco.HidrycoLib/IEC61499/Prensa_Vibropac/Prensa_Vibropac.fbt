<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="4c17f8b7-2b1c-e5be-8cee-8d0beb1c8e86" Comment="Prensa desaguadora Vibropac C-Press (VSD-1200) - HidrycoLib" Name="Prensa_Vibropac" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.0" Author="Hidryco" Date="19/10/2026" Remarks="1.0: Prensa desaguadora Vibropac C-Press (VSD-1200) - tabela Modbus TCP Inovaisa (PV-35525). Campo por symlink ${PATH}: leitura mbR4005..mbR4016 (INT, nome = mbR + registro), mbConexao (connStatusInt, 1 = online); escrita mbW4001 (ciclo remoto 0/1) e mbW4002 (reset 0/1). cfgHabilitada = FALSE para equipamento futuro." />
  <InterfaceList>
    <EventInputs>
      <Event ID="7E5F12997195C3C2" Name="REQ" Comment="Atualizacao do processo">
        <With Var="cmdLigarCiclo" />
      </Event>
      <Event ID="6BF17A43E520A528" Name="E_RESET_FALHAS" Comment="Reset pelo processo (com cmdResetFalhas = TRUE)">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="8111B44229D619D2" Name="CNF" Comment="Status">
        <With Var="stsComunicacaoOK" />
        <With Var="stsDisponivel" />
        <With Var="stsCicloLigado" />
        <With Var="stsFalha" />
        <With Var="stsEmergencia" />
        <With Var="stsFuncionando" />
        <With Var="stsNivelFloculador" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="12D984BF9E1FDA1E" Name="cmdLigarCiclo" Type="BOOL" Comment="TRUE = liga o ciclo remoto do skid (automatico)" />
      <VarDeclaration ID="38D2DBD6E8AAFA91" Name="cmdResetFalhas" Type="BOOL" Comment="TRUE = reset (com o evento E_RESET_FALHAS)" />
      <VarDeclaration ID="FF2D8D14693482D2" Name="cfgHabilitada" Type="BOOL" InitialValue="TRUE" Comment="FALSE = instancia desabilitada (equipamento futuro)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="6346B122610F5C8A" Name="stsComunicacaoOK" Type="BOOL" Comment="Comunicacao Modbus com o CLP do skid OK" />
      <VarDeclaration ID="D0AE1B8C5839DEE7" Name="stsDisponivel" Type="BOOL" Comment="Pode ser ligado pelo automatico agora" />
      <VarDeclaration ID="1C3316E7DDFF3B8E" Name="stsCicloLigado" Type="BOOL" Comment="Comando de ciclo remoto ligado (4001 = 1)" />
      <VarDeclaration ID="45D965BF3D32438A" Name="stsFalha" Type="BOOL" Comment="Skid em falha (alarme, emergencia ou motor)" />
      <VarDeclaration ID="1BEDB6C067FD4407" Name="stsEmergencia" Type="BOOL" Comment="Botao de emergencia do skid acionado (4006)" />
      <VarDeclaration ID="4BC1097F03D3F72F" Name="stsFuncionando" Type="BOOL" Comment="Prensa M1 funcionando" />
      <VarDeclaration ID="984D9CCB4CB171BC" Name="stsNivelFloculador" Type="REAL" Comment="Nivel do tanque floculador LT1 (%) (4016, 0-1000)" />
    </OutputVars>
  </InterfaceList>
