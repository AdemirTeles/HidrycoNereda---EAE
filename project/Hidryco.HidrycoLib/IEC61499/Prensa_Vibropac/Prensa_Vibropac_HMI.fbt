      <VarDeclaration ID="B52B8FE2067186A0" Name="STS_ALM_EMERGENCIA_EST" Type="USINT" Comment="Estado do ALARM_BIT (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="DAB162B603363F91" Name="STS_ALM_SKID_EST" Type="USINT" Comment="Estado do ALARM_BIT (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
      <VarDeclaration ID="D1F404D2A05AA8AD" Name="STS_ALM_MOTOR_EST" Type="USINT" Comment="Estado do ALARM_BIT (0 normal, 1 ativo reconhecido, 2 ativo nao reconhecido, 3 saiu nao reconhecido, 4 ativo e saiu nao reconhecido)" />
