      <Parameter Name="MoveStyle" Value="None" />
      <Parameter Name="Text" Value="Bits de Alarme 2:&#xD;&#xA;0 tensão de alimentação alta&#xD;&#xA;1 tensão de alimentação baixa&#xD;&#xA;2 tensão de bateria baixa&#xD;&#xA;3&#xD;&#xA;4 fim de curso mecânico ultrapassado na abertura&#xD;&#xA;5 fim de curso mecânico ultrapassado no fechamento&#xD;&#xA;6 fim de curso programado ultrapassado na abertura&#xD;&#xA;7 fim de curso programado ultrapassado no fechamento&#xD;&#xA;8 cartão anybus não detectado" />
      <Parameter Name="NxtLayerIdentifier" Value="" />
    </Frame>
    <Frame Name="COMMENT4" X="6440" Y="4320" Width="1108.333" Height="905.4688" IsComment="true">
