    <ECC>
      <ECState Name="START" Comment="Estado inicial" x="1500" y="640" />
      <ECState Name="EXEC" Comment="Executa a logica; o algoritmo decide quais eventos saem" x="1500" y="1100">
        <ECAction Algorithm="algEEE" Output="INITO" />
        <ECAction Output="CNF_CMD" />
        <ECAction Output="CNF_COM" />
        <ECAction Output="CNF_PID" />
        <ECAction Output="CNF_INIBE" />
        <ECAction Output="CNF" />
        <ECAction Output="CNF_HMI" />
        <ECAction Output="CNF_ALM" />
      </ECState>
      <ECTransition Source="START" Destination="EXEC" Condition="INIT OR REQ_PARA OR REQ_NIVEL OR REQ_PRESSAO OR REQ_BOIAS OR REQ_BOMBAS OR REQ_EXT OR REQ_CAMPO OR REQ_ATV OR REQ_PID OR REQ_RESET OR REQ_RESET_PROC OR TICK" x="1580" y="860" />
      <ECTransition Source="EXEC" Destination="START" Condition="1" x="1420" y="860" />
    </ECC>
    <Algorithm Name="algEEE" Comment="Logica completa da elevatoria (um unico algoritmo)">
      <ST><![CDATA[(* =====================================================================
   basicEEEBruto v1.1 - Elevatoria de Esgoto Bruto (100-BS-01/02/03)
   Padrao das bibliotecas Schneider: eventos de saida desligados no inicio e
   ligados so na mudanca; tempos contados pelo TICK de 1 s (E_CYCLE do CAT).
   Regras (definidas pelo usuario, out/2026):
   - numero de bombas por faixas de nivel do LIT-03 (mesmas tags do CAT
     Necessidade_2_Equipamentos), no maximo 2; velocidade pelo PID de nivel;
   - revezamento: troca da principal apos STP_TEMPO_Bx horas ligada, na
     sequencia 1-2-3 pulando a indisponivel; a 2a e a proxima da sequencia;
     principal indisponivel = troca na hora (tags do Revezamento_3_Motores);
   - HH do tanque do Nereda: a elevatoria para e segura o esgoto; volta a
     bombear quando o poco chega ao H dele (ou na LSH) - o tanque do Nereda
     tem extravasor; depois que esvazia ate a faixa 1, volta a segurar;
   - LIT-03 em falha: operacao pelas boias (LSH liga as 2 bombas na
     velocidade maxima; desligam quando a LSL abaixa; com a LSL com defeito,
     ficam cfgTempoFalhaBoiaL min depois que a LSH desce);
   - LSL abaixada desliga as bombas (ilkGeral) e elas voltam sozinhas;
   - PIT-01 em LL com bomba ligada = falha de recalque: para todas, alarma,
     memoriza ate o reset; L/LL do PIT-01 inibidos com as bombas paradas e
     nos primeiros cfgTempoPartidaPressao s depois da partida;
   - LSH so alarma (fora a operacao pelas boias e a liberacao do HH).
   v1.2: emergencia do PCM e NF (FALSE = em emergencia), so vale depois da
         1a leitura do campo.
   v1.1: emergencia do painel (campo) OU do processo vai para as bombas;
   falha de comunicacao de cada ATV630 = NOT ComStatus, publicada no
   stsFalhaComunicacao do motor (sem leitura = falha).
   ===================================================================== *)

(* ---- 0. Eventos de saida: so sai o que for ligado abaixo ---- *)
INITO     := FALSE;
CNF_CMD   := FALSE;
CNF_PID   := FALSE;
CNF_INIBE := FALSE;
CNF       := FALSE;
CNF_HMI   := FALSE;
CNF_ALM   := FALSE;
CNF_COM   := FALSE;

IF REQ_NIVEL THEN
    bNivelRecebido := TRUE;
END_IF;
IF REQ_BOIAS THEN
    bBoiasRecebidas := TRUE;
END_IF;
IF REQ_CAMPO THEN
    bCampoRecebido := TRUE;
END_IF;

(* ---- 1. Inicializacao ---- *)
IF INIT THEN
    initDone := TRUE;
    initPass := TRUE;
    INITO    := TRUE;
END_IF;
IF NOT initDone THEN
    RETURN;
END_IF;

bReset := (REQ_RESET AND hmiReset) OR (REQ_RESET_PROC AND cmdResetFalhas);
bAlgumaLigada := lig1 OR lig2 OR lig3;
stsBombasLigadas := 0;
IF lig1 THEN stsBombasLigadas := stsBombasLigadas + 1; END_IF;
IF lig2 THEN stsBombasLigadas := stsBombasLigadas + 1; END_IF;
IF lig3 THEN stsBombasLigadas := stsBombasLigadas + 1; END_IF;

(* ---- 2. Boias ---- *)
IF boiaH AND NOT boiaL THEN
    stsFalhaBoiaL := TRUE;                 (* LSH levantada com a LSL abaixada: LSL com defeito *)
END_IF;
IF bReset AND boiaL THEN
    stsFalhaBoiaL := FALSE;
END_IF;
(* nivel baixo: LSL abaixada (so se a LSL estiver confiavel); antes da 1a leitura, bloqueado *)
stsNivelBaixo := NOT bBoiasRecebidas OR (NOT boiaL AND NOT stsFalhaBoiaL);

(* ---- 3. Falha de recalque (PIT-01) ---- *)
IF bAlgumaLigada THEN
    IF TICK AND uSegLigada < UINT_TO_UDINT(cfgTempoPartidaPressao) THEN
        uSegLigada := uSegLigada + 1;
    END_IF;
ELSE
    uSegLigada := 0;
END_IF;
inibePressao := uSegLigada < UINT_TO_UDINT(cfgTempoPartidaPressao);
IF preLL AND NOT inibePressao THEN
    stsFalhaRecalque := TRUE;              (* pressao LL com bomba ligada: para todas *)
END_IF;
IF bReset AND NOT preLL THEN
    stsFalhaRecalque := FALSE;
END_IF;
ilkGeral := stsNivelBaixo OR stsFalhaRecalque;

(* ---- 3b. Emergencia e comunicacao dos ATV630 ---- *)
emergencia := emergProc OR (bCampoRecebido AND NOT emergPainel);   (* PCM: contato NF; sem leitura = sem emergencia *)
falhaCom1 := NOT atvCom1;
falhaCom2 := NOT atvCom2;
falhaCom3 := NOT atvCom3;

(* ---- 4. Origem do nivel ---- *)
bNivelOk := bNivelRecebido AND NOT nivFalha;
stsModoBoias := NOT bNivelOk;

(* ---- 5. HH do tanque do Nereda: segura enquanto o poco nao chega ao H ---- *)
IF NOT bufferHH THEN
    bLiberadoHH := FALSE;
ELSIF (bNivelOk AND nivAcimaH) OR boiaH THEN
    bLiberadoHH := TRUE;                   (* poco no H: volta a bombear (o Nereda tem extravasor) *)
END_IF;
stsSegurandoBuffer := necHabilita AND bufferHH AND NOT bLiberadoHH;

(* ---- 6. Numero de bombas ---- *)
IF NOT necHabilita OR stsSegurandoBuffer THEN
    iNec := 0;
    uTempoBoia := 0;
ELSIF NOT stsModoBoias THEN
    uTempoBoia := 0;
    IF iNec = 0 THEN
        IF nivValor >= stpFaixa3 THEN
            iNec := 1;
        END_IF;
    ELSIF iNec = 1 THEN
        IF nivValor >= stpFaixa4 THEN
            iNec := 2;
        ELSIF nivValor < stpFaixa1 THEN
            iNec := 0;
        END_IF;
    ELSE
        IF nivValor < stpFaixa2 THEN
            iNec := 1;
        END_IF;
    END_IF;
ELSE
    (* operacao de emergencia pelas boias *)
    IF boiaH THEN
        iNec := 2;
        uTempoBoia := UINT_TO_UDINT(cfgTempoFalhaBoiaL) * 60;
    ELSIF iNec > 0 THEN
        IF stsFalhaBoiaL THEN
            IF TICK AND uTempoBoia > 0 THEN
                uTempoBoia := uTempoBoia - 1;
            END_IF;
            IF uTempoBoia = 0 THEN
                iNec := 0;                 (* LSL com defeito: desliga pelo tempo *)
            END_IF;
        ELSIF NOT boiaL THEN
            iNec := 0;                     (* LSL abaixou *)
        END_IF;
    END_IF;
END_IF;
IF iNec = 0 AND oldNec > 0 THEN
    bLiberadoHH := FALSE;                  (* esvaziou: se o HH do Nereda continuar, volta a segurar *)
END_IF;
oldNec := iNec;
stsNecessidade := iNec;

(* ---- 7. Revezamento ---- *)
IF iPrincipal < 1 OR iPrincipal > 3 THEN
    iPrincipal := 1;
END_IF;
IF revSelecao >= 1 AND revSelecao <= 3 THEN
    IF iPrincipal <> INT_TO_UINT(revSelecao) THEN
        iPrincipal := INT_TO_UINT(revSelecao);
        uSegPrincipal := 0;
    END_IF;
END_IF;
(* proxima disponivel depois da principal, na sequencia 1-2-3 *)
iProx := 0;
iCand := iPrincipal;
FOR i := 1 TO 2 DO
    iCand := iCand + 1;
    IF iCand > 3 THEN
        iCand := 1;
    END_IF;
    IF iCand = 1 THEN
        bDisp := disp1;
    ELSIF iCand = 2 THEN
        bDisp := disp2;
    ELSE
        bDisp := disp3;
    END_IF;
    IF bDisp AND iProx = 0 THEN
        iProx := iCand;
    END_IF;
END_FOR;
IF iPrincipal = 1 THEN
    bDispP := disp1; bLigP := lig1; uLimite := UINT_TO_UDINT(stpTempoB1) * 3600;
ELSIF iPrincipal = 2 THEN
    bDispP := disp2; bLigP := lig2; uLimite := UINT_TO_UDINT(stpTempoB2) * 3600;
ELSE
    bDispP := disp3; bLigP := lig3; uLimite := UINT_TO_UDINT(stpTempoB3) * 3600;
END_IF;
IF revSelecao >= 1 AND revSelecao <= 3 THEN
    (* principal fixa: se estiver indisponivel, a proxima assume so enquanto ela estiver fora *)
    IF NOT bDispP AND iProx <> 0 THEN
        iUso := iProx;
    ELSE
        iUso := iPrincipal;
    END_IF;
    uLimite := 0;
ELSE
    IF NOT bDispP AND iProx <> 0 THEN
        iPrincipal := iProx;               (* principal indisponivel: troca na hora *)
        uSegPrincipal := 0;
    ELSE
        IF TICK AND bLigP AND revHabilita AND uLimite > 0 THEN
            uSegPrincipal := uSegPrincipal + 1;
        END_IF;
        IF revHabilita AND uLimite > 0 AND uSegPrincipal >= uLimite AND iProx <> 0 THEN
            iPrincipal := iProx;           (* venceu o tempo da principal *)
            uSegPrincipal := 0;
        END_IF;
    END_IF;
    iUso := iPrincipal;
    IF NOT revHabilita THEN
        uLimite := 0;
    ELSIF iPrincipal = 1 THEN
        uLimite := UINT_TO_UDINT(stpTempoB1) * 3600;
    ELSIF iPrincipal = 2 THEN
        uLimite := UINT_TO_UDINT(stpTempoB2) * 3600;
    ELSE
        uLimite := UINT_TO_UDINT(stpTempoB3) * 3600;
    END_IF;
END_IF;
(* 2a bomba: proxima disponivel depois da principal em uso *)
iSeg := 0;
iCand := iUso;
FOR i := 1 TO 2 DO
    iCand := iCand + 1;
    IF iCand > 3 THEN
        iCand := 1;
    END_IF;
    IF iCand = 1 THEN
        bDisp := disp1;
    ELSIF iCand = 2 THEN
        bDisp := disp2;
    ELSE
        bDisp := disp3;
    END_IF;
    IF bDisp AND iSeg = 0 THEN
        iSeg := iCand;
    END_IF;
END_FOR;
stsPrincipal := iUso;
stsSegunda := iSeg;
IF uLimite > uSegPrincipal THEN
    uResta := uLimite - uSegPrincipal;
ELSE
    uResta := 0;
END_IF;
stsRestanteHor := UDINT_TO_UINT(uResta / 3600);
stsRestanteMin := UDINT_TO_UINT((uResta MOD 3600) / 60);
stsRestanteSeg := UDINT_TO_UINT(uResta MOD 60);

(* ---- 8. Comandos ---- *)
cmdLiga1 := (iNec >= 1 AND iUso = 1) OR (iNec >= 2 AND iSeg = 1);
cmdLiga2 := (iNec >= 1 AND iUso = 2) OR (iNec >= 2 AND iSeg = 2);
cmdLiga3 := (iNec >= 1 AND iUso = 3) OR (iNec >= 2 AND iSeg = 3);

(* ---- 9. Velocidade ---- *)
pidModo := pidHabilita AND NOT stsModoBoias AND iNec > 0 AND bAlgumaLigada;
pidPreset := pidMinimo;
IF pidHabilita AND NOT stsModoBoias THEN
    IF pidModo THEN
        stpVelocidade := pidSaida;
    ELSE
        stpVelocidade := pidMinimo;        (* partida pela velocidade minima; o PID assume com a bomba ligada *)
    END_IF;
ELSE
    stpVelocidade := pidMaximo;            (* PID desabilitado ou operacao pelas boias *)
END_IF;
stsSaidaPID := pidSaida;

(* ---- 10. Status e alarmes ---- *)
stsBoiaL := boiaL;
stsBoiaH := boiaH;
stsBufferHH := bufferHH;
stsNivel := nivValor;
almRecalque := stsFalhaRecalque;
almNivelAlto := boiaH;
almFalhaBoiaL := stsFalhaBoiaL;
stsAlarme := almRecalque OR almNivelAlto OR almFalhaBoiaL;
IF emergencia THEN
    stsEstado := 7;
ELSIF stsFalhaRecalque THEN
    stsEstado := 4;
ELSIF stsNivelBaixo THEN
    stsEstado := 5;
ELSIF NOT necHabilita THEN
    stsEstado := 6;
ELSIF stsSegurandoBuffer THEN
    stsEstado := 2;
ELSIF stsModoBoias THEN
    stsEstado := 3;
ELSIF iNec > 0 THEN
    stsEstado := 1;
ELSE
    stsEstado := 0;
END_IF;

(* ---- 11. Eventos so na mudanca ---- *)
wCmd := 0;
IF cmdLiga1 THEN wCmd := wCmd OR 16#0001; END_IF;
IF cmdLiga2 THEN wCmd := wCmd OR 16#0002; END_IF;
IF cmdLiga3 THEN wCmd := wCmd OR 16#0004; END_IF;
IF ilkGeral THEN wCmd := wCmd OR 16#0008; END_IF;
IF emergencia THEN wCmd := wCmd OR 16#0010; END_IF;
CNF_CMD := initPass OR (wCmd <> oldCmd) OR (stpVelocidade <> oldVel);
CNF_PID := initPass OR (pidModo <> oldPidModo) OR (pidPreset <> oldPreset);
CNF_INIBE := initPass OR (inibePressao <> oldInibe);
wSts := 0;
IF stsSegurandoBuffer THEN wSts := wSts OR 16#0001; END_IF;
IF stsModoBoias       THEN wSts := wSts OR 16#0002; END_IF;
IF stsFalhaRecalque   THEN wSts := wSts OR 16#0004; END_IF;
IF stsAlarme          THEN wSts := wSts OR 16#0008; END_IF;
uInfo := iNec + stsBombasLigadas * 16 + iUso * 256 + iSeg * 4096;
CNF := initPass OR (wSts <> oldSts) OR (iNec <> (oldInfo MOD 16)) OR (stsBombasLigadas <> ((oldInfo / 16) MOD 16));
wHmi := wSts;
IF stsFalhaBoiaL  THEN wHmi := wHmi OR 16#0010; END_IF;
IF stsNivelBaixo  THEN wHmi := wHmi OR 16#0020; END_IF;
IF boiaL          THEN wHmi := wHmi OR 16#0040; END_IF;
IF boiaH          THEN wHmi := wHmi OR 16#0080; END_IF;
IF bufferHH       THEN wHmi := wHmi OR 16#0100; END_IF;
CNF_HMI := initPass OR (wHmi <> oldHmi) OR (uInfo <> oldInfo) OR (stsEstado <> oldEstado) OR (nivValor <> oldNivel)
           OR (pidSaida <> oldSaida) OR (stpVelocidade <> oldVel) OR (uResta <> oldResta);
wAlm := 0;
IF almRecalque   THEN wAlm := wAlm OR 16#0001; END_IF;
IF almNivelAlto  THEN wAlm := wAlm OR 16#0002; END_IF;
IF almFalhaBoiaL THEN wAlm := wAlm OR 16#0004; END_IF;
CNF_ALM := initPass OR (wAlm <> oldAlm);
wCom := 0;
IF falhaCom1 THEN wCom := wCom OR 16#0001; END_IF;
IF falhaCom2 THEN wCom := wCom OR 16#0002; END_IF;
IF falhaCom3 THEN wCom := wCom OR 16#0004; END_IF;
CNF_COM := initPass OR REQ_ATV OR (wCom <> oldCom);   (* a cada leitura: tambem republica depois do INIT do publicador *)
oldCmd := wCmd;
oldVel := stpVelocidade;
oldPidModo := pidModo;
oldPreset := pidPreset;
oldInibe := inibePressao;
oldSts := wSts;
oldHmi := wHmi;
oldInfo := uInfo;
oldEstado := stsEstado;
oldNivel := nivValor;
oldSaida := pidSaida;
oldResta := uResta;
oldAlm := wAlm;
oldCom := wCom;

initPass := FALSE;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>