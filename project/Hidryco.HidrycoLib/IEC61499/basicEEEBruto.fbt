<FBType GUID="e14d74a2-b12c-4091-96f7-9c4c77b6d7ba" Comment="Logica unica da elevatoria de esgoto bruto (3 bombas, 2 operando + 1 reserva)" Name="basicEEEBruto" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.2" Author="Hidryco" Date="14/10/2026" Remarks="1.2: emergencia do PCM NF. 1.1: emergencia do painel e falha de comunicacao dos ATV630. 1.0: faixas de nivel, revezamento por tempo, PID de velocidade, HH do Nereda, operacao pelas boias, falha de recalque" />
