      <VarDeclaration ID="665448845ED3554E" Name="stpTempoB2" Type="UINT" Comment="IHM: horas da bomba 2 como principal antes da troca; 0 = sem troca por tempo (STP_TEMPO_B2)" />
      <VarDeclaration ID="06814213D61A9713" Name="stpTempoB3" Type="UINT" Comment="IHM: horas da bomba 3 como principal antes da troca; 0 = sem troca por tempo (STP_TEMPO_B3)" />
