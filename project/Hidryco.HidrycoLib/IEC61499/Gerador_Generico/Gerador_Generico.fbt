<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="5f9304dd-53d5-4c3a-a384-d08c3d2f6b97" Name="Gerador_Generico" Format="2.0" Comment="Grupo gerador com DEIF AGC 150 - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Attribute Name="HMI.Alias" Value="" />
  <Attribute Name="Configuration.FB.IDCounter" Value="6" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.1" Author="Hidryco" Date="15/10/2026" Remarks="1.1: comandos basicos da IHM (automatico, semiautomatico, partir e parar so em semiautomatico, reconhecer alarmes do AGC) nas palavras de comando 5 e 6 do AGC, publicadas em ${PATH}agcCmd5 e ${PATH}agcCmd6 (INT) para um MODBUSWREG2 no endereco 5; pulso de cfgTempoComando s, depois as palavras voltam a 0. 1.0: grupo gerador com controlador DEIF AGC 150 (aplicacao GEN, QTA com GB e MB). Leitura Modbus TCP FC04 pela configuracao de hardware (MODBUSGENTCPS + 9 MODBUSRREG8: 501, 513, 521, 536, 554, 567, 593, 1005, 1013); os registradores sao publicados nos symlinks ${PATH}rVAB ... ${PATH}rW1020 (INT) e o connStatusInt em ${PATH}comInt. Enderecos e escalas da tabela DEIF rev. S (software 1.19). " />
  <InterfaceList>
    <EventInputs>
      <Event ID="7928A75A5088ACBD" Name="E_RESET_FALHAS" Comment="Reconhecimento pelo processo com cmdResetFalhas = TRUE">
        <With Var="cmdResetFalhas" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="B61E80D27D776DFC" Name="CNF" Comment="Valores e estados (so na mudanca)">
