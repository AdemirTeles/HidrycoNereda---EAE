      <VarDeclaration ID="A410B91E1EF5ABA2" Name="cfgTempoCom" Type="UINT" InitialValue="10" Comment="Tempo (s) sem comunicacao com o AGC 150 para confirmar a falha" />
      <VarDeclaration ID="1B81B60F03D017E8" Name="cfgTempoComando" Type="UINT" InitialValue="2" Comment="Tempo (s) que a palavra de comando fica escrita no AGC" />
