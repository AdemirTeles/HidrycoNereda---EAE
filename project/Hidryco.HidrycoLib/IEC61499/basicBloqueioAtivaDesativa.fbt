<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="498ac585-d1a5-4b9c-9766-587646460e87" Name="basicBloqueioAtivaDesativa" Comment="Basic Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Version="0.0" Author=" " Date="02/03/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event ID="21F55DF80FB38702" Name="REQ">
        <With Var="cmdHabilita" />
        <With Var="stsSensorHabilitado" />
        <With Var="stsFalhaSensor" />
        <With Var="stsSensor" />
        <With Var="stpAtivaBloqueio" />
        <With Var="stpDesativaBloqueio" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="9A683898C46F5B59" Name="CNF">
        <With Var="stsBloqueio" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="cmdHabilita" Type="BOOL" />
      <VarDeclaration Name="stsSensorHabilitado" Type="BOOL" />
      <VarDeclaration Name="stsFalhaSensor" Type="BOOL" />
      <VarDeclaration Name="stsSensor" Type="REAL" />
      <VarDeclaration Name="stpAtivaBloqueio" Type="REAL" />
      <VarDeclaration Name="stpDesativaBloqueio" Type="REAL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="stsBloqueioAutomatico" Name="stsBloqueio" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="7197abd0-b922-4ddd-8be5-832938fb5ed8">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="algREQ" />
    <InternalVars>
      <VarDeclaration ID="C05B7820A221C00D" Name="bBloqueioNivel" Type="BOOL" />
      <VarDeclaration ID="409D44FE31DBA2A8" Name="bBloqueioAnt" Type="BOOL" />
      <VarDeclaration ID="6DE1117F0C1F1C73" Name="bMudou" Type="BOOL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="1640.941" y="517.4117" />
      <ECState Name="AVALIA" x="1708" y="916">
        <ECAction Algorithm="algREQ" />
      </ECState>
      <ECState Name="NOTIFICA" x="1804" y="1416">
        <ECAction Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="AVALIA" Condition="REQ" x="1757.344" y="704.2627">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="441.2086,162.7694,445.3336,187.2881" />
      </ECTransition>
      <ECTransition Source="AVALIA" Destination="NOTIFICA" Condition="bMudou" x="1821.425" y="1189.171">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="457.0625,284.993,461.0282,313.4543" />
      </ECTransition>
      <ECTransition Source="AVALIA" Destination="START" Condition="1" x="1673.292" y="791.7058">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="420.6801,216.4358,416.5551,191.9171" />
      </ECTransition>
      <ECTransition Source="NOTIFICA" Destination="AVALIA" Condition="1" x="1685.213" y="1151.923">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="419.2781,300.098,415.1647,273.5172" />
      </ECTransition>
    </ECC>
    <Algorithm ID="d0c70da0-b32e-446f-8096-a543214e47e5" Name="algREQ">
      <ST><![CDATA[bBloqueioAnt := stsBloqueio;

IF NOT cmdHabilita THEN
    (* bloqueio desabilitado *)
    stsBloqueio := FALSE;

ELSIF NOT stsSensorHabilitado OR stsFalhaSensor THEN
    (* sensor indisponível *)
    stsBloqueio := TRUE;

ELSIF stpAtivaBloqueio = stpDesativaBloqueio THEN
    (* setpoints iguais: configuração inválida *)
    stsBloqueio := TRUE;

ELSIF stpAtivaBloqueio < stpDesativaBloqueio THEN
    (* nível baixo *)
    IF stsSensor < stpAtivaBloqueio THEN
        bBloqueioNivel := TRUE;
    ELSIF stsSensor >= stpDesativaBloqueio THEN
        bBloqueioNivel := FALSE;
    END_IF;
    stsBloqueio := bBloqueioNivel;

ELSE
    (* nível alto *)
    IF stsSensor > stpAtivaBloqueio THEN
        bBloqueioNivel := TRUE;
    ELSIF stsSensor <= stpDesativaBloqueio THEN
        bBloqueioNivel := FALSE;
    END_IF;
    stsBloqueio := bBloqueioNivel;
END_IF;

bMudou := (stsBloqueio <> bBloqueioAnt);
;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>