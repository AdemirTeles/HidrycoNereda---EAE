<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="7f193c0c-a565-4e5f-ba34-271c153d5803" Name="basicEscalonamento" Comment="Basic Function Block Type" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="1/29/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Comment="Normal Execution Request">
        <With Var="stsSensorBruto" />
        <With Var="cmdHabilitaSensor" />
        <With Var="stpRangeMaximo" />
        <With Var="stpRangeMinimo" />
      </Event>
      <Event Name="E_RESET_FALHA">
        <With Var="cmdReset" />
      </Event>
      <Event Name="END_DELAY" />
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="stsFalhaSensor" />
        <With Var="stsSensorEscalonado" />
      </Event>
      <Event Name="START_DELAY" />
      <Event ID="4C6B42B2888B4333" Name="STOP_DELAY" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="cmdHabilitaSensor" Type="BOOL" />
      <VarDeclaration Name="stsSensorBruto" Type="INT" Comment="Input event qualifier" />
      <VarDeclaration Name="stpRangeMaximo" Type="REAL" />
      <VarDeclaration Name="stpRangeMinimo" Type="REAL" />
      <VarDeclaration ID="28C4AFA85E501AD7" Name="cmdReset" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="stsSensorEscalonado" Type="REAL" />
      <VarDeclaration Name="stsFalhaSensor" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB ID="73987586-d8c3-4512-a7ff-6d007ddd4a24">
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ" />
    <InternalVars>
      <VarDeclaration ID="535E4E2401792ACE" Name="bTimerAtivo" Type="BOOL" />
      <VarDeclaration ID="39DE10BD3377CE30" Name="bForaFaixa" Type="BOOL" />
      <VarDeclaration ID="E1AA8835EFF0F897" Name="bFalhaAnt" Type="BOOL" />
      <VarDeclaration ID="7760B85456C33CEE" Name="rValorAnt" Type="REAL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="1500.941" y="641.4117" />
      <ECState Name="EXEC" x="1504" y="1092">
        <ECAction Algorithm="REQ" Output="STOP_DELAY" />
        <ECAction Output="START_DELAY" />
        <ECAction Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="EXEC" Condition="REQ OR E_RESET_FALHA OR END_DELAY" x="1585.253" y="866.1967">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="400.5191,202.0807,400.715,230.9327" />
      </ECTransition>
      <ECTransition Source="EXEC" Destination="START" Condition="1" x="1502.388" y="941.7058">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="375.7156,256.1024,375.5197,227.2505" />
      </ECTransition>
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[(* ---- Zera eventos de saída: só sai o que for ligado abaixo ---- *)
STOP_DELAY  := FALSE;
START_DELAY := FALSE;
CNF         := FALSE;

bFalhaAnt := stsFalhaSensor;
rValorAnt := stsSensorEscalonado;

IF NOT cmdHabilitaSensor THEN
    (* ---- Sensor desabilitado: zera tudo ---- *)
    stsSensorEscalonado := 0.0;
    stsFalhaSensor      := FALSE;
    STOP_DELAY          := bTimerAtivo;
    bTimerAtivo         := FALSE;

ELSE
    (* ---- Sinal fora da faixa 4-20 mA ---- *)
    bForaFaixa := (stsSensorBruto < 3900) OR (stsSensorBruto > 20100);

    (* ---- Fim do tempo: confirma a falha se ainda fora ---- *)
    IF END_DELAY AND bTimerAtivo THEN
        bTimerAtivo := FALSE;
        IF bForaFaixa THEN
            stsFalhaSensor := TRUE;
        END_IF;
    END_IF;

    (* ---- Reset: só zera se o sinal já voltou à faixa ---- *)
    IF E_RESET_FALHA AND cmdReset AND stsFalhaSensor AND NOT bForaFaixa THEN
        stsFalhaSensor := FALSE;
    END_IF;

    (* ---- Temporizador ---- *)
    IF bForaFaixa AND NOT stsFalhaSensor AND NOT bTimerAtivo THEN
        START_DELAY := TRUE;        (* inicia contagem de 5 s *)
        bTimerAtivo := TRUE;
    ELSIF NOT bForaFaixa AND bTimerAtivo THEN
        STOP_DELAY  := TRUE;        (* sinal voltou: cancela *)
        bTimerAtivo := FALSE;
    END_IF;

    (* ---- Valor ---- *)
    IF stsFalhaSensor THEN
        stsSensorEscalonado := 0.0;
    ELSE
        stsSensorEscalonado := (INT_TO_REAL(stsSensorBruto) - 4000.0)
                               * (stpRangeMaximo - stpRangeMinimo) / 16000.0
                               + stpRangeMinimo;
        (* limita entre mínimo e máximo *)
        IF stpRangeMaximo >= stpRangeMinimo THEN
            IF stsSensorEscalonado < stpRangeMinimo THEN stsSensorEscalonado := stpRangeMinimo; END_IF;
            IF stsSensorEscalonado > stpRangeMaximo THEN stsSensorEscalonado := stpRangeMaximo; END_IF;
        ELSE
            IF stsSensorEscalonado > stpRangeMinimo THEN stsSensorEscalonado := stpRangeMinimo; END_IF;
            IF stsSensorEscalonado < stpRangeMaximo THEN stsSensorEscalonado := stpRangeMaximo; END_IF;
        END_IF;
    END_IF;
END_IF;

(* ---- Notifica só se mudou ---- *)
CNF := (stsSensorEscalonado <> rValorAnt) OR (stsFalhaSensor <> bFalhaAnt);
;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>