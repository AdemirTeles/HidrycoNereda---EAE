<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="452b06fd-79ba-43ed-9c8e-67a1430e6c52" Name="basicAguaReuso" Comment="Logica unica da agua de reuso (PIT-01/02, boia LSL-01, comunicacao)" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.2" Author="Hidryco" Date="15/10/2026" Remarks="1.2: sai o MGE (vira instancia propria no ETE_TJ). 1.0: monitoracao da agua de reuso - niveis 1000-PIT-01/02, boia 1000-LSL-01 e comunicacao das remotas 1/2 da Subestacao" />
  <InterfaceList>
    <EventInputs>
      <Event ID="1F2574A6F30133E3" Name="INIT" Comment="Inicializacao">
        <With Var="cfgTempoBoia" />
        <With Var="cfgBoiaInvertida" />
        <With Var="cfgTempoCom" />
      </Event>
      <Event ID="B449598857AB2011" Name="REQ_S1" Comment="PIT_1000_01">
        <With Var="s1Valor" />
        <With Var="s1Porc" />
        <With Var="s1Hab" />
        <With Var="s1Falha" />
        <With Var="s1FalhaMem" />
        <With Var="s1HH" />
        <With Var="s1H" />
        <With Var="s1L" />
        <With Var="s1LL" />
      </Event>
      <Event ID="25FCE411FF203199" Name="REQ_S2" Comment="PIT_1000_02">
        <With Var="s2Valor" />
        <With Var="s2Porc" />
        <With Var="s2Hab" />
        <With Var="s2Falha" />
        <With Var="s2FalhaMem" />
        <With Var="s2HH" />
        <With Var="s2H" />
        <With Var="s2L" />
        <With Var="s2LL" />
      </Event>
      <Event ID="299D414224484D8E" Name="REQ_BOIA" Comment="Boia 1000-LSL-01">
        <With Var="boia" />
      </Event>
      <Event ID="AF9BA5F5EA0D0DE5" Name="REQ_COM" Comment="Comunicacao das remotas">
