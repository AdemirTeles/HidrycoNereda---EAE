<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="3af978b7-e4d2-5fe1-b398-fb9c07f1a450" Name="EstocagemLodo" Comment="Estocagem do lodo (900): tanques TQ-01/02 (LIT), sopradores SO-01/02, valvulas VA-01/02 e VB-03/04 - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.2" Author="Hidryco" Date="04/11/2026" Remarks="1.2: CNF_NEREDA com H/HH (com tempo, sem memoria) e disponivel dos LIT-900-01/02 para os SludgeHoldingTank1/2 da Nereda; sai na mudanca e a cada 5 s (TickNereda). 1.1: SO sem supervisao de termica (sem sinal no PCE); STP_VEL_SOPRADORES (Hz) no REQ_PARA -> stpVelocidadeAutomatico dos SO. 1.0: divisao da Fase_Solida 1.5 como no legado (estocagem). Sem simbolos proprios: o resumo e os faceplates ficam na DesidratacaoLodo, que recebe CNF_HMI e devolve REQ_PARA, ACK_ALARMES e REQ_EMERG pela camada." />
  <InterfaceList>
    <EventInputs>
      <Event ID="DAB96FE935A92679" Name="E_RESET_FALHAS" Comment="Reset pelo processo (estocagem e equipamentos) com cmdResetFalhas = TRUE">
        <With Var="cmdResetFalhas" />
      </Event>
      <Event ID="39F3DF7DDD7B4C23" Name="REQ_PARA" Comment="DesidratacaoLodo (IHM): ajustes da estocagem">
        <With Var="HAB_SOPRADORES" />
        <With Var="STP_NIVEL_MIN_TQ" />
        <With Var="STP_NIVEL_RETOMA_TQ" />
        <With Var="STP_VEL_SOPRADORES" />
      </Event>
      <Event ID="AB5FAE61D1BCDDFE" Name="REQ_EMERG" Comment="DesidratacaoLodo: emergencia do PCM LODO">
        <With Var="emergencia" />
      </Event>
      <Event ID="4FA8CBCB1032FBD8" Name="ACK_ALARMES" Comment="DesidratacaoLodo (IHM): reconhecer os alarmes da estocagem" />
    </EventInputs>
    <EventOutputs>
      <Event ID="E3809710B35A5BE3" Name="CNF" Comment="Tanques em nivel baixo (suspende as bombas da DesidratacaoLodo)">
        <With Var="stsNivelBaixoTQ" />
      </Event>
      <Event ID="974B4969DB603762" Name="CNF_HMI" Comment="Status dos sopradores e tanques para o resumo da DesidratacaoLodo">
        <With Var="STS_SO_ATIVO" />
        <With Var="STS_SO_TRANSFERINDO" />
        <With Var="STS_SO_HORAS_ATUAL" />
        <With Var="STS_SEM_SOPRADOR" />
        <With Var="STS_NIVEL_TQ" />
        <With Var="STS_NIVEL_BAIXO_TQ" />
        <With Var="STS_SEM_NIVEL_TQ" />
        <With Var="STS_ALM_SOPRADORES_EST" />
        <With Var="STS_ALM_NIVEL_TQ_EST" />
      </Event>
      <Event ID="3B317909428F66BD" Name="CNF_NEREDA" Comment="Nivel dos tanques para a Nereda (SludgeHoldingTank1/2): na mudanca e a cada 5 s">
        <With Var="TQ1_HH" />
        <With Var="TQ1_H" />
        <With Var="TQ1_DISPONIVEL" />
        <With Var="TQ2_HH" />
        <With Var="TQ2_H" />
        <With Var="TQ2_DISPONIVEL" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="24CD1B2317618B18" Name="cmdResetFalhas" Type="BOOL" Comment="TRUE = reset (com o evento E_RESET_FALHAS)" />
      <VarDeclaration ID="E59CBDC75C3131D4" Name="HAB_SOPRADORES" Type="BOOL" Comment="Da DesidratacaoLodo (IHM): HAB_SOPRADORES" />
      <VarDeclaration ID="8E87331950BD000E" Name="STP_NIVEL_MIN_TQ" Type="REAL" Comment="Da DesidratacaoLodo (IHM): STP_NIVEL_MIN_TQ" />
      <VarDeclaration ID="3B31F82669E06299" Name="STP_NIVEL_RETOMA_TQ" Type="REAL" Comment="Da DesidratacaoLodo (IHM): STP_NIVEL_RETOMA_TQ" />
      <VarDeclaration ID="EE49B187C469C0B7" Name="emergencia" Type="BOOL" Comment="Emergencia do PCM LODO" />
      <VarDeclaration ID="A8767255ECC4E3FD" Name="STP_VEL_SOPRADORES" Type="REAL" InitialValue="60.0" Comment="Da DesidratacaoLodo (IHM): velocidade dos sopradores no automatico (Hz)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="5405EB7088EC4BDE" Name="stsNivelBaixoTQ" Type="BOOL" Comment="Tanques de estocagem em nivel baixo" />
      <VarDeclaration ID="649314760363E488" Name="STS_SO_ATIVO" Type="INT" Comment="Para a DesidratacaoLodo (IHM): STS_SO_ATIVO" />
      <VarDeclaration ID="B87FCF9EF6E17A10" Name="STS_SO_TRANSFERINDO" Type="BOOL" Comment="Para a DesidratacaoLodo (IHM): STS_SO_TRANSFERINDO" />
      <VarDeclaration ID="273D781A989DEA3F" Name="STS_SO_HORAS_ATUAL" Type="INT" Comment="Para a DesidratacaoLodo (IHM): STS_SO_HORAS_ATUAL" />
      <VarDeclaration ID="0D2CE8145A8A40C5" Name="STS_SEM_SOPRADOR" Type="BOOL" Comment="Para a DesidratacaoLodo (IHM): STS_SEM_SOPRADOR" />
      <VarDeclaration ID="E7A1F2C70FD2876B" Name="STS_NIVEL_TQ" Type="REAL" Comment="Para a DesidratacaoLodo (IHM): STS_NIVEL_TQ" />
      <VarDeclaration ID="5C0EE27FAC026E42" Name="STS_NIVEL_BAIXO_TQ" Type="BOOL" Comment="Para a DesidratacaoLodo (IHM): STS_NIVEL_BAIXO_TQ" />
      <VarDeclaration ID="28C5117F80A71252" Name="STS_SEM_NIVEL_TQ" Type="BOOL" Comment="Para a DesidratacaoLodo (IHM): STS_SEM_NIVEL_TQ" />
      <VarDeclaration ID="F39C9B782425030B" Name="STS_ALM_SOPRADORES_EST" Type="USINT" Comment="Para a DesidratacaoLodo (IHM): STS_ALM_SOPRADORES_EST" />
      <VarDeclaration ID="CA5C991A51FB83CF" Name="STS_ALM_NIVEL_TQ_EST" Type="USINT" Comment="Para a DesidratacaoLodo (IHM): STS_ALM_NIVEL_TQ_EST" />
      <VarDeclaration ID="E2CA55FAEBB4E606" Name="TQ1_HH" Type="BOOL" Comment="TQ-01 (LIT-900-01): alarme HH com tempo, sem memoria - para o SludgeHoldingTank1 da Nereda" />
      <VarDeclaration ID="5FECFF6590BA1CB8" Name="TQ1_H" Type="BOOL" Comment="TQ-01 (LIT-900-01): alarme H com tempo, sem memoria - para o SludgeHoldingTank1 da Nereda" />
      <VarDeclaration ID="C03F8F23B8219B89" Name="TQ1_DISPONIVEL" Type="BOOL" Comment="TQ-01 (LIT-900-01): nivel disponivel (sensor habilitado e sem falha) - para o SludgeHoldingTank1 da Nereda" />
      <VarDeclaration ID="47DA0D3EDA2667D7" Name="TQ2_HH" Type="BOOL" Comment="TQ-02 (LIT-900-02): alarme HH com tempo, sem memoria - para o SludgeHoldingTank2 da Nereda" />
      <VarDeclaration ID="5EDEC437D5610CDE" Name="TQ2_H" Type="BOOL" Comment="TQ-02 (LIT-900-02): alarme H com tempo, sem memoria - para o SludgeHoldingTank2 da Nereda" />
      <VarDeclaration ID="D43E44FA212AEC2C" Name="TQ2_DISPONIVEL" Type="BOOL" Comment="TQ-02 (LIT-900-02): nivel disponivel (sensor habilitado e sem falha) - para o SludgeHoldingTank2 da Nereda" />
    </OutputVars>
  </InterfaceList>
