<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="cd66cc86-31ed-51c3-9a0a-7da15d055844" Name="DesidratacaoLodo" Comment="Desidratacao do lodo (900): alimentacao das prensas C-Press, bombas, barrilete, polimero e painel PCM LODO - HidrycoLib" Namespace="Hidryco.HidrycoLib">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Hidryco" Version="1.2" Author="Hidryco" Date="04/11/2026" Remarks="Revisao 04/11/2026: BR sem supervisao de termica; STP_VEL_SOPRADORES para a EstocagemLodo; FT stsHabilitado na Alimentacao. 1.1: SV_900_01..08 como sub-CATs Valvula_Solenoide (caminho do legado para a IO List da Nereda), ligadas ao CNF_SV da Alimentacao. 1.0: divisao da Fase_Solida 1.5 como no legado: DesidratacaoLodo (prensas, bombas BO/BR, barrilete VA-06..13, FT, SV, PP, painel PCM) + EstocagemLodo (tanques, sopradores, VA-01/02, VB-03/04). O resumo e os faceplates continuam aqui; a estocagem troca status, ajustes, reset e emergencia com a EstocagemLodo pela camada." />
  <InterfaceList>
    <EventInputs>
      <Event ID="DAB96FE935A92679" Name="E_RESET_FALHAS" Comment="Reset pelo processo (desidratacao e equipamentos) com cmdResetFalhas = TRUE">
        <With Var="cmdResetFalhas" />
      </Event>
      <Event ID="91E17855232378A8" Name="REQ_ESTOCAGEM" Comment="EstocagemLodo: status dos sopradores e tanques para a IHM (resumo)">
        <With Var="STS_SO_ATIVO" />
        <With Var="STS_SO_TRANSFERINDO" />
        <With Var="STS_SO_HORAS_ATUAL" />
        <With Var="STS_SEM_SOPRADOR" />
        <With Var="STS_NIVEL_TQ" />
        <With Var="STS_NIVEL_BAIXO_TQ" />
        <With Var="STS_SEM_NIVEL_TQ" />
        <With Var="STS_ALM_SOPRADORES_EST" />
        <With Var="STS_ALM_NIVEL_TQ_EST" />
      </Event>
      <Event ID="335836E160C77742" Name="REQ_TQ" Comment="EstocagemLodo: tanques em nivel baixo (suspende as bombas)">
        <With Var="tqNivelBaixo" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="D64A39BCF02DDEB2" Name="CNF" Comment="Status (emergencia do PCM LODO vai para a EstocagemLodo)">
        <With Var="stsEmergencia" />
        <With Var="stsAlarme" />
      </Event>
      <Event ID="EA9A2427D178E8B5" Name="CNF_PARA_ESTOCAGEM" Comment="IHM: ajustes da estocagem para a EstocagemLodo">
        <With Var="HAB_SOPRADORES" />
        <With Var="STP_NIVEL_MIN_TQ" />
        <With Var="STP_NIVEL_RETOMA_TQ" />
        <With Var="STP_VEL_SOPRADORES" />
      </Event>
      <Event ID="EE8958653A86D261" Name="ACK_ESTOCAGEM" Comment="IHM: reconhecer os alarmes da EstocagemLodo" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="24CD1B2317618B18" Name="cmdResetFalhas" Type="BOOL" Comment="TRUE = reset (com o evento E_RESET_FALHAS)" />
      <VarDeclaration ID="AC99B8EE5C6DBA64" Name="STS_SO_ATIVO" Type="INT" Comment="Da EstocagemLodo (IHM): STS_SO_ATIVO" />
      <VarDeclaration ID="D231A14376C3E2F6" Name="STS_SO_TRANSFERINDO" Type="BOOL" Comment="Da EstocagemLodo (IHM): STS_SO_TRANSFERINDO" />
      <VarDeclaration ID="DE00033B699DACF0" Name="STS_SO_HORAS_ATUAL" Type="INT" Comment="Da EstocagemLodo (IHM): STS_SO_HORAS_ATUAL" />
      <VarDeclaration ID="099E44A540EF9490" Name="STS_SEM_SOPRADOR" Type="BOOL" Comment="Da EstocagemLodo (IHM): STS_SEM_SOPRADOR" />
      <VarDeclaration ID="426B37B9A495B79C" Name="STS_NIVEL_TQ" Type="REAL" Comment="Da EstocagemLodo (IHM): STS_NIVEL_TQ" />
      <VarDeclaration ID="FD17B98D889E4E9C" Name="STS_NIVEL_BAIXO_TQ" Type="BOOL" Comment="Da EstocagemLodo (IHM): STS_NIVEL_BAIXO_TQ" />
      <VarDeclaration ID="91FA512D1B0CCA17" Name="STS_SEM_NIVEL_TQ" Type="BOOL" Comment="Da EstocagemLodo (IHM): STS_SEM_NIVEL_TQ" />
      <VarDeclaration ID="18A2A222BB911413" Name="STS_ALM_SOPRADORES_EST" Type="USINT" Comment="Da EstocagemLodo (IHM): STS_ALM_SOPRADORES_EST" />
      <VarDeclaration ID="14561E73765FBECA" Name="STS_ALM_NIVEL_TQ_EST" Type="USINT" Comment="Da EstocagemLodo (IHM): STS_ALM_NIVEL_TQ_EST" />
      <VarDeclaration ID="1CD77F0C67EACF01" Name="tqNivelBaixo" Type="BOOL" Comment="Da EstocagemLodo: tanques em nivel baixo" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="317BB96205F3F911" Name="stsEmergencia" Type="BOOL" Comment="Emergencia do PCM LODO" />
      <VarDeclaration ID="2462DCD097711319" Name="stsAlarme" Type="BOOL" Comment="Algum alarme da alimentacao/painel" />
      <VarDeclaration ID="A2D8149F0FE69321" Name="HAB_SOPRADORES" Type="BOOL" Comment="Para a EstocagemLodo: HAB_SOPRADORES" />
      <VarDeclaration ID="08464482A0BF6120" Name="STP_NIVEL_MIN_TQ" Type="REAL" Comment="Para a EstocagemLodo: STP_NIVEL_MIN_TQ" />
      <VarDeclaration ID="4080C84A5DF2BAE8" Name="STP_NIVEL_RETOMA_TQ" Type="REAL" Comment="Para a EstocagemLodo: STP_NIVEL_RETOMA_TQ" />
      <VarDeclaration ID="9DCD88E1901DA328" Name="STP_VEL_SOPRADORES" Type="REAL" Comment="Para a EstocagemLodo: velocidade dos sopradores no automatico (Hz)" />
    </OutputVars>
  </InterfaceList>
