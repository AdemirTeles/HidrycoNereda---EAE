<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="02af2d1a-3c90-4949-ae51-718d11cd24af" Name="PIDBase" Format="2.0" Comment="Composite Function Block Type" Namespace="Main">
  <Attribute Name="HMI.Alias" Value="" />
  <Attribute Name="Configuration.FB.IDCounter" Value="54" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="1.0.1" Author="ApplicationLibDevTeam" Date="10/18/2023" Remarks="First Version" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ_SP" Comment="Request to update setpoint">
        <With Var="Sp" />
      </Event>
      <Event Name="REQ_PV" Comment="Request to update input value">
        <With Var="Pv" />
        <With Var="PvMin" />
        <With Var="PvMax" />
      </Event>
      <Event Name="REQ_EXT_PARA" Comment="Request to update external PID parameters">
        <With Var="ExtPara" />
      </Event>
      <Event Name="REQ_FEEDFWD" Comment="Request for executing feed forward gain">
        <With Var="FeedFwd" />
      </Event>
      <Event Name="REQ_ILCK" Comment="Request to update interlock conditions">
        <With Var="IlckCond" />
        <With Var="IlckType" />
      </Event>
      <Event Name="REQ_ILCKSP" Comment="Request to update interlock setpoint to PID ouput">
        <With Var="IlckSp" />
      </Event>
      <Event Name="REQ_TRACK" Comment="Request to track PID setpoint with TrackState">
        <With Var="Track" />
        <With Var="TrackSp" />
      </Event>
      <Event ID="FBF5D049D5250326" Name="REQ_RCPY" Comment="Request for actuator position">
        <With Var="EnRcpy" />
        <With Var="RcpyVal" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Comment="Execution confirmation (Cyclic update)">
        <With Var="Out" />
        <With Var="OutMinActive" />
        <With Var="OutMaxActive" />
        <With Var="OutMin" />
        <With Var="OutMax" />
      </Event>
      <Event Name="CNF_SP" Comment="Execution confirmation of current setpoint">
        <With Var="CurrentSp" />
      </Event>
      <Event Name="CNF_MODE" Comment="Execution of confirmation of current mode">
        <With Var="CurrentMode" />
      </Event>
      <Event Name="CNF_OWNER" Comment="Execution confirmation of owner">
        <With Var="CurrentOwner" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Sp" Type="REAL" Comment="Setpoint for PID calculation" />
      <VarDeclaration Name="Pv" Type="VTQREAL" Comment="Unscaled analog process value" />
      <VarDeclaration Name="PvMin" Type="REAL" Comment="Minimum range of process value" />
      <VarDeclaration Name="PvMax" Type="REAL" Comment="Maximum range of process value" />
      <VarDeclaration Name="ExtPara" Type="PIDExternalParameters" Namespace="SE.App2CommonProcess" Comment="External parameters for PID calculation" />
      <VarDeclaration Name="FeedFwd" Type="REAL" Comment="Feed forward value" />
      <VarDeclaration Name="IlckCond" Type="BOOL" Comment="1 = Interlock condition active" />
      <VarDeclaration Name="IlckType" Type="CondType" Namespace="SE.App2CommonProcess" Comment="Type of condition interlock, (0 = Normal, 1 = Process interlock/Sequence interlock)" />
      <VarDeclaration Name="IlckSp" Type="REAL" Comment="Interlock setpoint" />
      <VarDeclaration Name="Track" Type="BOOL" Comment="1 = Track calclated output to TrackSp" />
      <VarDeclaration Name="TrackSp" Type="VTQREAL" Comment="If Track enabled, PID ouput follows TrackSp (Out = TrackSp)" />
      <VarDeclaration ID="79693414AD076668" Name="EnRcpy" Type="BOOL" Comment="1 = the RCPY is enabled" />
      <VarDeclaration ID="3A0AFF2C2D605891" Name="RcpyVal" Type="REAL" Comment="RCPY value (actuator position)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Out" Type="VTQREAL" Comment="Calculated output value" />
      <VarDeclaration Name="OutMin" Type="REAL" Comment="Minimum range of ouput value" />
      <VarDeclaration Name="OutMax" Type="REAL" Comment="Maximum range of ouput value" />
      <VarDeclaration Name="OutMinActive" Type="BOOL" Comment="1 = Out has reached OutMin Limit" />
      <VarDeclaration Name="OutMaxActive" Type="BOOL" Comment="1 = Out has reached OutMax Limit" />
      <VarDeclaration Name="CurrentSp" Type="VTQREAL" Comment="Current setpoint value" />
      <VarDeclaration Name="CurrentMode" Type="INT" Comment="Current mode selected for PID calculation" />
      <VarDeclaration Name="CurrentOwner" Type="WORD" Comment="Current owner data from externlal source and basic owner 16#8 = Program owner, 16#10 = Operator owner, 16#4 = program Local and 16#40 Operator Local" />
    </OutputVars>
    <Sockets>
      <AdapterDeclaration Name="IServiceExtension" Type="IPIDServiceExtension" Namespace="SE.App2CommonProcess" Comment="Services extension adapter(Seq control and Owner)" x="12620" y="660">
        <Parameter Name="$ServiceState" Value="TRUE" />
      </AdapterDeclaration>
    </Sockets>
  </InterfaceList>
