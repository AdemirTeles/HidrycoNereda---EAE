<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="b258bae6-2619-4afc-bfbf-517bd0cce91a" Comment="Composite Function Block Type" Name="MotorVsBase" Format="2.0" Namespace="Main">
  <Attribute Name="HMI.Alias" Value="" />
  <Attribute Name="Configuration.FB.IDCounter" Value="204" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="1.0.1" Author="ApplicationLibDevTeam" Date="2/5/2024" Remarks="First Version" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ_SP" Comment="Request to update setpoint">
        <With Var="Sp" />
      </Event>
      <Event Name="REQ_SPEED_SP">
        <With Var="SpeedSp" />
        <With Var="SpeedSpMin" />
        <With Var="SpeedSpMax" />
      </Event>
      <Event Name="REQ_FB" Comment="Request to update feedbacks">
        <With Var="FbStop" />
        <With Var="FbFwd" />
        <With Var="FbRev" />
      </Event>
      <Event Name="REQ_FB_SPEED">
        <With Var="FbSpeed" />
      </Event>
      <Event Name="REQ_PERM" Comment="Request to update permissive conditions">
        <With Var="PermStop" />
        <With Var="PermFwd" />
        <With Var="PermRev" />
      </Event>
      <Event Name="REQ_ILCK" Comment="Request to update interlock conditions">
        <With Var="IlckCond" />
        <With Var="IlckPos" />
        <With Var="IlckType" />
      </Event>
      <Event Name="REQ_ILCK_SPEED">
        <With Var="IlckSpeed" />
      </Event>
      <Event Name="REQ_FAIL" Comment="Request to update out of service and fail status and parameters">
        <With Var="Fail" />
      </Event>
      <Event Name="REQ_DIS_FB_ALM" Comment="Request to disable feedback alarm" />
      <Event Name="REQ_EXT_CTL" Comment="Request External control signal">
        <With Var="ExternalControlled" />
      </Event>
      <Event Name="REQ_SUPPRESS_ALM" Comment="Request to update the alarm suppress status">
        <With Var="SuppressAlarm" />
      </Event>
      <Event Name="REQ_RESET" Comment="Request to reset the device">
        <With Var="Reset" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF_OUT" Comment="Execution of output confirmation">
        <With Var="Out" />
        <With Var="OutFwd" />
        <With Var="OutStop" />
        <With Var="OutRev" />
      </Event>
      <Event Name="CNF_SPEED_OUT" Comment="Execution of apeed output confirmation">
        <With Var="OutSpeed" />
        <With Var="OutSpeedMin" />
        <With Var="OutSpeedMax" />
      </Event>
      <Event Name="CNF_SP" Comment="Execution of confirmation current setpoint">
        <With Var="CurrentSp" />
      </Event>
      <Event Name="CNF_SPEED_SP" Comment="Execution of confirmation current speed setpoint">
        <With Var="CurrentSpeedSp" />
      </Event>
      <Event Name="CNF_FB_STS" Comment="Execution of confirmed state">
        <With Var="FbFwdRunning" />
        <With Var="FbStopped" />
        <With Var="FbStatus" />
        <With Var="FbRevRunning" />
      </Event>
      <Event Name="CNF_FB_SPEED_STS" Comment="Execution of confirmed speed state">
        <With Var="FbSpeedStatus" />
        <With Var="FbSpeedMin" />
        <With Var="FbSpeedMax" />
      </Event>
      <Event Name="CNF_READY" Comment="Execution of ready status">
        <With Var="Ready" />
      </Event>
      <Event Name="CNF_FB_ALM" Comment="Execution of confirmation  Fb alarm">
        <With Var="FbAlarm" />
      </Event>
      <Event Name="CNF_ALM" Comment="Execution of confirmation  alarm conditions">
        <With Var="AlarmStatus" />
      </Event>
      <Event Name="CNF_FAIL" Comment="Execution of confirmation  failure">
        <With Var="FailStatus" />
      </Event>
      <Event Name="CNF_NEED_RESET" Comment="Request for reset">
        <With Var="NeedReset" />
      </Event>
      <Event Name="CNF_MODE" Comment="Excecution of new operational modes">
        <With Var="Simulation" />
        <With Var="FbOverride" />
        <With Var="Maintenance" />
        <With Var="OutOfService" />
      </Event>
      <Event Name="CNF_OWNER" Comment="Execution confirmation of owner">
        <With Var="CurrentOwner" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Sp" Type="INT" Comment="Setpoint of device (0 = Stop, 1 = Run Forward, 2 = Run Reverse)" />
      <VarDeclaration Name="SpeedSp" Type="REAL" Comment="Speed setpoint of device" />
      <VarDeclaration Name="SpeedSpMin" Type="REAL" Comment="Speed setpoint minimum range" />
      <VarDeclaration Name="SpeedSpMax" Type="REAL" Comment="Speed setpoint maximum range" />
      <VarDeclaration Name="FbStop" Type="BOOL" Comment="1 = Device stop feedback incoming" />
      <VarDeclaration Name="FbFwd" Type="BOOL" Comment="1 = Device forward running feedback incoming" />
      <VarDeclaration Name="FbRev" Type="BOOL" Comment="1 = Device reverse running feedback incoming" />
      <VarDeclaration Name="FbSpeed" Type="REAL" Comment="Device speed feedback incoming (Minimum Value  = 0.0, Maximum Value = 100.0)" />
      <VarDeclaration Name="PermStop" Type="BOOL" InitialValue="TRUE" Comment="1 = Device stop permission active" />
      <VarDeclaration Name="PermFwd" Type="BOOL" InitialValue="TRUE" Comment="1 = Device forward run permission active" />
      <VarDeclaration Name="PermRev" Type="BOOL" InitialValue="TRUE" Comment="1 = Device reverse run permission active" />
      <VarDeclaration Name="IlckCond" Type="BOOL" Comment="1 = Interlock condition active" />
      <VarDeclaration Name="IlckPos" Type="INT" Comment="Interlock setpoint state (0 = Stop, 1 = Run Forward, 1 = Run Reverse, 3 = Interlock inactive)" />
      <VarDeclaration Name="IlckType" Type="CondType" Namespace="SE.App2CommonProcess" Comment="Type of condition interlock, (0 = Normal, 1 = Process interlock/Sequence interlock)" />
      <VarDeclaration Name="IlckSpeed" Type="REAL" Comment="Interlock speed setpoint" />
      <VarDeclaration Name="Fail" Type="BOOL" Comment="1 = Failure is active" />
      <VarDeclaration Name="SuppressAlarm" Type="BOOL" Comment="1 = Suppress alarm in HMI" />
      <VarDeclaration Name="ExternalControlled" Type="BOOL" Comment="1 = External control is active" />
      <VarDeclaration Name="Reset" Type="BOOL" Comment="1 = Reset device failure" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Out" Type="INT" Comment="Calculated output of the device ( 0 = Stop command, 1 = Forward Run command,  1 = Reverse Run command)" />
      <VarDeclaration Name="OutStop" Type="BOOL" Comment="1 = Stop output of the device" />
      <VarDeclaration Name="OutFwd" Type="BOOL" Comment="1 = Forward output of the device" />
      <VarDeclaration Name="OutRev" Type="BOOL" Comment="1 = Reverse output of the device" />
      <VarDeclaration Name="OutSpeed" Type="REAL" Comment="Calculated speed output of the device" />
      <VarDeclaration Name="OutSpeedMin" Type="REAL" Comment="Current output speed minimum value" />
      <VarDeclaration Name="OutSpeedMax" Type="REAL" Comment="Current output speed maximum value" />
      <VarDeclaration Name="CurrentSp" Type="INT" Comment="Current output value considering permissive conditions" />
      <VarDeclaration Name="CurrentSpeedSp" Type="REAL" Comment="Current output value" />
      <VarDeclaration Name="FbStatus" Type="INT" Comment="Confirmed state of the device (0 = Stopped, 1 =Running, 253 = Unknown)" />
      <VarDeclaration Name="FbStopped" Type="BOOL" Comment="1 = Stopped" />
      <VarDeclaration Name="FbFwdRunning" Type="BOOL" Comment="1 = Running Forward " />
      <VarDeclaration Name="FbRevRunning" Type="BOOL" Comment="1 = Running Reverse " />
      <VarDeclaration Name="FbSpeedStatus" Type="REAL" Comment="Speed feedback" />
      <VarDeclaration Name="FbSpeedMin" Type="REAL" Comment="Minimum speed setpoint range" />
      <VarDeclaration Name="FbSpeedMax" Type="REAL" Comment="Maximum speed setpoint range" />
      <VarDeclaration Name="Ready" Type="BOOL" Comment="1 = Device is ready to run" />
      <VarDeclaration Name="AlarmStatus" Type="WORD" Comment="Bit 1 = Device failure status, Bit 2 = Feedback failure status" />
      <VarDeclaration Name="FbAlarm" Type="BOOL" Comment="Current output speed minimum value" />
      <VarDeclaration Name="FailStatus" Type="BOOL" Comment="1 = Fail active" />
      <VarDeclaration Name="NeedReset" Type="BOOL" Comment="1 = Device need reset to resume the operation" />
      <VarDeclaration Name="Simulation" Type="BOOL" Comment="1 = Simulation mode is active" />
      <VarDeclaration Name="FbOverride" Type="BOOL" Comment="1 = Feedback overide (Sp = FbStatus)" />
      <VarDeclaration Name="Maintenance" Type="BOOL" Comment="1 = Maintenance mode is active" />
      <VarDeclaration Name="OutOfService" Type="BOOL" Comment="1 = Out of service mode is active" />
      <VarDeclaration Name="CurrentOwner" Type="WORD" Comment="Current owner data from externlal source and basic owner 16#8 = Program owner, 16#10 = Operator owner, 16#4 = program Local and 16#40 Operator Local" />
    </OutputVars>
    <Sockets>
      <AdapterDeclaration Name="IServiceExtension" Type="IServiceExtension" Namespace="SE.App2CommonProcess" Comment="Services extension adapter(Seq control, Local panel, Maintenance and Owner)" x="9900" y="3400">
        <Parameter Name="$ServiceState" Value="TRUE" />
      </AdapterDeclaration>
    </Sockets>
  </InterfaceList>
