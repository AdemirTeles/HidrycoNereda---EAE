<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="59fdd048-5dbc-4d80-9498-68208ab277e9" Comment="Service Interface Function Block Type" Name="ValveBase_HMI" Namespace="Main">
  <Attribute Name="Runtime.Persistence.Storage" Value="0" />
  <Attribute Name="HMI.Alias" Value="" />
  <Attribute Name="Configuration.FB.IDCounter" Value="0" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="1.0.1" Author="ApplicationLibDevTeam" Date="10/17/2023" Remarks="First Version" />
  <InterfaceList>
    <EventInputs>
      <Event ID="34A017503AC1070A" Name="INIT">
        <With Var="QI" />
      </Event>
      <Event ID="F2953B6BB9388F21" Name="REQ_INITDATA" Comment="Request to initialize data" />
      <Event ID="EC791CA6E67D66B3" Name="UPD" Comment="Update data to supervision">
        <With Var="FbStatus" />
        <With Var="TransFbStatus" />
        <With Var="CurrentOp" />
        <With Var="CurrentSp" />
        <With Var="NeedReset" />
        <With Var="CurrentOwner" />
        <With Var="FbFail" />
        <With Var="IlckCond" />
        <With Var="CondPos" />
        <With Var="PermClose" />
        <With Var="PermOpen" />
        <With Var="StdOwnerConnected" />
        <With Var="ExternalControlled" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="377462E9CE5193B5" Name="INITO">
        <With Var="QO" />
        <With Var="STATUS" />
      </Event>
      <Event ID="95BEA68906019444" Name="CFG" Comment="Request for new parameter">
        <With Var="MonTime" />
        <With Var="TripTime" />
        <With Var="ConfResetReq" />
        <With Var="ScanTime" />
        <With Var="AlmAckType" />
        <With Var="EnTrackSp" />
        <With Var="ValveCmdType" />
        <With Var="FbMode" />
      </Event>
      <Event ID="C6CA4032A5F6989A" Name="SP_CMD" Comment="Request fro new operator setpoint">
        <With Var="Sp" />
      </Event>
      <Event ID="1A2B085F4B246BF1" Name="RESET_CMD" Comment="Request  to reset device">
        <With Var="Reset" />
      </Event>
      <Event ID="4711DA9A2DFC024" Name="IND_MODE" Comment="Request for new operational modes">
        <With Var="Simulation" />
        <With Var="FbOverride" />
        <With Var="Maintenance" />
        <With Var="OutOfService" />
      </Event>
      <Event ID="AB45C9C76752120B" Name="OWNER" Comment="Request for New Owner">
        <With Var="Owner" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="A08029BD5BCA0193" Name="QI" Type="BOOL" />
      <VarDeclaration ID="F2AD3CD6DCE76874" Name="FbStatus" Type="INT" Comment="Valve state( 0 = Closed, 1= Opened, 2 = Closed , 253 = Unknown)">
        <Attribute Name="Runtime.Archive.Counters" Value="AbsoluteValues=False" Type="INT" />
        <Attribute Name="Runtime.Archive.Id" Value="0" Type="INT" />
        <Attribute Name="Runtime.History.Depth" Value="100" Type="INT" />
        <Attribute Name="Runtime.History.SmoothTime" Value="60000" Type="INT" />
        <Attribute Name="Runtime.History.SmoothValue" Value="1" Type="INT" />
      </VarDeclaration>
      <VarDeclaration ID="18339E8B84CEF55" Name="TransFbStatus" Type="INT" Comment="Valve transition state( 0 = Closed, 1= Opened, 2 = Closed , 6 = Opening, 7= Closing and 253 = Unknown)">
        <Attribute Name="Runtime.Archive.Counters" Value="AbsoluteValues=False" Type="INT" />
        <Attribute Name="Runtime.Archive.Id" Value="0" Type="INT" />
        <Attribute Name="Runtime.History.Depth" Value="100" Type="INT" />
        <Attribute Name="Runtime.History.SmoothTime" Value="60000" Type="INT" />
        <Attribute Name="Runtime.History.SmoothValue" Value="1" Type="INT" />
      </VarDeclaration>
      <VarDeclaration ID="D2C35BC47DF71FCC" Name="CurrentOp" Type="INT" Comment="Current value of the output">
        <Attribute Name="Runtime.Archive.Counters" Value="AbsoluteValues=False" />
        <Attribute Name="Runtime.Archive.Id" Value="1" />
        <Attribute Name="Runtime.History.Depth" Value="100" />
        <Attribute Name="Runtime.History.SmoothTime" Value="60000" />
        <Attribute Name="Runtime.History.SmoothValue" Value="1" />
      </VarDeclaration>
      <VarDeclaration ID="C6876D790F3A950E" Name="CurrentSp" Type="INT" Comment="Current value of the setpoint">
        <Attribute Name="Runtime.Archive.Counters" Value="AbsoluteValues=False" />
        <Attribute Name="Runtime.Archive.Id" Value="1" />
        <Attribute Name="Runtime.History.Depth" Value="100" />
        <Attribute Name="Runtime.History.SmoothTime" Value="60000" />
        <Attribute Name="Runtime.History.SmoothValue" Value="1" />
      </VarDeclaration>
      <VarDeclaration ID="9CD6749867E91606" Name="NeedReset" Type="BOOL" Comment="1= Device need reset" />
      <VarDeclaration ID="66F5D611520B8E21" Name="CurrentOwner" Type="WORD" Comment="Current Owner status" />
      <VarDeclaration ID="E324EF7311434CB7" Name="FbFail" Type="VTQBOOL" Comment="1=Feedback fail alarm status active" />
      <VarDeclaration ID="CAD2FBF5C8122C72" Name="IlckCond" Type="BOOL" Comment="1= Interlock Active" />
      <VarDeclaration ID="F97E56AEBDD59492" Name="CondPos" Type="INT" Comment="Interlock setpoint, 1 = Open , 2 = Close" />
      <VarDeclaration ID="7DE7E04BA65FF582" Name="PermClose" Type="BOOL" Comment="1= Close Permission available" />
      <VarDeclaration ID="F1D46CDCC1D5A6C6" Name="PermOpen" Type="BOOL" Comment="1= Open Permission available" />
      <VarDeclaration ID="9BBC553B7236462E" Name="StdOwnerConnected" Type="BOOL" Comment="1 = External owner conncted" />
      <VarDeclaration ID="6C32AB699640FC5A" Name="ExternalControlled" Type="BOOL" Comment="1 = External control is active" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="6FC14464C1C740FE" Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration ID="4F225555750B7DE3" Name="STATUS" Type="STRING" Comment="Service Status" />
      <VarDeclaration ID="D82AC87A2FA22E86" Name="Owner" Type="WORD" Comment="16#10= Operator owner , 16#8 = Program owner" />
      <VarDeclaration ID="861B8773AF2757FC" Name="MonTime" Type="DINT" Comment="Feedback monitoring time" />
      <VarDeclaration ID="5568E3E91B9AAED8" Name="TripTime" Type="DINT" Comment="Feedback trip time" />
      <VarDeclaration ID="3DA6D0F9276D43A4" Name="ConfResetReq" Type="BOOL" Comment="1= Need reset on confirmation mismatch" />
      <VarDeclaration ID="4D34C1A4533BA5DF" Name="Reset" Type="BOOL" Comment="1 = Reset request from supervision" />
      <VarDeclaration ID="869E02415F6A841" Name="Sp" Type="INT" Comment="New setpoint from the supervision" />
      <VarDeclaration ID="CF1EA84FDDBF53A1" Name="Simulation" Type="BOOL" Comment="1 = Enable device in Simulation" />
      <VarDeclaration ID="AD38F01F8F0043E7" Name="FbOverride" Type="BOOL" Comment="1 = Enable device in Override mode" />
      <VarDeclaration ID="C8DEEF765E4F14C0" Name="Maintenance" Type="BOOL" Comment="1 = Enable device in maintenance mode" />
      <VarDeclaration ID="C4714A0B76119976" Name="OutOfService" Type="BOOL" Comment="1 = Out of Service Mode selected" />
      <VarDeclaration ID="B394B8C6484B76DE" Name="ScanTime" Type="DINT" Comment="Alarm holding time" />
      <VarDeclaration ID="E4ACFA19543211CB" Name="AlmAckType" Type="USINT" Comment="0=Not ackable; 1=Ack deletes; 2=Came has to be acked; 3=Came and gone have to be acked; 4=Pair has to be acked" />
      <VarDeclaration ID="52A3AF601F61E85C" Name="EnTrackSp" Type="BOOL" Comment="1= Enable the tracking of Interlock setpoint" />
      <VarDeclaration ID="6A4CE6BC8D982056" Name="ValveCmdType" Type="BOOL" Comment="0 = Normally Closed Valve, 1 = Normally Open Valve" />
      <VarDeclaration ID="7801A8D91AA682F9" Name="FbMode" Type="BYTE" Comment="Bit mask to disable feedback monitoring (16#0- Both fb; 16#1- Only Open fb; 16#3- No fb)" />
    </OutputVars>
  </InterfaceList>
  <Service RightInterface="" LeftInterface="">
    <ServiceSequence Name="" />
  </Service>
</FBType>