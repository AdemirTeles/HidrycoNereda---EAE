<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="2d5e4423-2092-4636-ae0d-a957726e335b" Comment="Composite Function Block Type" Name="ValveBase" Format="2.0" Namespace="Main">
  <Attribute Name="HMI.Alias" Value="" />
  <Attribute Name="Configuration.FB.IDCounter" Value="209" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="1.0.1" Author="ApplicationLibDevTeam" Date="10/17/2023" Remarks="First Version" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ_SP" Comment="Request to update setpoint">
        <With Var="Sp" />
      </Event>
      <Event Name="REQ_FB" Comment="Request to update feedbacks">
        <With Var="FbClose" />
        <With Var="FbOpen" />
      </Event>
      <Event Name="REQ_PERM" Comment="Request to update permissive conditions">
        <With Var="PermClose" />
        <With Var="PermOpen" />
      </Event>
      <Event Name="REQ_ILCK" Comment="Request to update interlock conditions">
        <With Var="PermClose" />
        <With Var="IlckCond" />
        <With Var="IlckPos" />
        <With Var="IlckType" />
      </Event>
      <Event Name="REQ_DIS_FBALM" Comment="Request to disable feedback alarm" />
      <Event Name="REQ_SUPPRESS_ALM" Comment="Request to update the alarm suppress status">
        <With Var="SuppressAlarm" />
      </Event>
      <Event Name="REQ_RESET" Comment="Request to reset the device">
        <With Var="Reset" />
      </Event>
      <Event Name="REQ_EXT_CTL">
        <With Var="ExternalControlled" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF_OUT" Comment="Execution of confirmation output">
        <With Var="Out" />
      </Event>
      <Event Name="CNF_FB_STS" Comment="Execution of confirmed state">
        <With Var="FbStatus" />
        <With Var="FbOpened" />
        <With Var="FbClosed" />
      </Event>
      <Event Name="CNF_READY" Comment="Execution of Ready status">
        <With Var="Ready" />
      </Event>
      <Event Name="CNF_ALM" Comment="Execution of confirmation  alarm conditions">
        <With Var="AlarmStatus" />
      </Event>
      <Event Name="CNF_FB_ALM" Comment="Execution of confirmation  Fb alarm">
        <With Var="FbAlarm" />
      </Event>
      <Event Name="CNF_NEED_RESET" Comment="Request for Reset">
        <With Var="NeedReset" />
      </Event>
      <Event Name="CNF_MODE" Comment="Excecution of new operational modes">
        <With Var="OutOfService" />
        <With Var="Simulation" />
        <With Var="FbOverride" />
        <With Var="Maintenance" />
      </Event>
      <Event Name="CNF_SP">
        <With Var="CurrentSp" />
      </Event>
      <Event Name="CNF_OWNER" Comment="Execution confirmation of owner">
        <With Var="CurrentOwner" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Sp" Type="INT" Comment="Setpoint of device (1 = Open, 2 = Close)" />
      <VarDeclaration Name="FbClose" Type="BOOL" Comment="1 = Device Close feedback active" />
      <VarDeclaration Name="FbOpen" Type="BOOL" Comment="1 = Device Open feedback active" />
      <VarDeclaration Name="PermClose" Type="BOOL" InitialValue="TRUE" Comment="1 = Device Close permission active" />
      <VarDeclaration Name="PermOpen" Type="BOOL" InitialValue="TRUE" Comment="1 = Device Open permission active" />
      <VarDeclaration Name="IlckCond" Type="BOOL" Comment="1 = Interlock condition active" />
      <VarDeclaration Name="IlckPos" Type="INT" Comment="Interlock setpoint state (0 = stop, 1 = Open, 2 = Close, 3 = Interlock inactive)" />
      <VarDeclaration Name="IlckType" Type="CondType" Namespace="SE.App2CommonProcess" Comment="Type of condition interlock, (0 = Normal, 1 = Process interlock/Sequence interlock)" />
      <VarDeclaration Name="SuppressAlarm" Type="BOOL" Comment="1 = Suppress alarm in HMI" />
      <VarDeclaration Name="Reset" Type="BOOL" Comment="1 = Reset device failure" />
      <VarDeclaration Name="ExternalControlled" Type="BOOL" Comment="1 = External control is active" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Out" Type="INT" Comment="Output to HW ( 1 = Open command, 2 = Close command) depending on NO/NC" />
      <VarDeclaration Name="CurrentSp" Type="INT" Comment="Output value considering permissive conditions" />
      <VarDeclaration Name="FbStatus" Type="INT" Comment="Confirmed state of the device (0 = Stopped, 1 = Opened, 2 = Closed , 253 = Unknown)" />
      <VarDeclaration Name="FbClosed" Type="BOOL" Comment="1 = Closed" />
      <VarDeclaration Name="FbOpened" Type="BOOL" Comment="1 = Opened" />
      <VarDeclaration Name="Ready" Type="BOOL" Comment="1 = Device is ready to run" />
      <VarDeclaration Name="AlarmStatus" Type="WORD" Comment="Bit 2 = Feedback failure status" />
      <VarDeclaration Name="FbAlarm" Type="BOOL" Comment="1 = Feedback failure alarm is active" />
      <VarDeclaration Name="NeedReset" Type="BOOL" Comment="1 = Device need reset to resume the operation" />
      <VarDeclaration Name="Simulation" Type="BOOL" Comment="1 = Simulation mode is active" />
      <VarDeclaration Name="FbOverride" Type="BOOL" Comment="1 = Feedback overide (Sp = FbStatus)" />
      <VarDeclaration Name="Maintenance" Type="BOOL" Comment="1 = Maintenance mode is active" />
      <VarDeclaration Name="OutOfService" Type="BOOL" Comment="1 = Out of service mode is active" />
      <VarDeclaration Name="CurrentOwner" Type="WORD" Comment="Current owner data from externlal source and basic owner 16#8 = Program owner, 16#10 = Operator owner, 16#4 = program Local and 16#40 Operator Local" />
    </OutputVars>
    <Sockets>
      <AdapterDeclaration ID="187" Name="IServiceExtn" Type="IServiceExtension" Namespace="SE.App2CommonProcess" Comment="Services extension adapter(Seq control, Local panel, Maintenance and Owner)" x="9780" y="2920">
        <Parameter Name="$ServiceState" Value="TRUE" />
      </AdapterDeclaration>
    </Sockets>
  </InterfaceList>
