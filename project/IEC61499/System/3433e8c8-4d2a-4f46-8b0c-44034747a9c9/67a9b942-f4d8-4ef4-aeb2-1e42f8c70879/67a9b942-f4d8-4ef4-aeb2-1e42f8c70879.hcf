              <Value xsi:type="xsd:unsignedShort">502</Value>
            </ItemProperty>
            <ItemProperty>
              <Name>connectinfo.transportprotocol</Name>
              <Value xsi:type="xsd:string">tcp</Value>
            </ItemProperty>
            <ItemProperty>
              <Name>connectinfo.stationid</Name>
              <Value xsi:type="xsd:unsignedShort">255</Value>
            </ItemProperty>
            <ItemProperty>
              <Name>connectinfo.responsetimeout</Name>
              <Value xsi:type="xsd:unsignedShort">500</Value>
            </ItemProperty>
            <ItemProperty>
              <Name>connectinfo.fallbackValue</Name>
              <Value xsi:type="xsd:string">HOLD</Value>
            </ItemProperty>
            <ItemProperty>
