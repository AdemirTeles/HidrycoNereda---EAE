            </ItemProperty>
            <ItemProperty>
              <Name>diagnostics</Name>
              <Value xsi:type="xsd:string">disabled</Value>
            </ItemProperty>
          </ItemProperties>
          <ParameterValues>
            <ParameterValue Name="ComStatusTimeout" Value="T#5s" Comment="Delay Time" />
            <ParameterValue Name="FeedbackTimeout" Value="T#3s" Comment="Feedback Timeout Settings" />
            <ParameterValue Name="CommandReady" Comment="Drive Ready State Command (0: NST | 1: RDY)" IsSymlink="true" />
            <ParameterValue Name="CommandRunForward" Comment="Run Forward Command (0: Stop | 1: RunForward) " IsSymlink="true" />
            <ParameterValue Name="CommandRunReverse" Comment="Run Reverse Command (0: Stop | 1: RunReverse) " IsSymlink="true" />
            <ParameterValue Name="CommandQuickStop" Comment="Quick Stop Command (0: No/Reset Command | 1: Quick Stop)" IsSymlink="true" />
            <ParameterValue Name="CommandSetpointSpeedPct" Comment="Speed Setpoint (%)" IsSymlink="true" />
            <ParameterValue Name="AtvCommandSetpointSpeedRpm" Comment="Speed Setpoint (RPM) " IsSymlink="true" />
            <ParameterValue Name="AtvUseRpmSpeed" Comment="Speed Setpoint Unit Selection (0: % | 1: RPM) " IsSymlink="true" />
            <ParameterValue Name="ResetError" Comment="Reset Error Command (0: No reset | 1: Reset command) " IsSymlink="true" />
            <ParameterValue Name="FeedbackRunForward" Comment="Run Forward Feedback (0: Stopped | 1: RunForward) " IsSymlink="true" />
            <ParameterValue Name="FeedbackRunReverse" Comment="Run Reverse Feedback (0: Stopped | 1: RunReverse) " IsSymlink="true" />
            <ParameterValue Name="FeedbackSpeedPct" Comment="Speed Feedback (%) " IsSymlink="true" />
            <ParameterValue Name="AtvFeedbackSpeedRpm" Comment="Speed Feedback (RPM) " IsSymlink="true" />
            <ParameterValue Name="Error" Comment="Error Status (0: No error | 1: Error active) " IsSymlink="true" />
            <ParameterValue Name="Ready" Comment="Drive is in Ready State (0: Not ready | 1: Ready) " IsSymlink="true" />
            <ParameterValue Name="LocalOverride" Comment="Motor External Control (0: Auto | 1: External Control) " IsSymlink="true" />
            <ParameterValue Name="ComStatus" Comment="Device Communication Status (0: Inactive | 1: Active) " IsSymlink="true" />
            <ParameterValue Name="ConnStatus" Comment="Connection establishment status between the client and server (online = connection established; offline = connection not established)" IsSymlink="true" />
            <ParameterValue Name="ConnDisable" Comment="connection control , False:connect(default), True:disconnect" IsSymlink="true" />
          </ParameterValues>
          <PreviousItem>
            <Name>MODBUS</Name>
            <PortName>busOut</PortName>
          </PreviousItem>
          <Items />
        </ConfigurationBaseItem>
