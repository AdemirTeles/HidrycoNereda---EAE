<?xml version="1.0" encoding="utf-8"?>
<DeviceHwConfigurationItems xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Version="1.0.0.0">
  <DeviceHwConfigurationItem ResourceId="8EEDDB2ED1745356">
    <ConfigurationBaseItem>
      <Name>BMTM3</Name>
      <ID>22B94E91D408B02E</ID>
      <Type>
        <Name>BMTM3</Name>
        <Namespace>SE.IoTMx</Namespace>
      </Type>
      <ItemProperties>
        <ItemProperty>
          <Name>busid</Name>
          <Value xsi:type="xsd:string">TM3Config</Value>
          <HWParameters>
            <string>BUS_ID</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>powerConsumption</Name>
          <Value xsi:type="xsd:unsignedByte">0</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>buscycletime</Name>
          <Value xsi:type="xsd:string">T#80ms</Value>
          <HWParameters>
            <string>busCycleTime</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>buscycletolerance</Name>
          <Value xsi:type="xsd:string">30</Value>
          <HWParameters>
            <string>busCycleTolerance</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>buscycleactionwhenmissed</Name>
          <Value xsi:type="xsd:string">1</Value>
          <HWParameters>
            <string>busCycleActionWhenMissed</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>enableSymlinkOC</Name>
          <Value xsi:type="xsd:string">TRUE</Value>
          <HWParameters>
            <string>enableSymlinkOC</string>
          </HWParameters>
        </ItemProperty>
      </ItemProperties>
      <ParameterValues>
        <ParameterValue Name="busId" Value="'BMTM3'" Comment="Uniquely identifies a bus in a device" />
        <ParameterValue Name="enableSymlinkOC" Value="TRUE" Comment="If TRUE, Symlink variables are relearnt during OnlineChange" />
        <ParameterValue Name="phase" Value="T#0ms" Comment="Delay before starting the bus events at application start to avoid same phase. &#xD;&#xA;Please apply a different phase for each bus master to avoid having all events processed in the same time phase." />
        <ParameterValue Name="busCycleTime" Value="T#80ms" Comment="Period at which the bus is scheduled (RX/TX)" />
        <ParameterValue Name="busCycleTolerance" Value="30" Comment="Tolerance expressed as percentage of the bus cycle time. &#xD;&#xA;We consider a missed cycle if elapsed time since previous cycle &gt; (bus cycle time + tolerance) or &lt; (bus cycle time - tolerance)." />
        <ParameterValue Name="busCycleActionWhenMissed" Value="1" Comment="Action to trigger on missed bus cycle. &#xD;&#xA;INFO to log warning with lower impact on performances (indicates how many bus cycle(s) were missed) ; &#xD;&#xA;DEBUG to log detailed warning with higher impact on performance (indicates exact drift for each missed cycle) ; &#xD;&#xA;ERROR_HALT to log an error and move" />
        <ParameterValue Name="busStatusSymlink" Value="" Comment="Get bus Status via Symlink" IsSymlink="true" />
      </ParameterValues>
      <MasterConfigFileName>${ProjectDir}\${SystemName}\RuntimeData\${DeviceName}\boot\${busid}.xml</MasterConfigFileName>
      <Items>
        <ConfigurationBaseItem>
          <Name>TM262L01MDESE8T</Name>
          <ID>F903885E680FD8F5</ID>
          <Type>
            <Name>TM262L01MDESE8T</Name>
            <Namespace>SE.IoTMx</Namespace>
          </Type>
          <ItemProperties />
          <ParameterValues />
          <PreviousItem>
            <Name>BMTM3</Name>
            <PortName>BusOut</PortName>
          </PreviousItem>
          <Items />
        </ConfigurationBaseItem>
      </Items>
    </ConfigurationBaseItem>
    <ConfigurationBaseItem>
      <Name>MODBUS</Name>
      <ID>8F1289C95ED838F9</ID>
      <Type>
        <Name>MODBUS</Name>
        <Namespace>Standard.IoModbus</Namespace>
      </Type>
      <ItemProperties>
        <ItemProperty>
          <Name>busid</Name>
          <Value xsi:type="xsd:string">MODBUS</Value>
          <HWParameters>
            <string>BUS_ID</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>configurationFilesLocation</Name>
          <Value xsi:type="xsd:string">Working</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>protocol</Name>
          <Value xsi:type="xsd:string">modbus</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>buscycletime</Name>
          <Value xsi:type="xsd:string">T#80ms</Value>
          <HWParameters>
            <string>busCycleTime</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>enableSymlinkOC</Name>
          <Value xsi:type="xsd:string">FALSE</Value>
          <HWParameters>
            <string>enableSymlinkOC</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>buscycletolerance</Name>
          <Value xsi:type="xsd:string">10</Value>
          <HWParameters>
            <string>busCycleTolerance</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>buscycleactionwhenmissed</Name>
          <Value xsi:type="xsd:string">1</Value>
          <HWParameters>
            <string>busCycleActionWhenMissed</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>alignwithrespriority</Name>
          <Value xsi:type="xsd:string">FALSE</Value>
          <HWParameters>
            <string>alignWithResPriority</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>ReconnectAfterTimeout</Name>
          <Value xsi:type="xsd:string">Enable</Value>
          <HWParameters>
            <string>ReconnectAfterTimeout</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>connectinfo.mastertype</Name>
          <Value xsi:type="xsd:string">master</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>connectinfo.transportprotocol</Name>
          <Value xsi:type="xsd:string">tcp</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>connectinfo.interframedelay</Name>
          <Value xsi:type="xsd:unsignedShort">10</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>logging.enabled</Name>
          <Value xsi:type="xsd:boolean">false</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>logging.filename</Name>
          <Value xsi:type="xsd:string">modbus.log</Value>
        </ItemProperty>
      </ItemProperties>
      <ParameterValues>
        <ParameterValue Name="autoStart" Value="FALSE" Comment="If TRUE, the initial event is taken from an E_RESTART block; &#xD;&#xA;if FALSE, the function block can be initialized using an event chain with name HW_INIT" />
        <ParameterValue Name="BUS_ID" Value="'MODBUS'" Comment="Modbus Client BusMaster Instance Name" />
        <ParameterValue Name="enableSymlinkOC" Value="FALSE" Comment="if TRUE, Symlink variables are relearnt during OnlineChange" />
        <ParameterValue Name="phase" Value="T#0ms" Comment="Delay before starting the bus events at application start to avoid same phase. &#xD;&#xA;Please apply a different phase for each bus master to avoid having all events processed in the same time phase." />
        <ParameterValue Name="busCycleTime" Value="T#80ms" Comment="Time interval at which the I/O scanning operation will be performed" />
        <ParameterValue Name="busCycleTolerance" Value="10" Comment="Tolerance expressed as percentage of the bus cycle time. &#xD;&#xA;Missed cycle count is incremented if elapsed time since previous cycle time is not within limits of bus cycle time with tolerance." />
        <ParameterValue Name="busCycleActionWhenMissed" Value="1" Comment="Action to trigger on missed bus cycle. &#xD;&#xA;INFO to log warning with lower impact on performances (indicates how many bus cycle(s) were missed) ; &#xD;&#xA;DEBUG to log detailed warning with higher impact on performance (indicates exact drift for each missed cycle) ; &#xD;&#xA;ERROR_HALT to log an error and move to Error Halt state" />
        <ParameterValue Name="alignWithResPriority" Value="FALSE" Comment="Set to true to align priority of Modbus worker threads with resource priority" />
      </ParameterValues>
      <MasterConfigFileName>${ProjectDir}\${SystemName}\RuntimeData\${DeviceName}\boot\${busid}.xml</MasterConfigFileName>
      <Items>
        <ConfigurationBaseItem>
          <Name>ATV320SpeedControlLightMbtcp</Name>
