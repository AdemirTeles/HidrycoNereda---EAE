          <Name>connectinfo.serialSettings.port</Name>
          <Value xsi:type="xsd:string">COM1</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>connectinfo.serialSettings.speed</Name>
          <Value xsi:type="xsd:unsignedInt">9600</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>connectinfo.serialSettings.databits</Name>
          <Value xsi:type="xsd:unsignedShort">8</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>connectinfo.serialSettings.parity</Name>
          <Value xsi:type="xsd:string">N</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>connectinfo.serialSettings.stopbits</Name>
          <Value xsi:type="xsd:unsignedShort">2</Value>
        </ItemProperty>
