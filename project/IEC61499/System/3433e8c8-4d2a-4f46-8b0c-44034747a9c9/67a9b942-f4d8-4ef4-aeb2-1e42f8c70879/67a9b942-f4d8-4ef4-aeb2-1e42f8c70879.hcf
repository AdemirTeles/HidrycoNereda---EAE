      <Name>MB_INSTRUMENTOS_NEREDA</Name>
      <ID>E415073E9B1C9CA3</ID>
      <Type>
        <Name>MODBUS</Name>
        <Namespace>Standard.IoModbus</Namespace>
      </Type>
      <ItemProperties>
        <ItemProperty>
