          <Name>connectinfo.serialSettings.standard</Name>
          <Value xsi:type="xsd:string">RS485</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>connectinfo.serialSettings.polarisation</Name>
          <Value xsi:type="xsd:string">No</Value>
