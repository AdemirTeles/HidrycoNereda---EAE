      <ParameterValues>
        <ParameterValue Name="autoStart" Value="TRUE" Comment="If TRUE, the initial event is taken from an E_RESTART block; &#xD;&#xA;if FALSE, the function block can be initialized using an event chain with name HW_INIT" />
        <ParameterValue Name="BUS_ID" Value="'MB_INVERSORES_EEEB'" Comment="Bus master Modbus TCP dos inversores ATV630 da Elevatoria de Esgoto Bruto (100-BS-01/02/03). LIGA e RESET cabeados; por aqui so referencia de velocidade e leituras." />
        <ParameterValue Name="enableSymlinkOC" Value="FALSE" Comment="if TRUE, Symlink variables are relearnt during OnlineChange" />
        <ParameterValue Name="phase" Value="T#90ms" Comment="Delay before starting the bus events at application start to avoid same phase. &#xD;&#xA;Please apply a different phase for each bus master to avoid having all events processed in the same time phase." />
        <ParameterValue Name="busCycleTime" Value="T#200ms" Comment="Time interval at which the I/O scanning operation will be performed" />
        <ParameterValue Name="busCycleTolerance" Value="10" Comment="Tolerance expressed as percentage of the bus cycle time. &#xD;&#xA;Missed cycle count is incremented if elapsed time since previous cycle time is not within limits of bus cycle time with tolerance." />
        <ParameterValue Name="busCycleActionWhenMissed" Value="1" Comment="Action to trigger on missed bus cycle. &#xD;&#xA;INFO to log warning with lower impact on performances (indicates how many bus cycle(s) were missed) ; &#xD;&#xA;DEBUG to log detailed warning with higher impact on performance (indicates exact drift for each missed cycle) ; &#xD;&#xA;ERROR_HALT to log an error and move to Error Halt state" />
        <ParameterValue Name="alignWithResPriority" Value="FALSE" Comment="Set to true to align priority of Modbus worker threads with resource priority" />
      </ParameterValues>
      <MasterConfigFileName>${ProjectDir}\${SystemName}\RuntimeData\${DeviceName}\boot\${busid}.xml</MasterConfigFileName>
