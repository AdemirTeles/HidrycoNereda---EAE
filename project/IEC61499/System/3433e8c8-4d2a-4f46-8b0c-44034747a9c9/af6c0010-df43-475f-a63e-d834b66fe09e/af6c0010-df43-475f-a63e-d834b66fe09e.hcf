    <ConfigurationBaseItem>
      <Name>MB_INVERSORES_SUB</Name>
      <ID>9F8BA5F2265A42FA</ID>
      <Type>
        <Name>MODBUS</Name>
        <Namespace>Standard.IoModbus</Namespace>
      </Type>
      <ItemProperties>
        <ItemProperty>
          <Name>busid</Name>
          <Value xsi:type="xsd:string">MB_INVERSORES_SUB</Value>
          <HWParameters>
            <string>BUS_ID</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>configurationFilesLocation</Name>
          <Value xsi:type="xsd:string">Working</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>protocol</Name>
          <Value xsi:type="xsd:string">modbus</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>buscycletime</Name>
          <Value xsi:type="xsd:string">T#80ms</Value>
          <HWParameters>
            <string>busCycleTime</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>enableSymlinkOC</Name>
          <Value xsi:type="xsd:boolean">false</Value>
          <HWParameters>
            <string>enableSymlinkOC</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>buscycletolerance</Name>
          <Value xsi:type="xsd:unsignedInt">10</Value>
          <HWParameters>
            <string>busCycleTolerance</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>buscycleactionwhenmissed</Name>
          <Value xsi:type="xsd:unsignedInt">1</Value>
          <HWParameters>
            <string>busCycleActionWhenMissed</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>alignwithrespriority</Name>
          <Value xsi:type="xsd:boolean">false</Value>
          <HWParameters>
            <string>alignWithResPriority</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>ReconnectAfterTimeout</Name>
          <Value xsi:type="xsd:string">Enable</Value>
          <HWParameters>
            <string>ReconnectAfterTimeout</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>connectinfo.mastertype</Name>
          <Value xsi:type="xsd:string">master</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>connectinfo.transportprotocol</Name>
          <Value xsi:type="xsd:string">tcp</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>connectinfo.interframedelay</Name>
          <Value xsi:type="xsd:unsignedShort">10</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>logging.enabled</Name>
          <Value xsi:type="xsd:boolean">false</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>logging.filename</Name>
          <Value xsi:type="xsd:string">modbus.log</Value>
        </ItemProperty>
      </ItemProperties>
      <ParameterValues>
        <ParameterValue Name="autoStart" Value="TRUE" Comment="If TRUE, the initial event is taken from an E_RESTART block; &#xD;&#xA;if FALSE, the function block can be initialized using an event chain with name HW_INIT" />
        <ParameterValue Name="BUS_ID" Value="'MB_INVERSORES_SUB'" Comment="Bus master Modbus TCP dos inversores das bombas de gordura 200-BR-03/04 (LIGA e RESET cabeados na remota 1; por aqui referencia de velocidade, leituras e ComStatus)." />
        <ParameterValue Name="enableSymlinkOC" Value="FALSE" Comment="if TRUE, Symlink variables are relearnt during OnlineChange" />
        <ParameterValue Name="phase" Value="T#50ms" Comment="Delay before starting the bus events at application start to avoid same phase. &#xD;&#xA;Please apply a different phase for each bus master to avoid having all events processed in the same time phase." />
        <ParameterValue Name="busCycleTime" Value="T#80ms" Comment="Time interval at which the I/O scanning operation will be performed" />
        <ParameterValue Name="busCycleTolerance" Value="10" Comment="Tolerance expressed as percentage of the bus cycle time. &#xD;&#xA;Missed cycle count is incremented if elapsed time since previous cycle time is not within limits of bus cycle time with tolerance." />
        <ParameterValue Name="busCycleActionWhenMissed" Value="1" Comment="Action to trigger on missed bus cycle. &#xD;&#xA;INFO to log warning with lower impact on performances (indicates how many bus cycle(s) were missed) ; &#xD;&#xA;DEBUG to log detailed warning with higher impact on performance (indicates exact drift for each missed cycle) ; &#xD;&#xA;ERROR_HALT to log an error and move to Error Halt state" />
        <ParameterValue Name="alignWithResPriority" Value="FALSE" Comment="Set to true to align priority of Modbus worker threads with resource priority" />
      </ParameterValues>
      <MasterConfigFileName>${ProjectDir}\${SystemName}\RuntimeData\${DeviceName}\boot\${busid}.xml</MasterConfigFileName>
      <Items>
      <ConfigurationBaseItem>
        <Name>BR_200_03_COM</Name>
        <ID>9625C4DF3D377E43</ID>
        <Type>
          <Name>ATVSpeedControlMbtcp</Name>
          <Namespace>SE.FieldDevice</Namespace>
        </Type>
        <ItemProperties>
          <ItemProperty>
            <Name>IPAddress</Name>
            <Value xsi:type="xsd:string">10.26.208.176</Value>
            <HWParameters>
              <string>IPAddress</string>
            </HWParameters>
          </ItemProperty>
