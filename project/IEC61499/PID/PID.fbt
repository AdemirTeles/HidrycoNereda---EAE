      <Adapter Name="IExtPara" Type="IPIDExtPara" Namespace="SE.App2CommonProcess" Comment="External PID parameters interface adapter" />
      <Adapter Name="ISc" Type="IDevice" Namespace="SE.App2CommonProcess" Comment="Sequence control adapter, Controls the block when owner is in program local" />
      <Adapter Name="IAutotune" Type="IAutotune" Namespace="SE.App2CommonProcess" />
    </AdapterInputs>
    <AdapterOutputs>
      <Adapter Name="IOut" Type="IAnalog" Namespace="SE.App2Base" Comment="Current output status Interface adapter" />
